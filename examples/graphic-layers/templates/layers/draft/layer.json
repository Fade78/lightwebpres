{
  "schema": "lightwebpres.layer/1",
  "id": "draft",
  "tags": ["draft"],
  "plane": "under-content",
  "elements": [
    {
      "id": "stamp",
      "asset": "draft-label",
      "rotate": "-16deg",
      "opacity": 0.09,
      "size": {"width": {"percent": 65, "of": "slide.width"}},
      "place": {"target": {"ref": "slide", "anchor": "center"}, "self_anchor": "center"}
    },
    {
      "id": "mark",
      "asset": "compass",
      "size": {"width": "44px"},
      "opacity": 0.6,
      "place": {
        "target": {"ref": "slide", "anchor": "bottom-right"},
        "self_anchor": "bottom-right",
        "offset": ["-96px", "-24px"]
      },
      "effects": [{"kind": "shadow", "x": "1px", "y": "2px", "blur": "3px", "color": "#00000033"}]
    }
  ]
}
