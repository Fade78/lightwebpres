  }

  var shareBtn        = document.getElementById('navShare');
  var sharePopover     = document.getElementById('sharePopover');
  var shareHeadFiche   = document.getElementById('shareHeadFiche');
  var qrModal          = document.getElementById('shareQrModal');
  var qrModalContent   = document.getElementById('shareQrModalContent');
  var qrModalUrl       = document.getElementById('shareQrModalUrl');
  var shareFicheBtns   = sharePopover
    ? Array.prototype.slice.call(sharePopover.querySelectorAll('[data-scope="fiche"]'))
    : [];

  function updateShareFicheState() {
    var enabled = !!currentSlideId();
    shareFicheBtns.forEach(function (b) { b.disabled = !enabled; });
