def _series_entries(series_data):
    return (series_data.get('articles', series_data)
            if isinstance(series_data, dict) else series_data)


def series_tags(series_data):
    """Returns the ordered tag vocabulary available to the page runtime."""
    meta = series_meta_of(series_data)
    tags = ['default']
    seen = {'default'}

    def add(tag):
        if tag and tag not in seen:
            seen.add(tag)
            tags.append(tag)

    add(meta.get('default_tag', 'default'))
    for entry in _series_entries(series_data):
        for tag in entry.get('_lwp_article_tags', ()):
            add(tag)
        for tag in entry.get('_lwp_slide_tags', ()):
            add(tag)
    return tags


def _tag_set_accepts(tags, tag):
    """Applies the shared/default slide-tag rule to canonical tag values."""
    return ('default' in tags if tag == 'default'
            else 'default' in tags or tag in tags)


def tag_visibility_counts(series_data, entries=None, skip_ignored=False):
    """Counts effective article cards and slides for every selectable tag."""
    entries = (_series_entries(series_data) if entries is None else entries)
    vocabulary_entries = [entry for entry in entries
                          if not skip_ignored or entry.get('status') != 'ignored']
    vocabulary_data = series_data
    if skip_ignored:
        if isinstance(series_data, dict):
            vocabulary_data = dict(series_data)
            vocabulary_data['articles'] = vocabulary_entries
        else:
            vocabulary_data = vocabulary_entries
    counts = {tag: {'articles': 0, 'slides': 0}
              for tag in series_tags(vocabulary_data)}
    for entry in entries:
        if skip_ignored and entry.get('status') == 'ignored':
            continue
        article_tags = set(entry.get('_lwp_article_tags', ()))
        for tag in counts:
            if article_tags and tag not in article_tags:
                continue
            matching = [slide for slide in entry.get('_lwp_tag_slides', ())
                        if _tag_set_accepts(slide.get('tags', ()), tag)]
            if matching:
                counts[tag]['articles'] += 1
                counts[tag]['slides'] += len(matching)
    return counts


def warn_tag_visibility(series_data, entries=None, audit=False):
    """Warns when a selectable tag cannot display any effective slide."""
    try:
        meta = series_meta_of(series_data)
    except SystemExit:
        # `audit` has already reported the malformed default_tag and must keep
        # going; the normal build path reaches this helper only after the
        # stricter validation above has succeeded.
        if audit:
            return 0
        raise
    default_tag = meta.get('default_tag', 'default')
    counts = tag_visibility_counts(series_data, entries=entries,
                                   skip_ignored=audit)
    warnings = 0
    for tag, count in counts.items():
        if count['slides']:
            continue
        origin = 'audit' if audit else 'build'
        initial = (' The initial selection will be empty.'
                   if tag == default_tag else '')
        log('warn', f'{origin}: tag {tag!r} selects no displayable slide '
            f'after article gates and excluded slides are applied.{initial}')
        warnings += 1
    return warnings


def validate_series_default_tag(series_data):
    """Refuses a default tag absent from the articles being built."""
    meta = series_meta_of(series_data)
    default_tag = meta.get('default_tag', 'default')
    if default_tag == 'default':
        return
    available = set()
    for entry in _series_entries(series_data):
        available.update(entry.get('_lwp_article_tags', ()))
        available.update(entry.get('_lwp_slide_tags', ()))
    if default_tag not in available:
        log('error', f'series.json: series_meta.default_tag {default_tag!r} '
            'does not occur on an article or non-excluded slide in the '
            'articles selected for this build.')
        sys.exit(1)


def _entry_tag_attributes(entry):
    """HTML data attributes for one article card in index/nav."""
    article_tags = html_escape(
        ' '.join(entry.get('_lwp_article_tags', ())), quote=True)
    slide_tags = html_escape(
        ' '.join(entry.get('_lwp_slide_tags', ())), quote=True)
    return (' data-lwp-article-card="true"'
            f' data-lwp-article-tags="{article_tags}"'
            f' data-lwp-slide-tags="{slide_tags}"')


def tag_preview_data(series_data):
    """Serializes article and slide titles used by the runtime tag menu."""
    articles = []
    for number, entry in enumerate(_series_entries(series_data), 1):
        fallback = entry.get('page_dest') or f'Article {number}'
        title = entry.get('card_title') or entry.get('nav_title') or fallback
        title = strip_ws(re.sub(r'<[^<>]+>', ' ', str(title))) or fallback
        slides = []
        for slide in entry.get('_lwp_tag_slides', ()):
            slides.append({
                'title': slide.get('title', ''),
                'type': slide.get('type', 'standard'),
                'tags': list(slide.get('tags', ())),
            })
        articles.append({
            'title': title,
            'tags': list(entry.get('_lwp_article_tags', ())),
            'slides': slides,
        })
    return json.dumps({'articles': articles}, ensure_ascii=False,
                      separators=(',', ':'))


def build_series_nav(current_file, series_data, strings, typo_engine):
    """Generates the navigation block HTML for the current article.

    typo_engine here is always the *build's* engine, never the hosting
    article's own article_typo_engine: a `typo: off` on article X only
    scopes to X's own page content (§4.5) — X's fragments reused
    elsewhere, including every entry rendered here (even X's own), follow
    the normal build-wide rules, exactly like build_index()'s cards."""
    articles = _series_entries(series_data)
    read = strings.get('series_read', 'Read the article')
    current_status = strings.get('series_current_status', 'Currently reading')
    back = strings.get('series_back_to_index', 'Back to index')
    parts = []
    for entry in articles:
        # card_label/nav_title/nav_desc are already resolved by
        # resolve_article_fields() (series.json > article meta > fallback
        # chain, §20.3.1).
        label = apply_typo(typo_engine, escape_amps(entry.get('card_label', '')))
        # No empty <div class="series-label"> when there is no label
        label_html = f'      <div class="series-label">{label}</div>\n' if label else ''
        title = apply_typo(typo_engine, escape_amps(entry['nav_title']))
        desc = apply_typo(typo_engine, escape_amps(entry['nav_desc']))
        if entry['page_dest'] == current_file:
            parts.append(TEMPLATE_SERIES_NAV_ITEM_CURRENT.format(
                tag_attrs=_entry_tag_attributes(entry),
                label_html=label_html,
                title=title,
                desc=desc,
                status=current_status))
        else:
            parts.append(TEMPLATE_SERIES_NAV_ITEM_LINK.format(
                file=html_escape(entry['page_dest'], quote=True),
                tag_attrs=_entry_tag_attributes(entry),
                label_html=label_html,
                title=title,
                desc=desc,
                read=read))
    parts.append(TEMPLATE_SERIES_NAV_BACK.format(back=back))
    return '\n'.join(parts)


