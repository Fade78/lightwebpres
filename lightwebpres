# ----------------------------------------------------------------------------
# Catalogue port: THEMES entries expressed as property layers.
#
# Factored INSIDE, complete OUTSIDE — the owner's rule. Here, the dark
# furniture is one shared table instead of fourteen copies and a converter
# maps the old entry shape; but every user-facing file (the settings
# scaffold, a theme shown to an author) is always written complete, with
# nothing to chase through an include. The one legitimate include already
# exists and is the cascade itself: a settings file sits ON a theme.
# ----------------------------------------------------------------------------

# The old SURFACE_PRESETS[True], dissolved into ordinary component colours
# (alphas kept: .14->24, .24->3D, .055->0E, .30->4D, .13->21, .09->17).
# Light themes need no counterpart: the registry defaults ARE the light set.
DARK_FURNITURE_PROPS = {
    'slide.rule-fg': '#FFFFFF24', 'footer.rule-fg': '#FFFFFF24',
    'table.rule-fg': '#FFFFFF24', 'code.rule-fg': '#FFFFFF24',
    'quote.rule-fg': '#FFFFFF3D',
    'series-nav.current.rule-fg': '#FFFFFF3D',
    'card.rule-fg': '#FFFFFF3D', 'nav-btn.rule-fg': '#FFFFFF3D',
    'nav-dot.bg': '#FFFFFF3D',
    'fact.bg': '#FFFFFF0E', 'article.bg': '#FFFFFF0E',
    'series-nav.link.bg': '#FFFFFF0E', 'card.bg': '#FFFFFF0E',
    'code.bg': '#0000004D', 'table.head.bg': '#0000004D',
    'table.col-signal.bg': '#0000004D', 'table.col-snap.bg': '#0000004D',
    'series-nav.current.bg': '#0000004D', 'version-tag.bg': '#0000004D',
    'nav-btn.bg': '#FFFFFF21', 'nav-btn.bg-soft': '#FFFFFF17',
}

_ROLE_TO_COLOR = {'marker': 'mark', 'accent': 'call', 'positive': 'affirm',
                  'ink': 'ink', 'ink-muted': 'ink-quiet', 'page': 'page'}

# Per-slug property additions beyond what the old entry shape can say.
# terminal's register is the owner's decision (fixed pitch is what the theme
# is named for) plus its phosphor halo on display text.
THEME_PROPERTY_OVERRIDES = {
    'terminal': {
        'font.text': 'mono', 'font.display': 'mono', 'font.ui': 'mono',
        'title1.shadow.fg': '#33FF8866', 'title1.shadow.blur': '10px',
        'highlight.shadow.fg': '#33FF8859', 'highlight.shadow.blur': '8px',
    },
}


def theme_property_layer(theme_key):
    """A THEMES entry as a property layer for the engine.

    What dark_background used to switch behind the theme's back, the layer
    now says: the furniture veils invert, the cover stops inverting (its
    ground is a deeper veil of the page, its ink the pale text colour), and
    the two measured cover opacities are restated against the actual palette
    instead of assuming the default one."""
    t = THEMES[theme_key]
    dark = bool(t.get('dark_background'))
    layer = {
        'color.page': t['page'], 'color.ink': t['ink'],
        'color.ink-quiet': t['ink-muted'], 'color.mark': t['marker'],
        'color.call': t['accent'], 'color.affirm': t['positive'],
    }
    if dark:
        layer.update(DARK_FURNITURE_PROPS)
        layer.update({
            'cover.bg.from': '#00000073',        # rgba(0,0,0,.45) over the page
            'cover.fg': 'ink',
            'cover.summary.fg': t['ink'] + 'C7',   # the measured 0.78
            'cover.num.fg': '#FFFFFF8F',           # the measured 0.56
        })
    else:
        # The default literal assumes the default palette; restate it
        # against this theme's page so the 0.78 measurement follows.
        layer['cover.summary.fg'] = t['page'] + 'C7'

    layer['fact.strong.weight'] = t.get('fact_weight', 'bold')
    layer['fact.strong.style'] = t.get('fact_style', 'normal')
    # An entry may say `fact_highlight: None` — no ground at all, which is
    # not the same as saying nothing (the default is the mark ground). Five
    # catalogue themes use it; the first port run turned them yellow.
    highlight = t.get('fact_highlight', 'marker')
    if highlight in (None, 'transparent'):
        layer['fact.strong.bg'] = 'transparent'
        layer['fact.strong.fg'] = 'ink'
    else:
        layer['fact.strong.bg'] = _ROLE_TO_COLOR[highlight]
        # Text on a bright ground takes the dark tone: page on a dark
        # theme IS the dark tone, ink on a light one.
        layer['fact.strong.fg'] = 'page' if dark else 'ink'
    if t.get('fact_decoration'):
        layer['fact.strong.decoration'] = t['fact_decoration']
        if t.get('fact_decoration_color'):
            layer['fact.strong.decoration-color'] = (
                _ROLE_TO_COLOR[t['fact_decoration_color']])

    layer.update(THEME_PROPERTY_OVERRIDES.get(theme_key, {}))
    return layer


def _reference_target(prop, value):
    """The property `value` points at, or None if it is a literal.

    The axis fixes the type, the type fixes the namespace. A bare word is
    looked up there; a dotted word is a qualified reference. That is the
    whole rule — no guessing whether a value 'looks like' a key."""
    if prop.type.is_literal(value):
        return None
    if '.' in value:
        return value                  # qualified: title1.fg, cover.bg.from
    if prop.type.namespace:
        return f'{prop.type.namespace}.{value}'
    return None


def resolve_theme_properties(*layers):
    """built-in defaults -> theme -> series settings -> article. Later wins.

    Unknown keys are errors, not silence — that is the point of typing the
    surface. References are followed here and never reach the CSS."""
    raw = {k: p.default for k, p in PROPERTY_REGISTRY.items()}
    for layer in layers:
        for key, value in layer.items():
            if key not in PROPERTY_REGISTRY:
                tail = key.split('.')[-1]
                near = [k for k in PROPERTY_REGISTRY
                        if k.split('.')[-1] == tail]
                raise PropertyError(
                    f'{key}: unknown property'
                    + (f' (did you mean {near[0]}?)' if near else ''))
            raw[key] = value

    out = {}
    for key, prop in PROPERTY_REGISTRY.items():
        value, chain = raw[key], [key]
        while True:
            target = _reference_target(prop, value)
            if target is None:
                break
            if target not in PROPERTY_REGISTRY:
                raise PropertyError(
                    f'{key}: refers to unknown property {target!r}. '
                    f'A bare word is looked up in {prop.type.namespace}.*; '
                    f'a literal {prop.type.name} does not go through the '
                    f'namespace.')
            if target in chain:
                raise PropertyError(f'{key}: reference cycle '
                                    f'{" -> ".join(chain + [target])}')
            if len(chain) - 1 >= MAX_REFERENCE_HOPS:
                raise PropertyError(
                    f'{key}: reference chain deeper than '
                    f'{MAX_REFERENCE_HOPS} hops '
                    f'({" -> ".join(chain + [target])})')
            chain.append(target)
            value = raw[target]
        out[key] = prop.type.check(key, value)
    return out


def emit_theme_css(resolved):
    """The resolved property set becomes the :root block plus the rules that
    read it. Emission is derived from the registry, so completeness is
    structural: every property is consumed by construction, and nothing a
    rule consumes escapes the registry."""
    lines = [':root {', '  /* shared */']
    for p in THEME_SHARED_PROPS:
        lines.append(f'  {p.var}: {resolved[p.key]};')
    for c in THEME_COMPONENTS:
        lines.append(f'  /* {c.key} */')
        for p in c.props:
            lines.append(f'  {p.var}: {resolved[p.key]};')
    lines.append('}')

    for c in THEME_COMPONENTS:
        # Grouped by effective selector: a component's properties may land on
        # an inner element, a context, or a state — the base selector first,
        # overrides after it in declaration order.
        groups = {}
        for cssprop, value in c.composite:
            groups.setdefault(c.selector, []).append(f'  {cssprop}: {value};')
        for p in c.props:
            if p.css:
                sel = p.selector or c.selector
                groups.setdefault(sel, []).append(f'  {p.css}: var({p.var});')
        for sel, decls in groups.items():
            lines += [f'{sel} {{', *decls, '}']
        mark = next((p for p in c.props if p.key.endswith('.mark')), None)
        if mark:
            lines.append(
                f'{c.selector}::before {{ content: var({mark.var}); }}')
    return '\n'.join(lines)


def _driven_declarations():
    """(simple selector, css property) pairs the engine emits — the set the
    skeleton must NOT also contain, or a stale literal would fight the
    engine's value across the cascade."""
    driven = set()
    for c in THEME_COMPONENTS:
        for cssprop, _value in c.composite:
            for s in c.selector.split(','):
                driven.add((s.strip(), cssprop))
        for p in c.props:
            if p.css:
                for s in (p.selector or c.selector).split(','):
                    driven.add((s.strip(), p.css))
        if any(p.key.endswith('.mark') for p in c.props):
            driven.add((c.selector.strip() + '::before', 'content'))
    # The measured cover-summary opacity became an explicit alpha in
    # cover.summary.fg; leaving the opacity in the skeleton would dim the
    # already-dimmed colour a second time.
    driven.add(('.slide-cover .summary', 'opacity'))
    return driven


class SkeletonGapError(Exception):
    """A declaration in TEMPLATE_STYLE still references a CSS variable after
    every engine-driven declaration was removed. Each gap is a visual
    decision the registry does not expose — the completeness rule says that
    is a decision confiscated from the theme, so extraction refuses to ship
    it silently dead instead."""


def extract_skeleton(css_text=None):
    """The static, layout-only part of TEMPLATE_STYLE: everything the
    property registry does not drive.

    Derived at runtime from the same constant the old system ships, so there
    is exactly one source sheet during the transition. Drops the :root block
    (the engine emits its own) and every declaration the engine drives; keeps
    layout verbatim. --content-max stays: it is the skeleton's own layout
    variable, declared in the minimal :root this returns, and the one var()
    the gap check tolerates."""
    css_text = css_text if css_text is not None else TEMPLATE_STYLE
    driven = _driven_declarations()

    # Comments go first: the sheet's documentation contains braces and even
    # literal `:root { ... }` recipes, which wreck brace counting — and the
    # skeleton is an artifact nobody reads for prose. Stripping them also
    # removes the recipes block and the customization marker, both replaced
    # by the settings scaffold.
    css_text = re.sub(r'/\*.*?\*/', '', css_text, flags=re.S)

    out = [':root {\n    --content-max: min(84vw, 1100px);\n  }']
    gaps = []
    pos = 0
    depth = 0
    block_start = None
    at_rule = None
    i = 0
    # One linear pass. The sheet is machine-written and regular: top-level
    # `selector { decls }` blocks, plus one @media containing the same shape.
    while i < len(css_text):
        ch = css_text[i]
        if ch == '{':
            if depth == 0:
                block_start = pos
                header = css_text[pos:i].strip()
                if header.startswith('@'):
                    at_rule = header
            depth += 1
        elif ch == '}':
            depth -= 1
            if depth == 0:
                block = css_text[block_start:i + 1]
                header = css_text[block_start:css_text.index('{', block_start)].strip()
                if header.startswith('@'):
                    # Media overrides must survive: engine rules are emitted
                    # BEFORE the skeleton, so anything here wins by order —
                    # removal would break exactly what the query exists for.
                    out.append(block.strip())
                elif header == ':root':
                    pass                        # replaced by the engine's
                else:
                    kept = _strip_driven(header, block, driven, gaps)
                    if kept:
                        out.append(kept)
                pos = i + 1
                at_rule = None
        i += 1

    for line in out:
        for m in re.finditer(r'var\((--[a-z-]+)', line):
            if m.group(1) != '--content-max':
                gaps.append(m.group(0))
    if gaps:
        raise SkeletonGapError(
            'declarations the registry does not drive still reference '
            'variables: ' + ', '.join(sorted(set(gaps))))
    return '\n  '.join(out)


# CSS shorthands carrying colour, width AND style in one declaration. The
# engine drives colour and width as longhands; when it does, the skeleton
# keeps only the style the shorthand carried.
_SHORTHAND_STYLES = ('border', 'border-top', 'border-bottom', 'border-left',
                     'border-right', 'outline')


def _strip_driven(header, block, driven, gaps):
    """One block with its engine-driven declarations removed; '' if nothing
    is left worth keeping."""
    simples = [s.strip() for s in header.split(',')]
    body = block[block.index('{') + 1:block.rindex('}')]
    kept = []
    for decl in body.split(';'):
        decl = decl.strip()
        if not decl:
            continue
        prop = decl.split(':', 1)[0].strip()
        if any((s, prop) in driven for s in simples):
            continue
        if (prop in _SHORTHAND_STYLES
                and any((s, prop + '-color') in driven for s in simples)):
            # `border-bottom: 1px solid var(--rule)` -> the engine owns
            # colour and width; the style token is all that stays here.
            kept.append(f'{prop}-style: solid')
            continue
        kept.append(decl)
    if not kept:
        return ''
    return header + ' { ' + '; '.join(kept) + '; }'


def compose_stylesheet(resolved):
    """The full sheet for one resolved property set: the engine's :root and
    rules first, then the static skeleton — order matters, because the
    skeleton's @media overrides must beat the engine's base values, and they
    share specificity."""
    return emit_theme_css(resolved) + '\n' + extract_skeleton()


# ----------------------------------------------------------------------------
# The author's surface: templates/settings.conf (values) + custom.css (rules).
# Neither is ever written by the tool except on explicit request — that
# ownership split is what deleted the customization-marker apparatus.
# ----------------------------------------------------------------------------

SETTINGS_FILENAME = 'settings.conf'
CUSTOM_CSS_FILENAME = 'custom.css'

CUSTOM_CSS_STUB = '''/* Your own CSS. lightwebpres never writes this file, and appends it after
   the generated stylesheet. Anything CSS can do, you can do here — new
   rules, @font-face, media queries. Plain VALUES belong in settings.conf. */
'''


def parse_settings_text(text, source='settings.conf'):
    """(theme_slug_or_None, {property: raw value}) from an author's settings
    file. `key: value` lines, `#` comments, nothing else — a file that looks
    like properties and silently accepted CSS would be the old surface back.
    Errors name their line: the silent no-op is the failure mode this whole
    format exists to kill."""
    theme = None
    props = {}
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        if ':' not in line:
            raise PropertyError(
                f'{source}:{lineno}: not a `key: value` line: {line!r}. '
                f'CSS rules belong in {CUSTOM_CSS_FILENAME}.')
        key, value = line.split(':', 1)
        key, value = key.strip(), value.strip()
        if key == 'theme':
            if value not in THEMES:
                raise PropertyError(
                    f'{source}:{lineno}: unknown theme {value!r}. '
                    f'Run `lightwebpres themes` for the list.')
            theme = value
        else:
            props[key] = value
    return theme, props


def build_settings_scaffold(theme_key=None):
    """The complete settings file, every property present and commented out
    at its value under the chosen theme. Complete outside, always: the
    author sees the whole surface with nothing to chase through an include,
    and uncommenting a line pins it across every future theme change.

    Generated from the registry — the same structure that emits the CSS — so
    it cannot drift from what the engine accepts. Values are shown RAW
    (references as bare words, `tag.fg: ink-quiet`), because that is the
    vocabulary the author writes."""
    raw = {k: p.default for k, p in PROPERTY_REGISTRY.items()}
    if theme_key:
        raw.update(theme_property_layer(theme_key))

    lines = [
        '# lightwebpres settings — plain `key: value` properties, one per line.',
        '# lightwebpres never writes this file (set-theme rewrites only the',
        '# theme line below). Uncomment a line to pin it: it survives every',
        '# theme change and every version upgrade. Values shown are those of',
        f'# the theme at generation time. CSS rules belong in {CUSTOM_CSS_FILENAME}.',
        '',
        f'theme: {theme_key}' if theme_key else '# theme: <slug>   (default theme)',
        f'# scaffold-for: {theme_key or "default"}',
        '',
        '# ── shared values ──',
    ]
    for p in THEME_SHARED_PROPS:
        lines.append(f'# {p.key}: {raw[p.key]}')
    for c in THEME_COMPONENTS:
        lines.append('')
        lines.append(f'# ── {c.key} ──')
        for p in c.props:
            lines.append(f'# {p.key}: {raw[p.key]}')
    return '\n'.join(lines) + '\n'


def compose_series_stylesheet(templates_dir):
    """The CSS for one series: defaults -> theme -> settings, composed in
    memory, with the author's custom.css appended last so their rules win
    every same-specificity fight. Nothing here needs the disk beyond the two
    author-owned files."""
    settings_file = templates_dir / SETTINGS_FILENAME
    theme_key, props = (parse_settings_text(read_text_file(settings_file))
                        if settings_file.exists() else (None, {}))

    legacy = templates_dir / 'style.css'
    if legacy.exists():
        print(f'[WARN] templates/style.css is no longer read: the stylesheet '
              f'is composed from {SETTINGS_FILENAME}. Move your values there '
              f'(audit names the variable renames) and delete it.',
              file=sys.stderr)

    layers = [theme_property_layer(theme_key)] if theme_key else []
    layers.append(props)
    css = compose_stylesheet(resolve_theme_properties(*layers))

    custom_file = templates_dir / CUSTOM_CSS_FILENAME
    if custom_file.exists():
        css += '\n' + read_text_file(custom_file)
    return css


