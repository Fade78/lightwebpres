};
QRCodeModel.createBytes = function (buffer, rsBlocks) {
  var offset = 0;
  var maxDcCount = 0, maxEcCount = 0;
  var dcdata = new Array(rsBlocks.length);
  var ecdata = new Array(rsBlocks.length);
  for (var r = 0; r < rsBlocks.length; r++) {
    var dcCount = rsBlocks[r].dataCount;
    var ecCount = rsBlocks[r].totalCount - dcCount;
    maxDcCount = Math.max(maxDcCount, dcCount);
    maxEcCount = Math.max(maxEcCount, ecCount);
    dcdata[r] = new Array(dcCount);
    for (var i = 0; i < dcdata[r].length; i++) dcdata[r][i] = 0xff & buffer.buffer[i + offset];
    offset += dcCount;
    var rsPoly = QRUtil.getErrorCorrectPolynomial(ecCount);
    var rawPoly = new QRPolynomial(dcdata[r], rsPoly.getLength() - 1);
    var modPoly = rawPoly.mod(rsPoly);
    ecdata[r] = new Array(rsPoly.getLength() - 1);
    for (var i2 = 0; i2 < ecdata[r].length; i2++) {
      var modIndex = i2 + modPoly.getLength() - ecdata[r].length;
      ecdata[r][i2] = (modIndex >= 0) ? modPoly.get(modIndex) : 0;
    }
  }
  var totalCodeCount = 0;
  for (var i3 = 0; i3 < rsBlocks.length; i3++) totalCodeCount += rsBlocks[i3].totalCount;
  var data = new Array(totalCodeCount);
  var index = 0;
  for (var i4 = 0; i4 < maxDcCount; i4++) {
    for (var r2 = 0; r2 < rsBlocks.length; r2++) {
      if (i4 < dcdata[r2].length) data[index++] = dcdata[r2][i4];
    }
  }
  for (var i5 = 0; i5 < maxEcCount; i5++) {
    for (var r3 = 0; r3 < rsBlocks.length; r3++) {
      if (i5 < ecdata[r3].length) data[index++] = ecdata[r3][i5];
    }
  }
  return data;
};

function qrEncode(text, errorCorrectLevel) {
  var ecLevel = errorCorrectLevel === undefined ? QRErrorCorrectLevel.M : errorCorrectLevel;
  for (var typeNumber = 1; typeNumber <= 40; typeNumber++) {
    try {
      var qr = new QRCodeModel(typeNumber, ecLevel);
      qr.addData(text);
      qr.make();
      var n = qr.getModuleCount();
      var matrix = new Array(n);
      for (var row = 0; row < n; row++) {
        matrix[row] = new Array(n);
        for (var col = 0; col < n; col++) matrix[row][col] = qr.isDark(row, col);
      }
      return matrix;
    } catch (e) {
      if (typeNumber === 40) throw e;
      continue;
    }
  }
}
  return qrEncode;
})();

document.addEventListener('DOMContentLoaded', function() {
(function(){
  var slides   = Array.prototype.slice.call(document.querySelectorAll('section.slide'));
  var current  = 0;
  var isScrolling = false;
  // Separate from isScrolling (which only guards goTo()'s own scroll
  // animation, and only against re-targeting the SAME slide): holding
  // an arrow key down fires native auto-repeat keydown events much
  // faster than isScrolling's lock ever blocks — every repeat calls
  // stepForward()/stepBackward() again with `current` already updated
  // from the previous call, so it just keeps advancing (card to card,
  // then straight past the whole series-nav slide) far faster than a
  // human can perceive any of the individual steps. This cooldown
  // throttles processing to one step per STEP_COOLDOWN_MS regardless of
  // how fast the events actually arrive — invisible to a single
  // deliberate press (which never repeats within the window), only
  // felt as a controlled pace while a key is held.
  var stepCooldownActive = false;
  var STEP_COOLDOWN_MS = 150;
  // Index into the CURRENT slide's keyboard-reachable links (series-nav
  // cards + the "back to index" link, in document order) — -1 means none
  // focused yet. Reset on every slide change (goTo). Only ever non-empty
  // on the series-nav slide; every other slide behaves exactly as if
  // this never existed.
  var focusedCard = -1;
  var btnPrev    = document.getElementById('navPrev');
  var btnNext    = document.getElementById('navNext');
  var btnHome    = document.getElementById('navHome');
  var navDots    = document.querySelector('.nav-dots');

  if (navDots) {
    slides.forEach(function(s, i) {
      var a = document.createElement('a');
      a.href = '#' + (s.id || ('s'+(i+1)));
      var tagEl = s.querySelector('.slide-tag');
      var headEl = s.querySelector('h2, h1');
      a.title = tagEl ? tagEl.textContent : (headEl ? headEl.textContent : ('{{str_nav_dot_fallback}} ' + (i+1)));
      a.addEventListener('click', function(e){ e.preventDefault(); goTo(i); });
      navDots.appendChild(a);
    });
  }
  var dots = navDots ? Array.prototype.slice.call(navDots.querySelectorAll('a')) : [];

  function goTo(idx) {
    idx = Math.max(0, Math.min(slides.length - 1, idx));
    if (idx === current && isScrolling) return;
    current = idx;
    focusedCard = -1;
    isScrolling = true;
    slides[idx].scrollIntoView({ behavior: 'smooth', block: 'start' });
    updateUI();
    setTimeout(function(){ isScrolling = false; }, 700);
  }

  // The series-nav slide's cards, in document order (includes the "back
  // to index" link, itself an .series-link — it's a legitimate stop in
  // the same keyboard journey). Empty on every other slide.
  function slideCards(idx) {
    return Array.prototype.slice.call(slides[idx].querySelectorAll('.series-list a.series-link'));
  }

  // .slide only sets min-height: 100vh (specifications.md §9), so a
  // slide's real height only exceeds the viewport when its own content
  // demands it — a long full-article slide being the common case, but
  // this only ever looks at actual layout, never a slide type or
  // position, so it works for whichever slide ends up being the tall one.
  function overflowsViewport(slide) {
    return slide.getBoundingClientRect().height > window.innerHeight + 1;
  }
  function atSlideTop(slide) {
    return slide.getBoundingClientRect().top >= -1;
  }
  function atSlideBottom(slide) {
    return slide.getBoundingClientRect().bottom <= window.innerHeight + 1;
  }
  function scrollWithinSlide(direction) {
    window.scrollBy({ top: direction * window.innerHeight * 0.9, behavior: 'smooth' });
  }

  // The natural keyboard journey (in this order, each one only kicking in
  // once the previous is exhausted): slide to slide, then — on the
  // series-nav slide specifically — card to card (focus() already
  // scrolls a card into view on its own, which doubles as "scroll a
  // series-nav slide taller than the viewport"), then, for any other
  // slide taller than the viewport (typically the closing full-article),
  // scroll it down in increments before moving on. Enter needs no extra
  // handling: once a card has real focus, the browser's own default
  // "Enter activates the focused link" already does the jump.
  function stepForward() {
    var cards = slideCards(current);
    if (cards.length && focusedCard < cards.length - 1) {
      focusedCard++;
      cards[focusedCard].focus();
      return;
    }
    if (focusedCard >= 0 && cards.length) { cards[focusedCard].blur(); }
    var slide = slides[current];
    if (overflowsViewport(slide) && !atSlideBottom(slide)) {
      scrollWithinSlide(1);
      return;
    }
    goTo(current + 1);
  }

  function stepBackward() {
    var cards = slideCards(current);
    if (focusedCard > 0) {
      focusedCard--;
      cards[focusedCard].focus();
      return;
    }
    if (focusedCard === 0) {
      focusedCard = -1;
      cards[0].blur();
    }
    var slide = slides[current];
