document.addEventListener('DOMContentLoaded', function() {
(function(){
  var slides   = Array.prototype.slice.call(document.querySelectorAll('section.slide'));
  var current  = 0;
  var isScrolling = false;
  // Separate from isScrolling (which only guards goTo()'s own scroll
  // animation, and only against re-targeting the SAME slide): holding
  // an arrow key down fires native auto-repeat keydown events much
  // faster than isScrolling's lock ever blocks — every repeat calls
  // stepForward()/stepBackward() again with `current` already updated
  // from the previous call, so it just keeps advancing (card to card,
  // then straight past the whole series-nav slide) far faster than a
  // human can perceive any of the individual steps. This cooldown
  // throttles processing to one step per STEP_COOLDOWN_MS regardless of
  // how fast the events actually arrive — invisible to a single
  // deliberate press (which never repeats within the window), only
  // felt as a controlled pace while a key is held.
  var stepCooldownActive = false;
  var STEP_COOLDOWN_MS = 150;
  // Index into the CURRENT slide's keyboard-reachable links (series-nav
  // cards + the "back to index" link, in document order) — -1 means none
  // focused yet. Reset on every slide change (goTo). Only ever non-empty
  // on the series-nav slide; every other slide behaves exactly as if
  // this never existed.
  var focusedCard = -1;
  var btnPrev    = document.getElementById('navPrev');
  var btnNext    = document.getElementById('navNext');
  var btnHome    = document.getElementById('navHome');
  var navDots    = document.querySelector('.nav-dots');

  if (navDots) {
    slides.forEach(function(s, i) {
      var a = document.createElement('a');
      a.href = '#' + (s.id || ('s'+(i+1)));
      var tagEl = s.querySelector('.slide-tag');
      var headEl = s.querySelector('h2, h1');
      a.title = tagEl ? tagEl.textContent : (headEl ? headEl.textContent : ('{{str_nav_dot_fallback}} ' + (i+1)));
      a.addEventListener('click', function(e){ e.preventDefault(); goTo(i); });
      navDots.appendChild(a);
    });
  }
  var dots = navDots ? Array.prototype.slice.call(navDots.querySelectorAll('a')) : [];

  function goTo(idx) {
    idx = Math.max(0, Math.min(slides.length - 1, idx));
    if (idx === current && isScrolling) return;
    current = idx;
    focusedCard = -1;
    isScrolling = true;
    slides[idx].scrollIntoView({ behavior: 'smooth', block: 'start' });
    updateUI();
    setTimeout(function(){ isScrolling = false; }, 700);
  }

  // The series-nav slide's cards, in document order (includes the "back
  // to index" link, itself an .series-link — it's a legitimate stop in
  // the same keyboard journey). Empty on every other slide.
  function slideCards(idx) {
    return Array.prototype.slice.call(slides[idx].querySelectorAll('.series-list a.series-link'));
  }

  // .slide only sets min-height: 100vh (specifications.md §9), so a
  // slide's real height only exceeds the viewport when its own content
  // demands it — a long full-article slide being the common case, but
  // this only ever looks at actual layout, never a slide type or
  // position, so it works for whichever slide ends up being the tall one.
  function overflowsViewport(slide) {
    return slide.getBoundingClientRect().height > window.innerHeight + 1;
  }
  function atSlideTop(slide) {
    return slide.getBoundingClientRect().top >= -1;
  }
  function atSlideBottom(slide) {
    return slide.getBoundingClientRect().bottom <= window.innerHeight + 1;
  }
  function scrollWithinSlide(direction) {
    window.scrollBy({ top: direction * window.innerHeight * 0.9, behavior: 'smooth' });
  }

  // The natural keyboard journey (in this order, each one only kicking in
  // once the previous is exhausted): slide to slide, then — on the
  // series-nav slide specifically — card to card (focus() already
  // scrolls a card into view on its own, which doubles as "scroll a
  // series-nav slide taller than the viewport"), then, for any other
  // slide taller than the viewport (typically the closing full-article),
  // scroll it down in increments before moving on. Enter needs no extra
  // handling: once a card has real focus, the browser's own default
  // "Enter activates the focused link" already does the jump.
  function stepForward() {
    var cards = slideCards(current);
    if (cards.length && focusedCard < cards.length - 1) {
      focusedCard++;
      cards[focusedCard].focus();
      return;
    }
    if (focusedCard >= 0 && cards.length) { cards[focusedCard].blur(); }
    var slide = slides[current];
    if (overflowsViewport(slide) && !atSlideBottom(slide)) {
      scrollWithinSlide(1);
      return;
    }
    goTo(current + 1);
  }

  function stepBackward() {
    var cards = slideCards(current);
    if (focusedCard > 0) {
      focusedCard--;
      cards[focusedCard].focus();
      return;
    }
    if (focusedCard === 0) {
      focusedCard = -1;
      cards[0].blur();
    }
    var slide = slides[current];
    if (overflowsViewport(slide) && !atSlideTop(slide)) {
      scrollWithinSlide(-1);
      return;
    }
    goTo(current - 1);
  }

  function updateUI() {
    btnPrev.classList.toggle('disabled', current === 0);
    btnNext.classList.toggle('disabled', current === slides.length - 1);
    dots.forEach(function(d, i){ d.classList.toggle('active', i === current); });
    updateShareFicheState();
  }

  btnPrev.addEventListener('click', function(){ goTo(current - 1); });
  btnNext.addEventListener('click', function(){ goTo(current + 1); });
  if (btnHome) {
    btnHome.addEventListener('click', function(){ window.location.href = 'index.html'; });
  }

  // Keyboard operability for the round nav buttons (they are role=button
  // divs, tabindex=0): Enter/Space activate them like a native <button>,
  // so the share popover (which has no other keyboard entry point) and
  // the prev/next/home controls are reachable without a mouse.
  Array.prototype.forEach.call(document.querySelectorAll('.nav-btn'), function (btn) {
    btn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        btn.click();
      }
    });
  });

  function runStepped(fn) {
    if (stepCooldownActive) return;
    stepCooldownActive = true;
    fn();
    setTimeout(function () { stepCooldownActive = false; }, STEP_COOLDOWN_MS);
  }

  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown') {
      e.preventDefault(); runStepped(stepForward);
    } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
      e.preventDefault(); runStepped(stepBackward);
    } else if (e.key === 'Home') {
      e.preventDefault(); window.location.href = 'index.html';
    }
  });

  function detectCurrent() {
    if (isScrolling) return;
    var winH = window.innerHeight;
    var mid  = winH / 2;
    var best = current;
    // Which slide's own [top, bottom] span contains the viewport's
    // vertical midpoint — not "nearest center", which breaks as soon as
    // one slide is much taller than the rest (a long full-article, the
    // very case arrow-key scrolling now has to handle): its center can
    // sit far below the visible viewport even while its top edge is what
    // the user is actually looking at, so distance-to-center would keep
    // picking a short neighboring slide instead.
    slides.forEach(function(s, i) {
      var rect = s.getBoundingClientRect();
      if (rect.top <= mid && rect.bottom >= mid) best = i;
    });
    if (best !== current) { current = best; focusedCard = -1; updateUI(); }
  }

  var scrollTimer = null;
  window.addEventListener('scroll', function() {
    if (scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(detectCurrent, 80);
  }, { passive: true });

  // --- Share button: popover with a copy-link / QR-code matrix, scoped to
  // the series index, this article, or the current slide. §9.3.4.
  // The slide scope is decided by TYPE, not position: disabled on cover
  // slides (they identify the article itself, wherever they sit — slide
  // order is free, §4.4) and on the series-nav slide (its id is not
  // sN); enabled on standard and full-article slides, including one in
  // first position.
  function currentSlideId() {
    var s = slides[current];
    if (!s || !/^s\d+$/.test(s.id)) return null;
    if (s.classList.contains('slide-cover')) return null;
    return s.id;
  }

  function shareUrl(scope) {
    if (scope === 'series') {
      return location.origin + location.pathname.replace(/[^\/]*$/, '') + 'index.html';
    }
    if (scope === 'article') {
      return location.origin + location.pathname;
    }
    if (scope === 'fiche') {
      var id = currentSlideId();
      return id ? (location.origin + location.pathname + '#' + id) : null;
    }
    return null;
  }

  var shareBtn        = document.getElementById('navShare');
  var sharePopover     = document.getElementById('sharePopover');
  var shareHeadFiche   = document.getElementById('shareHeadFiche');
  var qrModal          = document.getElementById('shareQrModal');
  var qrModalContent   = document.getElementById('shareQrModalContent');
  var qrModalUrl       = document.getElementById('shareQrModalUrl');
  var shareFicheBtns   = sharePopover
    ? Array.prototype.slice.call(sharePopover.querySelectorAll('[data-scope="fiche"]'))
    : [];

  function updateShareFicheState() {
    var enabled = !!currentSlideId();
    shareFicheBtns.forEach(function (b) { b.disabled = !enabled; });
    if (shareHeadFiche) shareHeadFiche.classList.toggle('share-cell-head-disabled', !enabled);
  }

  function closeSharePopover() {
    if (sharePopover) sharePopover.classList.remove('open');
  }

  function closeQrModal() {
    if (qrModal) qrModal.classList.remove('open');
  }

  function qrToSvg(text) {
    var matrix = qrEncode(text);
    var n = matrix.length;
    var border = 4;
    var size = n + border * 2;
    var rects = '';
    for (var r = 0; r < n; r++) {
      for (var c = 0; c < n; c++) {
        if (matrix[r][c]) rects += '<rect x="' + (c + border) + '" y="' + (r + border) + '" width="1" height="1"/>';
      }
    }
    return '<svg viewBox="0 0 ' + size + ' ' + size + '" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">'
      + '<rect width="' + size + '" height="' + size + '" fill="#fff"/>'
      + '<g fill="#1a1a2e">' + rects + '</g></svg>';
  }

  if (shareBtn && sharePopover) {
    shareBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      updateShareFicheState();
      sharePopover.classList.toggle('open');
    });
    sharePopover.addEventListener('click', function (e) { e.stopPropagation(); });
    document.addEventListener('click', function () { closeSharePopover(); });

    Array.prototype.slice.call(sharePopover.querySelectorAll('.share-action')).forEach(function (btn) {
      btn.addEventListener('click', function () {
        var scope = btn.getAttribute('data-scope');
        var action = btn.getAttribute('data-action');
        var url = shareUrl(scope);
        if (!url) return;
        if (action === 'copy') {
          var original = btn.textContent;
          var originalTitle = btn.title;
          var done = function () {
            btn.textContent = '✓';
            btn.title = '{{str_copy_link_done}}';
            setTimeout(function () { btn.textContent = original; btn.title = originalTitle; }, 1600);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done, function () { window.prompt('{{str_copy_prompt}}', url); });
          } else {
            window.prompt('{{str_copy_prompt}}', url);
          }
        } else if (action === 'qr' && qrModal && qrModalContent) {
          qrModalContent.innerHTML = qrToSvg(url);
          if (qrModalUrl) qrModalUrl.textContent = url;
          closeSharePopover();
          qrModal.classList.add('open');
        }
      });
    });
  }

  if (qrModal) {
    qrModal.addEventListener('click', function (e) {
      if (e.target === qrModal || e.target.classList.contains('share-qr-close')) closeQrModal();
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeSharePopover(); closeQrModal(); }
  });

  updateUI();
})();
});
'''

