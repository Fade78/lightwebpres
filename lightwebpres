  padding: 8px 12px;
  border-style: solid;
}
.full-article table th { font-weight: 700; }
.full-article strong { font-weight: 700; }
.full-article em { font-style: italic; }
.full-article .refs p { font-size: max(13px, 1.625vmin); margin-bottom: 6px; }

/* --- Series navigation --- */
/* The column, like everything else on a card. A flat 680px left the
   navigation at 42% of the column at 1920 and 21% at 3840, pinned to the
   left edge of a card whose heading ran the full width -- and the
   heading is what a series-nav slide puts directly above this list, so
   any width narrower than the column is also a second centre on the one
   card that has only two things on it. Reading --page-content-max gives
   both of the things a narrow box was reaching for: it is wider, and it
   is centred, because it IS the column. */
.series-list { max-width: var(--page-content-max); }
.series-item {
  display: block;
  padding: 20px 24px;
  margin-bottom: 16px;
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
}
/* No opacity on the current card. Dimming it to signal "you are here"
   dimmed its three lines of text with it: 1.62:1 on the worst theme, and
   below AA on the affected themes. Its sunken ground, its border and the status glyph
   carry the same signal without touching a contrast ratio. */
.series-current { border-style: solid; }
.series-link {
  border-style: solid;
  transition: transform 0.15s, box-shadow 0.15s;
}
.series-link:hover, .series-link:focus-visible {
  transform: translateY(-2px);
}
.series-link:focus-visible { outline-style: solid; outline-offset: 2px; }
.series-label { margin-bottom: 4px; }
.series-title { margin-bottom: 4px; }
.series-desc { margin-bottom: 8px; }

/* --- Navigation chrome. The opacities below fade a control's glyph, not
   running text, which is why they are allowed to stay literal. --- */
/* Pause overlay (B/W/T keys): a solid screen that hides the slide so the
   speaker draws the audience's eye. Sits above the slides, below the
   nav buttons (so the speaker can still navigate). The background is
   set by JS (black, white, or the theme's --page-bg) — never a colour
   literal here, the skeleton carries no content colour. */
.pause-overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 500;
}
.pause-overlay.open { display: block; }
/* In fullscreen, disable text selection: rapid slide navigation (mouse
   wheel, click-drag, keyboard) can be misread by the browser as a
   double-click drag and leave a selection highlight across slide content
   while the speaker is talking. */
body.fs-noselect {
  user-select: none;
  -webkit-user-select: none;
}
.nav-buttons {
  position: fixed;
  bottom: calc(24px + env(safe-area-inset-bottom));
  right: 28px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  z-index: 200;
  transition: opacity 0.4s;
}
.nav-row { display: flex; justify-content: flex-end; }
/* Auto-hide in presentation: the buttons fade out after 3s of idleness
   and come back on 250ms of continuous mouse movement, the same
   condition as the cursor.

   Touch devices fade out on the same delay and come back on a double
   tap. They used to keep the chrome forever — the reason given was that
   there is no cursor to wake it, which was true of the mechanism and
   false of the need: on a phone the buttons sit permanently over the
   text, and a reader has no way at all to put them away. A deliberate
   gesture is the wake, and it is the one the reader already knows from
   every video player. */
/* The scroll bar is navigation too, and it was the last thing left
   answering to the pointer on its own: with the buttons and the cursor
   correctly hidden, moving the mouse painted an overlay bar down the
   edge of the wall. Reported from a real talk.

   Colour, not width. `scrollbar-width: none` and a zero-width
   ::-webkit-scrollbar remove the bar's BOX, which on a platform with
   classic (space-taking) bars reflows the whole page every time the
   chrome hides or shows — far worse than a visible bar. `scrollbar-color`
   only recolours, so the gutter is untouched wherever there is one, and
   an engine that does not support it simply keeps its bar rather than
   relaying out the page. */
:root.nav-idle { scrollbar-color: transparent transparent; }
.nav-buttons.idle { opacity: 0; }
.nav-buttons.idle:hover { opacity: 1; }
.nav-mode-toast {
  position: fixed;
  left: 50%;
  bottom: calc(24px + env(safe-area-inset-bottom) + 64px);
  z-index: 260;
  max-width: calc(100vw - 32px);
  padding: 8px 14px;
  border-style: solid;
  border-width: 1px;
  border-radius: 999px;
  background: inherit;
  color: inherit;
  visibility: hidden;
  pointer-events: none;
  transform: translate(-50%, 8px);
  transition: visibility 0s linear 0.18s, transform 0.18s;
  white-space: normal;
  text-align: center;
}
.nav-mode-toast.show {
  visibility: visible;
  transition-delay: 0s;
  transform: translate(-50%, 0);
}
/* Faded chrome must also stop answering the finger. `opacity: 0` hides a
   thing without disarming it, and with a mouse that is harmless — the
   hover rule above brings it back before any click can land. There is no
   hover on a phone, so an invisible button in the bottom-right corner
   would fire on a reader who touched the corner of their own text. */
@media (pointer: coarse) { .nav-buttons.idle, .nav-dots.idle, .slide-counter.idle { pointer-events: none; } }
/* No width/height here: the circle is drawn against the glyph, so the
   engine derives both from `nav-btn.size` (see the nav-btn composite).
   The skeleton stating a second number is how they drifted apart. */
.nav-btn {
  border-radius: 50%;
  border-style: solid;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s, box-shadow 0.15s;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.nav-btn:hover {
  transform: scale(1.08);
}
.nav-btn:active { transform: scale(0.96); }
.nav-btn:focus-visible { outline-style: solid; outline-offset: 2px; }
.nav-btn.disabled { opacity: 0.25; cursor: default; pointer-events: none; }
/* The home glyph's size comes from the nav-btn-home composite. */
/* The dialog's children are all `em`, so without a size here they were
   `em` of a body that never grows -- flat at every width, measured. */
.tag-menu {
  position: fixed;
  font-size: max(16px, 2vmin);
  bottom: 24px;
  z-index: 250;
  display: none;
  min-width: 180px;
  max-height: min(72vh, 720px);
  box-sizing: border-box;
  overflow: auto;
  border-style: solid;
  border-width: 1px;
  background: inherit;
  color: inherit;
}
.tag-menu.open { display: block; }
.tag-menu-title {
  margin: 2px 4px 8px;
  font-size: 0.8em;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.tag-menu-current {
  margin: 0 4px 5px;
  font-size: 0.95em;
  font-weight: 700;
}
.tag-menu-summary {
  margin: 0 4px 12px;
  font-size: 0.75em;
}
.tag-menu-list { display: flex; flex-wrap: wrap; gap: 6px; }
.tag-option {
  border-style: solid;
  border-width: 1px;
  border-radius: 999px;
  padding: 5px 9px;
  background: inherit;
  color: inherit;
  cursor: pointer;
  font: inherit;
  font-size: 0.85em;
}
.tag-option.active {
  font-weight: 700;
  border-width: 2px;
}
.tag-option:focus-visible { outline-style: solid; outline-offset: 2px; }
.tag-menu-preview-title {
  margin: 16px 4px 7px;
  padding-top: 11px;
  border-top-style: solid;
  border-top-width: 1px;
  font-size: 0.75em;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.tag-preview-article + .tag-preview-article { margin-top: 11px; }
.tag-preview-article-title { font-size: 0.9em; font-weight: 700; }
.tag-preview-slides {
  margin: 3px 0 0;
  padding: 0 0 0 1.1em;
}
.tag-preview-slide {
  margin: 2px 0;
  font-size: 0.8em;
}
.tag-preview-empty {
  margin: 0 4px;
  font-size: 0.8em;
  font-style: italic;
}
.tag-empty-state {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 140;
  max-width: min(520px, 80vw);
  padding: 14px 18px;
  border-style: solid;
  border-width: 1px;
  background: inherit;
  color: inherit;
  text-align: center;
  transform: translate(-50%, -50%);
}
.tag-empty-state[hidden] { display: none; }
.nav-dots {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  z-index: 150;
  transition: opacity 0.4s;
}
.nav-dots.idle { opacity: 0; }
.nav-dots.idle:hover { opacity: 1; }
.nav-dots a {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: block;
  transition: background 0.2s, transform 0.2s;
}
.nav-dots a:hover { transform: scale(1.3); }
.nav-dots a.active { transform: scale(1.3); }

/* The index column, on the measure a slide uses and read from the same
   property, so the two pages of one series cannot drift apart.
   `templates/index.html` carried `padding: 60px 8vw; max-width: 1200px`
   inline: a fixed cap beside a padding that grows with the viewport, so
   the index got NARROWER as the screen got wider while the slide got
   wider. Measured before the fix, index against slide: 970 against 1210
   at 1440, 893 against 1613 at 1920, 790 against 2150 at 2560 — and on a
   390-wide phone, 31px of side padding against 24px, because the mobile
   breakpoint below reached one page and not the other. Two ends of the
   same scale, one cause: the rule was somewhere no rule could answer. */
.index-page { padding: 60px max(8vw, (100% - var(--page-content-max)) / 2); }
/* Speaker counter (X / N) + presenter notes panel (key N). */
.slide-counter {
  position: fixed;
  bottom: 22px;
  left: 28px;
  z-index: 150;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: max(13px, 1.625vmin);
  padding: 4px 11px;
  border-radius: 999px;
  border-style: solid;
  border-width: 1px;
  /* `inherit`, like every neighbouring overlay -- .presenter-panel,
     .tag-menu and .help-overlay all resolve to the page's own ground and
     measure AA on every theme in the catalogue. `none` let the cover's
     gradient show
     through, and on a light theme `page.fg` and `cover.bg.from` are both
     `color.ink`: the counter's ink WAS its ground. Measured at exactly
     1.00:1 on 15 themes in the then catalogue, with the 1px border in currentColor
     vanishing along with it. Invisible to `theme show`'s contrast report
     by construction, because this element has no registry property for
     that report to read. */
  background: inherit;
  transition: opacity 0.4s;
  user-select: none;
  -webkit-user-select: none;
}
.slide-counter.idle { opacity: 0; }
.slide-counter.idle:hover { opacity: 1; }
/* The one part of the page a SPEAKER reads, and it was the flattest:
   15.2px at 375 and 15.2px at 3840, measured, because its three children
   are all `em` of a body that never grew. Same expression as .slide-body,
   which is the size the panel paraphrases.

   `tabindex="0"` in the markup is not decoration: `overflow: auto` with a
   max-height makes this a scrollable region, and a scrollable region that
   cannot take focus cannot be scrolled from the keyboard at all. */
.presenter-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  font-size: max(16px, 2vmin);
  max-height: 44vh;
  z-index: 300;
  padding: 16px 28px 20px;
  border-top-style: solid;
  border-top-width: 1px;
  background: inherit;
  color: inherit;
  overflow: auto;
  display: none;
}
.presenter-panel.open { display: block; }
.presenter-panel .pp-head {
  font-weight: 700;
  font-size: 0.95em;
  margin-bottom: 10px;
}
.presenter-panel .pp-notes { font-size: 0.95em; line-height: 1.5; white-space: pre-wrap; }
.presenter-panel .pp-next {
  margin-top: 12px;
  padding-top: 10px;
  border-top-style: solid;
  border-top-width: 1px;
  font-size: 0.9em;
}

/* Help overlay (key H): every keyboard shortcut and gesture. */
.help-overlay {
  position: fixed;
  inset: 0;
  z-index: 400;
  background: inherit;
  color: inherit;
  display: none;
  overflow: auto;
  overscroll-behavior: contain;
  padding: 48px 24px;
}
.help-overlay.open { display: block; }
/* Same as .tag-menu: every line inside is `em` of this box, and this box
   had no size of its own. */
.help-card {
  font-size: max(16px, 2vmin);
  max-width: 660px;
  margin: 0 auto;
  border-style: solid;
  border-width: 1px;
  border-radius: 12px;
  padding: 24px 28px;
  background: inherit;
}
.help-title { font-weight: 700; font-size: 1.2em; margin-bottom: 16px; }
.help-list { list-style: none; margin: 0; padding: 0; }
.help-list li {
  display: flex;
  gap: 16px;
  align-items: baseline;
  padding: 7px 0;
  border-top-style: solid;
  border-top-width: 1px;
}
.help-keys {
  flex: 0 0 220px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-weight: 700;
}
.help-desc { flex: 1; }
.help-card:focus { outline: none; }
.help-stamp {
  margin-top: 16px;
  padding-top: 12px;
  border-top-style: solid;
  border-top-width: 1px;
  font-size: max(12px, 0.75em);
  text-align: center;
  letter-spacing: 0.02em;
}

/* Presenter action menu (key M). It is the keyboard equivalent of the
   navigation chrome: one place for actions that otherwise live behind
   separate keys or small buttons. */
.presenter-menu, .theme-menu {
  position: fixed;
  inset: 0;
  z-index: 500;
  display: none;
  overflow: auto;
  padding: 48px 24px;
  background: inherit;
  color: inherit;
}
.presenter-menu.open, .theme-menu.open { display: block; }
.presenter-menu-card, .theme-menu-card {
  max-width: 720px;
  margin: 0 auto;
  padding: 24px 28px;
  /* These overlays sit outside a slide, so body ems would otherwise stay
     flat while the page's other controls grow with the viewport. */
  font-size: max(16px, 1.5vmin);
  border-style: solid;
  border-width: 1px;
  border-radius: 12px;
  background: inherit;
}
.presenter-menu-title, .theme-menu-title {
  margin-bottom: 16px;
  font-size: 1.2em;
  font-weight: 700;
}
.presenter-menu-actions {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 8px;
}
.presenter-menu-action, .theme-option {
  border-style: solid;
  border-width: 1px;
  border-radius: 8px;
  padding: 10px 12px;
  background: inherit;
  color: inherit;
  cursor: pointer;
  font: inherit;
  text-align: left;
}
.presenter-menu-action {
  display: grid;
  grid-template-columns: 1.25em minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
}
.presenter-menu-action[hidden] { display: none; }
.presenter-menu-action > svg {
  width: 1.25em;
  height: 1.25em;
}
.presenter-menu-label { min-width: 0; }
.presenter-menu-action kbd {
  padding: 0.12em 0.35em;
  border: 1px solid currentColor;
  border-radius: 4px;
  font: 0.72em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  white-space: nowrap;
  opacity: 0.85;
}
.presenter-menu-action:hover, .theme-option:hover,
.presenter-menu-action.active, .theme-option.active {
  text-decoration-line: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 0.15em;
}
.presenter-menu-action:focus-visible, .theme-option:focus-visible,
.theme-filter:focus-visible { outline-style: solid; outline-offset: 2px; }
.theme-menu-help {
  margin: 0 0 12px;
  font-size: 0.85em;
}
.theme-filter {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 12px;
  padding: 9px 11px;
  border-style: solid;
  border-width: 1px;
  border-radius: 8px;
  background: inherit;
  color: inherit;
  font: inherit;
}
.theme-options {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 8px;
  max-height: 54vh;
  overflow: auto;
}
.theme-option {
  min-height: 72px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.theme-option small { display: block; margin-top: 3px; opacity: 0.85; }
.theme-menu-foot {
  margin-top: 16px;
  padding-top: 12px;
  border-top-style: solid;
  border-top-width: 1px;
  font-size: 0.85em;
}

/* --- The highlight block ---
   --page-content-max, not --page-block-max, and NOT a flex column. Two
   defects lived in the four lines this replaces, and both were measured
   in a browser before and after.

   The width: block-max caps at 1100px, so on a card whose text ran the
   full column the key figure was centred inside a 1100px box pinned to
   the column's left edge -- centred on a different thing from everything
   above and below it. Measured off-centre by 55px at 1440, 256px at
   1920 and 1063px at 3840. block-max is right for a table or a code
   block: those are LEFT-aligned, so a narrower box still shares the
   column's left edge and reads as deliberate. A centred box is the one
   case where a different width becomes a different centre, which is why
   this is the only consumer that had to move.

   The flex: `align-items: center` centred the two children and, in doing
   so, made highlight.align dead. That property emits `text-align` onto
   this element, and text-align does nothing to flex items -- setting
   `highlight.align: left` moved the figure by zero pixels, measured.
   Plain blocks inherit text-align, so the property now does what the
   registry has always advertised, and the default `center` centres the
   figure and its caption on the column. */
.highlight {
  margin: 18px 0 22px;
  max-width: var(--page-content-max);
}
.highlight-figure { display: block; overflow-wrap: anywhere; }
.highlight-caption { display: block; margin-top: 6px; }

/* --- Share popover and its QR modal --- */
.share-popover {
  position: fixed;
  font-size: max(14px, 1.75vmin);
  bottom: 80px;
  right: 28px;
  z-index: 250;
  border-radius: 12px;
  padding: 14px;
  display: none;
  max-width: calc(100vw - 40px);
}
.share-popover.open { display: block; }
.share-matrix {
  display: grid;
  grid-template-columns: auto repeat(3, 1fr);
  gap: 6px 10px;
  align-items: center;
}
.share-cell-head {
  font-weight: 700;
  text-align: center;
  font-size: max(11px, 1.375vmin);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.share-cell-head-disabled { opacity: 0.35; }
.share-cell-label { white-space: nowrap; padding-right: 10px; }
button.share-action {
  /* 36 / 16 = 2.25: the box drawn against the glyph, as .nav-btn is --
     written out rather than derived, because the share chrome states no
     glyph size of its own for the engine to read. */
  width: max(36px, 4.5vmin);
  height: max(36px, 4.5vmin);
  border-radius: 8px;
  border-style: solid;
  cursor: pointer;
  font-size: max(16px, 2vmin);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  font-family: inherit;
  transition: border-color 0.15s, background 0.15s;
}
button.share-action:disabled { opacity: 0.25; cursor: default; }
.share-qr-modal {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.share-qr-modal.open { display: flex; }
/* 400px, not 320: a longer URL bumps the code to a higher version (more
   modules), and a small on-screen code is the likeliest reason a phone's
   native camera fails to detect one that decodes fine in a dedicated
   scanner. Give it room to stay legible. */
.share-qr-modal-content {
  font-size: max(15px, 1.875vmin);
  border-radius: 12px;
  padding: 24px;
  max-width: 400px;
  width: 100%;
  text-align: center;
}
.share-qr-modal-title {
  font-size: max(15px, 1.875vmin);
  font-weight: 700;
  margin-bottom: 12px;
}
.share-qr-modal-content svg {
  width: 100%;
  height: auto;
  display: block;
  margin-bottom: 12px;
}
.share-qr-modal-url {
  font-size: max(12px, 1.5vmin);
  word-break: break-all;
  margin-bottom: 16px;
}
.share-qr-close {
  border-style: solid;
  border-radius: 8px;
  padding: 8px 20px;
  cursor: pointer;
  font-family: inherit;
  font-size: max(14px, 1.75vmin);
}

/* The popover's phone geometry. It used to live in the responsive block
   further up, where it did nothing at all: same specificity, declared
   ABOVE `.share-popover`, so the base rule won every time. Measured in
   Chromium at 375px it resolved to bottom 80px / right 28px / max-width
   335px -- the desktop values, on the screen where the 8px of margin it
   was trying to reclaim actually matter. The block's own comment already
   warned about source order; this is what ignoring it looks like, so the
   override now sits after the rule it overrides. */
@media (max-width: 600px) {
  .share-popover { bottom: 72px; right: 16px; max-width: calc(100vw - 32px); }
}

/* --- The index page: article cards, masthead, intro --- */
.article-card {
  display: block;
  padding: 24px 28px;
  margin-bottom: 20px;
  border-radius: 12px;
  text-decoration: none;
  color: inherit;
  border-style: solid;
  transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
}
.article-card:hover {
  transform: translateY(-2px);
}
.article-card:focus-visible { outline-style: solid; outline-offset: 2px; }
.article-number { margin-bottom: 6px; }
.article-title { margin-bottom: 6px; }
.article-desc { margin-bottom: 8px; }
.header {
  margin-bottom: 48px;
  padding-bottom: 32px;
  border-bottom-style: solid;
}
.header h1 { margin-bottom: 16px; }
.header .subtitle { max-width: var(--page-content-max); }
.version-tag {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 4px;
  margin-top: 12px;
}
.intro { max-width: var(--page-content-max); margin-bottom: 48px; }
.intro p { margin-bottom: 16px; }

/* --- Notes: the body, and the two surfaces it can land on ---
   Layout only; every colour and size here is a registry axis. The list is
   unstyled and the number explicit, because the displayed number restarts
   per locality while the anchor id stays unique to the document — an <ol>
   counter could not carry both. */
.notes-local {
  /* The rule is the block's own, not the page's: without this it spans the
     full slide while the note text sits in a ~50ch column beside it, and
     reads as a section break rather than as the foot of this block. Same
     measure as the prose it belongs to, which is the one variable the
     skeleton is allowed to reach for. */
  max-width: var(--page-content-max);
  margin-top: 20px;
  padding-top: 12px;
  border-top-style: solid;
}
.notes-section {
  padding: 40px 8vw 60px 8vw;
  border-top-style: solid;
}
.notes-section h2 { margin-bottom: 16px; }
/* The class is DOUBLED here, and it is load-bearing rather than tidy:
   `article.size` drives `.full-article ol` at (0,1,1), which beats a
   plain `.note-body` at (0,1,0) and was handing the article's own note
   block a 24px indent, a bottom margin and its list markers back. Proved
   by mutation -- undoubling it fails the browser test with "the article's
   note list is indented 24px". */
.note-body.note-body {
  max-width: var(--page-content-max);
  margin: 0;
  padding: 0;
  list-style: none;
}
.note-body li { margin-bottom: 8px; }
.note-num { font-weight: 700; margin-right: 6px; }
.note-back { text-decoration: none; margin-left: 6px; }
/* The call is a link, and must not look like one: it takes the size and
   colour the footnote-call component gives the <sup> around it, not the
   page's link styling. Layout, not a theme value -- a theme that wanted
   to paint it would set footnote-call.fg. */
.note-call a { color: inherit; text-decoration: none; }
.note-call a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

/* --- Block alignment: the instance layer of the align axes ---
   {align:center} in an article source wraps its blocks in one of these.
   The descendant selector is deliberate: text-align is inherited, but a
   component that declares its own beats what it inherits, so reaching the
   children is the only way an author's local choice can win over the
   theme -- which is what an instance tag is for.

   The class is DOUBLED on that arm, and the reason is measured. A plain
   `.align-x *` is (0,1,0), which loses to `.full-article p` and
   `.comparison-table td` at (0,1,1) -- so the tag was inert on exactly the
   long-form prose it exists for, while its `hyphens` companion (which had
   no competitor) still landed: a paragraph came out left-aligned AND
   hyphenated, which no layer asked for. Doubling reaches (0,2,0).
   These arms set alignment and nothing else. Breaking words at end of
   line is its own axis (page.hyphens), off unless asked for by name, so
   re-aligning a block never changes whether its words break. */
.align-left,    .align-left.align-left *       { text-align: left; }
.align-center,  .align-center.align-center *   { text-align: center; }
.align-right,   .align-right.align-right *     { text-align: right; }
.align-justify, .align-justify.align-justify * { text-align: justify; }


/* Responsive overrides. Their placement is load-bearing: they close the
   sheet, after every base rule of the skeleton AND after the engine's
   rules, which is what lets them win at equal specificity. They used to
   sit mid-sheet; the presenter and theme menus appended after them
   outlived the print block's own display declarations at equal
   specificity, and the guard that exists for exactly this named the
   pair. Closing the sheet with them means nothing can be declared below:
   the next rule appended here cannot silently beat a breakpoint or the
   print sheet. */
@media (max-width: 600px) {
  /* `max(24px, …)`, not a flat 24px. The wide rule above centres the
     column by making the padding BE the leftover, and this override
     replaced that with a fixed number while the 84vw cap on the children
     stayed — so the leftover all landed on one side. Measured: at 390 the
     text sat 24px from the left and 38.4px from the right, at 600 it was
     24 against 72. Visible, and reported. Above 300px `max()` picks the
     centring value; below it, the cap no longer bites and 24px is what is
     left. */
  .slide { padding: 40px max(24px, (100% - var(--page-content-max)) / 2); }
  /* The same turn for the index, in the same query: a breakpoint that
     reaches one page of a series and not the other is the defect this
     rule exists to close, not a detail of it. */
