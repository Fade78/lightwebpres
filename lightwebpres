    # surface; nav.js keeps a pre-rewrite series recognized as installed.
    if not ((td / 'templates' / SETTINGS_FILENAME).exists()
            or (td / 'templates' / 'nav.js').exists()):
        print(f'[ERROR] {td} has not been installed. Run first: lightwebpres install {td}', file=sys.stderr)
        sys.exit(1)

    articles_dir = td / 'articles'

    demo_filenames = ['first.md', 'first_article.md', 'middle.md', 'middle_article.md',
                       'last.md', 'last_article.md', 'img/demo-figure.svg']
    existing = [f for f in demo_filenames if (articles_dir / f).exists()]
    if existing:
        print(f'[ERROR] {td}/articles already has demo file(s): {", ".join(existing)}. '
              f'Remove them first, or run demo in an empty series.', file=sys.stderr)
        sys.exit(1)

