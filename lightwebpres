def build_theme_preview_document(theme_key):
    """A complete, standalone card document for `theme_key` — the same
    parser, the same renderer and the same stylesheet a build uses.

    This is what makes the gallery's claim true. The preview used to be a
    hand-written imitation with its own .preview-* rules, and it drifted
    twice without anyone noticing: once it painted every dark theme with a
    light page's overlays, and once it laid the key figure out as a
    left-aligned row with an arrow between figure and caption — an element
    render_slide() has never emitted. A copy that has to be kept in step
    by hand will not be; running the real thing removes the question.

    Rendered inside an iframe by the caller, so the stylesheet's
    viewport-relative sizes (clamp(.., 4.5vw, ..), 84vw) resolve against
    the preview instead of the reader's window."""
    meta, slides, _, _ = parse_markdown_extended(TEMPLATE_THEMES_GALLERY_MOCK)
    language_pack = load_language(None, 'en')
    typo_engine = TypoEngine(language_pack)
    strings = language_pack.get('strings', {})

    body = '\n'.join(
        render_slide(slide, i, len(slides), typo_engine, strings)
        for i, slide in enumerate(slides, 1)
    )
    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">'
        f'<style>{compose_stylesheet(resolve_theme_properties(theme_property_layer(theme_key)))}</style>'
        # The real page scrolls between slides; a static preview should
        # not, or a card would show a scrollbar it does not have.
        '<style>html,body{overflow:hidden}.slide{min-height:auto}</style>'
        f'</head><body>{body}</body></html>'
    )


def cmd_themes_gallery(output_path, args):
    """themes-gallery command — generates a self-contained HTML page
    documenting every THEMES entry (§9.5), built purely from that data so
    it can never drift from what `install --theme` actually applies."""
    out = Path(output_path).resolve()

    cards = []
    for slug, theme in THEMES.items():
        facets = theme_facets(theme)
        # No variables are injected by hand: the composed sheet carries every
        # property into the preview document's own stylesheet, exactly as it
        # does for an installed series. Every bug this file has had in the
        # preview came from maintaining a second copy of that wiring.
        preview_doc = html_escape(build_theme_preview_document(slug), quote=True)
        # Built from PALETTE_ROLES rather than spelled out in the
        # template, so a role can never be renamed in one place and left
        # behind in the other — which is how the swatches came to
        # announce variable names in the first place.
        swatches = ''.join(
            f'\n        <li class="swatch">'
            f'<span class="swatch-chip" style="background:{theme[role]}"></span>'
            f'<span class="swatch-text">'
            f'<div class="swatch-role">{PALETTE_ROLE_LABELS[role]}</div>'
            f'<div class="swatch-var">--{role}</div>'
            f'<div class="swatch-hex">{theme[role]}</div>'
            f'</span></li>'
            for role in PALETTE_ROLES
        )
        cards.append(TEMPLATE_THEMES_GALLERY_CARD.format(
            preview_doc=preview_doc,
            swatches=swatches,
            fact_treatment=fact_treatment_label(theme),
            polarity=facets['polarity'],
            intensity=facets['intensity'],
            hue=facets['hue'],
            label=theme['label'],
            source=theme['source'],
            note=note_to_html(theme['note']),
            note_good_class=' theme-note--good' if theme.get('note_good') else '',
            slug=slug,
        ))

    html = TEMPLATE_THEMES_GALLERY_HEAD + ''.join(cards) + TEMPLATE_THEMES_GALLERY_FOOT
    out.write_text(html, encoding='utf-8')
    print(f'Generated: {out}')


