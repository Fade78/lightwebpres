CONTRAST_UNMEASURED = {
    # The seven shared values. A rule never reads one directly (§9.1): what
    # paints is the component property that takes it as a default, and
    # every one of those is measured on the ground it actually lands on.
    # Measuring `color.call` once, against the page, would answer for a
    # note call in a fact box, a "partially" verdict in a tinted column and
    # a focus ring — three grounds, three answers, none of them that one.
    'color.page': 'a shared value: only the properties that take it paint',
    'color.ink': 'a shared value: only the properties that take it paint',
    'color.ink-quiet': 'a shared value: only the properties that take it paint',
    'color.mark': 'a shared value: only the properties that take it paint',
    'color.call': 'a shared value: only the properties that take it paint',
    'color.affirm': 'a shared value: only the properties that take it paint',
    'color.nav': 'a shared value: only the properties that take it paint',

    # Grounds. They are the second operand of every pair above, never the
    # first — a background has no contrast requirement of its own.
    'page.bg': 'the page itself, the base of every ground',
    'fact.bg': 'ground: the fact box',
    'fact.strong.bg': 'ground: the mark under a bold run',
    'cover.bg.from': 'ground: the cover, first stop',
    'cover.bg.to': 'ground: the cover, second stop',
    'code.bg': 'ground: a code span or block',
    'note.page.bg': 'ground: the notes section',
    'article.bg': 'ground: the long-form article',
    'table.head.bg': 'ground: a table header cell',
    'table.col-signal.bg': 'ground: the signal column veil',
    'table.col-snap.bg': 'ground: the snapshot column veil',
    'series-nav.link.bg': 'ground: a series-nav card that links',
    'series-nav.current.bg': 'ground: the series-nav card being read',
    'nav-btn.bg': 'ground: a navigation button',
    'nav-btn.bg-soft': 'ground: the home button',
    'share.bg': 'ground: the share panel',
    'share.bg-hover': 'ground: a share button under the pointer',
    'card.bg': 'ground: an index card',
    'version-tag.bg': 'ground: the version pill',
    'nav-dot.bg': 'ground: a slide dot that is not the current one',

    # Text haloes. Transparent unless a theme asks for one, and a shadow
    # sits BEHIND the glyph it thickens rather than carrying it: WCAG has
    # nothing to say about a colour that is never the thing being read.
    # The exemption is written once and applied to every halo the registry
    # carries, because the reason is the same for all of them and a list of
    # thirty-two identical lines is a list nobody rereads. It is DERIVED
    # from HALO_COMPONENTS rather than restated, so a component gaining a
    # halo cannot arrive without its exemption, nor keep one after losing
    # it -- the two tests that walk the registry against this table would
    # otherwise be satisfied by a copy that had stopped matching.
    **{f'{_k}.shadow.fg': 'a halo behind text, not text'
       for _k in ('page', 'title1', 'highlight') + HALO_COMPONENTS},

    # Elevations. A drop shadow falls OUTSIDE the box it lifts, on whatever
    # the page happens to put there, so there is no pair to measure: the
    # ratio would be against a ground the theme does not own. Nor does it
    # carry information -- take every shadow off the sheet and the reader
    # loses depth, not a single word or state. Derived from
    # ELEVATION_COMPONENTS for the same reason the haloes are derived from
    # HALO_COMPONENTS: a component gaining depth cannot arrive without its
    # exemption, and one losing it cannot keep it.
    **{f'{_k}.{_g}.fg': 'a shadow outside the box, not ink'
       for _k, (_rest, _hover) in ELEVATION_COMPONENTS.items()
       for _g in (('elevation', 'elevation-hover') if _hover
                  else ('elevation',))},

    # Decorative rules. SC 1.4.11 covers non-text that CARRIES information;
    # a separator whose removal costs the reader nothing is exempt by the
    # standard's own words, and measuring it would drown the pairs that do
    # carry something. Each of these delimits a block that its own ground,
    # its label or its position already identifies.
    'slide.rule-fg': 'decorative: the hairline between slides',
    'fact.rule-fg': 'decorative: the fact box already has a ground and a label',
    'footer.rule-fg': 'decorative: the line above the page footer',
    'quote.rule-fg': 'decorative: a quote is also set in italic',
    'code.rule-fg': 'decorative: a code block already has a ground',
    'note.local.rule-fg': 'decorative: the line opening a note block',
    'note.page.rule-fg': 'decorative: the line opening the notes section',
    'table.rule-fg': 'decorative: the line between table rows',
    'table.head.rule-fg': 'decorative: the line under a table header',
    'article.rule-fg': 'decorative: the borders of a table in the article',
    'header.rule-fg': 'decorative: the line under the index header',

    # The outline of a control that carries a label or a glyph. SC 1.4.11
    # asks for 3:1 on the visual information REQUIRED to identify a
    # component — and a button showing an arrow, a card showing its title,
    # are identified by that, not by their edge. The glyph and the title
    # are measured, on the control's own fill. Requiring the edge as well
    # would put every theme in the catalogue at `fail` for a reason no
    # reader has: the edges are all a 16% veil, by design.
    'nav-btn.rule-fg': 'the button is identified by its glyph, which is measured',
    'series-nav.link.rule-fg': 'the card is identified by its title, which is measured',
    'series-nav.current.rule-fg': 'the card is identified by its title, which is measured',
    'card.rule-fg': 'the card is identified by its title, which is measured',
    'share.rule-fg': 'the button is identified by its glyph, which is measured',

    # Focus rings. Only the keyboard reaches them, and they are the one
    # thing that says where the keyboard is, so they ARE measured — the
    # property registry refuses a theme whose focus ring vanishes into
    # its ground (SC 1.4.11, non-text).
    'nav-btn.ring': 'the focus ring of a navigation button, against the page',
    'series-nav.link.ring': 'the focus ring of a series-nav card, against the page',
    'card.ring': 'the focus ring of an index card, against the page',

    # Pointer-only states. Hover is feedback, never the only carrier of
    # anything: the focus ring is what a keyboard gets, and it IS measured.
    'nav-dot.bg-hover': 'a pointer-only state, and the dot also scales',
    'card.rule-fg-hover': 'a pointer-only state of a card already identified '
                          'by its title',
    'share.rule-fg-hover': 'a pointer-only state of a button already '
                           'identified by its glyph',

    # A dimmer, on purpose.
    'share.scrim': 'darkens the viewport behind the QR modal — its job is '
                   'to be a veil, not to be seen',
}


def measure_contrast(resolved):
    """The three WCAG categories of §11.9.1, measured on `resolved`.

    Returns {category: {level, threshold_aa, threshold_aaa, pairs_measured,
    worst, failures}}. `worst` is the pair that decides the level, so a
    category sitting at AA names the limiting pair whose ratio would have to
    change for the category to reach AAA; the report does not change it.

    Comparisons are made on the UNROUNDED ratio: 2.9970 rounds to 3.00
    without ever reaching 3."""
    out = {name: {'level': None,
                  'threshold_aa': bars['aa'], 'threshold_aaa': bars['aaa'],
                  'pairs_measured': 0, 'worst': None, 'failures': []}
           for name, bars in CONTRAST_LEVELS.items()}
    worst_ratio = {name: None for name in CONTRAST_LEVELS}
    # Several sites composite to the same two colours — the two gradient
    # stops of a flat cover, the two tinted table columns at the same
    # alpha. Counting them twice would not change a level, but it would
    # hand a reader the same counter-example four times over, which is how
    # an actionable list stops being one.
    seen = {name: set() for name in CONTRAST_LEVELS}

    for site in CONTRAST_SITES:
        if site.unless and resolved.get(site.unless[0]) == site.unless[1]:
            continue
        category = site.category(resolved)
        bucket = out[category]
        for stack in site.grounds:
            ground = ground_colour(resolved, stack)
            pair = (site.fg, _hex6(ground))
            if pair in seen[category]:
                continue
            seen[category].add(pair)
            ratio = contrast_ratio(composite_over(resolved[site.fg], ground), ground)
            record = {
                'site': site.where,
                'foreground': site.fg, 'foreground_color': resolved[site.fg],
                'ground': list(stack), 'ground_color': _hex6(ground),
                'ratio': round(ratio, 4),
                'required': CONTRAST_LEVELS[category]['aa'],
            }
            bucket['pairs_measured'] += 1
            if worst_ratio[category] is None or ratio < worst_ratio[category]:
                worst_ratio[category] = ratio
                bucket['worst'] = record
            if ratio < CONTRAST_LEVELS[category]['aa']:
                bucket['failures'].append(record)

    for name, bucket in out.items():
        bars = CONTRAST_LEVELS[name]
        low = worst_ratio[name]
        if low is None:                     # no site of this kind: say so
            bucket['level'] = 'n/a'
        elif low < bars['aa']:
            bucket['level'] = 'fail'
        elif bars['aaa'] is None:
            bucket['level'] = 'pass'
        elif low < bars['aaa']:
            bucket['level'] = 'AA'
        else:
            bucket['level'] = 'AAA'
        bucket['failures'].sort(key=lambda record: record['ratio'])
    return out


# ----------------------------------------------------------------------------
# The skeleton (§9): the static half of every composed sheet, frozen as
# source. It used to be derived at runtime from the old full stylesheet by
# stripping the declarations the registry drives — which meant two thirds of
# that constant was dead, and editing a driven line in it was a silent no-op.
# What follows is that extraction's result, kept verbatim and re-prettified:
# what you read here is what a page gets.
# ----------------------------------------------------------------------------
TEMPLATE_SKELETON = r'''/* LightWebPres skeleton — layout only: everything no theme property
   drives. Composed AFTER the engine's rules, so the @media block below
   wins at equal specificity. Two rules when editing:
     - a declaration here must not also be driven by PROPERTY_REGISTRY,
       or a stale literal fights the engine across the cascade;
     - no colour literal, and no var() but --page-content-max — a colour here
       would survive theming, the exact defect the registry kills.
   These comments ship: the sheet is inlined into every page. Keep them
   short, and never spell a markup tag out literally — anything scanning
   the output would read it as markup. */

/* The skeleton's own layout variable: the one it declares, and the one
   var() allowed below. Every other variable comes from the engine. */

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
html.help-open, html.help-open body { overflow: hidden; }

/* --- The slide frame --- */
.slide {
  min-height: 100vh;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  /* The column is CENTRED in the card, and it is the padding that centres
     it -- 8vw until the card is wider than the column, then whatever is
     left over, split in two. Measured at 1920px before this line existed:
     154px of margin on the left and 666px on the right, the whole card
     hugging one edge.

     Centring the padding box rather than the items, because
     `align-items: center` on a flex column gives every item its own
     CONTENT width: measured, a short heading landed at x=915 and the
     summary under it at x=884, so the column stopped having one left edge
     at all. Every child stays stretched to the same width; only the box
     they stretch inside moves.

     Reading --page-content-max rather than repeating its value: an author
     who pins a different column width gets it centred too, with nothing
     else to set. */
  padding: 60px max(8vw, (100% - var(--page-content-max)) / 2);
  border-bottom-style: solid;
  position: relative;
}
/* The runtime tag filter hides slides (and the L button) via the
   hidden attribute. An author-origin `display` above beats the UA rule
   `[hidden] { display: none }` — the exact defeat the themes gallery once
   had for .theme-row, and the same fix. Keep this override beside every
   display on .slide/.nav-btn. */
.slide[hidden], .nav-btn[hidden] { display: none; }
.article-card[hidden], .series-item[hidden] { display: none; }
/* The number sits over the COLUMN, not over the card.

   `right: 32px` measured it against the card edge while every line of
   text on the slide starts at the padding the rule above computes, so the
   two drifted apart as the screen grew: measured, the number's right edge
   was 275px past the heading's at 3840, 122px at 1920, 45px at 768, and
   the sign inverted on a phone -- the one width where it looked centred
   was the one nobody presents on. Reading the same expression as the
   padding keeps them on one edge at every width, including for an author
   who pins a different --page-content-max. */
.slide-num {
  position: absolute;
  top: 24px;
  right: max(8vw, (100% - var(--page-content-max)) / 2);
}
.slide-kicker { display: inline-block; margin-bottom: 16px; }
h1 { margin-bottom: 20px; max-width: var(--page-content-max); }
h2 { margin-bottom: 18px; max-width: var(--page-content-max); }
.summary { max-width: var(--page-content-max); margin-bottom: 32px; }

/* --- The fact box --- */
.fact-box {
  border-left-style: solid;
  padding: 24px 28px;
  border-radius: 0 8px 8px 0;
  max-width: var(--page-content-max);
}
.fact-label { margin-bottom: 8px; }
/* Measured, not guessed: at the default offset the underline collides
   with the descenders, and inside a highlight it runs into the mark's
   lower edge. Both properties degrade silently on an old engine — the
   rule falls back to its default position rather than disappearing.

   The two lengths still here are a halo around a glyph: the weight of
   the rule and how far it clears the baseline. Both are drawn against
   the text, so both scale with it. The side padding is a pinnable
   property (fact.strong.pad, emitted by the engine); the corner radius
   stays here — no reason to expose it. The padding was 4px (v0.24.2) —
   too wide, it read as a stray space before the comma that follows a
   **bold**. It is 3px from v0.25.0: absorb-punct pulls that comma into
   the mark, so the padding no longer opens a gap before it. Below
   roughly an 800px smaller dimension these are the pixel values they
   were measured at, and above it they hold the ratio they were
   measured at. */
.fact-content strong {
  text-decoration-thickness: max(2px, 0.25vmin);
  text-underline-offset: max(3px, 0.375vmin);
  border-radius: max(2px, 0.25vmin);
}
.fact-content h1, .fact-content h2, .fact-content h3 { margin: 14px 0 6px; }
.fact-content h1:first-child,
.fact-content h2:first-child,
.fact-content h3:first-child {
  margin-top: 0;
}
.fact-content h1 { font-size: 1.3em; }
.fact-content h2 { font-size: 1.15em; }
.fact-content h3 { font-size: 1.05em; }
.fact-content ul, .fact-content ol {
  padding-left: 20px;
  margin-bottom: 10px;
}
.fact-content li { margin-bottom: 4px; }

/* Free-form standard-slide body (no fact-label). A heading here is body
   content (§22.2), never the slide's own title, so it must render
   smaller than that title. These em sizes resolve against the inherited
   base, i.e. well under it.

   That base is what this rule sets, and it did not exist: .slide-body
   carried no size at all, so it and its em-relative headings inherited
   the document's unset 16px and stayed there while the card around them
   tripled. Measured at 3840: 16px of body under a 101.5px title, and the
   SAME prose rendering at 47.5px if a `fact-label:` happened to precede
   it -- a three-fold difference decided by a field, not by the writing.
   16/8 keeps the phone byte-identical and closes the gap above it. */
.slide-body { font-size: max(16px, 2vmin); }
.slide-body h1, .slide-body h2, .slide-body h3 {
  margin: 14px 0 6px;
  max-width: var(--page-content-max);
}
.slide-body h1:first-child,
.slide-body h2:first-child,
.slide-body h3:first-child {
  margin-top: 0;
}
.slide-body h1 { font-size: 1.3em; }
.slide-body h2 { font-size: 1.15em; }
.slide-body h3 { font-size: 1.05em; }
/* #### heading: rendered as a bold-font paragraph (body-heading styling,
   not <strong> markdown emphasis). #####/###### render as plain text. */
.fact-content .h4, .slide-body .h4 {
  font-weight: bold;
  margin: 14px 0 6px;
  max-width: var(--page-content-max);
}
.fact-content .h4:first-child,
.slide-body .h4:first-child { margin-top: 0; }

.source { margin-top: 16px; max-width: var(--page-content-max); }
.page-footer { padding: 20px 8vw 28px; border-top-style: solid; }
.page-footer .footer-byline { margin-bottom: 4px; }
.page-footer .footer-license a { color: inherit; }

/* --- Markdown constructs the converter has always emitted. Their ground,
   ink and rule colours are registry properties; the geometry is here. --- */
blockquote {
  margin: 0 0 16px;
  padding: 4px 0 4px 18px;
  border-left-style: solid;
  max-width: var(--page-content-max);
}
blockquote p:last-child { margin-bottom: 0; }
code { padding: 1px 5px; border-radius: 4px; }
pre {
  margin: 0 0 16px;
  padding: 14px 16px;
  border-style: solid;
  border-radius: 8px;
  overflow-x: auto;
  max-width: var(--page-block-max);
}
/* Inside a block, the ground belongs to the block itself: a second one
   would double up and the rounded corners would show through. */
pre code {
  background: none;
  padding: 0;
  font-size: 0.85em;
  line-height: 1.55;
}
sup { vertical-align: super; line-height: 0; }

/* A body link keeps the ink around it and is signalled by an underline
   rather than by a colour. The browser default blue measures 1.03:1 on
   pop-violet and fails AA on fifteen themes, and no palette colour can
   replace it — each is already a verdict colour or below AA somewhere.
   Ink on page is the one pair every theme is admitted on, so a link is
   AA everywhere by construction, and WCAG 1.4.1 is satisfied by the
   underline, which is not a colour. Only the rule's tint is exposed
   (link.decoration-color); thickness and offset stay here, because a
   hairline sitting on the baseline is what makes underlined text hard
   to read. The scope is load-bearing: widen this selector and every
   navigation card in the site gets underlined too. */
.fact-content a, .full-article a {
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}
.full-article blockquote, .full-article pre { font-size: max(15px, 1.875vmin); }

/* --- Comparison table --- */
.comparison-table {
  width: 100%;
  max-width: var(--page-block-max);
  border-collapse: collapse;
  margin: 20px 0;
}
.comparison-table th, .comparison-table td {
  padding: 12px 16px;
  border-bottom-style: solid;
}
.comparison-table th {
  border-bottom-style: solid;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
  color-adjust: exact;
}
/* Verdict cells (§6.1) carry a shape as well as a colour. Red/green
   colour-vision deficiency affects roughly one man in twelve, and weight
   alone is too fine a cue; the marks are registry properties, their
   spacing is here. print-color-adjust keeps the distinction on paper,
   where colour is often dropped — same reason on the emphasized
   columns below. */
.comparison-table .yes::before,
.comparison-table .partial::before,
.comparison-table .no::before {
  margin-right: 0.4em;
  font-size: 0.95em;
}
.comparison-table .yes, .comparison-table .no, .comparison-table .partial {
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.comparison-table .col-signal {
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.comparison-table .col-snap {
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

/* --- Figures --- */
.figure {
  margin: 20px auto;
  max-width: var(--page-block-max);
  text-align: center;
  /* `caption.size` is 0.85em — relative to a context that has to exist.
     It did not: the figure inherited the document's unset 16px, so the
     one em-relative size in the reading surface resolved to a flat 13.6px
     at every width. An em only scales if something above it does. */
  font-size: max(16px, 2vmin);
}
.figure img { max-width: 100%; height: auto; }
.figure-caption { margin-top: 6px; }

/* --- The full-article slide: a measure of its own, narrower than the
   deck's, because it is read as prose rather than glanced at. --- */
.full-article { padding: 60px 8vw 80px 8vw; }
/* These scale for the same reason the registry's thirty-five do, and they
   were missed because they are LITERALS: the sweep that gave the design a
   scale counted properties, and nothing counted the sizes written
   straight into this sheet. `article.size` grew; the article's own
   headings did not. Measured at 3840, h2 sat at 22px under a 40.5px body
   -- a heading 0.54x the text it heads -- and the inversion already
   started at 1920. The coefficient is the pixel value over 8, the same
   arithmetic the registry uses, so every ratio these had at 1920x1080 is
   the ratio they keep above it, and the floors leave a phone untouched. */
.full-article h1 { font-size: max(28px, 3.5vmin); margin-bottom: 8px; }
.full-article h2 { font-size: max(22px, 2.75vmin); margin-top: 40px; margin-bottom: 12px; }
.full-article h3 { font-size: max(18px, 2.25vmin); margin-top: 28px; margin-bottom: 10px; }
.full-article .h4 { font-weight: bold; margin-top: 20px; margin-bottom: 8px; }
.full-article p { margin-bottom: 14px; max-width: var(--page-content-max); }
.full-article ul, .full-article ol {
  margin-bottom: 14px;
  padding-left: 24px;
  max-width: var(--page-content-max);
}
.full-article table {
  width: 100%;
  max-width: var(--page-block-max);
