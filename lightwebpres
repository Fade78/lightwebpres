# ---------------------------------------------------------------------------
# The halo, on every component that paints glyphs (B20).
#
# `text-shadow` is inherited, so `page.shadow` tints the whole site at once
# and that is the ambient case. What it CANNOT do is be proportional to the
# glyph: inherited, its `em` resolves once at the root, so a 0.13em halo is
# 2.1px on a 42px slide heading exactly as on a 13px kicker. Measured over
# blur ÷ rendered size, the slide heading came out worst served of all —
# 0.05 against 0.26 for `h1` — and it is a heading. A halo is proportional
# to its glyph only where the component declares its own.
#
# So the axes go to every component whose selector paints text, and only
# those. A container gets nothing: `text-shadow` being inherited, a halo on
# `.fact-box` reaches the code, the tables and the footnote calls inside it,
# which is a different instrument rather than a finer grain. `code` and
# `sup` get nothing either — 2px of bleed on 1px stems, and the smallest
# glyph on the page is the one whose job is to be findable.
#
# Four axes, not three: there was `dy` and no `dx`, so a halo could only be
# offset downward — a constraint nobody chose, arrived at by only ever
# needing the vertical case. `dx` defaults to `0` like `dy`, and the
# neutral halo stays the centred one.
#
# Written as a list of keys and a loop rather than four ThemeProps repeated
# twenty-nine times: the axes are identical everywhere, and the decision
# worth reading is WHICH components have them.
HALO_COMPONENTS = (
    # A slide, and what it carries
    'slide.num', 'kicker', 'title2', 'summary', 'fact-label', 'source',
    'body-heading', 'fact.strong',
    # The cover's own contexts
    'cover.kicker', 'cover.summary', 'cover.num',
    # Comparison tables and their verdicts
    'table.head', 'verdict.yes', 'verdict.no', 'verdict.partial',
    # Figures
    'caption', 'highlight-caption',
    # The cross-article navigation block
    'series-nav.label', 'series-nav.title', 'series-nav.desc',
    'series-nav.status',
    # The index page
    'card.label', 'card.title', 'card.desc', 'card.cta',
    'header.title', 'header.subtitle', 'version-tag',
    # Chrome that carries a glyph
    'nav-btn',
)

for _c in THEME_COMPONENTS:
    if _c.key not in HALO_COMPONENTS:
        continue
    _v = '--' + _c.key.replace('.', '-')
    _c.props.extend([
        ThemeProp(f'{_c.key}.shadow.fg',   PROP_COLOR,  'transparent'),
        ThemeProp(f'{_c.key}.shadow.blur', PROP_LENGTH, '0'),
        ThemeProp(f'{_c.key}.shadow.dx',   PROP_LENGTH, '0'),
        ThemeProp(f'{_c.key}.shadow.dy',   PROP_LENGTH, '0'),
    ])
    _c.composite.append(Composite(
        'text-shadow',
        f'var({_v}-shadow-dx) var({_v}-shadow-dy) '
        f'var({_v}-shadow-blur) var({_v}-shadow-fg)',
        omit_when_default=True))

_missing = [k for k in HALO_COMPONENTS
            if k not in {c.key for c in THEME_COMPONENTS}]
if _missing:  # pragma: no cover - a typo here would fail silently otherwise
    raise PropertyError(f'HALO_COMPONENTS names no such component: {_missing}')


# ---------------------------------------------------------------------------
# The elevation, on every component the sheet lifted off the page (B12).
#
# Thirteen `box-shadow` declarations sat in the skeleton at fixed values a
# theme could not reach. That is not a small omission on a catalogue where
# half the themes are dark: every one of those shadows was black at an alpha
# chosen against a white page, and on a dark ground a black shadow is not a
# shadow, it is nothing at all. A theme could restyle the ink, the ground,
# the rules and the halo of a card and not the one property that says how
# far off the page it sits.
#
# Five axes rather than the three the sheet used. `dx` for the same reason
# the halo gained it — the sheet only ever needed the vertical case, which
# is not a decision anyone made — and `spread`, which no current value uses
# and which is the axis that makes a ring or a soft lift expressible at all.
# Both default to `0`, so the neutral elevation is the one the sheet drew.
#
# Rest and hover are two sets, on the idiom the registry already uses for a
# state: `card.rule-fg-hover` beside `card.rule-fg`. Here the state names a
# whole group of five, so the suffix goes on the group -- `elevation-hover`
# -- and each axis keeps its own name. Only three components have a hover
# elevation, because only three had one in the sheet; the hover selector
# comes with it, because `.series-link` lifts on focus as well and losing
# that would be a keyboard regression dressed as a refactor.
#
# `box-shadow` is NOT inherited, so unlike the halo this always emits: a
# component saying `box-shadow: 0 0 0 0 transparent` paints nothing and
# blocks nothing, and always emitting is what makes the declaration
# available to `custom.css` at a stable specificity.
#
# The colours are the sheet's `rgba(0,0,0,a)` alphas carried over as
# eight-digit hex, rounding half up as the rest of the registry does
# (.30 -> 4D, .70 -> B3). Only .20 -> 33 is exact; the other seven move by
# less than half a step of alpha.
ELEVATION_COMPONENTS = {
    # key: (fg, blur, dx, dy) at rest, then hover as
    # (selector, (fg, blur, dx, dy)) or None
    'fact':            (('#0000000F', '8px',  '0', '1px'), None),
    'card':            (('#0000000F', '8px',  '0', '1px'),
                        ('.article-card:hover',
                         ('#0000001A', '16px', '0', '4px'))),
    'series-nav.link': (('#00000014', '12px', '0', '2px'),
                        ('.series-link:hover, .series-link:focus-visible',
                         ('#0000001F', '16px', '0', '4px'))),
    'nav-btn':         (('#0000001A', '8px',  '0', '2px'),
                        ('.nav-btn:hover',
                         ('#00000026', '14px', '0', '4px'))),
    'slide-counter':   (('#0000001A', '6px',  '0', '1px'), None),
    'tag-menu':        (('#0000002E', '18px', '0', '4px'), None),
    'share':           (('#0000002E', '32px', '0', '8px'), None),
    'presenter-panel': (('#00000033', '22px', '0', '-4px'), None),
    'help-card':       (('#00000040', '40px', '0', '8px'), None),
    'share.qr':        (('#00000040', '32px', '0', '8px'), None),
}


def _elevation_axes(key, group, values):
    """The five properties of one elevation group, in CSS order."""
    fg, blur, dx, dy = values
    return [
        ThemeProp(f'{key}.{group}.fg',     PROP_COLOR,  fg),
        ThemeProp(f'{key}.{group}.blur',   PROP_LENGTH, blur),
        ThemeProp(f'{key}.{group}.dx',     PROP_LENGTH, dx),
        ThemeProp(f'{key}.{group}.dy',     PROP_LENGTH, dy),
        ThemeProp(f'{key}.{group}.spread', PROP_LENGTH, '0'),
    ]


def _elevation_decl(key, group, selector=None):
    """`box-shadow: dx dy blur spread colour`, the order CSS reads it in."""
    v = '--' + key.replace('.', '-') + '-' + group
    return Composite(
        'box-shadow',
        f'var({v}-dx) var({v}-dy) var({v}-blur) '
        f'var({v}-spread) var({v}-fg)',
        selector=selector)


for _c in THEME_COMPONENTS:
    _elev = ELEVATION_COMPONENTS.get(_c.key)
    if _elev is None:
        continue
    _rest, _hover = _elev
    _c.props.extend(_elevation_axes(_c.key, 'elevation', _rest))
    _c.composite.append(_elevation_decl(_c.key, 'elevation'))
    if _hover:
        _hover_sel, _hover_values = _hover
        _c.props.extend(
            _elevation_axes(_c.key, 'elevation-hover', _hover_values))
        _c.composite.append(
            _elevation_decl(_c.key, 'elevation-hover', _hover_sel))

_missing = [k for k in ELEVATION_COMPONENTS
            if k not in {c.key for c in THEME_COMPONENTS}]
if _missing:  # pragma: no cover - a typo here would fail silently otherwise
    raise PropertyError(
        f'ELEVATION_COMPONENTS names no such component: {_missing}')


PROPERTY_REGISTRY = {p.key: p for p in THEME_SHARED_PROPS}
for _c in THEME_COMPONENTS:
    for _p in _c.props:
        PROPERTY_REGISTRY[_p.key] = _p

# The way back from a CSS variable name to the property key that owns it.
# Built, not computed: `--card-elevation-hover-blur` does not become
# `card.elevation.hover.blur` by turning hyphens into dots, because a key
# segment may itself contain a hyphen -- `nav-btn`, `highlight-caption`,
# `ink-quiet`, `content-max`, `elevation-hover`. Guessing is not a near
# miss: measured over this registry when the map was written, it named the
# wrong key for 174 of the 431 properties and for 86 of the 202 var
# references the composites read. It fails silently in every one of those
# cases, and for a composite that reads this map a silent miss is a
# declaration that is never emitted.
VAR_TO_KEY = {p.var: p.key for p in PROPERTY_REGISTRY.values()}

# Two properties may not claim the same variable, and two components may
# not claim the same key. Both dictionaries above are built by assignment,
# so a clash overwrites in silence: the sheet would carry two `:root` lines
# of the same name and the map would hand back the wrong key -- the exact
# failure this map exists to remove, one step upstream. `nav.btn.size` and
# `nav-btn.size` are the shape of it, and nothing about the naming
# convention prevents them.
_seen_props = [p for c in THEME_COMPONENTS for p in c.props] + \
    list(THEME_SHARED_PROPS)
if len(_seen_props) != len(PROPERTY_REGISTRY):  # pragma: no cover
    _dupes = sorted({p.key for p in _seen_props
                     if [q.key for q in _seen_props].count(p.key) > 1})
    raise PropertyError(f'two components claim the same property: {_dupes}')
if len(VAR_TO_KEY) != len(PROPERTY_REGISTRY):  # pragma: no cover
    _vars = [p.var for p in PROPERTY_REGISTRY.values()]
    raise PropertyError(
        f'two properties claim the same variable: '
        f'{sorted({v for v in _vars if _vars.count(v) > 1})}')


