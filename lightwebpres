  var btnNext    = document.getElementById('navNext');
  var btnHome    = document.getElementById('navHome');
  var navDots    = document.querySelector('.nav-dots');

  if (navDots) {
    slides.forEach(function(s, i) {
      var a = document.createElement('a');
      a.href = '#' + (s.id || ('s'+(i+1)));
      var tagEl = s.querySelector('.slide-tag');
      var headEl = s.querySelector('h2, h1');
      a.title = tagEl ? tagEl.textContent : (headEl ? headEl.textContent : ('{{str_nav_dot_fallback}} ' + (i+1)));
      a.addEventListener('click', function(e){ e.preventDefault(); goTo(i); });
      navDots.appendChild(a);
    });
  }
  var dots = navDots ? Array.prototype.slice.call(navDots.querySelectorAll('a')) : [];

  function goTo(idx) {
    idx = Math.max(0, Math.min(slides.length - 1, idx));
    if (idx === current && isScrolling) return;
