# AUDIT COMMAND
# ============================================================================

def cmd_audit(series_dir, args):
    """audit command — flags editorial conventions that are not respected.

    Unlike check (which compares the generated HTML with the existing one),
    audit never compiles anything and never makes the command fail: page
    layout (number and position of cover slides, see specifications.md
    §22.13) remains entirely the author's responsibility. audit only prints
    informational warnings.
    """
    sd, articles_dir, templates_dir, lang_dir, output_dir, lang, language_file = resolve_paths(series_dir, args)
    series_data = load_series_data(sd)
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data

    warnings = 0

    for entry in articles:
        source_path = articles_dir / entry['source']
        if not source_path.exists():
            print(f'[ERROR] {entry["file"]}: source not found ({source_path})', file=sys.stderr)
            continue

        md_text = source_path.read_text(encoding='utf-8')
        meta, slides, has_meta_block = parse_markdown_extended(md_text)

        has_cover = any(s.slide_type == 'cover' for s in slides)
        if not has_cover:
            print(f'[WARNING] {entry["file"]}: no cover slide')
            warnings += 1
        elif slides[0].slide_type != 'cover':
            print(f'[WARNING] {entry["file"]}: the first slide is not a cover (found: {slides[0].slide_type})')
            warnings += 1

    if warnings == 0:
        print('No warnings: all editorial conventions are respected.')
    else:
        print(f'{warnings} warning(s). Reminder: audit never blocks the build, page layout remains the author\'s responsibility.')


