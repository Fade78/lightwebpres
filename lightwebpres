#!/usr/bin/env python3
"""
LightWebPres — framework for generating self-contained web pages.

Single-file executable. Python 3.8+ standard library only.
Native UTF-8. Built-in French and English language packs (typography
rules + interface strings).

Usage:
  lightwebpres install [directory] [--lang fr] [--force] [--theme name] [--gitlab-ci]
  lightwebpres demo [directory] [--lang fr]
  lightwebpres build [directory] [--lang fr] [--output public/] [--no-typography] [--only file] [--nav-cache path] [--include-drafts]
  lightwebpres check [directory] [--lang fr] [--output public/] [--no-typography] [--include-drafts]
  lightwebpres audit [directory] [--lang fr]
  lightwebpres refresh-templates [directory]
  lightwebpres themes [--polarity light|dark] [--intensity name] [--hue name]
  lightwebpres set-theme [directory] --theme name [--force]
  lightwebpres themes-gallery [path]
  lightwebpres --help
"""

import sys
import os
