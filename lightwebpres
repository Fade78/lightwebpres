# §9.5.3 — facets. Past a dozen or so palettes a gallery stops being a
# thing you read and becomes a thing you search, so every theme carries
# the axes a reader actually narrows on. The two measured ones are
# derived, never hand-maintained per theme:
#
#   polarity   light | dark      — already known: the dark_background flag
#   hue        computed from the background, so it can never contradict
#              the palette it describes
#
# A third used to sit here: `intensity` (sober | vivid | mono), declared
# by hand because "how loud is this" is an editorial judgement. It was
# retired once `family` existed, because family is the same kind of claim
# — a statement about intent that no measurement can check — made
# properly: against a closed vocabulary, refusing an unknown value by
# name instead of defaulting. Two hand-declared editorial axes is one too
# many, and the one that survives is the one that is fenced.
#
# Hue is deliberately CALCULATED rather than declared: a hand-written
# label drifts the moment someone tweaks a colour, and there is no reason
# to trust prose over the value itself.
# Boundaries in CIELAB hue angle, not RGB. RGB hue cannot tell a pale
# cream from a full orange — both sit at the same angle — so naming from
# it labelled Solarized's paper "orange", which no reader would say.
# Calibrated by measuring the angle of known references rather than from
# memory: CIELAB's angles are not the ones RGB intuition suggests (a full
# blue sits near 297°, not 240°, and cyan near 227°).
#
# Facet VALUES are in English, like every other identifier the CLI takes
# (`themes --hue green`, §11.9). The gallery shows its own display
# labels — "Light", "Dark" — and holds them separately from the data-*
# values it filters on: a display string and a key are not the same
# thing, and conflating them is what would make the CLI untranslatable.
HUE_NAMES = (
    (38, 'red'), (78, 'orange'), (120, 'yellow'), (185, 'green'),
    (262, 'cyan'), (303, 'blue'), (330, 'violet'), (358, 'magenta'), (360, 'red'),
)
# Below this chroma a background reads as paper or ink, never as a hue.
#
# The threshold follows LIGHTNESS. A fixed one is wrong at both ends: a
# pale cream carries real chroma and still reads as paper (Gruvbox's
# #FBF1C7 sits at C=21.8 and was filed under `yellow`, while the docstring
# below uses "a pale cream" as its example of what must come out neutral),
# and a near-black keeps its hue identity at very low chroma (Blueprint
# Night's navy #0A1626, C=12.6, was filed `neutral`). Chroma is compressed
# towards black and inflated towards white, so the bar rises with L — with
# a floor, because at L~3 a chroma of 0.9 is noise, not a colour.
NEUTRAL_CHROMA_FLOOR = 4.0
NEUTRAL_CHROMA_SLOPE = 0.25


def neutral_chroma_threshold(lightness):
    """Chroma below which a background of this lightness reads neutral."""
    return max(NEUTRAL_CHROMA_FLOOR, NEUTRAL_CHROMA_SLOPE * lightness)


# The families, and the one facet that is DECLARED rather than measured.
#
# Polarity and hue are read off the palette: a theme cannot lie about
# them, and adjusting a colour moves the facet with it. Family cannot
# work that way — "this is the register of work" and "this is a fire seen
# at three moments" are editorial statements about intent, and no amount of
# CIELAB recovers them from seven hex values.
#
# So it is declared, and therefore fenced: the vocabulary below is closed,
# every theme must name one of these, and an unknown name is a build error
# rather than a silent miscategorisation. A declared label that nothing
# checks is how `theme show`'s docstring says an accessibility level would
# lie — the fence is what stops the same thing happening here.
THEME_FAMILIES = {
    'desk': 'The register of work: sober, legible, nothing competing '
            'with the text.',
    'light': 'Where the light comes from, and at what hour.',
    'terrain': 'The material world — earth, stone, concrete, and what '
               'grows on them.',
    'heat': 'Warmth with no visible source.',
    'pop': 'The colour is the ground, not a detail.',
    'ported': 'A palette from elsewhere, kept as its authors drew it.',
    'print': 'Drawn for ink and paper: a white ground, and colours that '
             'survive printing.',
}

# Every value each facet can take, in the order a listing should show
# them (hue follows the colour wheel, not the alphabet). Single source of
# truth for the `themes` command's validation and for its grouped output,
# so a new hue band cannot be added to HUE_NAMES without appearing here.
FACET_VALUES = {
    'polarity': ('light', 'dark'),
    'hue': ('neutral', 'red', 'orange', 'yellow', 'green',
            'cyan', 'blue', 'violet', 'magenta'),
    'family': tuple(THEME_FAMILIES),
}

# Runtime theme selectors use the vocabulary readers already see in the
# catalogue, with short aliases for the command line. A selector is an
# addition to the requested set; several selectors therefore form a union,
# just like several comma-separated slugs.
_RUNTIME_THEME_FACET_ALIASES = {
    'polarity': 'polarity',
    'background': 'polarity',
    'bg': 'polarity',
    'hue': 'hue',
    'background hue': 'hue',
    'bgh': 'hue',
    'family': 'family',
    'fam': 'family',
}
ESSENTIAL_THEME_IDS = ('monochrome', 'monochrome-night', 'print-ink')


def _lab(hex_colour):
    """sRGB hex to CIELAB. Only used to name a facet, so D65/2° and the
    textbook constants are ample."""
    rgb = [int(hex_colour.lstrip('#')[i:i + 2], 16) / 255 for i in (0, 2, 4)]
    r, g, b = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in rgb]
    x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047
    y = 0.2126 * r + 0.7152 * g + 0.0722 * b
    z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883
    fx, fy, fz = [t ** (1 / 3) if t > 0.008856 else 7.787 * t + 16 / 116 for t in (x, y, z)]
    return 116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)


def theme_hue_family(theme):
    """Names the hue family of a theme's BACKGROUND — what a reader sees
    first, and what they mean by "a green theme". Computed in CIELAB so
    the answer matches perception: a pale cream has a hue ANGLE like a
    full orange but almost no chroma, and is called 'neutral'."""
    import math
    lightness, a, b = _lab(theme['page'])
    if math.hypot(a, b) < neutral_chroma_threshold(lightness):
        return 'neutral'
    angle = math.degrees(math.atan2(b, a)) % 360
    for bound, name in HUE_NAMES:
        if angle < bound:
            return name
    return 'red'


def theme_facets(theme):
    """The facets of a THEMES entry, as the gallery (§11.7) and the
    `themes` command (§11.9) both present them — one function, so a
    browser picker and a terminal picker can never disagree.

    The keys are FACET_VALUES, and deliberately not spelled out in this
    docstring: the sentence that named them said "three" for the fortnight
    between family arriving and this one being read again."""
    return {
        'polarity': 'dark' if theme.get('dark_background') else 'light',
        'hue': theme_hue_family(theme),
        'family': theme.get('family'),
    }


def themes_matching(filters):
    """The THEMES entries whose facets satisfy every filter in `filters`
    (a facet-name -> value mapping; a None or absent value matches
    anything). Returns a list of (slug, theme, facets) in table order."""
    out = []
    for slug, theme in THEMES.items():
        facets = theme_facets(theme)
        if all(want is None or facets[name] == want for name, want in filters.items()):
            out.append((slug, theme, facets))
    return out



def note_to_html(note):
    """§9.5.4 — a theme note is stored as plain text, because it has two
    consumers with opposite needs: `themes` prints it to a terminal, and
    themes-gallery puts it in a page. Plain text is the safe default of
    the two — a terminal cannot render markup, while HTML can always be
    produced from text. The reverse arrangement shipped until v0.12.1 and
    leaked `&ldquo;` to the terminal on eight themes.

    So: escape what HTML reserves, then honour the one piece of markup a
    note needs, `backticks` for a variable name, in the format's own
    inline-code syntax."""
    out = (note.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;'))
    return re.sub(r'`([^`]+)`', r'<code>\1</code>', out)


def fact_treatment_label(theme):
    """One sentence saying how a theme renders **bold** inside a
    fact-box (§9.1), for themes-gallery (§11.7).

    The gallery applied these properties to its mock-up and never said a
    word about them, so nothing anywhere told a reader that a theme can
    be bold WITHOUT a highlight, or un-bold WITH a coloured one. Every
    distinct combination in the table was invisible: you had to squint at
    a two-line preview and guess."""
    weight = theme.get('fact_weight', 'bold')
    style = theme.get('fact_style', 'normal')
    role = theme.get('fact_highlight', 'marker')

    faces = []
    if weight == 'bold':
        faces.append('bold')
    if style == 'italic':
        faces.append('italic')
    face = ' '.join(faces) if faces else 'normal weight'
    face = face[0].upper() + face[1:]

    # Names the settings.conf property, the one an author can type — never a
    # CSS variable the emitted sheet no longer declares. `fact_highlight`
    # still carries the old role name in the THEMES entry, so map it.
    ground = PROPERTY_NAME_OF_ROLE.get(role, role) if role else None
    parts = [face, f'highlighted <code>{ground}</code>' if ground else 'no highlight']
    # Only mentioned when present: naming the absence of an underline on
    # every one of the built-in themes would bury the axes that differ.
    if theme.get('fact_decoration') == 'underline':
        colour = theme.get('fact_decoration_color')
        name = PROPERTY_NAME_OF_ROLE.get(colour, colour) if colour else None
        parts.append(f'underlined <code>{name}</code>' if name else 'underlined')
    return ', '.join(parts)


# ============================================================================
# THEME ENGINE (§9 rewrite) — typed properties in, CSS out
# ============================================================================
# The authoring surface is a flat list of typed properties named after the
# components the format already names (GLOSSARY.md); CSS is only the emission
# format. Layers — built-in defaults, theme, series settings, article,
# instance tags — are plain dicts merged before emission, so what ships is
# flat and what the author writes is data the tooling can read.
#
# The registry below is the full inventory of what the sheet paints; build,
# init, series theme set, template update and audit all go through it (see
# series_style_context / compose_with and the cmd_* functions). What it does
# NOT drive is the skeleton (TEMPLATE_SKELETON), and the two sets are
# disjoint by construction — a test pins that.

FONT_GENERICS = ('serif', 'sans-serif', 'monospace', 'cursive', 'fantasy')
# vmin/vmax and the small/large/dynamic viewport units are here because
# the engine's own defaults use them (B13): a type that rejects the unit
# its defaults ship is a trap for the first author who restates one.
LENGTH_UNITS = ('px', 'rem', 'em', 'ch', 'vw', 'vh', 'vmin', 'vmax',
                'svh', 'svw', 'lvh', 'lvw', 'dvh', 'dvw', '%', 'pt')
LENGTH_FUNCS = ('clamp', 'calc', 'min', 'max')

# Reference chains are resolved at generation time and never reach the CSS,
# so this cap protects only the reader of a settings file. Two hops proved too
# tight the day the catalogue's own `terminal` needed page.font ->
# font.text -> font.mono: an ordinary theme sat exactly at the limit, leaving
# a series no room to add one indirection of its own.
MAX_REFERENCE_HOPS = 3


class PropertyError(Exception):
    """A property value that does not match its type, or a reference that
    leads nowhere. Always names the offending key: the silent no-op — a
    mistyped variable doing nothing, wordlessly — was the single most
    expensive failure of the CSS surface this engine replaces."""


class PropType:
    """Base property type. `namespace` is where a bare-word reference is
    looked up (the axis fixes the type, the type fixes the namespace); None
    means the axis takes literals only."""
    name = 'value'
    namespace = None

    def is_literal(self, value):
        return True

    def check(self, key, value):
        return value


class ColourType(PropType):
    name = 'colour'
    namespace = 'color'
    HEX = re.compile(r'^#(?:[0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$')

    def is_literal(self, value):
        # Unambiguous by construction: a literal colour always starts with #.
        return value.startswith('#') or value == 'transparent'

    def check(self, key, value):
        if value == 'transparent':
            return '#00000000'
        if not self.HEX.match(value):
            raise PropertyError(f'{key}: {value!r} is not a colour '
                                f'(expected #RGB, #RRGGBB or #RRGGBBAA)')
        h = value.lstrip('#')
        if len(h) in (3, 4):
            h = ''.join(c * 2 for c in h)
        if len(h) == 6:
            h += 'FF'
        return '#' + h.upper()


class LengthType(PropType):
    name = 'length'

    # What may appear inside a CSS length function. No <, >, }, ; or quotes:
    # inspecting only the five-character prefix let `calc(0px)} </style>
    # <script>...` out of the declaration and out of the sheet.
    FUNC_BODY = re.compile(r'^[0-9a-zA-Z.,%+*/()\- ]*$')

    def check(self, key, value):
        if any(value.startswith(f + '(') for f in LENGTH_FUNCS):
            if not self.FUNC_BODY.match(value) or value.count('(') != value.count(')'):
                raise PropertyError(
                    f'{key}: {value!r} is not a well-formed CSS length '
                    f'function (balanced parentheses, no punctuation that '
                    f'could leave the declaration)')
            return value
        if value == '0':
            return value
        m = re.match(r'^-?\d*\.?\d+([a-z%]+)$', value)
        if not m or m.group(1) not in LENGTH_UNITS:
            # `auto` used to be accepted here and is refused by name,
            # because it validated, resolved and emitted: written on a
            # shadow axis it produced `box-shadow: auto 1px 8px 0 …`,
            # which no browser parses, so the shadow vanished with no
            # build error, no audit warning and nothing in `theme show`.
            # Swept across the registry, `auto` is meaningless in EVERY
            # one of the CSS contexts a length reaches here — shadow
            # offsets, blurs, spreads, font sizes, border widths,
            # tracking, padding, and the two max-widths, which take
            # `none` and not `auto`. So it is not a narrower type that
            # was missing, it is one value that never belonged.
            if value == 'auto':
                raise PropertyError(
                    f'{key}: `auto` is not a length here. No property in '
                    f'this registry reaches a CSS context that accepts '
                    f'it, and it used to be emitted verbatim into one '
                    f'that does not — silently deleting the shadow, rule '
                    f'or size it was written on. Write `0` for none.')
            raise PropertyError(f'{key}: {value!r} is not a length '
                                f'(units: {", ".join(LENGTH_UNITS)})')
        return value


class RatioType(PropType):
    """Unitless, and deliberately not a Length. A unitless line-height is
    inherited as a factor and re-multiplied by each child's own font-size;
    `1.5rem` is inherited as a fixed length and breaks the moment a child
    changes size. Invisible until it bites — which is what typing is for."""
    name = 'ratio'

    def check(self, key, value):
        if not re.match(r'^\d*\.?\d+$', value):
            raise PropertyError(f'{key}: {value!r} is not a ratio '
                                f'(a unitless number, e.g. 1.5)')
        return value


class AngleType(PropType):
    name = 'angle'

    def check(self, key, value):
        if not re.match(r'^-?\d*\.?\d+(deg|rad|turn|grad)$', value):
            raise PropertyError(f'{key}: {value!r} is not an angle '
                                f'(deg, rad, turn, grad)')
        return value


class FontStackType(PropType):
    """A stack must end on a CSS 2.1 generic: that is the only guarantee a
    browser owes us. Everything before the generic is a chance; the generic
    is the promise."""
    name = 'font stack'
    namespace = 'font'

    def is_literal(self, value):
        # A real stack ends on a generic (so it has a comma) or IS a bare
        # generic. Anything else without a comma is a reference.
        return ',' in value or value in FONT_GENERICS

    # A family name, quoted or not. Deliberately narrow: this value is
    # emitted into the page's inlined <style> without further transformation,
    # so anything outside this shape is a way out of the declaration. Checking
    # only the last component let `</style><script>x</script><style>y, serif`
    # through, because it ends on a generic.
    FAMILY = re.compile(r'''^(?:"[A-Za-z0-9 _-]+"|'[A-Za-z0-9 _-]+'|[A-Za-z][A-Za-z0-9 _-]*)$''')

    def check(self, key, value):
        parts = [p.strip() for p in value.split(',')]
        for part in parts:
            if not self.FAMILY.match(part):
                raise PropertyError(
                    f'{key}: {part!r} is not a font family name. A stack is '
                    f'comma-separated names, letters/digits/space/-/_ only, '
                    f'optionally quoted.')
        last = parts[-1].strip('"\'')
        if last not in FONT_GENERICS:
            raise PropertyError(
                f'{key}: font stack must end on a generic family '
                f'({", ".join(FONT_GENERICS)}), found {last!r}. '
                f'No named font is guaranteed to be installed.')
        return value


class ChoiceType(PropType):
    def __init__(self, *values, hint=''):
        self.values = values
        self.hint = hint
        self.name = 'one of ' + '|'.join(values)

    def check(self, key, value):
        if value not in self.values:
            msg = (f'{key}: {value!r} not allowed '
                   f'(expected {"|".join(self.values)})')
            raise PropertyError(msg + (f'. {self.hint}' if self.hint else ''))
        return value


class FreeTextType(PropType):
    """A CSS string token — the verdicts' shape marks. NOT free text,
    despite the historical name: the value lands inside the page's
    inlined <style>, where an unquoted `}` escapes the declaration and a
    literal `</style>` escapes the sheet itself — the audit's stored-XSS
    vector, reachable from an ARTICLE's style.* meta, the one trust level
    the rewrite hardened everywhere else. So: exactly one double-quoted
    CSS string (backslash escapes allowed, no raw quote and no `<`), or
    the keyword `none`."""
    name = 'CSS string'
    STRING = re.compile(r'^"(?:[^"\\<\n]|\\[0-9A-Fa-f]{1,6} ?|\\["\\])*"$')

    def check(self, key, value):
        if value == 'none':
            return value
        if not self.STRING.match(value):
            raise PropertyError(
                f'{key}: {value!r} is not a CSS string (one double-quoted '
                f'string, e.g. "\\25CF", or none). Raw }} < or an unpaired '
                f'quote would let a value escape the inlined stylesheet.')
        return value


PROP_COLOR = ColourType()
PROP_LENGTH = LengthType()
PROP_RATIO = RatioType()
PROP_ANGLE = AngleType()
PROP_FONT = FontStackType()
PROP_TEXT = FreeTextType()
# Only normal and bold survive a generic family: asked for 600 a two-weight
# font renders 700, and 500 renders 400 — three declared weights collapse
# into two, and "partial" stops being distinguishable from "yes".
PROP_WEIGHT = ChoiceType('normal', 'bold',
                         hint='Intermediate weights collapse on a generic family.')
PROP_STYLE = ChoiceType('normal', 'italic')
PROP_CASE = ChoiceType('none', 'uppercase', 'lowercase', 'small-caps')
PROP_ALIGN = ChoiceType('left', 'center', 'right', 'justify')
# Breaking words at end of line is never done unless it is asked for, by
# name. `manual` is CSS's own initial value: words break only where the
# author put a soft hyphen. This shipped once tied to `justify`, which meant
# choosing an alignment silently turned word-breaking on -- a typographic
# decision arriving as a side effect of a different one.
PROP_HYPHENS = ChoiceType('manual', 'auto')
PROP_NUMERIC = ChoiceType('normal', 'tabular-nums', 'tabular-nums lining-nums')
PROP_DECORATION = ChoiceType('none', 'underline', 'line-through',
                             'underline line-through')


class ThemeProp:
    def __init__(self, key, type_, default, css=None, selector=None):
        self.key = key            # 'kicker.fg'
        self.type = type_
        self.default = default    # a literal, or a reference written as a word
        self.css = css            # CSS declaration it feeds, None if composite
        # Where the declaration lands when it is NOT the component's base
        # selector: an inner element (.fact-content inside .fact-box), a
        # context (.slide-cover h1), or a state (:hover, .active). The
        # inventory showed one selector per component is a fiction the real
        # sheet does not honour.
        self.selector = selector

    @property
    def var(self):
        return '--' + self.key.replace('.', '-')


class Composite:
    """One declaration built from several properties at once.

    `selector` overrides the component's own, exactly as ThemeProp.selector
    already does for a simple property, and for the same stated reason:
    "one selector per component is a fiction the real sheet does not
    honour". A halo belongs on the element that paints the glyphs, not on
    the box around them; an elevation on hover belongs on `:hover`.

    `omit_when_default` drops the declaration entirely when every property
    it reads is still at its registry default. That exists for ONE
    property, and it is not an optimisation: `text-shadow` is INHERITED.
    Emitting `text-shadow: 0 0 0 transparent` on a component that asked for
    nothing does not paint nothing -- it BLOCKS the halo the page set,
    which is how nine delivered themes would have lost their atmosphere on
    every component this lot newly covers. A component that declares
    nothing must go on inheriting, and the only way to say that in CSS is
    to say nothing at all. `box-shadow` is not inherited, so elevation
    leaves this off and always emits.
    """

    __slots__ = ('cssprop', 'value', 'selector', 'omit_when_default')

    def __init__(self, cssprop, value, selector=None, omit_when_default=False):
        self.cssprop = cssprop
        self.value = value
        self.selector = selector
        self.omit_when_default = omit_when_default

    def reads(self):
        """The property keys this declaration's value expression consumes.

        Derived from the `var(--x)` names in the expression rather than
        declared beside it: a list written twice is a list that drifts, and
        this one decides whether the declaration is emitted at all.

        Translated through VAR_TO_KEY rather than by turning hyphens into
        dots, because a key segment may contain a hyphen -- `nav.btn`,
        `highlight.caption`, `elevation-hover`. A var this map does not know
        comes back unchanged, which no registry key can match, so the caller
        sees an unknown and keeps the declaration instead of dropping it on
        a name it failed to read."""
        return [VAR_TO_KEY.get(name, name)
                for name in re.findall(r'var\(\s*(--[\w-]+)', self.value)]


class ThemeComponent:
    def __init__(self, key, selector, props, composite=None):
        self.key = key
        self.selector = selector
        self.props = props
        # Declarations built from several properties at once — a gradient, an
        # inset box-shadow bar, a halo. Composite instances; a plain
        # (css_property, value) pair is still accepted and means "on this
        # component's own selector, always emitted".
        self.composite = [c if isinstance(c, Composite) else Composite(*c)
                          for c in (composite or [])]


def _gradient_decl(v_angle, v_from, v_to):
    """A flat fill is a gradient whose two stops are equal — one mechanism,
    no branch, and a flat theme stays flat without saying anything."""
    return Composite(
        'background',
        f'linear-gradient(var({v_angle}), var({v_from}), var({v_to}))')


