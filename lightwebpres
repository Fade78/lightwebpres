# --- Refonte CLI v0.24.0 ----------------------------------------------------
# Options accepted BEFORE the command (git-style): --lang, the logging
# switches and --version/--help act immediately. The option nearest the
# command wins.
#
# Two natures share this table, and conflating them is what let `build s
# --version` build the series and print nothing. A MODIFIER changes how a
# command runs, so "before or after" is a real convenience: `build s
# --quiet` and `--quiet build s` are the same run. An ACTION replaces the
# command; honouring it after one would mean discarding the request the
# user actually typed. `--help` is the exception that proves it: after a
# command it has a contextual meaning -- the help OF that command -- so it
# earns its position, and main() answers it before dispatch. `--version`
# has no contextual meaning, so it is refused after a command by name
# rather than accepted and ignored (BACKLOG B22).
_GLOBAL_MODIFIERS = frozenset({'--lang', '--quiet', '--verbose', '--no-color',
                               '--timestamp', '--dry-run'})
_GLOBAL_ACTIONS = frozenset({'--version', '--help'})
_GLOBAL_OPTIONS = _GLOBAL_MODIFIERS | _GLOBAL_ACTIONS
_GLOBAL_FLAGS = frozenset({'--quiet', '--verbose', '--no-color', '--timestamp',
                           '--dry-run', '--version', '--help'})
_GLOBAL_VALUES = frozenset({'--lang'})

# Canonical commands are the source of truth. Shortcuts are
# a root-level comfort layer; legacy aliases are the previous names, kept for
# one MAJOR with a [WARNING] on stderr.
# Each entry maps the user-facing token → the internal `cmd_*` dispatch key.
# The dispatch key is also what _COMMAND_OPTIONS is indexed by, so the option
# tables above stay valid without duplication.
_SHORTCUTS = {
    'init': 'install',
    'demo': 'demo',
    'build': 'build',
    'verify': 'check',
    'audit': 'audit',
    'status': 'series-info',
    'clean': 'clean',
    'resolve': 'resolve',
    'watch': 'watch',
    'completion': 'completion',
}
# Two-word shortcuts: `template update` → refresh-templates. Parsed by
# _resolve_command when the first token is `template` and the second is
# `update`; a lone `template` is NOT a shortcut: the `series template`
# reading command it would have led to was abandoned.
# (No other two-word shortcuts yet — `template update` is handled inline.)
# Legacy names → new dispatch key. Each emits a [WARNING] on stderr naming the
# new form. The dispatch key is the OLD cmd_* name (option tables stay valid).
# Spellings this program used to accept and no longer does. They are NOT
# commands: nothing here is offered by completion, named in --help, or
# written in any document. The table exists for one purpose, which is to
# refuse them by name.
#
# They were accepted as deprecated aliases, each printing a [WARNING] and
# then working. That is a worse teacher than a refusal: the completion
# offered them, so a reader learning the CLI met `install` and `check`
# alongside `init` and `verify` with nothing to say which was which, and
# a command that works after complaining is a command people keep typing.
#
# Refused rather than made unknown, because the two are not the same
# service. An unknown token prints the whole help and leaves the reader
# to find the word themselves; this names it. Same shape as the `theme
# set` refusal, which has always worked this way.
#
# Whole sentences rather than bare command names, because one of them
# needs two: `theme-info` became a catalogue reading and a series
# reading, which are not the same question, and a table that could hold
# only one command would have had to pick.
_RETIRED_SPELLINGS = {
    'install': 'Use `lightwebpres init`.',
    'check': 'Use `lightwebpres verify`.',
    'refresh-templates': 'Use `lightwebpres template update`.',
    'themes': 'Use `lightwebpres theme list`.',
    'theme-info': 'Use `lightwebpres theme show <slug>` for the catalogue, '
                  'or `lightwebpres series theme [dir]` for the effective '
                  'theme of a series.',
    'set-theme': 'Use `lightwebpres series theme set`.',
    'themes-gallery': 'Use `lightwebpres theme gallery`.',
    'series-info': 'Use `lightwebpres status`.',
}
# Canonical `series <verbe>` and `theme <verbe>` forms. `series` is the
# dominant object; almost every series verb has a root shortcut. `theme` is
# the catalogue node and never touches a series.
_SERIES_VERBS = {
    'init': 'install', 'demo': 'demo', 'build': 'build', 'verify': 'check',
    'audit': 'audit', 'status': 'series-info', 'clean': 'clean',
    'watch': 'watch', 'resolve': 'resolve',
    'theme': 'series-theme',
    'slug': 'series-slug',
}
_THEME_VERBS = {
    'list': 'themes', 'show': 'theme-info', 'gallery': 'themes-gallery',
}
# `template` is the node for the files the EXECUTABLE owns, which is why
# `show` and `write` live here rather than under `series`: neither needs a
# series to answer (show needs none at all), and what they hand over comes
# out of this file, not off a disk.
_TEMPLATE_VERBS = {
    'update': 'refresh-templates',
    'show': 'template-show',
    'write': 'template-write',
}


# Dispatch key -> the name a user should type. The keys are the LEGACY
# tokens, because that is what the dispatcher was built on, and every
# message that echoed a key therefore recommended the command the same
# program tells you not to use: `status --strict` answered "not an option
# of `series-info`" for eight of the thirteen commands, and `series theme`
# answered "series-theme", which is not a CLI token at all. Derived from
# the verb tables rather than typed out, so a new verb cannot arrive
# without a name here.
_CANONICAL_NAME = {}
for _verb, _key in _SERIES_VERBS.items():
    _CANONICAL_NAME.setdefault(_key, _verb if _verb in _SHORTCUTS
                               else f'series {_verb}')
for _verb, _key in _THEME_VERBS.items():
    _CANONICAL_NAME[_key] = f'theme {_verb}'
_CANONICAL_NAME.update({
    'set-theme': 'series theme set',
    'series-slug': 'series slug',
    'assign-slug': 'series slug set',
    'refresh-templates': 'template update',
    'template-show': 'template show',
    'template-write': 'template write',
    'series-theme': 'series theme',
    'completion': 'completion',
})


def canonical(command):
    """The invocation to show a user for an internal dispatch key."""
    return _CANONICAL_NAME.get(command, command)


# How many positionals each command can actually use. Anything past
# that was SILENTLY DISCARDED: `init A B` created A, printed
# "Installed: A", and never mentioned B -- a write command ignoring
# half of what it was given, without a word. Same for `status a b c`,
# `theme list junk`, and `build dir -x`, where a single-dash typo is
# not recognised as an option at all and quietly becomes a positional.
#
# specifications.md §2.4 already promises an unknown option is fatal
# and "never a silent no-op". An unusable positional is that same
# promise seen from the other side. `resolve` has always counted its
# own, which is where the wording below comes from: the check was
# right, it was simply never generalised.
#
# None means "as many as you like" -- theme show and theme gallery
# take a list of slugs, and gallery also accepts a legacy output path.
_MAX_POSITIONAL = {
    'install': 1, 'demo': 1, 'build': 1, 'check': 1, 'audit': 1,
    'clean': 1, 'watch': 1, 'series-info': 1, 'series-theme': 1,
    'set-theme': 1, 'refresh-templates': 1,
    'series-slug': 1, 'assign-slug': 1,
    # `template show <file>` takes the file and nothing else -- it
    # reads the executable, so there is no series to name. `write`
    # takes the file first, then the series it goes into.
    'template-show': 1, 'template-write': 2,
    'resolve': 2,
    'themes': 0, 'completion': 0,
    'theme-info': None, 'themes-gallery': None,
}

# Where the count above cannot say the shape. `template show` takes a file
# name and no directory at all; `template write` takes the file FIRST and
# the series after it. The derived form would print `[directory] <name>`,
# which the parser refuses -- a synopsis promising a rejected form is the
# one failure the help generator exists to prevent.
_POSITIONAL_SHAPE = {
    'template-show': ' <nav.js|fr.json|en.json>',
    'template-write': ' <nav.js|fr.json|en.json> [directory]',
}


def print_command_help(command):
    """Help for one command, derived from the option tables.

    `<command> --help` used to be a hard error -- `build --help`,
    `theme show --help` and `series build --help` all exited 1 with
    "Unknown option: --help", because --help was honoured only in leading
    position. A refactor whose headline is nested subcommands shipped with
    no subcommand help at all, and the most reflexive keystroke in the new
    grammar was the one that failed.

    Built from _COMMAND_OPTIONS rather than sliced out of the full help
    text, so it cannot drift: an option added to a command appears here
    the same day."""
    name = canonical(command)
    # The argument shape comes from the same table that enforces it, so
    # the synopsis cannot promise a form the parser refuses.
    limit = _MAX_POSITIONAL.get(command, 1)
    # Two commands take their positionals the other way round -- the FILE
    # first, the optional directory second -- so the derived shape would
    # promise a form the parser refuses, which is the one thing this
    # function exists not to do. Named rather than inferred: a count
    # cannot say which order a command wants.
    shape = _POSITIONAL_SHAPE.get(
        command,
        '' if limit == 0 else
        ' [directory]' if limit == 1 else
        ' [directory] <name>' if limit == 2 else
        ' <slug>...')
    print(f'lightwebpres {name}{shape} [options]')
    print()
    own = sorted(_COMMAND_OPTIONS.get(command, set()) - _GLOBAL_OPTIONS)
    if own:
        print('OPTIONS')
        for opt in own:
            takes = ' <value>' if opt in _VALUE_OPTIONS else ''
            print(f'  {opt}{takes}')
    else:
        print('This command takes no options of its own.')
    print()
    print('GLOBAL OPTIONS (before or after the command)')
    print('  ' + '  '.join(sorted(_GLOBAL_OPTIONS)))
    print()
    print(f'Run `lightwebpres --help` for every command and the full '
          f'description of each option.')


def _node_help(node, verbs):
    """Help for a command NODE (`series`, `theme`) rather than a command.

    `theme --help` answered "Unknown theme verb: `theme --help`", which is
    both wrong and unhelpful: --help is not a verb someone mistyped."""
    print(f'lightwebpres {node} <verb> [arguments]')
    print()
    print('VERBS')
    for verb in sorted(verbs):
        print(f'  {node} {verb}')
    if node == 'series':
        print(f'  {node} theme set        change a series\' theme')
    print()
    print(f'Run `lightwebpres <verb> --help` for one verb, or '
          f'`lightwebpres --help` for everything.')


def _refuse_retired(spelling):
    # 'error' and a non-zero exit, because this is no longer a way to run
    # anything. It used to be 'warn' over a successful run, which is the
    # arrangement this retirement ends.
    log('error', f'`{spelling}` is not a command. '
        f'{_RETIRED_SPELLINGS[spelling]}')
    sys.exit(1)


def _resolve_command(args):
    """Resolves the user's first token(s) to a dispatch key and the remaining
    args. Returns (dispatch_key, remaining_args), or (None, args) if no
    command is recognised. There is no third element any more: it used to
    say whether the token was a deprecated alias, and there are no
    deprecated aliases.

    Acceptance order (first match wins):
      1. `--version` / `--help` / `-h` as a global flag (handled by main).
      2. `series <verb>` / `theme <verb>` canonical forms.
      3. Two-word shortcuts (`template update`).
      4. Root shortcuts (`init`, `build`, ...).
      5. Retired spellings (`install`, `check`, ...) — matched last, and
         not accepted: each is a fatal error naming the form to type. They
         are matched rather than ignored so the message can name it.
    """
    if not args:
        return None, args
    head = args[0]

    if head == 'series' and len(args) >= 2:
        verb = args[1]
        if verb in ('--help', '-h'):
            _node_help('series', _SERIES_VERBS)
            sys.exit(0)
        # `series theme set <dir> --theme X` — two-word series verb.
        if verb == 'theme' and len(args) >= 3 and args[2] == 'set':
            return 'set-theme', args[3:]
        # `series slug set [dir]` — the one command that writes into an
        # author's articles, which is why it is a verb of its own and not
        # a flag on the build.
        if verb == 'slug' and len(args) >= 3 and args[2] == 'set':
            return 'assign-slug', args[3:]
        if verb in _SERIES_VERBS:
            return _SERIES_VERBS[verb], args[2:]
        log('error', f"Unknown series verb: `series {verb}`. "
              f"Run `lightwebpres --help` for the command list.")
        sys.exit(1)

    if head == 'theme' and len(args) >= 2:
        verb = args[1]
        if verb in ('--help', '-h'):
            _node_help('theme', _THEME_VERBS)
            sys.exit(0)
        if verb in _THEME_VERBS:
            return _THEME_VERBS[verb], args[2:]
        # `theme set` is NOT a shortcut: the `theme` node never
        # touches a series. Point at the canonical form.
        if verb == 'set':
            log('error', "`theme set` is not a root command: the `theme` "
                  "node is the catalogue and never modifies a series. "
                  "Use `lightwebpres series theme set [dir] --theme X`.")
            sys.exit(1)
        log('error', f"Unknown theme verb: `theme {verb}`. "
              f"Run `lightwebpres --help` for the command list.")
        sys.exit(1)

    # `template <verb>`: update, show, write.
    if head == 'template' and len(args) >= 2 and args[1] in _TEMPLATE_VERBS:
        return _TEMPLATE_VERBS[args[1]], args[2:]
    # Lone `template` is NOT a shortcut (series template reading is abandoned).
    if head == 'template':
        log('error', "`template` alone is not a command. Use "
              f"{', '.join('`lightwebpres template ' + v + '`' for v in sorted(_TEMPLATE_VERBS))}"
              " (the reading command was replaced by `audit --templates`).")
        sys.exit(1)

    if head in _SHORTCUTS:
        return _SHORTCUTS[head], args[1:]

    if head in _RETIRED_SPELLINGS:
        _refuse_retired(head)

    return None, args


def parse_cli_options(command, rest, global_opts=None):
    """Parses `rest` into (opts, positional) against _COMMAND_OPTIONS.

    Fatal errors (exit 1): an option the command doesn't accept (whether
    it exists elsewhere or not), and a value option with no value.

    `global_opts` (optional) is the dict of options already consumed before
    the command. They are merged in, with the per-command option winning on
    conflict (nearest-to-the-command wins)."""
    # The globals belong to every command, before it or after it. They were
    # fatal in postfix -- `build s --quiet` exited 1 -- while --lang, which
    # IS one of them, worked in both positions, and a global the target
    # command cannot use was silently accepted in leading position. The
    # rule was inconsistent in both directions at once; it is one rule now:
    # a global is always accepted, wherever it sits.
    allowed = _COMMAND_OPTIONS[command] | _GLOBAL_OPTIONS
    opts = dict(global_opts) if global_opts else {}
    positional = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg == '--':
            # End of options: everything after is a positional, whatever it
            # looks like. Without it there was no way to name a directory
            # that starts with a dash or collides with a verb -- and `--`
            # itself was reported as an unknown option, which is the least
            # helpful answer to someone reaching for exactly this.
            positional.extend(rest[i + 1:])
            break
        if arg.startswith('--'):
            # GNU-style --opt=value: split once, the rest is the value
            # (which may itself contain '=').
            name, eq, inline_value = arg.partition('=')
            if name not in allowed:
                hint = f' (not an option of `{canonical(command)}`)' if name in _VALUE_OPTIONS or any(
                    name in v for v in _COMMAND_OPTIONS.values()) else ''
                log('error', f'Unknown option: {name}{hint}. '
                      f'Run `lightwebpres --help` for the option list.')
                sys.exit(1)
            if name in _VALUE_OPTIONS:
                if eq:
                    opts[name] = inline_value
                    i += 1
                elif i + 1 < len(rest) and not rest[i + 1].startswith('--'):
                    opts[name] = rest[i + 1]
                    i += 2
                else:
                    log('error', f'Option {name} requires a value '
                          f'(`{name} VALUE` or `{name}=VALUE`).')
                    sys.exit(1)
            else:
                if eq:
                    log('error', f'Option {name} takes no value.')
                    sys.exit(1)
                opts[name] = True
                i += 1
        else:
            positional.append(arg)
            i += 1
    return opts, positional


def _flag_before_terminator(args, names):
    """True if any of `names` appears in `args` before a bare `--`.

    Everything after the terminator is a positional, whatever it looks
    like (§2.4.1). Scanning the whole list instead made `build -- --help`
    print help for a directory literally named `--help`."""
    for arg in args:
        if arg == '--':
            return False
        if arg in names:
            return True
    return False


def _parse_global_options(args):
    """Consumes global options (git-style) from the front of `args` until a
    non-option is met. Returns (global_opts, remaining).

    `--version` and `--help`/`-h` short-circuit: they print and exit. The
    other globals are accepted as no-op in Phase 1 (Phase 2 wires them)."""
    global_opts = {}
    i = 0
    while i < len(args):
        arg = args[i]
        if not arg.startswith('--'):
            break
        name, eq, inline_value = arg.partition('=')
        if name not in _GLOBAL_OPTIONS:
            # Not a global — leave it for the command parser. But stop here so
            # the command can flag it if it's unknown to it either.
            break
        if name == '--version':
            print(f'LightWebPres v{VERSION}')
            sys.exit(0)
        if name in ('--help', '-h'):
            print_help()
            sys.exit(0)
        if name in _GLOBAL_FLAGS:
            if eq:
                log('error', f'Option {name} takes no value.')
                sys.exit(1)
            global_opts[name] = True
            i += 1
        elif name in _GLOBAL_VALUES:
            if eq:
                global_opts[name] = inline_value
                i += 1
            elif i + 1 < len(args) and not args[i + 1].startswith('--'):
                global_opts[name] = args[i + 1]
                i += 2
            else:
                log('error', f'Option {name} requires a value.')
                sys.exit(1)
        else:
            break
    return global_opts, args[i:]


def main():
    # Re-read the terminal width now: the one computed at import time may
    # be stale (e.g. the module was imported in a narrow context but the
    # user runs in a wide terminal).
    global _TERM_WIDTH
    _TERM_WIDTH = _shutil.get_terminal_size((80, 24)).columns
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help', 'help'):
        print_help()
        return

    # Global options before the command (git-style). --version/--help short-
    # circuit inside _parse_global_options.
    global_opts, args = _parse_global_options(args)

    command, rest = _resolve_command(args)
    # `<command> --help`, in any position after the command. Honouring it
    # only in leading position made the most reflexive keystroke in a
    # nested grammar a hard error. Only up to `--`: after the terminator a
    # token that looks like a flag is a positional, and answering it with
    # help would be answering a question nobody asked.
    if command is not None and _flag_before_terminator(rest, ('--help', '-h')):
        print_command_help(command)
        return
    # `<command> --version` is the other half of that table, and it does not
    # get the same treatment (BACKLOG B22). The version does not depend on
    # the command, so there is nothing contextual to report; printing it and
    # exiting would silently drop the command the user typed. It was
    # accepted and ignored until v0.37.0 -- the one silent no-op inside the
    # section that forbids silent no-ops.
    if command is not None and _flag_before_terminator(rest, ('--version',)):
        log('error', '--version reports the version and exits; it does not '
                     'modify a command. Run `lightwebpres --version`.')
        sys.exit(1)
    if command is None:
        if args:
            log('error', f'Unknown command: {args[0]}')
        else:
            log('error', 'no command given — run `lightwebpres --help` to list commands')
        print_help()
        sys.exit(1)

    opts, positional = parse_cli_options(command, rest, global_opts)

    # Wire the global verbosity flags into the logger. Read from `opts`,
    # not `global_opts`: parse_cli_options merges the leading globals in
    # and then adds any that came after the command, so this is the one
    # dict that has both. Reading the leading ones only is what made a
    # postfix global parse cleanly and then do nothing.
    configure_logging(
        quiet=opts.get('--quiet', False),
        verbose=opts.get('--verbose', False),
        no_color=opts.get('--no-color', False),
        timestamp=opts.get('--timestamp', False),
        dry_run=opts.get('--dry-run', False),
    )

    _limit = _MAX_POSITIONAL.get(command, 1)
    if _limit is not None and len(positional) > _limit:
        # The shape when one is declared, the count otherwise: `template
        # show` takes a file and no directory at all, so "at most a
        # directory" named the wrong thing entirely.
        wanted = (f'{_POSITIONAL_SHAPE[command].strip()}'
                  if command in _POSITIONAL_SHAPE else
                  'no arguments' if _limit == 0 else
                  'at most a directory' if _limit == 1 else
                  f'at most {_limit} arguments')
        unused = ', '.join(repr(a) for a in positional[_limit:])
        # canonical(), because the dispatch KEY is not a word a user can
        # type: `status a b` answered "`series-info` takes...", and this
        # lot added `template-show`, which is not a token at all. The
        # table exists for exactly this and this site was missed when it
        # was written.
        log('error', f'`{canonical(command)}` takes {wanted}; '
            f'got {len(positional)}. '
            f'Unused: {unused}. (A single-dash typo such as `-x` is read '
            f'as an argument, not as an option.)')
        sys.exit(1)

    target = positional[0] if positional else os.environ.get('LWP_SERIES_DIR', '.')

    if command == 'install':
        cmd_install(target, opts)
    elif command == 'demo':
        cmd_demo(target, opts)
    elif command == 'build':
        cmd_build(target, opts)
    elif command == 'check':
        cmd_check(target, opts)
    elif command == 'audit':
        cmd_audit(target, opts)
    elif command == 'refresh-templates':
        cmd_refresh_templates(target, opts)
    elif command == 'template-show':
        # The file name is the only positional here, so the generic
        # `target` above -- which defaults to a directory -- is not what
        # this command wants. Naming nothing is fatal and lists the set,
        # rather than printing a menu: §2.4, no silent no-op.
        if not positional:
            log('error', 'template show: name a file — '
                f'{", ".join(sorted(tool_owned_files()))}.')
            sys.exit(1)
        cmd_template_show(positional[0], opts)
    elif command == 'template-write':
        if not positional:
            log('error', 'template write: name a file — '
                f'{", ".join(sorted(tool_owned_files()))}.')
            sys.exit(1)
        cmd_template_write(
            positional[0], opts,
            positional[1] if len(positional) > 1
            else os.environ.get('LWP_SERIES_DIR', '.'))
    elif command == 'themes':
        # Not a series-directory command: it reads the built-in table
        # only, so a stray positional would mean nothing.
        cmd_themes(opts)
    elif command == 'theme-info':
        # `theme show <slug> [<slug>…] [--all]`: the catalogue reading.
        # The series reading is `series theme [dir]`, and naming a
        # DIRECTORY here is refused rather than redirected -- it was the
        # last surviving shape of the old `theme-info`, which did both
        # jobs, and a form kept working for compatibility is a form people
        # keep learning.
        #
        # No slug, no --all, and the working directory IS a series: read
        # that series, exactly as `theme show .` already does. Every other
        # command that takes a directory defaults to the one you are
        # standing in — build, verify, audit, status, clean, series theme —
        # and this was the single exception, so the one place the habit
        # broke was the place you were most likely to be standing inside
        # the series when you asked. A directory that is NOT a series falls
        # through to the usage error, which is the more useful answer for
        # someone who meant to name a slug and forgot.
        if (not positional and not opts.get('--all')
                and (Path.cwd() / 'templates').is_dir()):
            cmd_series_theme('.', opts)
        elif (positional and positional[0] not in THEMES
                and Path(positional[0]).is_dir()):
            log('error', f'`theme show` reads the catalogue, not a series. '
                f'For {positional[0]!r}, use `lightwebpres series theme '
                f'{positional[0]}`; for a catalogue entry, name a theme.')
            sys.exit(1)
        else:
            cmd_theme_info(positional, opts)
    elif command == 'series-info':
        cmd_series_info(target, opts)
    elif command == 'resolve':
        # Two positionals, and the name is the one that is never optional:
        # `resolve <name>` in the current series, `resolve <dir> <name>`
        # elsewhere. Read by count rather than by guessing which of the
        # two a lone argument looks like.
        if not positional:
            log('error', 'resolve needs a name: '
                  '`lightwebpres resolve [directory] <name>`. The shape of '
                  'the name picks the cascade — dotted for a theme property, '
                  'snake_case for an article field, kebab-case for a slide '
                  'field (§20.0).')
            sys.exit(1)
        if len(positional) > 2:
            log('error', f'resolve takes at most a directory and a name; '
                  f'got {len(positional)} arguments.')
            sys.exit(1)
        if len(positional) == 2:
            cmd_resolve(positional[0], positional[1], opts)
        else:
            cmd_resolve(os.environ.get('LWP_SERIES_DIR', '.'),
                        positional[0], opts)
    elif command == 'set-theme':
        cmd_set_theme(target, opts)
    elif command == 'series-slug':
        cmd_series_slug(target, opts)
    elif command == 'assign-slug':
        cmd_assign_slug(target, opts)
    elif command == 'series-theme':
        # `series theme [dir]` — the effective theme of an installed series
        # The directory branch of the old theme-info,
        # split out so the slug reading (theme show) and the directory reading
        # no longer share one ambiguous positional.
        cmd_series_theme(target, opts)
    elif command == 'themes-gallery':
        # `theme gallery [<slug>… | --all] [--output path]`.
        # The output path is now --output (default: themes-gallery.html), and
        # the positionals are slugs to restrict the gallery to. The legacy
        # `themes-gallery [path]` form is kept via the alias: a single
        # positional that is not a slug is treated as the output path.
        cmd_themes_gallery(positional, opts)
    elif command == 'clean':
        # `clean [dir] [--force]`: purges public/
        # of orphan files using the manifest written by build. Dry-run by
        # default, --force to remove.
        cmd_clean(target, opts)
    elif command == 'watch':
        # `watch [dir] [--serve] [--port N] [--open]`: polls sources,
        # rebuilds on change, optionally serves.
        cmd_watch(target, opts)
    elif command == 'completion':
        # `completion --shell bash|zsh` — prints a shell completion script.
        cmd_completion(opts)


if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        # `lightwebpres theme list | head` closes the pipe early. Not a themes
        # bug: any command whose output outruns the pipe buffer hits it,
        # which is why the handler is here rather than in one command.
        # Python flushes the standard streams at shutdown, which would
        # raise a second BrokenPipeError and print a traceback after this
        # handler returned, so stdout is pointed at devnull first (the
        # recipe from the signal module's note on SIGPIPE). Exit 1: the
        # output was truncated, and nothing downstream should read it as
        # complete.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
    except KeyboardInterrupt:
        # Ctrl-C is an answer, not a fault. `watch` documents exit 0 on it.
        sys.exit(0)
    except OSError as exc:
        # Every refusal this tool decides for itself is an `[ERROR]` line.
        # A refusal the filesystem decides -- output turned read-only, disk
        # full, a path that is a directory where a file was expected -- came
        # out as a raw Python traceback, so the one class of failure the
        # user has no control over was the one reported in a language about
        # the program's insides. Turning `public/index.html` into a
        # directory printed eleven frames of pathlib.
        where = f': {exc.filename}' if exc.filename else ''
        log('error', f'{exc.strerror or exc}{where}')
        log('error', 'the output directory may hold a partly updated site; '
            'fix the cause and build again.')
        sys.exit(1)
    except Exception as exc:  # noqa: BLE001 -- the last line before a traceback
        # Anything unforeseen. The traceback is the maintainer's evidence
        # and stays reachable behind --verbose; what reaches the user by
        # default is one line in the same voice as every other refusal.
        log('error', f'internal error: {type(exc).__name__}: {exc}')
        if _LOG_STATE['verbose']:
            traceback.print_exc()
        else:
            log('error', 'run again with --verbose for the traceback, and '
                'please report it with the series that provoked it.')
        sys.exit(1)
