# ============================================================================
# LANGUAGE (typography rules + interface strings)
# ============================================================================

def strip_ws(text):
    """Like str.strip(), but keeps a leading/trailing non-breaking space
    (U+00A0) intact. Plain str.strip() treats U+00A0 as whitespace and
    trims it — fine for str.isspace() purposes, but wrong here: a
    non-breaking space already present in an author's source is content,
    not parsing whitespace, and must reach the output unchanged (see
    specifications.md §7.5). Used at every site that trims a field value
    the author writes (headings, fact-box text, meta values, table
    cells...); left out of purely structural checks (blank-line/table
    separator detection) that never produce output text."""
    return text.strip(' \t\n\r\v\f')


def rstrip_ws(text):
    """Right-only counterpart of strip_ws — trims a trailing '\\r' left by
    a Windows-style line ending after `str.split('\\n')`, never a trailing
    non-breaking space."""
    return text.rstrip(' \t\n\r\v\f')


class TypoEngine:
    """Applies regex replacement rules to text."""

    def __init__(self, rules_data):
        self.rules = []
        # category -> the names of the rules that carry it
        self.categories = {}
        for i, rule in enumerate(rules_data.get('rules', []), 1):
            if not isinstance(rule, dict) or 'pattern' not in rule or 'replacement' not in rule:
                log('error', f'language rule {i}: must be an object with '
                      f'"pattern" and "replacement".')
                sys.exit(1)
            # pattern/replacement must be strings: a non-string used to
            # escape the `except re.error` below (re.compile on an int
            # raises TypeError, re.sub with an int replacement likewise) as
            # a raw traceback instead of a clean [ERROR].
            if not isinstance(rule['pattern'], str) or not isinstance(rule['replacement'], str):
                log('error', f'language rule {i}: "pattern" and "replacement" '
                      f'must be strings.')
                sys.exit(1)
            name = rule.get('name') or f'rule_{i}'
            pattern = rule['pattern']
            replacement = rule['replacement']
            # Convert $1 -> \1 for Python re.sub
            replacement = re.sub(r'\$(\d)', r'\\\1', replacement)
            # flags (§19.2): 'g' = replace every occurrence (without it,
            # only the first per text segment), 'i' = case-insensitive.
            # Anything else is fatal — this key used to be parsed and
            # silently ignored, a schema that lied to custom-pack authors.
            flags_str = str(rule.get('flags', 'g'))
            unknown_flags = set(flags_str) - {'g', 'i'}
            if unknown_flags:
                log('error', f'language rule {i} ("{name}"): unknown flag(s) '
                      f'{"".join(sorted(unknown_flags))!r} — supported: '
                      f'"g" (global), "i" (case-insensitive).')
                sys.exit(1)
            re_flags = re.IGNORECASE if 'i' in flags_str else 0
            count = 0 if 'g' in flags_str else 1
            try:
                compiled = re.compile(pattern, re_flags)
            except re.error as e:
                log('error', f'language rule {i}: invalid regex pattern '
                      f'"{pattern}" ({e}).')
                sys.exit(1)
            # `category` (§19.2) is what an opt-out names, and it has to
            # live on the rule because the rule is the only thing that
            # knows. A rule with none belongs to no bundle and is simply
            # never switched off by one -- which keeps a custom pack
            # written before this field valid, and unaffected.
            category = rule.get('category')
            if category is not None and not isinstance(category, str):
                log('error', f'language rule {i} ("{name}"): "category" '
                      f'must be a string.')
                sys.exit(1)
            self.rules.append((name, compiled, replacement, count))
            if category:
                self.categories.setdefault(category, set()).add(name)

    # Elements whose text content must never receive a typography
    # substitution (spec §6.3/§19.3): a code sample or a cited command is
    # shown exactly as written, so a rule silently inserting a
    # non-breaking space into it would corrupt the example.
    _NO_TYPO_TAGS = frozenset({'code', 'pre'})

    def apply(self, text, disabled=None):
        """Applies the typography rules to `text`, skipping HTML tags and
        the text content of <code>/<pre> elements.

        `disabled`, if given, is an iterable of rule names (the `name`
        field of a language-pack rule, spec §19.2) to skip for this call —
        how an article's own `typo_units`/`typo_thousands` meta fields
        (§4.5) turn a rule off for just that article's page, without
        touching the shared engine instance used for every other article.

        The engine is called on already-assembled HTML (fact-box content,
        full articles), so a naive whole-string substitution risks a future
        rule corrupting tag syntax (spec §19.3). Splitting on tags and only
        running rules on the text segments between them makes that
        structurally impossible, not just accidentally safe.

        The split pattern requires a tag name or `/` right after `<` (real
        tags always have one) and forbids crossing another `<`/`>` inside
        the match: a naive `<[^>]+>` would treat a stray "< 5" ... "> 10"
        in ordinary prose as one giant fake tag spanning everything between
        them, silently skipping typography on real text in between."""
        disabled = disabled or ()
        segments = re.split(r'(</?[a-zA-Z][^<>]*>)', text)
        skip_depth = 0
        for i, segment in enumerate(segments):
            if segment.startswith('<') and segment.endswith('>'):
                m = re.match(r'</?([a-zA-Z][a-zA-Z0-9]*)', segment)
                if m and m.group(1).lower() in self._NO_TYPO_TAGS:
                    if segment.startswith('</'):
                        skip_depth = max(0, skip_depth - 1)
                    else:
                        skip_depth += 1
                continue
            if skip_depth > 0:
                continue
            for name, pattern, replacement, count in self.rules:
                if name in disabled:
                    continue
                segment = pattern.sub(replacement, segment, count=count)
            segments[i] = segment
        return ''.join(segments)


def apply_typo(typo_engine, text, disabled=None):
    """`typo_engine.apply(text, disabled)` if there's an engine, `text`
    unchanged otherwise (--no-typography / typo: off pass None, §4.5/
    §19.6) — the `if typo_engine:` guard every call site needs, in one
    place instead of copied at each of them."""
    return typo_engine.apply(text, disabled) if typo_engine else text


def read_text_file(path):
    """Every source-file read goes through here. utf-8-sig, not utf-8:
    it silently absorbs a Windows-style BOM (a BOM'd full-article used
    to leak a literal U+FEFF into the published HTML and break its first
    heading, since '\\ufeff# Title' is not a heading line) and reads
    BOM-less files identically. A file that isn't valid UTF-8 dies with
    a clean [ERROR] naming the file and byte offset instead of a raw
    UnicodeDecodeError traceback."""
    try:
        return Path(path).read_text(encoding='utf-8-sig')
    except UnicodeDecodeError as e:
        log('error', f'{path}: not valid UTF-8 (byte offset {e.start}: '
              f'{e.reason}).')
        sys.exit(1)


def load_language(lang_dir, lang='fr', language_file=None):
    """Loads the language pack (typography rules + interface strings) for `lang`.

    The built-in pack for `lang` is used as a base (English if `lang` is
    neither 'fr' nor 'en'). An override file's "rules" replace the base
    rules wholesale, but its "strings" are merged key by key on top of the
    base strings — a partial override file only needs to define the keys
    it wants to change. `language_file`, when given (--language-file,
    spec §19.5 priority 1), is used as that override file instead of the
    conventional `{lang_dir}/{lang}.json` — same merge semantics either way.
    """
    if lang == 'fr':
        base = json.loads(LANG_FR)
    else:
        base = json.loads(LANG_EN)
        if lang != 'en' and not language_file and not (
                lang_dir and (Path(lang_dir) / f'{lang}.json').exists()):
            # The fallback above is deliberate and documented. What was
            # missing is saying so: `--lang de` with no de.json produced a
            # page carrying `lang="de"` over English strings, exit 0, in
            # silence. A pipeline cannot see that; a reader's screen reader
            # can. Not fatal -- a custom pack is a real use, supplied by
            # --language-file or LWP_LANGUAGE_DIR -- but never silent.
            log('warn', f'no language pack for {lang!r}: the page will '
                f'carry lang="{lang}" over the built-in English strings. '
                f'Provide {lang}.json in the language directory, or pass '
                f'--language-file.')

    if language_file:
        lang_file = Path(language_file)
    elif lang_dir is None:
        # No series directory in play (themes-gallery, §11.7): the
        # embedded pack IS the answer, there is nothing to override with.
        return base
    else:
        lang_file = lang_dir / f'{lang}.json'
    if lang_file.exists():
        try:
            override = json.loads(read_text_file(lang_file))
        except (ValueError, RecursionError) as e:
            # ValueError covers json.JSONDecodeError; RecursionError guards
            # a deeply-nested array/object from crashing the parser itself.
            log('error', f'{lang_file}: invalid JSON ({e}).')
            sys.exit(1)
        if not isinstance(override, dict):
            log('error', f'{lang_file}: must be a JSON object.')
            sys.exit(1)
        rules = override.get('rules', base.get('rules', []))
        strings = override.get('strings', {})
        if not isinstance(rules, list):
            log('error', f'{lang_file}: "rules" must be a list.')
            sys.exit(1)
        if not isinstance(strings, dict):
            log('error', f'{lang_file}: "strings" must be an object.')
            sys.exit(1)
        # Every interface string must be a string: a non-string value
        # crashes apply_strings' str.replace with a raw TypeError.
        for key, val in strings.items():
            if not isinstance(val, str):
                log('error', f'{lang_file}: strings["{key}"] must be a string '
                      f'(got {type(val).__name__}).')
                sys.exit(1)
        return {
            'lang': override.get('lang', base.get('lang', lang)),
            'name': override.get('name', base.get('name', lang)),
            'rules': rules,
            'strings': {**base.get('strings', {}), **strings},
        }
    elif language_file:
        log('error', f'--language-file {language_file}: file not found.')
        sys.exit(1)

    return base


_PLACEHOLDER_RE = re.compile(r'\{\{(\w+)\}\}')


def fill_placeholders(template, mapping):
    """Fills {{key}} placeholders from `mapping` in a SINGLE left-to-right
    pass. Because re.sub never re-scans its own replacement text, a value
    that itself contains a {{...}} token (e.g. a literal {{css}} an author
    typed into page_title, or a {{js_nav}} in a fact-box) is emitted
    verbatim rather than being substituted by a later key — the
    order-dependent str.replace chain this replaces let author content
    inject templates into the escaped <title>/<meta> sinks (§18.4). An
    unknown token is left untouched (missing placeholders are ignored,
    §18.4)."""
    return _PLACEHOLDER_RE.sub(lambda m: mapping.get(m.group(1), m.group(0)), template)


def apply_strings(text, strings, html_context=False):
    """Replaces {{str_KEY}} placeholders in `text` with values from `strings`.

    A placeholder enclosed in quotes — `'{{str_KEY}}'` or `"{{str_KEY}}"` — sits
    inside a literal, and the escaping must match the literal's language:

    - in a JS template (`html_context=False`), JSON-style quote/backslash
      escaping, because the surrounding literal is a JS string — the class
      of bug that once killed the whole <script> when a French string held
      `l'index`;
    - in an HTML template (`html_context=True`), entity escaping
      (`&quot;`, `&lt;`…), because `\\"` is not an HTML escape: a quote in a
      locale string would otherwise close the attribute and let the rest
      become real markup (attribute injection).

    Bare (unquoted) placeholders are text content: substituted verbatim in
    JS templates, HTML-escaped in HTML templates so a `<` in a locale
    string can never become markup.
    """
    for key, value in strings.items():
        token = '{{str_' + key + '}}'
        for q in ("'", '"'):
            quoted = q + token + q
            if quoted in text:
                if html_context:
                    escaped = (html_escape(value, quote=True)
                               .replace("'", '&#39;'))
                else:
                    escaped = value.replace('\\', '\\\\').replace(q, '\\' + q)
                text = text.replace(quoted, q + escaped + q)
        if token in text:
            text = text.replace(token, html_escape(value)
                                if html_context else value)
    return text


_SCRIPT_VALIDITY_CACHE = {}


def validate_page_scripts(html):
    """Validate every <script> block in `html` as JavaScript via `node --check`.

    Returns ``(ok, detail)``. A page that fails ships dead JS — fullscreen,
    navigation and the presenter panel would all be inert — so callers must
    treat ``ok is False`` as a hard build failure. ``node`` is optional: when
    absent the check is skipped (and reported as a skip) rather than failing
    the build. Results are cached by script content, so a series whose pages
    share one identical script is checked only once.
    """
    node = shutil.which('node')
    if not node:
        return True, 'node not available; script not validated'
    for attrs, block in re.findall(r'<script([^>]*)>(.*?)</script>', html, re.S):
        if re.search(r'\btype\s*=\s*["\']application/json["\']',
                     attrs, re.I):
            continue
        if not block.strip():
            continue
        sig = hashlib.md5(block.encode('utf-8')).hexdigest()
        cached = _SCRIPT_VALIDITY_CACHE.get(sig)
        if cached is not None:
            if not cached:
                return False, 'previously invalid <script> block (cached)'
            continue
        fd, path = tempfile.mkstemp(suffix='.js')
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as fh:
                fh.write(block)
            try:
                r = subprocess.run([node, '--check', path],
                                   stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE,
                                   universal_newlines=True, timeout=30)
            except subprocess.TimeoutExpired:
                r = None
        finally:
            os.unlink(path)
        if r is None:
            _SCRIPT_VALIDITY_CACHE[sig] = False
            return False, 'node --check timed out after 30s'
        if r.returncode != 0:
            _SCRIPT_VALIDITY_CACHE[sig] = False
            return False, 'invalid <script> block:\n' + (r.stderr or '')[:2000]
        _SCRIPT_VALIDITY_CACHE[sig] = True
    return True, ''


# ============================================================================
# MARKDOWN TO HTML CONVERTER
# ============================================================================

# The call marker md_inline() leaves behind for a `[^label]`, resolved into
# real markup by convert_markdown() (local placement) or by build_article()
# once the whole page is assembled (page placement). It cannot be written
# by an author: md_inline() strips U+0002 from its input first, the same
# way it owns U+0000 for code spans.
_NOTE_CALL_RE = re.compile('\x02(\\w+)\x02')
# [ \t]*, not \s* -- \s matches U+00A0 like str.strip() does, which would
# swallow a non-breaking space right after the ':' instead of preserving
# it as the body's first character (§7.6).
_NOTE_DEF_RE = re.compile(r'^\[\^(\w+)\]:[ \t]*(.*)')


class NoteScope:
    """One numbering locality for notes (ARCHI-NOTES §4).

    A note has a *call* in the running text and a *body* somewhere else.
    This object is what ties them together, and there is exactly one per
    locality: one per card and one for the long-form article under
    `notes_placement: local`, one for the whole page under `page`.

    Two identifiers, deliberately not the same thing. The reader sees a
    POSITION, restarting at 1 in each locality — a card is shareable on
    its own, so a note numbered 7 in a card someone arrived at directly
    would send them looking for six they will never find. The anchor id
    is scoped by `prefix` (`note-s3-1`) because HTML requires ids unique
    to the DOCUMENT: without that, two cards each carrying one note would
    emit two id="note-1" and every return link would land on the wrong
    one.

    The author's label (`[^kwh]`) never reaches the page. It is a key in
    this object and nothing more, which is why it can be anything and why
    numbering is not a rewrite of what the author wrote.
    """

    def __init__(self, prefix, tooltip=False, endnotes=False, deferred=False):
        self.prefix = prefix
        self.tooltip = tooltip
        # A page-wide scope is DEFERRED: its calls are numbered only once
        # every slide and the article have been converted. Two things
        # require it. Numbering must follow the order of the finished page,
        # not the order the converter happened to run in; and a tooltip
        # needs the body, which may be defined in a later card than the one
        # that calls it. A local scope has neither problem -- it opens and
        # closes inside one conversion -- and resolves as it goes.
        self.deferred = deferred
        # doc-endnote vs doc-footnote: the same body is an endnote when it
        # has been collected into a section of its own at the end of the
        # page, and a footnote when it sits at the foot of the unit that
        # called it. Assistive technology is told which one it is.
        self.endnotes = endnotes
        self.bodies = {}     # label -> body HTML, as md_inline() left it
        self.body_typography = {}  # label -> (engine, disabled rules)
        self.numbers = {}    # label -> displayed number
        self.order = []      # labels, in numbering order
        self.calls = {}      # label -> how many calls have been resolved
        # Definitions the converter had to pass through verbatim because
        # they sat inside a raw HTML block. They are not notes and never
        # become any -- they ship as literal `[^1]: text`. Recorded here so
        # `audit` can name them instead of an author finding them on the
        # published page (ARCHI-NOTES §4).
        self.swallowed = []

    def define(self, label, body_html, typography=None):
        """Records a body. The first definition of a label wins; a second
        one is an editorial slip, not a build error — `audit` names it."""
        if label not in self.bodies:
            self.bodies[label] = body_html
            if typography is not None:
                self.body_typography[label] = typography

    def number(self, label):
        """The displayed number for a label, assigned on first sight."""
        if label not in self.numbers:
            self.numbers[label] = len(self.order) + 1
            self.order.append(label)
        return self.numbers[label]

    def _call_markup(self, label):
        num = self.number(label)
        self.calls[label] = self.calls.get(label, 0) + 1
        nth = self.calls[label]
        # One label called twice yields ONE body with two return links, so
        # each call needs its own id for its own link to come back to.
        ref_id = f'noteref-{self.prefix}-{num}' + (f'-{nth}' if nth > 1 else '')
        title = ''
        if self.tooltip and label in self.bodies:
            plain = strip_ws(re.sub(r'<[^<>]+>', ' ', self.bodies[label]))
            if plain:
                title = f' title="{html_escape(plain)}"'
        if label not in self.bodies:
            # A call whose body is nowhere: the marker stays visible and
            # keeps its number (dropping it would renumber everything the
            # author already proofread), but it is not a link to a place
            # that does not exist. `audit` names it.
            return f'<sup class="note-call"><span id="{ref_id}">{num}</span></sup>'
        return (f'<sup class="note-call"><a id="{ref_id}" '
                f'href="#note-{self.prefix}-{num}" role="doc-noteref"'
                f'{title}>{num}</a></sup>')

    def resolve(self, html):
        """Turns every call marker in `html` into its markup, numbering in
        document order. Called once per locality, over text that is final
        apart from typography."""
        return _NOTE_CALL_RE.sub(lambda m: self._call_markup(m.group(1)), html)

    def apply_typography(self, typo_engine, disabled=None):
        """Runs the typography engine over every body, once, before any of
        them is read. A tooltip is a plain-text attribute the engine will
        never see again — this is the only moment the two renderings of one
        body can be made to say the same thing."""
        typed = {}
        for label, body in self.bodies.items():
            engine, rules = self.body_typography.get(
                label, (typo_engine, disabled))
            typed[label] = apply_typo(engine, body, rules)
        self.bodies = typed

    def orphan_calls(self):
        return [lb for lb in self.order if lb not in self.bodies]

    def unreferenced_bodies(self):
        # Keyed on `calls`, not on `numbers`: render_bodies() numbers the
        # unreferenced ones so they can still be shown, which would erase
        # the very signal this reports. `calls` only ever grows in
        # _call_markup(), so it is exactly "labels a marker pointed at".
        return [lb for lb in self.bodies if not self.calls.get(lb)]

    def render_bodies(self, strings):
        """The bodies block, or '' when there is nothing to render.

        Bodies never called are still rendered, numbered after the rest and
        without a return link: there is nothing to return to. Dropping them
        would lose text the author wrote over an editorial slip that `audit`
        already reports — a slip is not a licence to delete."""
        for label in self.unreferenced_bodies():
            self.number(label)
        if not self.order:
            return ''
        back_label = strings.get('note_back', 'Back to the text')
        role = 'doc-endnote' if self.endnotes else 'doc-footnote'
        items = []
        for label in self.order:
            num = self.numbers[label]
            body = self.bodies.get(label)
            if body is None:
                continue
            backs = []
            for nth in range(1, self.calls.get(label, 0) + 1):
                ref_id = f'noteref-{self.prefix}-{num}' + (f'-{nth}' if nth > 1 else '')
                mark = '↩' + (f'<sup>{nth}</sup>' if self.calls[label] > 1 else '')
                backs.append(f'<a class="note-back" href="#{ref_id}" '
                             f'role="doc-backlink" aria-label="{html_escape(back_label)}" '
                             f'data-lwp-i18n-aria-label="note_back">'
                             f'{mark}</a>')
            # No literal space around the body: `.note-num` and
            # `.note-back` carry their own margins in the skeleton, and a
            # space here would sit in FRONT of a body an author began
            # deliberately with a non-breaking space (§7.6).
            items.append(
                f'    <li id="note-{self.prefix}-{num}" role="{role}">'
                f'<span class="note-num">{num}</span>{body}'
                + ''.join(backs) + '</li>')
        if not items:
            return ''
        return '  <ol class="note-body">\n' + '\n'.join(items) + '\n  </ol>'


# The same split the typography engine uses, and deliberately the same:
# two mechanisms that disagree about where a tag begins would protect
# different halves of the same document. See TypoEngine.apply for why the
# pattern demands a tag name after `<` rather than matching `<[^>]+>` --
# a stray "< 5 ... > 10" in prose would otherwise be read as one giant
# tag spanning everything between them.
_TAG_SPLIT_RE = re.compile(r'(</?[a-zA-Z][^<>]*>)')


def escape_amps(text):
    """Escapes `&` OUTSIDE a tag, and leaves what is inside one verbatim.

    One rule for both grammars (§6.2). They used to have two, and both
    were wrong at one end:

      - a structural field escaped nothing, so `Marks & Spencer` reached
        the page as a bare `&`, and `&sect;` rendered as a section sign.
        The consequence that is not theoretical: `source:
        https://x.test/rechercher?q=marks&copy=1&reg=2` reached the reader
        as `…?q=marks©=1®=2`, because `&copy` and `&reg` without a
        semicolon are in HTML5's legacy character-reference list. Nobody
        made a mistake typing that.
      - the body escaped EVERY `&`, including inside the author's own raw
        HTML, so a hand-written `<a href="?a=1&amp;b=2">` became
        `&amp;amp;` and the link died.

    Outside a tag, an `&` is a character an author typed and gets
    escaped -- which also neutralises a hand-written entity, the position
    §6.2 already states: write the Unicode character, the pipeline is
    UTF-8. Inside a tag it is the author's own HTML, which this tool does
    not touch (§13.8).

    The one thing to know rather than discover: a bare `&` inside a raw
    tag is no longer corrected to `&amp;`. That is invalid HTML the author
    wrote, and repairing it would be exactly the interference §13.8 says
    this tool does not do."""
    parts = _TAG_SPLIT_RE.split(text)
    for i in range(0, len(parts), 2):   # even indices are outside a tag
        parts[i] = parts[i].replace('&', '&amp;')
    return ''.join(parts)


def md_inline(text, absorb_punct=False, inline_images=False, sources_dir=None):
    """Converts inline Markdown formatting to HTML."""
    # This function owns two control characters as internal placeholders
    # (U+0000 for code spans below, U+0002 for note calls). Neither is
    # meaningful in a Markdown source, and letting one through would let a
    # source forge a placeholder — so they are removed on the way in,
    # before anything else can look at the text.
    text = text.replace('\x00', '').replace('\x02', '')
    # Inline code spans (§6.3) come first, before any other substitution
    # below, for two reasons: their content must never be reinterpreted
    # as further Markdown (`` `**not bold**` `` stays literal), and —
    # unlike the rest of this function, which never touches < or > so
    # hand-written raw HTML can pass through (§6.2) — code content IS
    # HTML-escaped, since it's meant to be shown exactly as written even
    # if it looks like a tag. Matched spans are pulled out into \x00N\x00
    # placeholders and restored at the very end, once nothing else in
    # this function can touch them. `\`` (escaped backtick) never opens
    # or closes a span; a stray one left over after matching is just a
    # literal backtick, restored in the final cleanup pass.
    code_spans = []

    def _code_span(m):
        content = html_escape(m.group(1), quote=False)
        code_spans.append(f'<code>{content}</code>')
        return f'\x00{len(code_spans) - 1}\x00'

    text = re.sub(r'(?<!\\)`([^`]+?)(?<!\\)`', _code_span, text)

    # Escape ampersands before inserting our own tags -- outside the
    # author's own raw HTML, which is the whole of escape_amps's rule.
    text = escape_amps(text)
    # Inline images: `![alt](src)` anywhere in a line. Unlike links —
    # restricted to http(s) — the src may be a relative path (images
    # live in sources/img/, copied to public/img/ at build). The tag
    # goes straight into a placeholder so the bold/italic/link rules
    # below can never rewrite its inside. Standalone image lines never
    # reach this point: convert_markdown() turns them into <figure>
    # blocks (with optional caption) first.
    def _inline_img(m):
        alt = m.group(1).replace('"', '&quot;')
        src = m.group(2).replace('"', '&quot;')
        # --inline-images: replace the path with a base64 data URI so the
        # page is fully self-contained. If the file cannot be read, the
        # original src stays — a broken link is better than a silent
        # missing image (nothing inlined as nothing would hide the error).
        if inline_images and sources_dir is not None:
            encoded = _encode_inline_image(src, sources_dir)
            if encoded is not None:
                src = encoded
        # The optional Markdown title becomes a title="" attribute (a
        # tooltip), never a <figcaption>: a caption is block-level and
        # this image sits inside a sentence (§6.1). Deliberately NOT run
        # through md_inline() or the typography engine — both emit tags
        # and non-breaking spaces, which have no business inside an
        # attribute value. Escaping " is what makes it safe there; & is
        # already escaped globally further up.
        title = m.group(3)
        title_attr = ' title="{}"'.format(title.replace('"', '&quot;')) if title else ''
        code_spans.append(f'<img src="{src}" alt="{alt}"{title_attr}>')
        return f'\x00{len(code_spans) - 1}\x00'

    # The optional title group mirrors _FIGURE_LINE_RE's. Without it,
    # `![alt](src "Titre")` mid-paragraph matched NOTHING — the src class
    # stops at the first space — so the raw Markdown survived into the
    # page, and the typography engine then read the "!" of "![alt]" as
    # high punctuation and put a non-breaking space in front of it.
    # Bounded quantifiers only: no ReDoS window.
    # `(` and `[` are excluded from both classes, not for syntax but for
    # cost: without them a run of `![a](x` rescans to end-of-paragraph from
    # every opener -- measured 16s on 60kB, 4x per doubling.
    text = re.sub(r'!\[([^\]\[]*)\]\(([^)\s"\[(]+)(?:\s+"([^"]*)")?\)',
                  _inline_img, text)
    # Absorb the simple punctuation that immediately follows a **bold**
    # run into the mark: `**2000**,` becomes `**2000,**` before the bold
    # regex below parses it, so the comma is highlighted too. Without
    # this the side padding of the mark opens a visible gap before the
    # comma. `absorb_punct` is set only by the fact-box path
    # (convert_markdown called from render_slide), and only when the
    # theme carries a ground (fact.strong.bg is not transparent) — a
    # highlighter with no ink to highlight has nothing to absorb into.
    # One punctuation char only: `**a**, b` absorbs the comma, not the
    # space or the b.
    if absorb_punct:
        text = re.sub(r'\*\*(.+?)\*\*([,.!?;:])', r'**\1\2**', text)
    # Bold before italic
    text = re.sub(r'\*\*(.+?)\*\*', r'<strong>\1</strong>', text)
    text = re.sub(r'(?<!\*)\*([^*]+?)\*(?!\*)', r'<em>\1</em>', text)
    # Markdown links. The captured URL goes into an href="..." attribute,
    # so it must be attribute-escaped — exactly like _inline_img does for
    # its src above. Without this, a `"` in the URL closes the attribute
    # early and any following text is parsed as further tag attributes or
    # markup: `[x](https://a" onmouseover="location=name)` would inject a
    # live event handler, and `>` would let the URL close the <a> tag and
    # open an arbitrary element (§6.3's http(s)-only restriction is not by
    # itself a containment guarantee). `&` is already globally escaped
    # above, so only " < > remain to handle here (matching _inline_img).
    def _md_link(m):
        label = m.group(1)
        href = m.group(2).replace('"', '&quot;').replace('<', '&lt;').replace('>', '&gt;')
        # The opening tag goes into a placeholder so nothing that runs
        # after this — the instance tags — can rewrite the inside of the
        # href attribute (the audit showed a tag in a URL truncating it).
        # The label stays inline: tags inside link TEXT keep working, and
        # the bare </a> is inert to every later substitution.
        code_spans.append(f'<a href="{href}" target="_blank" rel="noopener">')
        return f'\x00{len(code_spans) - 1}\x00{label}</a>'

    # Label class excludes '[' as well as ']': a run of "["×N would
    # otherwise make each '[' rescan the whole line for a closing ']('
    # (O(n²)). A real link label doesn't contain a bare '[', so this
    # doesn't change normal parsing.
    # `[` excluded from the URL class for the same reason as the image
    # pattern above: quadratic on a run of unterminated openers.
    text = re.sub(r'\[([^\]\[]+)\]\((https?://[^\)\[]+)\)', _md_link, text)
    # Note calls. Only a MARKER is emitted here: the number a call gets
    # depends on every other call in its locality, which this function
    # cannot see -- it is handed one line at a time. convert_markdown()
    # (local placement) or build_article() (page placement) owns the
    # locality and turns each marker into its real markup. Placed after
    # the code-span extraction above, so `[^1]` inside backticks stays
    # literal, as every other construct does.
    text = re.sub(r'\[\^(\w+)\]', lambda m: f'\x02{m.group(1)}\x02', text)
    # A backslash-escaped backtick that never became part of a span
    # (either unpaired, or both delimiters were escaped) is just a
    # literal backtick. Likewise \> (only meaningful at the very start of
    # a line, where it stops the block-level loop above from opening a
    # blockquote — see §6.3) renders as a plain >, wherever it appears.
    text = text.replace('\\`', '`')
    text = text.replace('\\>', '>')

    # Instance tags — the fifth layer of the cascade, instance-scoped
    # (specifications.md §9, ARCHI §7). Same types as everywhere else: a
    # colour literal is a valid ARGB, a font stack ends on a generic, and a
    # bare word is looked up in its type's namespace and emitted as the
    # var() the :root is guaranteed to define. Processed after every other
    # substitution so bold/italic inside a tagged span survive; an opener
    # without its closer on the same line stays literal text — visible in
    # the render, where the author is already looking. Applied last, this
    # runs before placeholders are restored, so code spans stay untouchable.
    text = _apply_instance_tags(text)

    for idx, html in enumerate(code_spans):
        text = text.replace(f'\x00{idx}\x00', html)

    return text


def _instance_style(name, value):
    """The CSS declaration for one instance tag, its value type-checked.
    Raises PropertyError with the tag spelled out — a bad value is a build
    error naming its article, never a silent no-op."""
    where = f'inline tag {{{name}:{value}}}' if value else f'inline tag {{{name}}}'
    if name == 'color':
        if PROP_COLOR.is_literal(value):
            return f'color:{PROP_COLOR.check(where, value)}'
        if f'color.{value}' in PROPERTY_REGISTRY:
            return f'color:var(--color-{value})'
        raise PropertyError(
            f'{where}: neither a colour literal nor a color.* name')
    if name == 'font':
        if PROP_FONT.is_literal(value):
            checked = PROP_FONT.check(where, value).replace('"', '&quot;')
            return f'font-family:{checked}'
        if f'font.{value}' in PROPERTY_REGISTRY:
            return f'font-family:var(--font-{value})'
        raise PropertyError(
            f'{where}: neither a font stack (ending on a generic) nor a '
            f'font.* name')
    return {
        'sc': 'font-variant:small-caps',
        'u': 'text-decoration:underline',
        'strike': 'text-decoration:line-through',
        'mono': 'font-family:var(--font-mono)',
    }[name]


# Content classes exclude braces: an inner tag makes the outer NOT match
# until the inner has been rewritten to a <span> (brace-free), which is
# what makes resolution innermost-first — and what bounds backtracking,
# an unclosed opener failing at the next brace instead of rescanning to
# the end of the text (measured quadratic before: 29 s on 40k openers).
_INSTANCE_TAG_RE = re.compile(
    r'\{(color|font):([^{}]+)\}([^{}]*)\{/\1\}|\{(sc|u|strike|mono)\}([^{}]*)\{/\4\}')
_INSTANCE_TAG_MAX_DEPTH = 32

# Alignment is a property of a BLOCK container, so it gets block syntax:
# the opener and the closer each alone on their line, wrapping whole
# paragraphs. An inline <span> -- what every other instance tag produces --
# cannot carry text-align at all, so the asymmetry is CSS's, not a choice.
# A paragraph cannot be split mid-flow either, which is the other half of
# the reason this is not an inline tag.
# `[^{}]*`, not `[a-z]+`: the TYPE decides whether a value is allowed,
# never the regex. Matching only lowercase made `{align:CENTER}` fail to
# match at all, so it rendered as literal text instead of naming itself
# as an error -- the opposite of what the inline tags do with a bad value.
_BLOCK_ALIGN_OPEN = re.compile(r'^\{align:([^{}]*)\}$')
_BLOCK_ALIGN_CLOSE = '{/align}'


def _apply_instance_tags(text):
    def _span(m):
        if m.group(1):
            name, value, content = m.group(1), m.group(2).strip(), m.group(3)
        else:
            name, value, content = m.group(4), '', m.group(5)
        return (f'<span style="{_instance_style(name, value)}">'
                f'{content}</span>')
    # Innermost-first, so {color:...}{sc}x{/sc}{/color} nests: each pass
    # rewrites tags whose content holds no other tag, until none is left
    # or the depth cap is hit — beyond it the leftovers stay visible
    # literal text, the same fate as an unclosed opener.
    for _ in range(_INSTANCE_TAG_MAX_DEPTH):
        new = _INSTANCE_TAG_RE.sub(_span, text)
        if new == text:
            break
        text = new
    return text


def parse_table_row(line):
    """Splits a Markdown table row '| a | b | c |' into cells."""
    line = line.strip()
    if line.startswith('|'):
        line = line[1:]
    if line.endswith('|'):
        line = line[:-1]
    return [strip_ws(cell) for cell in line.split('|')]


def is_table_separator(line):
    """True if the line is a table separator."""
    line = line.strip()
    return bool(line) and bool(re.match(r'^\|?[\s\-:|]+\|?$', line)) and '-' in line


# Void HTML elements: never contribute an unclosed "open" to raw-HTML
# depth tracking (no closing tag is expected).
_VOID_HTML_TAGS = frozenset({
    'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link',
    'meta', 'param', 'source', 'track', 'wbr',
})

# The attribute run is [^<>]*? (not [^>]*?): forbidding a nested '<'
# bounds each match attempt to the distance to the next '<', which
# removes the O(n²) backtracking a line of "<a"×N would otherwise cause
# (each '<' rescanned the whole remainder looking for a '>' that never
# came). A valid tag never contains an unescaped '<' in its attribute
# area, so this doesn't change recognition of real markup; it stays lazy
# so the (/?) group still captures a trailing self-closing slash.
_HTML_TAG_RE = re.compile(r'<(/?)([a-zA-Z][a-zA-Z0-9]*)\b[^<>]*?(/?)>')

# A fenced code block delimiter (§6.3): three backticks alone, optionally
# followed immediately (no space) by a language hint on the opening line.
# Whether a given ``` line opens or closes a block is decided by parser
# state (in_code_block), not by this regex — a closing line is always
# just "```" with nothing after it, which this pattern also matches
# (empty language group).
_CODE_FENCE_RE = re.compile(r'^```(\S*)$')

# A standalone image line (§6.1): the whole line is `![alt](src)`, with
# an optional quoted caption after the path. Unlike links — restricted
# to http(s) — the src may be a relative path: images live in
# sources/img/ and are copied to public/img/ at build time.
_FIGURE_LINE_RE = re.compile(r'^!\[([^\]]*)\]\(\s*([^)\s"]+)(?:\s+"([^"]*)")?\s*\)$')

# The same line wrapped in an ordinary Markdown link: the figure becomes
# clickable. Groups are alt, src, caption, href -- the first three in the
# same order as _FIGURE_LINE_RE so one emission path serves both.
#
# Why this is a widened rule and not a new field. "Alone on its line" is
# already what separates a figure from an image inside a sentence, so
# "alone on its line, possibly wrapped in a link" extends a rule the
# format already has rather than introducing a mechanism. The long-form
# body is plain Markdown -- there is no field layer in it -- and Markdown
# already expresses "an image that is a link", so a property would have
# been a second syntax for something the first one says.
#
# Without this, such a line fell through to md_inline() and produced
# <p><a><img title="..."></a></p>: no <figure>, no <figcaption>, the
# caption silently demoted to a tooltip, and -- measured -- the typography
# engine skipping it, since it does not touch attribute values. A writer
# saw a tooltip appear and had no reason to suspect the figure was gone.
#
# http(s) only, matching the inline link rule: the href reaches an
# attribute, and §6.3 restricts link targets. Bounded classes as
# everywhere else here, `[` excluded from the URL for the same quadratic
# reason documented on the inline patterns.
_LINKED_FIGURE_LINE_RE = re.compile(
    r'^\[!\[([^\]]*)\]\(\s*([^)\s"]+)(?:\s+"([^"]*)")?\s*\)\]\((https?://[^)\[\s]+)\)$')


def _html_tag_depth_delta(line):
    """Net change in open-raw-HTML-tag depth contributed by `line`: +1 per
    unclosed opening tag, -1 per closing tag, 0 for void/self-closing
    tags. Used to track a multi-line raw HTML block (e.g. a hand-written
    <a href="..."> wrapping several lines of content, per spec §6.2)
    through the line-by-line Markdown converter."""
    delta = 0
    for m in _HTML_TAG_RE.finditer(line):
        closing, tag, self_closing = m.group(1), m.group(2).lower(), m.group(3)
        if closing:
            delta -= 1
        elif self_closing or tag in _VOID_HTML_TAGS:
            continue
        else:
            delta += 1
    return delta


# Inline-level HTML tags: a line starting with one of these AND fully
# opened+closed within that same line is still ordinary paragraph text
# (spec §6.2 allows inline HTML anywhere in free text, including at the
# start of a sentence, e.g. "<strong>Word</strong> opens the sentence.").
# An inline tag left unclosed on its opening line — e.g. a hand-written
# <a href="..." class="card"> wrapping several lines of block content —
# still starts raw HTML passthrough, same as any other tag.
_INLINE_HTML_TAGS = frozenset({
    'a', 'abbr', 'b', 'bdi', 'bdo', 'cite', 'code', 'data', 'dfn', 'em',
    'i', 'kbd', 'mark', 'q', 's', 'samp', 'small', 'span', 'strong',
    'sub', 'sup', 'time', 'u', 'var', 'wbr',
})


def _is_raw_html_line(line):
    """True if `line` should be treated as the start of raw HTML
    passthrough rather than ordinary paragraph text."""
    m = re.match(r'^\s*</?([a-zA-Z][a-zA-Z0-9]*)', line)
    if not m:
        return False
    tag = m.group(1).lower()
    if tag in _INLINE_HTML_TAGS and _html_tag_depth_delta(line) == 0:
        return False
    return True


def _is_paragraph_continuation(line, lines, idx, n):
    """True if `line` continues the paragraph in progress rather than
    starting a new block element (heading, list, table, raw HTML,
    footnote definition, blank/thematic break). Per spec §6.1, a bare
    line break does not end a Markdown paragraph — only a blank line does."""
    if line.strip() == '' or line.strip() == '---':
        return False
    if line.startswith('#'):
        return False
    if _is_raw_html_line(line):
        return False
    if re.match(r'^\d+\.\s+', line):
        return False
    if re.match(r'^-\s+', line):
        return False
    if re.match(r'^\[\^([\w]+)\]:\s*', line):
        return False
    if line.strip().startswith('|') and idx + 1 < n and is_table_separator(lines[idx + 1]):
        return False
    if line.startswith('>'):
        return False
    if _CODE_FENCE_RE.match(line):
        return False
    if _FIGURE_LINE_RE.match(line) or _LINKED_FIGURE_LINE_RE.match(line):
        return False
    # A block alignment tag alone on its line opens or closes a container:
    # swallowed as continuation it would land inside the paragraph it was
    # meant to wrap, and the closer would never fire.
    if _BLOCK_ALIGN_OPEN.match(line.strip()) or line.strip() == _BLOCK_ALIGN_CLOSE:
        return False
    return True


def convert_markdown(md_text, typo_engine=None, disabled=None,
                     notes=None, strings=None, absorb_punct=False,
                     inline_images=False, sources_dir=None):
    """Converts the Markdown body to HTML.

    `notes` is the NoteScope this text's notes belong to. A deferred scope
    (the page-wide one of `notes_placement: page`) only collects here: its
    calls stay markers and its bodies are rendered by whoever owns the
    page. With no scope at all, the text is its own locality — which is
    what an ad-hoc conversion wants.

    `absorb_punct` passes through to md_inline(inline_images=inline_images, sources_dir=sources_dir): when True, the simple
    punctuation that follows a **bold** run is absorbed into the mark so
    it is highlighted too (fact.strong.absorb-punct). Set only by the
    fact-box path.

    `inline_images` passes through to md_inline(): when True, image src
    paths are replaced with base64 data URIs (--inline-images). The
    `sources_dir` is needed to resolve the `img/...` path."""
    lines = md_text.split('\n')
    out = []
    in_list = None
    raw_html_depth = 0
    in_code_block = False
    align_depth = 0
    i = 0
    n = len(lines)
    # No scope given: this text is its own locality, and its bodies land at
    # its own foot. The prefix has to be unique in the document for the
    # anchors to work, so a caller rendering more than one such text must
    # pass its own scopes -- which build_article() does.
    scope = notes if notes is not None else NoteScope('n')

    def close_list():
        nonlocal in_list
        if in_list:
            out.append(f'  </{in_list}>')
            in_list = None

    while i < n:
        raw = lines[i]
        line = rstrip_ws(raw)

        # Already inside a multi-line raw HTML block (opened by an
        # earlier line whose tag wasn't closed yet): every line belongs
        # to it verbatim until the depth count returns to 0.
        if raw_html_depth > 0:
            m_swallowed = _NOTE_DEF_RE.match(line.lstrip())
            if m_swallowed:
                scope.swallowed.append(m_swallowed.group(1))
            out.append(rstrip_ws(raw))
            raw_html_depth = max(0, raw_html_depth + _html_tag_depth_delta(line))
            i += 1
            continue

        # Already inside a fenced code block (§6.3): every line is
        # reproduced verbatim (HTML-escaped, never interpreted as
        # Markdown — not even a blank line or "---") until the closing
        # ``` is found. An opening emitted here with no matching close by
        # end of file is caught as an unclosed <pre>/<code> tag by the
        # generic HTML balance check before the page is written (§13) —
        # no special end-of-file handling needed here.
        if in_code_block:
            if line == '```':
                out.append('  </code></pre>')
                in_code_block = False
            else:
                out.append(html_escape(raw, quote=False))
            i += 1
            continue

        # Block alignment, the instance layer of the align axes (§9.6).
        # An unknown value is a build error naming the tag, never a silent
        # no-op -- the same contract as the inline tags and settings.conf.
        stripped = line.strip()
        m = _BLOCK_ALIGN_OPEN.match(stripped)
        if m:
            close_list()
            value = m.group(1).strip()
            PROP_ALIGN.check(f'block tag {{align:{m.group(1)}}}', value)
            out.append(f'  <div class="align-{value}">')
            align_depth += 1
            i += 1
            continue
        if stripped == _BLOCK_ALIGN_CLOSE and align_depth:
            close_list()
            out.append('  </div>')
            align_depth -= 1
            i += 1
            continue

        if line.strip() == '' or line.strip() == '---':
            i += 1
            continue

        if line.startswith('# ') and not line.startswith('## '):
            out.append(f'  <h1>{md_inline(strip_ws(line[2:]), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</h1>')
            i += 1
            continue
        if line.startswith('## ') and not line.startswith('### '):
            close_list()
            out.append(f'  <h2>{md_inline(strip_ws(line[3:]), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</h2>')
            i += 1
            continue
        if line.startswith('### ') and not line.startswith('#### '):
            close_list()
            out.append(f'  <h3>{md_inline(strip_ws(line[4:]), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</h3>')
            i += 1
            continue
        if line.startswith('#### '):
            close_list()
            out.append(f'  <p class="h4">{md_inline(strip_ws(line[5:]), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</p>')
            i += 1
            continue
        if line.startswith('##### ') or line.startswith('###### '):
            close_list()
            level = 5 if line.startswith('##### ') else 6
            out.append(f'  <p>{md_inline(strip_ws(line[level:]), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</p>')
            i += 1
            continue

        # Standalone image (§6.1): the whole line is `![alt](src)`, with
        # an optional quoted caption — rendered as a <figure>, the
        # caption as a small centered <figcaption> under the image.
        # Mid-paragraph images are md_inline()'s job and have no caption.
        m_fig = _FIGURE_LINE_RE.match(line) or _LINKED_FIGURE_LINE_RE.match(line)
        if m_fig:
            close_list()
            alt = html_escape(m_fig.group(1), quote=True)
            src = html_escape(m_fig.group(2), quote=True)
            caption = m_fig.group(3)
            # --inline-images: same as mid-paragraph images above.
            if inline_images and sources_dir is not None:
                encoded = _encode_inline_image(src, sources_dir)
                if encoded is not None:
                    src = encoded
            img = f'<img src="{src}" alt="{alt}">'
            # A linked figure wraps the IMAGE only, never the caption. Two
            # reasons, and the second is the one that decides it: you click
            # the picture and the caption is text about it -- and wrapping
            # just the <img> leaves the link's accessible name to be the
            # alt text alone. Put the caption inside and a screen reader
            # announces the whole sentence as the link's name.
            if len(m_fig.groups()) == 4:
                href = html_escape(m_fig.group(4), quote=True)
                img = f'<a href="{href}" target="_blank" rel="noopener">{img}</a>'
            if caption:
                out.append(f'  <figure class="figure">{img}<figcaption class="figure-caption">{md_inline(caption, absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</figcaption></figure>')
            else:
                out.append(f'  <figure class="figure">{img}</figure>')
            i += 1
            continue

        # Fenced code block, opening (§6.3). An optional language hint
        # right after the backticks, no space, becomes an informational
        # class="language-xxx" — no syntax highlighting is applied.
        m_fence = _CODE_FENCE_RE.match(line)
        if m_fence:
            close_list()
            lang = m_fence.group(1)
            lang_class = f' class="language-{html_escape(lang, quote=True)}"' if lang else ''
            out.append(f'  <pre><code{lang_class}>')
            in_code_block = True
            i += 1
            continue

        # Blockquote (§6.3): consecutive >-prefixed lines merge into one
        # paragraph, the same way ordinary paragraph lines do (§6.1) — a
        # single quote of a single paragraph, not multi-paragraph or
        # nested (§15).
        if line.startswith('>'):
            close_list()
            quote_lines = [strip_ws(line[1:])]
            i += 1
            while i < n and rstrip_ws(lines[i]).startswith('>'):
                quote_lines.append(strip_ws(rstrip_ws(lines[i])[1:]))
                i += 1
            out.append(f'  <blockquote><p>{md_inline(" ".join(quote_lines), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</p></blockquote>')
            continue

        # Table
        if line.strip().startswith('|') and i + 1 < n and is_table_separator(lines[i + 1]):
            close_list()
            header_cells = parse_table_row(line)
            out.append('  <table class="comparison-table">')
            out.append('    <thead>')
            out.append('      <tr>')
            for cell in header_cells:
                out.append(f'        <th>{md_inline(cell, absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</th>')
            out.append('      </tr>')
            out.append('    </thead>')
            out.append('    <tbody>')
            i += 2
            while i < n and lines[i].strip().startswith('|'):
                row_cells = parse_table_row(lines[i])
                out.append('      <tr>')
                for cell in row_cells:
                    out.append(f'        <td>{md_inline(cell, absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</td>')
                out.append('      </tr>')
                i += 1
            out.append('    </tbody>')
            out.append('  </table>')
            continue

        # Raw HTML (line starting with a block-level tag, or an inline
        # tag left unclosed -- the opening of a multi-line block)
        if _is_raw_html_line(line):
            close_list()
            out.append(rstrip_ws(raw))
            raw_html_depth = max(0, _html_tag_depth_delta(line))
            i += 1
            continue

        # Lists. An item runs until a blank line or the start of another
        # block, exactly like a paragraph -- the rule is _is_paragraph_
        # continuation, shared rather than restated, because an item's text
        # IS a paragraph and two copies of that judgement would drift.
        #
        # Reading one line per item is what this used to do, and it did not
        # merely lose the wrapping. The continuation became a paragraph of
        # its own, emitted AFTER the list was closed, so a five-item list
        # whose items wrapped came out as five one-item lists with
        # paragraphs between them: the reading order broken, the structure
        # a screen reader announces false, and any emphasis spanning the
        # two lines shipped as literal `**` to the reader. Found on a real
        # 28-article corpus, where build, verify and audit were all green.
        m_ol = re.match(r'^\d+\.\s+(.*)', line)
        m_ul = None if m_ol else re.match(r'^-\s+(.*)', line)
        if m_ol or m_ul:
            kind = 'ol' if m_ol else 'ul'
            if in_list != kind:
                close_list()
                out.append(f'  <{kind}>')
                in_list = kind
            item_lines = [(m_ol or m_ul).group(1)]
            i += 1
            while i < n and _is_paragraph_continuation(rstrip_ws(lines[i]),
                                                       lines, i, n):
                item_lines.append(rstrip_ws(lines[i]).strip())
                i += 1
            out.append(f'    <li>{md_inline(" ".join(item_lines), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</li>')
            continue

        # A note body, wherever the author chose to write it.
        m_ref = _NOTE_DEF_RE.match(line)
        if m_ref:
            close_list()
            label, txt = m_ref.group(1), m_ref.group(2)
            # Nothing is emitted here. A body does not render where it was
            # written; it renders where its placement says (ARCHI-NOTES §2),
            # which is at the foot of this locality or in the page's notes
            # section. The scope is what carries it there.
            scope.define(
                label,
                md_inline(txt, absorb_punct=absorb_punct,
                          inline_images=inline_images,
                          sources_dir=sources_dir),
                (typo_engine, disabled))
            i += 1
            continue

        # Regular paragraph: merge consecutive lines with no blank line
        # between them into a single paragraph (spec §6.1) — a lone line
        # break is not a paragraph break in Markdown.
        close_list()
        para_lines = [line]
        i += 1
        while i < n and _is_paragraph_continuation(rstrip_ws(lines[i]), lines, i, n):
            para_lines.append(rstrip_ws(lines[i]))
            i += 1
        out.append(f'  <p>{md_inline(" ".join(para_lines), absorb_punct=absorb_punct, inline_images=inline_images, sources_dir=sources_dir)}</p>')

    close_list()
    # An unclosed BLOCK tag is not the same defect as an unclosed inline one.
    # The inline case stays literal text and the HTML remains valid; this one
    # leaves a <div> open. The §13 balance check does catch it, but it reports
    # a mismatched <div> to an author who wrote no raw HTML at all -- so name
    # the real cause here instead.
    if align_depth:
        raise PropertyError(
            f'{align_depth} unclosed {{align:...}} block(s): every opener '
            f'needs a {{/align}} alone on its own line')
    html = '\n'.join(out)
    # A local scope closes here: its calls get their numbers and its bodies
    # follow the text they belong to. A deferred one has only been filling
    # up -- the page closes it, once every card and the article have been
    # converted. The call markers are resolved BEFORE apply_typo() so no
    # typography rule can ever see one, and the bodies are typeset before
    # that so the block and the tooltips agree.
    bodies = ''
    if not scope.deferred:
        scope.apply_typography(typo_engine, disabled)
        html = scope.resolve(html)
    html = apply_typo(typo_engine, html, disabled)
    if not scope.deferred:
        bodies = scope.render_bodies(strings or {})
    if bodies:
        html += '\n  <div class="notes-local">\n' + bodies + '\n  </div>'

    return html


# ============================================================================
# EXTENDED MARKDOWN PARSER
# ============================================================================

# Every field a slide header recognizes, and the only place that list is
# written. Named rather than inlined in the regex below so the naming
# convention (§20.0 — a slide field is kebab-case, an article field is
# snake_case) has something to be checked against: the test suite reads
# this tuple and the article-level `meta.get(...)` keys, and holds each to
# the shape its level requires. `slide_title` is absent on purpose — it is
# written `#`/`##`, never as a `key:` line.
SLIDE_FIELD_NAMES = (
    'slug', 'kicker', 'tags', 'summary', 'fact-label', 'fact-variant',
    'source', 'highlight', 'highlight-caption', 'comment', 'note',
)


class SlideType:
    """One slide type: what it is called, how it carries its own title,
    which fields it accepts, and what free text becomes on it."""

    __slots__ = ('name', 'title_marker', 'fields', 'free_text', 'summary')

    def __init__(self, name, title_marker, fields, free_text, summary):
        self.name = name
        self.title_marker = title_marker  # '#', '##', or None (no title)
        self.fields = fields              # accepted `key:` lines
        self.free_text = free_text        # what text below the fields becomes
        self.summary = summary            # one line, for --help and callers


# The four slide types, and the only place that list is written. Both the
# validator and `--help` read it, so a type cannot be recognized by one and
# missing from the other — and neither can drift from a description written
# somewhere else. `comment` is on every type on purpose: it is parsed
# everywhere and rendered nowhere (GLOSSARY.md).
SLIDE_TYPES = (
    SlideType(
        'cover', '#', ('slug', 'kicker', 'tags', 'summary', 'comment', 'note'), None,
        "The article's opening slide: a title, an optional kicker above it, "
        'and the one sentence that says what the article is about.'),
    SlideType(
        'standard', '##', SLIDE_FIELD_NAMES, 'fact-box',
        'The ordinary slide, and the only one that takes free text: '
        'anything written below the fields becomes its fact-box.'),
    SlideType(
        'series-nav', None, ('slug', 'tags', 'comment'), None,
        'The list of the other articles in the series, generated from '
        'series.json — you place the marker, the build writes the list. '
        'At most one per article.'),
    SlideType(
        'full-article', None, ('slug', 'article', 'tags', 'comment'), None,
        'Pulls in a long-form .md file named by its `article:` field, '
        'which is required. A page may carry several, each with its own '
        'file (§22.8).'),
)

SLIDE_TYPES_BY_NAME = {t.name: t for t in SLIDE_TYPES}

# Which Slide attribute carries which slide-level field. `article` is here
# although it is not in SLIDE_FIELD_NAMES: it is parsed by the full-article
# slide's own branch rather than the shared field regex, and a reader
# asking where it is set does not care which branch read it.
_SLIDE_FIELD_ATTRS = {name: name.replace('-', '_') for name in SLIDE_FIELD_NAMES}
_SLIDE_FIELD_ATTRS['article'] = 'article_file'



# ============================================================================
# SLIDE IDENTITY
# ============================================================================
#
# What a card is called in a URL — and what a link someone shared, or a QR
# code someone PRINTED, still points at after the article is edited.
#
# ONE RULE: the author declares it, with `slug:`. A card without one is a
# build error naming the card and the command that fills them in.
#
# It used to be derived — from the heading, from a long-form file's name,
# from the card's rank — through a normalisation (NFKC, casefold, a
# combining-mark fold restricted to Latin bases) and a truncated hash.
# That machinery answered a question nobody should have to ask: an
# identity derived from a title moves when the title is edited, which is
# not a defect of the derivation but the whole of what a derivation IS.
# Every mechanism built on top of it — the `sN` alias, the collision
# suffix, the audit finding about identities that are not durable —
# existed to soften a consequence that declaring the slug removes
# outright. So it is gone, and 184 lines of engine with it.
#
# What that buys, beyond the deletion: an identity now says what it is at
# a glance. Reading a source, `slug: le-sucre` is a decision someone
# made; a hash of a heading looked exactly like the heading's business,
# and moved without anyone touching it.

RESERVED_SLIDE_IDS = frozenset(
    set(re.findall(r'id="([^"]+)"', TEMPLATE_PAGE))
    # `notes` is minted by the renderer under `notes_placement: page`, not
    # written in the skeleton, so deriving from the template alone misses
    # it — measured: `slug: notes` sailed through while `slug: navPrev`
    # was caught, and the two are the same mistake. A derivation that
    # covers one source and not the other is worse than a literal list,
    # because it looks complete.
    #
    # Note BODIES (`note-<locality>-<n>`) are not here on purpose. Their
    # locality is itself derived from the card's identity, so they move
    # with it and cannot be claimed ahead of time; the collision that
    # matters there is between two localities, and it is settled where
    # they are minted.
    | {'notes'})


# The alphabet a slug may use. Only a DECLARED value is checked, because
# only a declared value exists: it becomes an id, a URL fragment and the
# tail of a shared QR code, so anything outside this set would arrive
# somewhere other than what was typed.
SLUG_CHARSET_RE = re.compile(r'\A[A-Za-z0-9][A-Za-z0-9._-]*\Z')
SLUG_PREFIX_RE = re.compile(r'\A[A-Za-z0-9][A-Za-z0-9._-]*\Z')

# What `series slug set` writes, and how long. Eight was measured against
# the QR encoder on both base URLs tried: same QR version as six, and it
# buys 4.3 billion values instead of 16.8 million. Hexadecimal rather
# than a wider alphabet so the value reads as a machine's and not as a
# word someone chose — an author who wants a readable anchor writes one.
ASSIGNED_SLUG_LENGTH = 8


def assigned_slug(taken):
    """A fresh slug for a card that has none, unique against `taken`.

    Random, not derived: once the slug is written into the source it is
    the identity, and deriving it from a title would make it LOOK as
    though it still followed that title. It does not, and a value that
    misleads about what it depends on is worse than one that says
    nothing.

    `secrets` rather than `random` for no security reason — it is simply
    the module that does not carry a global seed, so nothing in a test or
    a plugin can make two runs agree by accident."""
    while True:
        candidate = secrets.token_hex(ASSIGNED_SLUG_LENGTH // 2)
        if candidate not in taken:
            taken.add(candidate)
            return candidate


def resolve_slide_slug(slide, ordinal, prefix, taken, where):
    """The id a card is given, or a fatal error naming what to run.

    `taken` is the set of ids already spoken for — the skeleton's own plus
    every card resolved before this one — and it is MUTATED here, because
    the answer for one card depends on the answers for all the ones before
    it and a caller that forgot to record them would mint duplicates in
    silence.

    A collision is an ERROR, not a suffix. Two derived identities could
    collide innocently (two cards with the same heading); two declared
    ones are a typing mistake, and `-2` appended in silence would publish
    an anchor the author never wrote while the card they meant to reach
    keeps the other."""
    explicit = (getattr(slide, 'slug', None) or '').strip()
    if not explicit:
        log('error',
            f'{where}: slide {ordinal} has no `slug:`, and every card needs '
            f'one — it is what a shared link and a printed QR code point '
            f'at. Run `lightwebpres series slug set` to give one to every '
            f'card that has none, or write it yourself: a readable name '
            f'(`slug: le-sucre`) is worth more than a generated one.')
        sys.exit(1)
    if not SLUG_CHARSET_RE.match(explicit):
        raise PropertyError(
            f'slug: {explicit!r} is not usable as an anchor — a slug must '
            f'start with a letter or a digit and may then contain '
            f'letters, digits, "-", "_" and ".". It becomes an id, a URL '
            f'fragment and the tail of a shared QR code, so anything '
            f'else would arrive somewhere different from what was typed.')
    value = f'{prefix}{explicit}' if prefix else explicit
    if value in taken:
        log('error',
            f'{where}: slide {ordinal} takes the id {value!r}, which is '
            f'already used on this page — by another card, or by the page '
            f'skeleton itself. Two things with one id means a reader who '
            f'follows the link lands on whichever the browser picks.')
        sys.exit(1)
    taken.add(value)
    return value


def resolve_page_slide_ids(visible_slides, prefix='', where=''):
    """Every visible card's id, in document order, for one page.

    One function rather than a loop at the call site, because the `taken`
    set has to start from the skeleton's own ids and be carried across the
    whole page: a card resolved with a fresh set would happily mint an id
    another card already holds, and the duplicate is invisible until a
    reader follows a link and lands on the wrong one.

    `excluded` cards are not passed in and take no identity — they produce
    no section, so there is nothing to point at."""
    taken = set(RESERVED_SLIDE_IDS)
    return [resolve_slide_slug(slide, ordinal, prefix, taken, where)
            for ordinal, slide in enumerate(visible_slides, 1)]



def resolve_slug_prefix(meta, series_meta, source_name):
    """`slug_prefix`: the namespace an author puts in front of every id on
    a page, declared and derived alike.

    The same cascade as `author`, `license` and the notes settings —
    series.json first, the article's own meta block over it — because the
    common case is a whole series wanting one, and the exception is one
    article inside it wanting another.

    A wrong value is a build error rather than a silent drop, for the
    reason every typed value in this tool is: an author who mistyped a
    prefix would otherwise publish a page whose anchors are not the ones
    they think they minted, and find out from a broken link."""
    for source, origin in ((meta, source_name), (series_meta, 'series.json')):
        if 'slug_prefix' in source and str(source['slug_prefix']).strip():
            value = str(source['slug_prefix']).strip()
            if not SLUG_PREFIX_RE.match(value):
                log('error', f'{origin}: slug_prefix: {value!r} must start '
                             f'with a letter or a digit and may then contain '
                             f'letters, digits, "-", "_" and ".".')
                sys.exit(1)
            return value
    return ''


class Slide:
    def __init__(self, slide_type='standard'):
        self.slide_type = slide_type  # one of SLIDE_TYPES (validated per article)
        # What this card is called in a URL, when the author names it
        # rather than letting it be derived (see SLIDE IDENTITY above).
        self.slug = None
        self.kicker = None
        self.tags = None
        self.h2 = None
        self.h1 = None
        self.summary = None
        self.fact_label = None
        self.fact_content = None
        self.fact_variant = None  # optional look, defined by the theme/author (§9)
        self.source = None
        self.highlight = None
        self.highlight_caption = None
        self.comment = None  # Review note (GLOSSARY.md) — parsed, never rendered
        self.note = None  # Speaker note — parsed, not rendered; shown only in the presenter panel (key N)
        self.extra_content = None  # series-nav/full-article only: unrecognized lines (fatal)
        self.article_file = None  # For full-article
        self.raw_meta = {}  # Raw metadata


def parse_metadata_block(text):
    """Parses the <!-- lwp:meta --> ... --- block at the top of the file."""
    meta = {}
    lines = strip_ws(text).split('\n')
    for line in lines:
        line = strip_ws(line)
        if line == '---':
            break
        if line.startswith('<!--') or line.endswith('-->'):
            continue
        if ':' in line:
            key, _, value = line.partition(':')
            meta[key.strip()] = strip_ws(value)
    return meta


def parse_markdown_extended(md_text):
    """Parses an extended Markdown file and returns
    (meta, slides, has_meta_block, content_before_meta).

    has_meta_block is False when no <!-- lwp:meta --> block was found at
    all (as opposed to one that parsed to an empty dict) — callers that
    must enforce §22.7 (a file must start with <!-- lwp:meta -->) need to
    tell the two apart, callers that don't (like audit, which never
    blocks) can just ignore it. content_before_meta is whatever non-blank
    text precedes the marker ('' when the file starts with it) — §22.7
    makes that fatal at build time too: it used to be silently discarded,
    which turned a stray first line into invisible data loss.
    """
    # Extract the meta block
    meta = {}
    has_meta_block = False
    content_before_meta = ''
    # Two anchored searches, not one lazy DOTALL span: with `.*?` every
    # `<!-- lwp:meta -->` occurrence rescanned the rest of the file when no
    # terminator followed, and the cost was paid BEFORE the file was rejected
    # (measured: 14s on 230kB, 4x per doubling). Semantics differ only when
    # the first marker has no `---`, which §22.7 already makes fatal.
    marker = re.search(r'<!--\s*lwp:meta\s*-->', md_text)
    terminator = (re.search(r'(?:^|\n)---', md_text[marker.end():])
                  if marker else None)
    if terminator:
        has_meta_block = True
        content_before_meta = md_text[:marker.start()].strip()
        body_start = marker.end()
        meta = parse_metadata_block(
            md_text[body_start:body_start + terminator.start()])
        # Strip the meta block from the text
        md_text = md_text[body_start + terminator.end():]

    # Split into slides on --- (alone on its own line, surrounded by blank lines)
    # Uses a regex that captures the separators
    parts = re.split(r'\n---\n', md_text)

    slides = []
    for part in parts:
        part = strip_ws(part)
        if not part:
            continue

        slide = None

        # Detect the slide type
        slide_type_match = re.search(r'<!--\s*lwp:slide:\s*(\S+)\s*-->', part)
        if slide_type_match:
            slide_type = slide_type_match.group(1)
            slide = Slide(slide_type)
        elif '<!-- lwp:slide -->' in part:
            slide = Slide('standard')
        else:
            # With no marker, this is either orphan content or the first part
            # Ignore it if empty, otherwise treat it as a standard slide
            if part.strip():
                slide = Slide('standard')
            else:
                continue

        # For series-nav and full-article, read the directives. Anything
        # else in these slides is collected as extra_content — fatal at
        # validation (it used to be silently dropped, invisible data
        # loss). `comment:` is recognized on every slide type (GLOSSARY),
        # these two included.
        if slide.slide_type in ('series-nav', 'full-article'):
            extra_lines = []
            ml_field = None
            for line in part.split('\n'):
                raw = line
                stripped = strip_ws(line)
                if not stripped or stripped.startswith('<!-- lwp:slide'):
                    continue
                is_indented = bool(raw) and (raw[0] == ' ' or raw[0] == '\t')
                if ml_field is not None and not is_indented and stripped:
                    ml_field = None
                if ml_field is not None and is_indented:
                    attr = _SLIDE_FIELD_ATTRS[ml_field]
                    cur = getattr(slide, attr) or ''
                    setattr(slide, attr,
                            (cur + '\n' + stripped) if cur else stripped)
                    continue
                comment_match = re.match(r'^comment:[ \t]*(.*)', stripped)
                if comment_match:
                    slide.comment = comment_match.group(1)
                    ml_field = 'comment'
                    continue
                tags_match = re.match(r'^tags:[ \t]*(.*)', stripped)
                if tags_match:
                    slide.tags = tags_match.group(1)
                    continue
                slug_match = re.match(r'^slug:[ \t]*(.*)', stripped)
                if slug_match:
                    slide.slug = slug_match.group(1)
                    continue
                if slide.slide_type == 'full-article':
                    article_match = re.match(r'^article:\s*(.+)$', stripped)
                    if article_match:
                        slide.article_file = article_match.group(1).strip()
                        continue
                extra_lines.append(stripped)
            if extra_lines:
                slide.extra_content = '\n'.join(extra_lines)
            slides.append(slide)
            continue

        # For cover and standard, parse the fields
        lines = part.split('\n')
        content_lines = []
        in_content = False
        ml_field = None  # active multi-line field ('note'/'comment'), if any

        for line in lines:
            stripped = strip_ws(line)

            # Ignore slide markers
            if stripped.startswith('<!-- lwp:slide'):
                continue

            # Multi-line continuation for `note:` / `comment:`: any line that
            # starts with whitespace belongs to the value of the field opened
            # above. The leading indentation is structural and dropped; an
            # indented blank line is kept as a paragraph break. The block ends
            # at the first unindented, non-empty line (a heading, the next
            # field, or the fact-box) — handled just below.
            is_indented = bool(line) and (line[0] == ' ' or line[0] == '\t')
            if ml_field is not None and not is_indented and stripped:
                ml_field = None
            if ml_field is not None and is_indented:
                attr = _SLIDE_FIELD_ATTRS[ml_field]
                cur = getattr(slide, attr) or ''
                setattr(slide, attr, (cur + '\n' + stripped) if cur else stripped)
                continue

            # Detect key: value fields
            # [ \t]*, not \s* — \s matches U+00A0 like str.strip() does,
            # which would swallow a non-breaking space right after the
            # ':' instead of preserving it as the value's first character
            # (§7.6).
            field_match = re.match(
                r'^(' + '|'.join(SLIDE_FIELD_NAMES) + r'):[ \t]*(.*)', stripped)
            if field_match and not in_content:
                key = field_match.group(1)
                value = field_match.group(2)
                if key == 'slug':
                    slide.slug = value
                elif key == 'kicker':
                    slide.kicker = value
                elif key == 'tags':
                    slide.tags = value
                elif key == 'summary':
                    slide.summary = value
                elif key == 'fact-label':
                    slide.fact_label = value
                elif key == 'fact-variant':
                    slide.fact_variant = value
                elif key == 'source':
                    slide.source = value
                elif key == 'highlight':
                    slide.highlight = value
                elif key == 'highlight-caption':
                    slide.highlight_caption = value
                elif key == 'comment':
                    slide.comment = value  # review note — never rendered (GLOSSARY.md)
                    ml_field = 'comment'
                elif key == 'note':
                    slide.note = value  # speaker note — not rendered; presenter panel only
                    ml_field = 'note'
            # `#` only ever means "this cover's own title" and `##` only
            # ever means "this non-cover slide's own title" — the other
            # heading level can never legitimately set anything here (a
            # non-cover slide is never rendered from slide.h1, a cover
            # never from slide.h2 — render_slide() treats every slide_type
            # other than 'cover' as standard, matched here for the two to
            # agree), so it must fall through to content immediately
            # rather than being silently captured into an attribute
            # nothing ever reads. Parsing stays permissive about the type
            # token; validate_slides() is what refuses one that is not in
            # SLIDE_TYPES, so the message can name the slide's rank.
            elif (slide.slide_type == 'cover' and stripped.startswith('# ')
                  and not stripped.startswith('## ') and not in_content and slide.h1 is None):
                slide.h1 = strip_ws(stripped[2:])
            elif (slide.slide_type != 'cover' and stripped.startswith('## ')
                  and not in_content and slide.h2 is None):
                slide.h2 = strip_ws(stripped[3:])
            else:
                # This is content (the fact-box)
                if stripped:
                    in_content = True
                    content_lines.append(line)
                elif in_content:
                    content_lines.append('')

        # Free-form content becomes the fact-box
        if content_lines:
            slide.fact_content = strip_ws('\n'.join(content_lines))

        slides.append(slide)

    return meta, slides, has_meta_block, content_before_meta


def _is_safe_relative_filename(value):
    """True if `value` is a bare filename with no directory component —
    rejects absolute paths and any `../` traversal. series.json and the
    article: field are attacker-reachable (LLM-edited content, unattended
    CI) and get joined into real filesystem paths (Path(dir) / value) with
    no other containment check — Path('/x') / '/etc/passwd' silently
    discards the left side and resolves to '/etc/passwd', so this check is
    the first thing standing between that input and an arbitrary file
    read/write. It is a name-shape check only: it cannot see that a bare
    name is a symlink pointing outside the tree — _resolve_contained()
    below is the realpath barrier that catches that. `.` and `..` both
    satisfy `value == Path(value).name` yet are directories (a bare `..`
    used to crash with IsADirectoryError), and a NUL byte would raise a
    raw ValueError at open() time — both are rejected here explicitly."""
    if not value or value in ('.', '..') or '\x00' in value:
        return False
    return value == Path(value).name


def _resolve_contained(base_dir, value):
    """Resolve base_dir/value and return the real path only if it stays
    inside base_dir — otherwise None. This is the barrier the name-shape
    check (_is_safe_relative_filename) cannot provide: a bare filename
    that is itself a symlink into an outside file or directory passes the
    name check, and every read/copy site would otherwise follow it. A git
    repo can carry such symlinks, so an unattended build of an
    attacker-authored series would leak host files into the published
    output without this."""
    base = Path(base_dir).resolve()
    target = (base / value).resolve()
    if target == base or base in target.parents:
        return target
    return None


_TAG_TOKEN_RE = re.compile(r'^[\w-]+$', re.UNICODE)


def _canonical_tag_tokens(raw, source, field='tags', allow_excluded=True,
                          strict=True):
    """Canonicalizes one space-separated tag field.

    Slide and article tags deliberately share this lexical surface. The
    caller decides whether the slide-only ``excluded`` token is allowed.
    """
    text = str(raw or '').strip()
    tags = []
    seen = set()
    for token in text.split():
        canonical = token.casefold()
        if (canonical.startswith('_')
                or not _TAG_TOKEN_RE.fullmatch(canonical)):
            if strict:
                log('error', f'{source}: invalid tag {token!r} in {field}: '
                    'allowed: letters, accents, digits, "-" and "_"; a tag '
                    'cannot start with "_".')
                sys.exit(1)
            continue
        if not allow_excluded and canonical == 'excluded':
            if strict:
                log('error', f'{source}: {field}: "excluded" is only a slide '
                    'omission; use status: ignored for an article.')
                sys.exit(1)
            continue
        if canonical not in seen:
            seen.add(canonical)
            tags.append(canonical)
    return tags


def normalize_default_tag(raw, source):
    """Returns the one series tag selected when no reader choice exists."""
    tags = _canonical_tag_tokens(raw, source, field='default_tag',
                                 allow_excluded=False)
    if not tags:
        return 'default'
    if len(tags) != 1:
        log('error', f'{source}: default_tag must contain exactly one tag.')
        sys.exit(1)
    return tags[0]


def normalize_article_tags(raw, filename, strict=True):
    """Canonicalizes the optional article gate from its meta block."""
    return _canonical_tag_tokens(raw, filename, field='tags',
                                 allow_excluded=False, strict=strict)


def collect_article_slide_tags(slides, filename, strict=True):
    """Returns ordered tags available from an article's non-excluded slides.

    This pass runs while resolving the index/nav metadata, before the article
    is rendered. It uses the same validator as the later slide render, so an
    index can never advertise a malformed tag as a usable choice.
    """
    tags, _ = _collect_article_slide_details(slides, filename, strict=strict)
    return tags


def _slide_preview_title(slide, number):
    """Returns the plain title the tag menu can show for one source slide."""
    if slide.slide_type == 'series-nav':
        return ''
    title = slide.h1 if slide.slide_type == 'cover' else slide.h2
    title = title or slide.h1 or slide.h2 or slide.kicker or slide.slug
    title = strip_ws(re.sub(r'<[^<>]+>', ' ', str(title or '')))
    return title or f'Slide {number}'


def _collect_article_slide_details(slides, filename, strict=True):
    """Returns the tag vocabulary and visible slide metadata for an article."""
    tags = []
    seen = set()
    details = []
    for number, slide in enumerate(slides, 1):
        slide_tags = _canonical_tag_tokens(
            slide.tags, f'{filename}: slide {number}', field='tags',
            strict=strict)
        if 'excluded' in slide_tags:
            continue
        visible_tags = slide_tags or ['default']
        for tag in visible_tags:
            if tag not in seen:
                seen.add(tag)
                tags.append(tag)
        details.append({
            'title': _slide_preview_title(slide, number),
            'type': slide.slide_type,
            'tags': visible_tags,
        })
    return tags, details


def _slide_tag_set(slide):
    """Returns the canonical tag set before full slide validation.

    Field resolution reads article slides before `validate_slides()` runs, so
    it needs the same default/excluded decision without turning malformed
    author input into a second validation path. The later validator replaces
    the raw value with an ordered canonical list.
    """
    if isinstance(slide.tags, (list, tuple, set)):
        return {str(tag).casefold() for tag in slide.tags}
    raw = str(slide.tags or '').strip()
    return {token.casefold() for token in raw.split()} or {'default'}


def normalize_slide_tags(slide, filename, slide_number):
    """Validate and canonicalize one slide's `tags:` field.

    Tags are deliberately a small lexical surface: Unicode word characters
    (letters, accents, digits and underscores) plus hyphens. Case folding
    makes matching and persistence independent of how the author capitalizes
    a tag. A missing or empty field is the shared `default` tag.
    """
    tags = _canonical_tag_tokens(
        slide.tags, f'{filename}: slide {slide_number}', field='tags')
    if not tags:
        slide.tags = ['default']
        return slide.tags
    slide.tags = tags or ['default']
    return slide.tags


def validate_slides(slides, filename, has_meta_block=True, content_before_meta=''):
    """Rejects the parser edge cases the spec (§22) says must be fatal,
    instead of letting them silently corrupt or truncate the build:

    - the file has no <!-- lwp:meta --> block at all (§22.7)
    - the file has no slides at all (§22.10)
    - a cover slide with content after its fields (it has no fact-box to
      put that content in, so it would otherwise vanish silently, §22.12)
    - a full-article slide missing its required article: field (otherwise
      the raw {FULL_ARTICLE_PLACEHOLDER:sN} leaks into the published HTML)
    - more than one series-nav slide (§22.9)

    Several full-article slides are NOT refused. They used to be, and the
    reason was never a rule about the format: the renderer wrote one
    shared placeholder and substituted it globally, so the first article
    landed in every slot and the rest were silently dropped. Each slide
    now carries its own marker (§22.8).
    """
    if not has_meta_block:
        log('error', f'{filename}: file must start with a <!-- lwp:meta --> block.')
        sys.exit(1)

    # §22.7: nothing but blank lines may precede the marker (a BOM is
    # already absorbed at read time, §13.1). This content used to be
    # silently discarded — invisible data loss for a stray first line.
    if content_before_meta:
        preview = content_before_meta.splitlines()[0][:60]
        log('error', f'{filename}: content found before the <!-- lwp:meta --> '
              f'block (starting with: "{preview}"). The file must start with the '
              f'marker; only blank lines may precede it.')
        sys.exit(1)

    if not slides:
        log('error', f'{filename}: file has no slides.')
        sys.exit(1)

    series_nav_positions = []

    for i, slide in enumerate(slides, 1):
        # A type this build does not know renders as a standard slide —
        # `render_slide()` treats everything that is not one of the three
        # special types as standard. So `<!-- lwp:slide:covre -->` used to
        # publish silently, as a slide of the wrong kind: no error, no
        # warning, and a page whose first slide is not the cover. Refuse
        # it here, naming what the types are.
        if slide.slide_type not in SLIDE_TYPES_BY_NAME:
            known = ', '.join(t.name for t in SLIDE_TYPES)
            log('error', f'{filename}: slide {i} has an unknown type '
                  f'"{slide.slide_type}" (known types: {known}).')
            sys.exit(1)

        normalize_slide_tags(slide, filename, i)
        if 'excluded' in slide.tags:
            continue

        if slide.slide_type == 'cover' and slide.fact_content:
            message = (f'{filename}: slide {i} (cover) has content after its '
                       f'fields, but a cover slide has no fact-box.')
            field_like = next(
                (line.strip() for line in slide.fact_content.splitlines()
                 if re.match(r'^[A-Za-z][A-Za-z0-9_-]*:', line.strip())),
                None,
            )
            if field_like:
                field_name = field_like.split(':', 1)[0]
                cover_fields = ', '.join(
                    f'{name}:' for name in SLIDE_TYPES_BY_NAME['cover'].fields)
                message += (f' The line starts with the unrecognized field '
                            f'"{field_name}:". Cover fields are: {cover_fields}; '
                            f'the title uses "# Title".')
                if field_name == 'tag':
                    message += (' Use "kicker:" for a visible label or "tags:" '
                                'for tag filtering.')
            log('error', message)
            sys.exit(1)

        # A cover renders only kicker / # title / summary (+ comment, never
        # rendered anywhere). The other standard-slide fields are parsed
        # but never rendered on a cover — warn, don't fail: toggling a
        # slide between standard and cover while drafting is a normal
        # workflow, and the extra fields cost nothing. Which fields those
        # are comes from the type's own entry, so a field added to the
        # cover stops being reported here by that edit alone.
        if slide.slide_type == 'cover':
            accepted = set(SLIDE_TYPES_BY_NAME['cover'].fields)
            ignored = [name for name in SLIDE_FIELD_NAMES
                       if name not in accepted
                       and getattr(slide, _SLIDE_FIELD_ATTRS[name]) is not None]
            if ignored:
                log('warn', f'{filename}: slide {i} (cover) has field(s) '
                      f'{", ".join(ignored)} — parsed but never rendered on a '
                      f'cover slide.')

        # series-nav / full-article: any line that isn't a recognized
        # directive (article:, comment:) would be silently dropped from
        # the rendering — fatal instead (§22.9/§22.8).
        if slide.slide_type in ('series-nav', 'full-article') and slide.extra_content:
            preview = slide.extra_content.splitlines()[0][:60]
            log('error', f'{filename}: slide {i} ({slide.slide_type}) has '
                  f'content that this slide type never renders (starting '
                  f'with: "{preview}").')
            sys.exit(1)

        if slide.slide_type == 'full-article':
            if not slide.article_file:
                log('error', f'{filename}: slide {i} is a full-article slide '
                      f'without an article: field.')
                sys.exit(1)
            if not _is_safe_relative_filename(slide.article_file):
                log('error', f'{filename}: slide {i} has an unsafe article: '
                      f'value "{slide.article_file}" (must be a plain filename, '
                      f'no path separators, no "..").')
                sys.exit(1)

        if slide.slide_type == 'series-nav':
            series_nav_positions.append(i)

    if len(series_nav_positions) > 1:
        log('error', f'{filename}: {len(series_nav_positions)} series-nav '
              f'slides found (slides {series_nav_positions}), only one is '
              f'allowed per article.')
        sys.exit(1)


