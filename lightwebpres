# Enforced at import: the source itself parses down to Python 3.6, so on
# an older interpreter this check runs and explains, instead of some
# unrelated TypeError (the first 3.8-only construct is shutil.copytree's
# dirs_exist_ok, which would otherwise only crash mid-build, and only on
# a series that has images).
if sys.version_info < (3, 8):
    print('[ERROR] lightwebpres requires Python 3.8 or newer '
          '(this is %d.%d).' % sys.version_info[:2], file=sys.stderr)
    sys.exit(1)

