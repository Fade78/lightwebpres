# Which options each command accepts, and whether they take a value.
# The parser consults this instead of guessing: a boolean flag never
# swallows the positional argument that follows it, a typoed or
# out-of-place option is a fatal error instead of a silent no-op, and
# `--opt=value` is accepted as equivalent to `--opt value`.
_VALUE_OPTIONS = frozenset({'--lang', '--output', '--language-file',
                            '--theme', '--only', '--nav-cache',
                            '--polarity', '--intensity', '--hue'})
_COMMAND_OPTIONS = {
    'install': {'--lang', '--force', '--theme', '--gitlab-ci'},
    'demo': {'--lang', '--output'},
    'build': {'--lang', '--output', '--language-file', '--no-typography',
              '--include-drafts', '--only', '--nav-cache',
              '--build-stamp', '--build-stamp-minimal'},
    'check': {'--lang', '--output', '--language-file', '--no-typography',
              '--include-drafts'},
    'audit': {'--lang'},
    'refresh-templates': set(),
    'themes': {'--polarity', '--intensity', '--hue'},
    'set-theme': {'--theme', '--force'},
    'themes-gallery': set(),
}


def parse_cli_options(command, rest):
    """Parses `rest` into (opts, positional) against _COMMAND_OPTIONS.

    Fatal errors (exit 1): an option the command doesn't accept (whether
    it exists elsewhere or not), and a value option with no value."""
    allowed = _COMMAND_OPTIONS[command]
    opts = {}
    positional = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg.startswith('--'):
            # GNU-style --opt=value: split once, the rest is the value
            # (which may itself contain '=').
            name, eq, inline_value = arg.partition('=')
            if name not in allowed:
                hint = f' (not an option of `{command}`)' if name in _VALUE_OPTIONS or any(
                    name in v for v in _COMMAND_OPTIONS.values()) else ''
                print(f'[ERROR] Unknown option: {name}{hint}. '
                      f'Run `lightwebpres --help` for the option list.', file=sys.stderr)
                sys.exit(1)
            if name in _VALUE_OPTIONS:
                if eq:
                    opts[name] = inline_value
                    i += 1
                elif i + 1 < len(rest) and not rest[i + 1].startswith('--'):
                    opts[name] = rest[i + 1]
                    i += 2
                else:
                    print(f'[ERROR] Option {name} requires a value '
                          f'(`{name} VALUE` or `{name}=VALUE`).', file=sys.stderr)
                    sys.exit(1)
            else:
                if eq:
                    print(f'[ERROR] Option {name} takes no value.', file=sys.stderr)
                    sys.exit(1)
                opts[name] = True
                i += 1
        else:
            positional.append(arg)
            i += 1
    return opts, positional


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help', 'help'):
        print_help()
        return

    command = args[0]
    if command not in _COMMAND_OPTIONS:
        print(f'Unknown command: {command}', file=sys.stderr)
        print_help()
        sys.exit(1)

    opts, positional = parse_cli_options(command, args[1:])

    target = positional[0] if positional else os.environ.get('LWP_SERIES_DIR', '.')

    if command == 'install':
        cmd_install(target, opts)
    elif command == 'demo':
        cmd_demo(target, opts)
    elif command == 'build':
        cmd_build(target, opts)
    elif command == 'check':
        cmd_check(target, opts)
    elif command == 'audit':
        cmd_audit(target, opts)
    elif command == 'refresh-templates':
        cmd_refresh_templates(target, opts)
    elif command == 'themes':
        # Not a series-directory command: it reads the built-in table
        # only, so a stray positional would mean nothing.
        cmd_themes(opts)
    elif command == 'set-theme':
        cmd_set_theme(target, opts)
    elif command == 'themes-gallery':
        # Not a series-directory command: no LWP_SERIES_DIR fallback here,
        # just an output file path defaulting to themes-gallery.html in cwd.
        output_path = positional[0] if positional else 'themes-gallery.html'
        cmd_themes_gallery(output_path, opts)


if __name__ == '__main__':
    main()
