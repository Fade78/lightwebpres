      // fragment, the focus is the position (stepIndexCards), and the
      // disabled state of the nav buttons is the on-screen map of it.
      clearIndexFocus();
      current = 0;
      updateUI();
      return;
    }
    if (!slides.length) {
      updateUI();
      return;
