def cmd_install(target_dir, args):
    """install command — creates the directory structure."""
    td = Path(target_dir).resolve()
    lang = args.get('--lang', 'fr')
    force = bool(args.get('--force'))
    theme_key = args.get('--theme')
    gitlab_ci = bool(args.get('--gitlab-ci'))

    if td.exists() and any(td.iterdir()) and not force:
        print(f'[ERROR] {td} is not empty. Use an empty or new directory, or pass --force.',
              file=sys.stderr)
        sys.exit(1)

    if theme_key is not None and theme_key not in THEMES:
        print(f'[ERROR] Unknown theme: {theme_key!r}. Valid themes: {", ".join(sorted(THEMES))}',
              file=sys.stderr)
        sys.exit(1)

    # Create the directories
    (td / 'articles').mkdir(parents=True, exist_ok=True)
    (td / 'templates').mkdir(exist_ok=True)
    (td / 'language').mkdir(exist_ok=True)
    (td / 'public').mkdir(exist_ok=True)

    # Extract the templates (only the two build actually reads back —
    # see specifications.md §9: page/index structure is fixed, not an
    # editable template; style.css and nav.js are overridable, and an
    # optional templates/index_extra.html is inserted as-is into the
    # index page if the author creates one — no default content, so
    # nothing to extract here)
    style_css = apply_theme(TEMPLATE_STYLE, theme_key) if theme_key else TEMPLATE_STYLE
    (td / 'templates' / 'style.css').write_text(style_css, encoding='utf-8')
    (td / 'templates' / 'nav.js').write_text(TEMPLATE_NAV_JS, encoding='utf-8')

    # Extract the language packs
    (td / 'language' / 'fr.json').write_text(LANG_FR, encoding='utf-8')
    (td / 'language' / 'en.json').write_text(LANG_EN, encoding='utf-8')

    # Empty series.json
    series_json = {
        "series_meta": {
            "title": "My article series",
            "subtitle": "Series subtitle",
            "version": "v0.1",
            "intro": "Series introduction.",
            "author": "",
            "license": ""
        },
        "articles": []
    }
    (td / 'series.json').write_text(json.dumps(series_json, ensure_ascii=False, indent=2), encoding='utf-8')

    # .gitlab-ci.yml — opt-in only (--gitlab-ci): install never assumes a
    # GitLab deployment, so a project doesn't end up depending on GitLab
    # just from having been scaffolded (see specifications.md §11.1). The
    # chosen --lang is baked into the CI build command: it's the one place
    # a scaffolded project's language persists, since a plain build/demo
    # otherwise defaults to fr (both packs are always installed, language
    # is a per-build choice — §7.1).
    if gitlab_ci:
        (td / '.gitlab-ci.yml').write_text(
            TEMPLATE_GITLAB_CI.format(lang=lang), encoding='utf-8')

    # Copy the executable itself into the directory, for standalone use
    # (the series directory shouldn't have to depend on lightwebpres being
    # installed system-wide or found elsewhere on PATH).
    exe_src = Path(__file__).resolve()
    exe_dst = td / 'lightwebpres'
    if exe_src.is_file() and exe_src != exe_dst:
        shutil.copy2(exe_src, exe_dst)
        exe_dst.chmod(exe_dst.stat().st_mode | 0o111)

    print(f'Installed: {td}')
    if theme_key:
        print(f'  theme: {THEMES[theme_key]["label"]}')
    print(f'  articles/   — your .md files')
    print(f'  templates/  — CSS and JS (editable; put custom CSS after the')
    print(f'              "Personnalisations locales" marker at the end of')
    print(f'              style.css so refresh-templates can update the rest)')
    print(f'  language/   — typography rules + interface strings (fr, en)')
    print(f'  public/     — generated HTML (build output)')
    print(f'  series.json — article list')
    if gitlab_ci:
        print(f'  .gitlab-ci.yml — CI pipeline')
    print(f'  lightwebpres — the executable itself, for standalone use')
    if not gitlab_ci:
        print()
        print('No .gitlab-ci.yml (opt-in only — pass --gitlab-ci to install one).')
    print()
    print('Next steps:')
    print(f'  1. Create articles in {td}/articles/')
    print(f'  2. Add entries to {td}/series.json')
    print(f'  3. Run: lightwebpres build {td}')


def cmd_refresh_templates(target_dir, args):
    """refresh-templates command — after an executable upgrade, updates the
    built-in portion of templates/style.css and templates/nav.js (which
    otherwise stay frozen at whatever install/refresh-templates last wrote,
    per the override mechanism of §9) without discarding local edits."""
    td = Path(target_dir).resolve()
    templates_dir = td / 'templates'

    if not templates_dir.is_dir():
        print(f'[ERROR] {templates_dir} not found. Run install first.', file=sys.stderr)
        sys.exit(1)

    refreshed = []
    up_to_date = []
    skipped = []

    style_path = templates_dir / 'style.css'
    if style_path.exists():
        old = read_text_file(style_path)
        detected_theme = detect_theme(old)
        if detected_theme is not None and detected_theme not in THEMES:
            print(f'[WARN] templates/style.css was built with theme {detected_theme!r}, '
                  f'which no longer exists. Falling back to the default theme for the '
                  f'built-in part.', file=sys.stderr)
            detected_theme = None
        new_builtin = apply_theme(TEMPLATE_STYLE, detected_theme) if detected_theme else TEMPLATE_STYLE
        if old == new_builtin:
            up_to_date.append('templates/style.css')
        else:
            # First occurrence, not last (rfind): the built-in part ends
            # with exactly one marker, so everything after the FIRST
            # marker is the author's — including a second literal marker
            # they may have pasted into their own CSS. rfind dropped every
            # author rule between the two markers.
            marker_pos = old.find(TEMPLATE_STYLE_CUSTOM_MARKER)
            if marker_pos == -1:
                skipped.append('templates/style.css')
                print(f'[SKIP] templates/style.css: no marker found, cannot tell your '
                      f'customizations apart from the built-in CSS safely. Add this exact '
                      f'line right before your own rules, then run refresh-templates again:',
                      file=sys.stderr)
                print(f'  {TEMPLATE_STYLE_CUSTOM_MARKER}', file=sys.stderr)
            else:
                custom_tail = old[marker_pos + len(TEMPLATE_STYLE_CUSTOM_MARKER):]
                style_path.write_text(new_builtin + custom_tail, encoding='utf-8')
                refreshed.append('templates/style.css')

    nav_path = templates_dir / 'nav.js'
    if nav_path.exists():
        old_nav = read_text_file(nav_path)
        if old_nav == TEMPLATE_NAV_JS:
            up_to_date.append('templates/nav.js')
        else:
            backup_path = templates_dir / 'nav.js.bak'
            backup_path.write_text(old_nav, encoding='utf-8')
            nav_path.write_text(TEMPLATE_NAV_JS, encoding='utf-8')
            refreshed.append('templates/nav.js (previous version saved as templates/nav.js.bak)')

    if not style_path.exists() and not nav_path.exists():
        print('Nothing to refresh: no templates/style.css or templates/nav.js in this directory.')
        return

    if refreshed:
        print('Refreshed:')
        for item in refreshed:
            print(f'  {item}')
    if up_to_date:
        print('Already up to date:')
        for item in up_to_date:
            print(f'  {item}')
    print()
    print('Run build again to apply the refreshed templates.')

    if skipped:
        sys.exit(1)


