def print_help():
    print(f'''LightWebPres v{VERSION} — framework for generating self-contained web pages.

COMMANDS
  lightwebpres install [directory] [--lang fr]   Creates the directory structure
  lightwebpres demo [directory] [--lang fr]      Creates a demo site
  lightwebpres build [directory] [--lang fr]     Builds the site (self-contained HTML)
  lightwebpres check [directory] [--lang fr]     Checks without building (diff)
  lightwebpres audit [directory] [--lang fr]     Warns about editorial conventions (never blocking)
  lightwebpres help | --help | -h                Shows this help

OPTIONS
  --lang fr|en           Language: typography rules + interface strings (default: fr)
  --output public/       Output directory (default: public/)
  --force                install: proceed even if the target directory is not empty
  --language-file path   build/check: use this language pack file instead of
                        language/<lang>.json (highest priority, spec §19.5)

ENVIRONMENT VARIABLES
  LWP_ARTICLES_DIR    Articles directory (default: $LWP_SERIES_DIR/articles)
  LWP_TEMPLATES_DIR   Templates directory (default: $LWP_SERIES_DIR/templates)
  LWP_OUTPUT_DIR      Output directory (default: $LWP_SERIES_DIR/public)
  LWP_LANG            Language (default: fr)
  LWP_SERIES_DIR      Series directory (default: .) — used when no
                      [directory] argument is given
  LWP_LANGUAGE_DIR    Language directory (default: $LWP_SERIES_DIR/language)

SERIES DIRECTORY (created by install)
  series.json          List of articles + series metadata
  articles/*.md         One .md file per article (+ *_article.md for the full article)
  articles/img/          Article images (copied to public/img/ on build)
  templates/            style.css, nav.js (editable; page/index HTML structure
                        is fixed, not a template — see language/ for vocabulary)
  language/              fr.json, en.json — typography rules + interface
                        strings (nav labels, "copy link" button...), editable;
                        strings can be partially overridden (missing keys
                        fall back to the built-in pack for that language)
  public/               Generated HTML (build output — do not edit by hand)
  README.md              Generated by build from series.json (article list)
  lightwebpres            Copy of the executable itself, for standalone use

ARTICLE FORMAT (.md)
  <!-- lwp:meta --> ... ---     Metadata block at the top of the file
  ---                           Separates slides, alone on its own line
  <!-- lwp:slide:TYPE -->       Marks a slide's type (absent = standard)
  key: value                    A slide field (one line = one value; no line
                                breaks inside a value for now)

SLIDE TYPES
  cover         Cover slide (tag, h1 or # Title, summary)
  standard      Regular slide (tag, h2 or ## Title, summary, highlight,
                highlight-caption, fact-label, source, + free text = fact-box)
  series-nav    Cross-article navigation block, generated from series.json
  full-article  Includes an external .md file via the article: field
                (required; only one full-article slide per article)

FIELDS RECOGNIZED IN A SLIDE
  tag, h2 (or ## Title), summary, fact-label, source, highlight, highlight-caption

The framework is a single executable file, with no external dependency.
Python 3 standard library only. Native UTF-8.
Full reference: specifications.md.''')


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help', 'help'):
        print_help()
        return

    command = args[0]
    rest = args[1:]

    # Parse the options
    opts = {}
    positional = []
    i = 0
    while i < len(rest):
        if rest[i].startswith('--'):
            if i + 1 < len(rest) and not rest[i + 1].startswith('--'):
                opts[rest[i]] = rest[i + 1]
                i += 2
            else:
                opts[rest[i]] = True
                i += 1
        else:
            positional.append(rest[i])
            i += 1

    target = positional[0] if positional else os.environ.get('LWP_SERIES_DIR', '.')

    if command == 'install':
        cmd_install(target, opts)
    elif command == 'demo':
        cmd_demo(target, opts)
    elif command == 'build':
        cmd_build(target, opts)
    elif command == 'check':
        cmd_check(target, opts)
    elif command == 'audit':
        cmd_audit(target, opts)
    else:
        print(f'Unknown command: {command}', file=sys.stderr)
        print_help()
        sys.exit(1)


if __name__ == '__main__':
    main()
