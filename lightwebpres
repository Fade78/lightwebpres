def _facet_filters(args):
    """Reads --polarity/--intensity/--hue out of parsed CLI options,
    rejecting an unknown value by name rather than silently returning an
    empty list (which would read as "no theme is like that")."""
    filters = {}
    for facet in FACET_VALUES:
        value = args.get(f'--{facet}')
        if value is not None and value not in FACET_VALUES[facet]:
            print(f'[ERROR] Unknown --{facet}: {value!r}. Valid values: '
                  f'{", ".join(FACET_VALUES[facet])}', file=sys.stderr)
            sys.exit(1)
        filters[facet] = value
    return filters


def cmd_themes(args):
    """themes command (§11.9) — lists the built-in themes, optionally
    narrowed by facet, so a theme can be chosen from the terminal instead
    of only from the generated gallery page. Prints slugs, because a slug
    is what `install --theme` and `set-theme` take."""
    import textwrap

    filters = _facet_filters(args)
    matches = themes_matching(filters)
    active = ' '.join(f'--{k} {v}' for k, v in filters.items() if v)

    if not matches:
        # Not an error: an empty result to a legitimate question. Name
        # the combination that came up empty rather than printing nothing
        # and letting the reader wonder whether the command ran.
        print(f'No theme matches {active}.')
        print(f'Drop a filter, or run `lightwebpres themes` for all {len(THEMES)}.')
        return

    if active:
        print(f'{len(matches)} of {len(THEMES)} themes match {active}:')
    else:
        print(f'{len(THEMES)} built-in themes:')
    print()

    for slug, theme, facets in matches:
        trio = '/'.join((facets['polarity'], facets['intensity'], facets['hue']))
        print(f'  {slug}  [{trio}]')
        # The notes are written for the gallery, so they carry <code>
        # markup. Strip it rather than print angle brackets at someone.
        note = re.sub(r'<[^<>]+>', '', theme['note'])
        for line in textwrap.wrap(f'{theme["label"]} — {note}', width=72):
            print(f'      {line}')
        print()

    print('Facets: polarity (light/dark), intensity (sober/vivid/mono), hue.')
    print('Narrow the list with, for example:')
    print('  lightwebpres themes --polarity dark --hue green')
    print('Apply one with `install --theme <slug>` (new series) or')
    print('`set-theme --theme <slug>` (existing one); see them rendered with')
    print('`lightwebpres themes-gallery`.')


def cmd_set_theme(target_dir, args):
    """set-theme command (§11.10) — changes the theme of an existing
    series by rewriting the variables in templates/style.css, instead of
    forcing a reinstall or a hand-edit of the theme marker.

    Refuses a file whose built-in CSS is not what this executable would
    have produced (theme_state()), unless --force: on such a file the
    substitution can silently miss a declaration and leave the page
    half-recoloured, which is worse than not running at all."""
    td = Path(target_dir).resolve()
    style_path = td / 'templates' / 'style.css'
    new_slug = args.get('--theme')
    force = bool(args.get('--force'))

    if new_slug is None:
        print(f'[ERROR] set-theme requires --theme <slug>. '
              f'Run `lightwebpres themes` to list them.', file=sys.stderr)
        sys.exit(1)
    if new_slug not in THEMES:
        print(f'[ERROR] Unknown theme: {new_slug!r}. '
              f'Run `lightwebpres themes` to list the {len(THEMES)} valid slugs.',
              file=sys.stderr)
        sys.exit(1)
    if not style_path.exists():
        print(f'[ERROR] {style_path} not found. Run install first.', file=sys.stderr)
        sys.exit(1)

    old_css = read_text_file(style_path)
    current, standard, reason = theme_state(old_css)

    if not standard and not force:
        print(f'[ERROR] {style_path} is not a standard theme file: {reason}.',
              file=sys.stderr)
        print(f'        Changing its theme may leave it partly recoloured. '
              f'Pass --force to do it anyway.', file=sys.stderr)
        sys.exit(1)

    # Named for the message even when it is not a THEMES key: the point
    # of the report is to say what is being replaced, and 'the default
    # theme' or an unknown slug are both answers to that.
    if current is None:
        current_name = 'default'
    elif current in THEMES:
        current_name = current
    else:
        current_name = f'{current} (unknown)'

    if current == new_slug and standard:
        print(f'Theme unchanged: {style_path} already uses {new_slug}. Nothing written.')
        return

    # Substitution rewrites declarations that exist; it never adds one.
    # Checked BEFORE writing, so a file where nothing could be applied is
    # refused rather than stamped with a marker it does not live up to.
    missing = unsubstituted_declarations(old_css)
    if len(missing) == len(unsubstituted_declarations('')):
        print(f'[ERROR] {style_path} declares none of the theme variables, so there '
              f'is nothing to substitute. Writing the theme marker on it would '
              f'claim a theme the file does not carry.', file=sys.stderr)
        print(f'        Run `lightwebpres refresh-templates` to restore the built-in '
              f'section first.', file=sys.stderr)
        sys.exit(1)

    style_path.write_text(apply_theme(old_css, new_slug), encoding='utf-8')

    print(f'Theme changed: {current_name} -> {new_slug}')
    print(f'  {style_path}')
    if missing:
        print(f'[WARN] {len(missing)} declaration(s) were not found and kept their '
              f'previous values: {", ".join(missing)}.', file=sys.stderr)
    if not standard:
        print(f'[WARN] Forced: {reason}.', file=sys.stderr)
    print()
    print('Run build again to apply the new theme.')


