  }

  function shareUrl(scope) {
    if (scope === 'series') {
      return location.origin + location.pathname.replace(/[^\/]*$/, '') + 'index.html';
    }
    if (scope === 'article') {
      return location.origin + location.pathname;
    }
    if (scope === 'fiche') {
