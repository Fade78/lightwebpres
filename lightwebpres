   the engine's rules, which is what lets them win at equal specificity.
   Anything declared BELOW them still beats them, so check the source
   order before adding a selector here. */
@media (max-width: 600px) {
  .slide { padding: 40px 24px; }
  .nav-dots { display: none; }
  .nav-buttons { bottom: 16px; right: 16px; }
}

/* --- The highlight block --- */
.highlight {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  margin: 18px 0 22px;
  max-width: var(--page-block-max);
}
.highlight-figure { overflow-wrap: anywhere; }
.highlight-caption { max-width: var(--page-content-max); }

/* --- Share popover and its QR modal --- */
.share-popover {
  position: fixed;
  bottom: 80px;
  right: 28px;
  z-index: 250;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  padding: 14px;
  display: none;
  max-width: calc(100vw - 40px);
}
.share-popover.open { display: block; }
.share-matrix {
  display: grid;
  grid-template-columns: auto repeat(3, 1fr);
  gap: 6px 10px;
  align-items: center;
}
.share-cell-head {
  font-weight: 700;
  text-align: center;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.share-cell-head-disabled { opacity: 0.35; }
.share-cell-label { white-space: nowrap; padding-right: 10px; }
button.share-action {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  border-style: solid;
  cursor: pointer;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  font-family: inherit;
  transition: border-color 0.15s, background 0.15s;
}
button.share-action:disabled { opacity: 0.25; cursor: default; }
.share-qr-modal {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.share-qr-modal.open { display: flex; }
/* 400px, not 320: a longer URL bumps the code to a higher version (more
   modules), and a small on-screen code is the likeliest reason a phone's
   native camera fails to detect one that decodes fine in a dedicated
   scanner. Give it room to stay legible. */
.share-qr-modal-content {
  border-radius: 12px;
  padding: 24px;
  max-width: 400px;
  width: 100%;
  text-align: center;
  box-shadow: 0 8px 32px rgba(0,0,0,0.25);
}
.share-qr-modal-title {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 12px;
}
.share-qr-modal-content svg {
  width: 100%;
  height: auto;
  display: block;
  margin-bottom: 12px;
}
.share-qr-modal-url {
  font-size: 12px;
  word-break: break-all;
  margin-bottom: 16px;
}
.share-qr-close {
  border-style: solid;
  border-radius: 8px;
  padding: 8px 20px;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
}

