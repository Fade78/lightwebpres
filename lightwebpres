  }

  function closeSharePopover() {
    if (sharePopover) sharePopover.classList.remove('open');
  }

  function closeQrModal() {
    if (qrModal) qrModal.classList.remove('open');
  }

  function qrToSvg(text) {
    var matrix = qrEncode(text);
    var n = matrix.length;
    var border = 4;
    var size = n + border * 2;
    var rects = '';
    for (var r = 0; r < n; r++) {
      for (var c = 0; c < n; c++) {
        if (matrix[r][c]) rects += '<rect x="' + (c + border) + '" y="' + (r + border) + '" width="1" height="1"/>';
      }
