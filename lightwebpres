TEMPLATE_INDEX_JS = r'''var btnUp   = document.getElementById('navUp');
  var btnHome = document.getElementById('navHome');
  var btnDown = document.getElementById('navDown');

  function scrollByViewport(direction) {
    window.scrollBy({ top: direction * window.innerHeight * 0.9, behavior: 'smooth' });
  }
  function scrollToTop() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateNavUI() {
    var atTop = window.scrollY <= 4;
    var atBottom = (window.innerHeight + window.scrollY) >= (document.documentElement.scrollHeight - 4);
    if (btnUp) btnUp.classList.toggle('disabled', atTop);
    if (btnDown) btnDown.classList.toggle('disabled', atBottom);
  }

  if (btnUp) btnUp.addEventListener('click', function () { scrollByViewport(-1); });
  if (btnDown) btnDown.addEventListener('click', function () { scrollByViewport(1); });
  if (btnHome) btnHome.addEventListener('click', function () { scrollToTop(); });

  window.addEventListener('scroll', updateNavUI);
  window.addEventListener('resize', updateNavUI);
  updateNavUI();

  document.addEventListener('keydown', function (e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown') {
      e.preventDefault(); scrollByViewport(1);
    } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
      e.preventDefault(); scrollByViewport(-1);
    } else if (e.key === 'Home') {
      e.preventDefault(); scrollToTop();
    }
  });

  var shareLink = document.getElementById('shareLink');
  var qrModal = document.getElementById('qrModal');
  if (shareLink && qrModal) {
    shareLink.addEventListener('click', function (e) {
      e.preventDefault();
      qrModal.classList.add('open');
    });
    qrModal.addEventListener('click', function () {
      qrModal.classList.remove('open');
    });
  }

  var copyLinkBtn = document.getElementById('copyLinkBtn');
  if (copyLinkBtn) {
    var siteUrl = 'index.html';
    var originalLabel = copyLinkBtn.textContent;
    copyLinkBtn.addEventListener('click', function (e) {
      e.preventDefault();
      function showCopied() {
        copyLinkBtn.textContent = '✅ {{str_copy_link_done}}';
        setTimeout(function () { copyLinkBtn.textContent = originalLabel; }, 1800);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(siteUrl).then(showCopied, function () {
          window.prompt('{{str_copy_prompt}}', siteUrl);
        });
      } else {
        window.prompt('{{str_copy_prompt}}', siteUrl);
      }
    });
  }
'''

