def print_help():
    # Deliberately NOT the full slug list any more. At nine themes it was
    # a helpful reminder; past thirty it is a wall of names carrying no
    # information about what any of them look like — the same problem the
    # facets exist to solve, only relocated into the terminal. Point at
    # the two commands that can actually answer "which one do I want".
    theme_count = len(THEMES)
    property_count = len(PROPERTY_REGISTRY)
    # Written from SLIDE_TYPES rather than typed out below, because a help
    # text listing three of the four types, or describing a type the parser
    # stopped accepting, is worse than no help text: it is read as the
    # answer. Same reason the theme counts above are counted, not stated.
    import textwrap
    slide_type_lines = []
    for t in SLIDE_TYPES:
        accepts = list(t.fields)
        if t.title_marker:
            accepts.append(f'{t.title_marker} Title')
        if t.free_text:
            accepts.append(f'free text = {t.free_text}')
        body = f'{t.summary} Takes: {", ".join(accepts)}.'
        # break_on_hyphens off: `fact-label` split across two lines reads as
        # two field names, which is exactly the confusion this list exists
        # to remove.
        wrapped = textwrap.wrap(body, width=_TERM_WIDTH - 16,
                                break_on_hyphens=False)
        slide_type_lines.append(f'  {t.name:<14}{wrapped[0]}')
        slide_type_lines.extend(f'{"":<16}{line}' for line in wrapped[1:])
    slide_types_block = '\n'.join(slide_type_lines)
    slide_fields_block = textwrap.fill(
        ', '.join(SLIDE_FIELD_NAMES) + ' — comment is a review note, parsed '
        'on every type and rendered nowhere. A slide writes its own title '
        'with `## Title`, or `# Title` on a cover; it is never a `key:` line.',
        width=_TERM_WIDTH - 2, initial_indent='  ', subsequent_indent='  ',
        break_on_hyphens=False)

    def _reflow(text):
        """Re-wraps the help to _TERM_WIDTH. Only prose re-fills the
        terminal width: a run of same-indent, non-tabular lines (a
        multi-line description or a text paragraph) is joined and
        re-wrapped. Everything else — column-aligned lines, command
        examples, and their deeper continuations — keeps its shape, so
        tabular material stays aligned. Single lines that overflow the
        terminal are wrapped as a last resort."""
        out = []
        for para in text.split('\n\n'):
            units = []
            for raw in para.split('\n'):
                stripped = raw.strip()
                if not stripped:
                    continue
                indent = len(raw) - len(stripped)
                joinable = (units
                            and '  ' not in stripped
                            and not stripped.startswith('lightwebpres ')
                            and indent == units[-1][0]
                            and '  ' not in units[-1][1][0].strip())
                if joinable:
                    units[-1][1].append(raw)
                else:
                    units.append([indent, [raw]])
            for indent, lines in units:
                if len(lines) > 1:
                    joined = ' '.join(l.strip() for l in lines)
                    out.append(textwrap.fill(
                        joined, width=_TERM_WIDTH - indent,
                        initial_indent=' ' * indent,
                        subsequent_indent=' ' * indent,
                        break_on_hyphens=False,
                        break_long_words=False))
                else:
                    line = lines[0]
                    if len(line) <= _TERM_WIDTH:
                        out.append(line)
                    else:
                        out.append(textwrap.fill(
                            line.strip(), width=_TERM_WIDTH - indent,
                            initial_indent=' ' * indent,
                            subsequent_indent=' ' * indent,
                            break_on_hyphens=False,
                            break_long_words=False))
            out.append('')
        return '\n'.join(out)

    help_text = f'''LightWebPres v{VERSION} — framework for generating self-contained web pages.

