    # Write the files
    (articles_dir / 'first.md').write_text(demo1, encoding='utf-8')
    (articles_dir / 'img').mkdir(exist_ok=True)
    (articles_dir / 'img' / 'demo-figure.svg').write_text(demo_figure_svg, encoding='utf-8')
    (articles_dir / 'first_article.md').write_text(demo1_article, encoding='utf-8')
    (articles_dir / 'middle.md').write_text(demo2, encoding='utf-8')
    (articles_dir / 'middle_article.md').write_text(demo2_article, encoding='utf-8')
    (articles_dir / 'last.md').write_text(demo3, encoding='utf-8')
    (articles_dir / 'last_article.md').write_text(demo3_article, encoding='utf-8')

    # Update series.json — series_meta carries author/license so the demo
    # exercises the series-wide editorial defaults and their footers.
    series_json = {
        "series_meta": {
            "title": "Demo series",
            "subtitle": "Three articles to test LightWebPres",
            "version": "v0.1",
            "intro": "This demo series contains three articles that test the first, middle, and last positions in navigation.",
            "author": "The LightWebPres demo",
            "license": "Demo content, no rights reserved."
        },
        "articles": [
            {"page_source": "first.md"},
            {"page_source": "middle.md", "card_label": "Article 2 (overridden from series.json)"},
            {"page_source": "last.md"}
        ]
    }
    (td / 'series.json').write_text(json.dumps(series_json, ensure_ascii=False, indent=2), encoding='utf-8')

    print(f'Demo created: {td}')
    print('  3 articles (first, middle, last) with full articles')
    print('  1 demo image with a caption (articles/img/demo-figure.svg)')

    # Run the build
    print()
    print('Running the build...')
    cmd_build(str(td), args)
    print()
    # Name the directory the build actually wrote to, not the default:
    # with --output the fixed string was simply false, and contradicted the
    # build's own line two above it. The default still reads "public/"
    # exactly as before.
    out = args.get('--output', 'public/')
    print(f'Demo site generated in {out}. '
          f'Open {Path(out) / "index.html"} in a browser.')


