  max-width: var(--page-block-max);
  border-collapse: collapse;
  margin: 16px 0;
  font-size: 14px;
}
.full-article table th, .full-article table td {
  padding: 8px 12px;
  border-style: solid;
}
.full-article table th { font-weight: 700; }
.full-article strong { font-weight: 700; }
.full-article em { font-style: italic; }
.full-article .refs p { font-size: 13px; margin-bottom: 6px; }

/* --- Series navigation --- */
.series-list { max-width: 680px; }
.series-item {
  display: block;
  padding: 20px 24px;
  margin-bottom: 16px;
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
}
/* No opacity on the current card. Dimming it to signal "you are here"
   dimmed its three lines of text with it: 1.62:1 on the worst theme, and
   below AA on all 33. Its sunken ground, its border and the status glyph
   carry the same signal without touching a contrast ratio. */
