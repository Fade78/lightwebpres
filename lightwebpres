# ============================================================================
# LANGUAGE (typography rules + interface strings)
# ============================================================================

def strip_ws(text):
    """Like str.strip(), but keeps a leading/trailing non-breaking space
    (U+00A0) intact. Plain str.strip() treats U+00A0 as whitespace and
    trims it — fine for str.isspace() purposes, but wrong here: a
    non-breaking space already present in an author's source is content,
    not parsing whitespace, and must reach the output unchanged (see
    specifications.md §7.5). Used at every site that trims a field value
    the author writes (headings, fact-box text, meta values, table
    cells...); left out of purely structural checks (blank-line/table
    separator detection) that never produce output text."""
    return text.strip(' \t\n\r\v\f')


def rstrip_ws(text):
    """Right-only counterpart of strip_ws — trims a trailing '\\r' left by
    a Windows-style line ending after `str.split('\\n')`, never a trailing
    non-breaking space."""
    return text.rstrip(' \t\n\r\v\f')


class TypoEngine:
    """Applies regex replacement rules to text."""

    def __init__(self, rules_data):
        self.rules = []
        for i, rule in enumerate(rules_data.get('rules', []), 1):
            if not isinstance(rule, dict) or 'pattern' not in rule or 'replacement' not in rule:
                print(f'[ERROR] language rule {i}: must be an object with '
                      f'"pattern" and "replacement".', file=sys.stderr)
                sys.exit(1)
            # pattern/replacement must be strings: a non-string used to
            # escape the `except re.error` below (re.compile on an int
            # raises TypeError, re.sub with an int replacement likewise) as
            # a raw traceback instead of a clean [ERROR].
            if not isinstance(rule['pattern'], str) or not isinstance(rule['replacement'], str):
                print(f'[ERROR] language rule {i}: "pattern" and "replacement" '
                      f'must be strings.', file=sys.stderr)
                sys.exit(1)
            name = rule.get('name') or f'rule_{i}'
            pattern = rule['pattern']
            replacement = rule['replacement']
            # Convert $1 -> \1 for Python re.sub
            replacement = re.sub(r'\$(\d)', r'\\\1', replacement)
            # flags (§19.2): 'g' = replace every occurrence (without it,
            # only the first per text segment), 'i' = case-insensitive.
            # Anything else is fatal — this key used to be parsed and
            # silently ignored, a schema that lied to custom-pack authors.
            flags_str = str(rule.get('flags', 'g'))
            unknown_flags = set(flags_str) - {'g', 'i'}
            if unknown_flags:
                print(f'[ERROR] language rule {i} ("{name}"): unknown flag(s) '
                      f'{"".join(sorted(unknown_flags))!r} — supported: '
                      f'"g" (global), "i" (case-insensitive).', file=sys.stderr)
                sys.exit(1)
            re_flags = re.IGNORECASE if 'i' in flags_str else 0
            count = 0 if 'g' in flags_str else 1
            try:
                compiled = re.compile(pattern, re_flags)
            except re.error as e:
                print(f'[ERROR] language rule {i}: invalid regex pattern '
                      f'"{pattern}" ({e}).', file=sys.stderr)
                sys.exit(1)
            self.rules.append((name, compiled, replacement, count))

    # Elements whose text content must never receive a typography
    # substitution (spec §6.3/§19.3): a code sample or a cited command is
    # shown exactly as written, so a rule silently inserting a
    # non-breaking space into it would corrupt the example.
    _NO_TYPO_TAGS = frozenset({'code', 'pre'})

    def apply(self, text, disabled=None):
        """Applies the typography rules to `text`, skipping HTML tags and
        the text content of <code>/<pre> elements.

        `disabled`, if given, is an iterable of rule names (the `name`
        field of a language-pack rule, spec §19.2) to skip for this call —
        how an article's own `typo-units`/`typo-thousands` meta fields
        (§4.5) turn a rule off for just that article's page, without
        touching the shared engine instance used for every other article.

        The engine is called on already-assembled HTML (fact-box content,
        full articles), so a naive whole-string substitution risks a future
        rule corrupting tag syntax (spec §19.3). Splitting on tags and only
        running rules on the text segments between them makes that
        structurally impossible, not just accidentally safe.

        The split pattern requires a tag name or `/` right after `<` (real
        tags always have one) and forbids crossing another `<`/`>` inside
        the match: a naive `<[^>]+>` would treat a stray "< 5" ... "> 10"
        in ordinary prose as one giant fake tag spanning everything between
        them, silently skipping typography on real text in between."""
        disabled = disabled or ()
        segments = re.split(r'(</?[a-zA-Z][^<>]*>)', text)
        skip_depth = 0
        for i, segment in enumerate(segments):
            if segment.startswith('<') and segment.endswith('>'):
                m = re.match(r'</?([a-zA-Z][a-zA-Z0-9]*)', segment)
                if m and m.group(1).lower() in self._NO_TYPO_TAGS:
                    if segment.startswith('</'):
                        skip_depth = max(0, skip_depth - 1)
                    else:
                        skip_depth += 1
                continue
            if skip_depth > 0:
                continue
            for name, pattern, replacement, count in self.rules:
                if name in disabled:
                    continue
                segment = pattern.sub(replacement, segment, count=count)
            segments[i] = segment
        return ''.join(segments)


def apply_typo(typo_engine, text, disabled=None):
    """`typo_engine.apply(text, disabled)` if there's an engine, `text`
    unchanged otherwise (--no-typography / typo: off pass None, §4.5/
    §19.6) — the `if typo_engine:` guard every call site needs, in one
    place instead of copied at each of them."""
    return typo_engine.apply(text, disabled) if typo_engine else text


def read_text_file(path):
    """Every source-file read goes through here. utf-8-sig, not utf-8:
    it silently absorbs a Windows-style BOM (a BOM'd full-article used
    to leak a literal U+FEFF into the published HTML and break its first
    heading, since '\\ufeff# Title' is not a heading line) and reads
    BOM-less files identically. A file that isn't valid UTF-8 dies with
    a clean [ERROR] naming the file and byte offset instead of a raw
    UnicodeDecodeError traceback."""
    try:
        return Path(path).read_text(encoding='utf-8-sig')
    except UnicodeDecodeError as e:
        print(f'[ERROR] {path}: not valid UTF-8 (byte offset {e.start}: '
              f'{e.reason}).', file=sys.stderr)
        sys.exit(1)


def load_language(lang_dir, lang='fr', language_file=None):
    """Loads the language pack (typography rules + interface strings) for `lang`.

    The built-in pack for `lang` is used as a base (English if `lang` is
    neither 'fr' nor 'en'). An override file's "rules" replace the base
    rules wholesale, but its "strings" are merged key by key on top of the
    base strings — a partial override file only needs to define the keys
    it wants to change. `language_file`, when given (--language-file,
    spec §19.5 priority 1), is used as that override file instead of the
    conventional `{lang_dir}/{lang}.json` — same merge semantics either way.
    """
    if lang == 'fr':
        base = json.loads(LANG_FR)
    else:
        base = json.loads(LANG_EN)

    if language_file:
        lang_file = Path(language_file)
    elif lang_dir is None:
        # No series directory in play (themes-gallery, §11.7): the
        # embedded pack IS the answer, there is nothing to override with.
        return base
    else:
        lang_file = lang_dir / f'{lang}.json'
    if lang_file.exists():
        try:
            override = json.loads(read_text_file(lang_file))
        except (ValueError, RecursionError) as e:
            # ValueError covers json.JSONDecodeError; RecursionError guards
            # a deeply-nested array/object from crashing the parser itself.
            print(f'[ERROR] {lang_file}: invalid JSON ({e}).', file=sys.stderr)
            sys.exit(1)
        if not isinstance(override, dict):
            print(f'[ERROR] {lang_file}: must be a JSON object.', file=sys.stderr)
            sys.exit(1)
        rules = override.get('rules', base.get('rules', []))
        strings = override.get('strings', {})
        if not isinstance(rules, list):
            print(f'[ERROR] {lang_file}: "rules" must be a list.', file=sys.stderr)
            sys.exit(1)
        if not isinstance(strings, dict):
            print(f'[ERROR] {lang_file}: "strings" must be an object.', file=sys.stderr)
            sys.exit(1)
        # Every interface string must be a string: a non-string value
        # crashes apply_strings' str.replace with a raw TypeError.
        for key, val in strings.items():
            if not isinstance(val, str):
                print(f'[ERROR] {lang_file}: strings["{key}"] must be a string '
                      f'(got {type(val).__name__}).', file=sys.stderr)
                sys.exit(1)
        return {
            'lang': override.get('lang', base.get('lang', lang)),
            'name': override.get('name', base.get('name', lang)),
            'rules': rules,
            'strings': {**base.get('strings', {}), **strings},
        }
    elif language_file:
        print(f'[ERROR] --language-file {language_file}: file not found.', file=sys.stderr)
        sys.exit(1)

    return base


_PLACEHOLDER_RE = re.compile(r'\{\{(\w+)\}\}')


def fill_placeholders(template, mapping):
    """Fills {{key}} placeholders from `mapping` in a SINGLE left-to-right
    pass. Because re.sub never re-scans its own replacement text, a value
    that itself contains a {{...}} token (e.g. a literal {{css}} an author
    typed into page_title, or a {{js_nav}} in a fact-box) is emitted
    verbatim rather than being substituted by a later key — the
    order-dependent str.replace chain this replaces let author content
    inject templates into the escaped <title>/<meta> sinks (§18.4). An
    unknown token is left untouched (missing placeholders are ignored,
    §18.4)."""
    return _PLACEHOLDER_RE.sub(lambda m: mapping.get(m.group(1), m.group(0)), template)


def apply_strings(text, strings):
    """Replaces {{str_KEY}} placeholders in `text` with values from `strings`."""
    for key, value in strings.items():
        text = text.replace('{{str_' + key + '}}', value)
    return text


# ============================================================================
# MARKDOWN TO HTML CONVERTER
# ============================================================================

def md_inline(text):
    """Converts inline Markdown formatting to HTML."""
    # Inline code spans (§6.3) come first, before any other substitution
    # below, for two reasons: their content must never be reinterpreted
    # as further Markdown (`` `**not bold**` `` stays literal), and —
    # unlike the rest of this function, which never touches < or > so
    # hand-written raw HTML can pass through (§6.2) — code content IS
    # HTML-escaped, since it's meant to be shown exactly as written even
    # if it looks like a tag. Matched spans are pulled out into \x00N\x00
    # placeholders and restored at the very end, once nothing else in
    # this function can touch them. `\`` (escaped backtick) never opens
    # or closes a span; a stray one left over after matching is just a
    # literal backtick, restored in the final cleanup pass.
    code_spans = []

    def _code_span(m):
        content = html_escape(m.group(1), quote=False)
        code_spans.append(f'<code>{content}</code>')
        return f'\x00{len(code_spans) - 1}\x00'

    text = re.sub(r'(?<!\\)`([^`]+?)(?<!\\)`', _code_span, text)

    # Escape ampersands before inserting our own tags
    text = text.replace('&', '&amp;')
    # Inline images: `![alt](src)` anywhere in a line. Unlike links —
    # restricted to http(s) — the src may be a relative path (images
    # live in articles/img/, copied to public/img/ at build). The tag
    # goes straight into a placeholder so the bold/italic/link rules
    # below can never rewrite its inside. Standalone image lines never
    # reach this point: convert_markdown() turns them into <figure>
    # blocks (with optional caption) first.
    def _inline_img(m):
        alt = m.group(1).replace('"', '&quot;')
        src = m.group(2).replace('"', '&quot;')
        # The optional Markdown title becomes a title="" attribute (a
        # tooltip), never a <figcaption>: a caption is block-level and
        # this image sits inside a sentence (§6.1). Deliberately NOT run
        # through md_inline() or the typography engine — both emit tags
        # and non-breaking spaces, which have no business inside an
        # attribute value. Escaping " is what makes it safe there; & is
        # already escaped globally further up.
        title = m.group(3)
        title_attr = ' title="{}"'.format(title.replace('"', '&quot;')) if title else ''
        code_spans.append(f'<img src="{src}" alt="{alt}"{title_attr}>')
        return f'\x00{len(code_spans) - 1}\x00'

    # The optional title group mirrors _FIGURE_LINE_RE's. Without it,
    # `![alt](src "Titre")` mid-paragraph matched NOTHING — the src class
    # stops at the first space — so the raw Markdown survived into the
    # page, and the typography engine then read the "!" of "![alt]" as
    # high punctuation and put a non-breaking space in front of it.
    # Bounded quantifiers only: no ReDoS window.
    text = re.sub(r'!\[([^\]]*)\]\(([^)\s"]+)(?:\s+"([^"]*)")?\)', _inline_img, text)
    # Bold before italic
    text = re.sub(r'\*\*(.+?)\*\*', r'<strong>\1</strong>', text)
    text = re.sub(r'(?<!\*)\*([^*]+?)\*(?!\*)', r'<em>\1</em>', text)
    # Markdown links. The captured URL goes into an href="..." attribute,
    # so it must be attribute-escaped — exactly like _inline_img does for
    # its src above. Without this, a `"` in the URL closes the attribute
    # early and any following text is parsed as further tag attributes or
    # markup: `[x](https://a" onmouseover="location=name)` would inject a
    # live event handler, and `>` would let the URL close the <a> tag and
    # open an arbitrary element (§6.3's http(s)-only restriction is not by
    # itself a containment guarantee). `&` is already globally escaped
    # above, so only " < > remain to handle here (matching _inline_img).
    def _md_link(m):
        label = m.group(1)
        href = m.group(2).replace('"', '&quot;').replace('<', '&lt;').replace('>', '&gt;')
        return f'<a href="{href}" target="_blank" rel="noopener">{label}</a>'

    # Label class excludes '[' as well as ']': a run of "["×N would
    # otherwise make each '[' rescan the whole line for a closing ']('
    # (O(n²)). A real link label doesn't contain a bare '[', so this
    # doesn't change normal parsing.
    text = re.sub(r'\[([^\]\[]+)\]\((https?://[^\)]+)\)', _md_link, text)
    # Inline footnotes
    text = re.sub(r'\[\^([\w]+)\]', r'<sup>[^\1]</sup>', text)
    # A backslash-escaped backtick that never became part of a span
    # (either unpaired, or both delimiters were escaped) is just a
    # literal backtick. Likewise \> (only meaningful at the very start of
    # a line, where it stops the block-level loop above from opening a
    # blockquote — see §6.3) renders as a plain >, wherever it appears.
    text = text.replace('\\`', '`')
    text = text.replace('\\>', '>')

    for idx, html in enumerate(code_spans):
        text = text.replace(f'\x00{idx}\x00', html)

    return text


def parse_table_row(line):
    """Splits a Markdown table row '| a | b | c |' into cells."""
    line = line.strip()
    if line.startswith('|'):
        line = line[1:]
    if line.endswith('|'):
        line = line[:-1]
    return [strip_ws(cell) for cell in line.split('|')]


def is_table_separator(line):
    """True if the line is a table separator."""
    line = line.strip()
    return bool(line) and bool(re.match(r'^\|?[\s\-:|]+\|?$', line)) and '-' in line


# Void HTML elements: never contribute an unclosed "open" to raw-HTML
# depth tracking (no closing tag is expected).
_VOID_HTML_TAGS = frozenset({
    'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link',
    'meta', 'param', 'source', 'track', 'wbr',
})

# The attribute run is [^<>]*? (not [^>]*?): forbidding a nested '<'
# bounds each match attempt to the distance to the next '<', which
# removes the O(n²) backtracking a line of "<a"×N would otherwise cause
# (each '<' rescanned the whole remainder looking for a '>' that never
# came). A valid tag never contains an unescaped '<' in its attribute
# area, so this doesn't change recognition of real markup; it stays lazy
# so the (/?) group still captures a trailing self-closing slash.
_HTML_TAG_RE = re.compile(r'<(/?)([a-zA-Z][a-zA-Z0-9]*)\b[^<>]*?(/?)>')

# A fenced code block delimiter (§6.3): three backticks alone, optionally
# followed immediately (no space) by a language hint on the opening line.
# Whether a given ``` line opens or closes a block is decided by parser
# state (in_code_block), not by this regex — a closing line is always
# just "```" with nothing after it, which this pattern also matches
# (empty language group).
_CODE_FENCE_RE = re.compile(r'^```(\S*)$')

# A standalone image line (§6.1): the whole line is `![alt](src)`, with
# an optional quoted caption after the path. Unlike links — restricted
# to http(s) — the src may be a relative path: images live in
# articles/img/ and are copied to public/img/ at build time.
_FIGURE_LINE_RE = re.compile(r'^!\[([^\]]*)\]\(\s*([^)\s"]+)(?:\s+"([^"]*)")?\s*\)$')


def _html_tag_depth_delta(line):
    """Net change in open-raw-HTML-tag depth contributed by `line`: +1 per
    unclosed opening tag, -1 per closing tag, 0 for void/self-closing
    tags. Used to track a multi-line raw HTML block (e.g. a hand-written
    <a href="..."> wrapping several lines of content, per spec §6.2)
    through the line-by-line Markdown converter."""
    delta = 0
    for m in _HTML_TAG_RE.finditer(line):
        closing, tag, self_closing = m.group(1), m.group(2).lower(), m.group(3)
        if closing:
            delta -= 1
        elif self_closing or tag in _VOID_HTML_TAGS:
            continue
        else:
            delta += 1
    return delta


# Inline-level HTML tags: a line starting with one of these AND fully
# opened+closed within that same line is still ordinary paragraph text
# (spec §6.2 allows inline HTML anywhere in free text, including at the
# start of a sentence, e.g. "<strong>Word</strong> opens the sentence.").
# An inline tag left unclosed on its opening line — e.g. a hand-written
# <a href="..." class="card"> wrapping several lines of block content —
# still starts raw HTML passthrough, same as any other tag.
_INLINE_HTML_TAGS = frozenset({
    'a', 'abbr', 'b', 'bdi', 'bdo', 'cite', 'code', 'data', 'dfn', 'em',
    'i', 'kbd', 'mark', 'q', 's', 'samp', 'small', 'span', 'strong',
    'sub', 'sup', 'time', 'u', 'var', 'wbr',
})


def _is_raw_html_line(line):
    """True if `line` should be treated as the start of raw HTML
    passthrough rather than ordinary paragraph text."""
    m = re.match(r'^\s*</?([a-zA-Z][a-zA-Z0-9]*)', line)
    if not m:
        return False
    tag = m.group(1).lower()
    if tag in _INLINE_HTML_TAGS and _html_tag_depth_delta(line) == 0:
        return False
    return True


def _is_paragraph_continuation(line, lines, idx, n):
    """True if `line` continues the paragraph in progress rather than
    starting a new block element (heading, list, table, raw HTML,
    footnote definition, blank/thematic break). Per spec §6.1, a bare
    line break does not end a Markdown paragraph — only a blank line does."""
    if line.strip() == '' or line.strip() == '---':
        return False
    if line.startswith('#'):
        return False
    if _is_raw_html_line(line):
        return False
    if re.match(r'^\d+\.\s+', line):
        return False
    if re.match(r'^-\s+', line):
        return False
    if re.match(r'^\[\^([\w]+)\]:\s*', line):
        return False
    if line.strip().startswith('|') and idx + 1 < n and is_table_separator(lines[idx + 1]):
        return False
    if line.startswith('>'):
        return False
    if _CODE_FENCE_RE.match(line):
        return False
    if _FIGURE_LINE_RE.match(line):
        return False
    return True


def convert_markdown(md_text, typo_engine=None, disabled=None):
    """Converts the Markdown body to HTML."""
    lines = md_text.split('\n')
    out = []
    in_list = None
    raw_html_depth = 0
    in_code_block = False
    i = 0
    n = len(lines)

    def close_list():
        nonlocal in_list
        if in_list:
            out.append(f'  </{in_list}>')
            in_list = None

    while i < n:
        raw = lines[i]
        line = rstrip_ws(raw)

        # Already inside a multi-line raw HTML block (opened by an
        # earlier line whose tag wasn't closed yet): every line belongs
        # to it verbatim until the depth count returns to 0.
        if raw_html_depth > 0:
            out.append(rstrip_ws(raw))
            raw_html_depth = max(0, raw_html_depth + _html_tag_depth_delta(line))
            i += 1
            continue

        # Already inside a fenced code block (§6.3): every line is
        # reproduced verbatim (HTML-escaped, never interpreted as
        # Markdown — not even a blank line or "---") until the closing
        # ``` is found. An opening emitted here with no matching close by
        # end of file is caught as an unclosed <pre>/<code> tag by the
        # generic HTML balance check before the page is written (§13) —
        # no special end-of-file handling needed here.
        if in_code_block:
            if line == '```':
                out.append('  </code></pre>')
                in_code_block = False
            else:
                out.append(html_escape(raw, quote=False))
            i += 1
            continue

        if line.strip() == '' or line.strip() == '---':
            i += 1
            continue

        if line.startswith('# ') and not line.startswith('## '):
            out.append(f'  <h1>{md_inline(strip_ws(line[2:]))}</h1>')
            i += 1
            continue
        if line.startswith('## '):
            close_list()
            out.append(f'  <h2>{md_inline(strip_ws(line[3:]))}</h2>')
            i += 1
            continue
        if line.startswith('### '):
            close_list()
            out.append(f'  <h3>{md_inline(strip_ws(line[4:]))}</h3>')
            i += 1
            continue

        # Standalone image (§6.1): the whole line is `![alt](src)`, with
        # an optional quoted caption — rendered as a <figure>, the
        # caption as a small centered <figcaption> under the image.
        # Mid-paragraph images are md_inline()'s job and have no caption.
        m_fig = _FIGURE_LINE_RE.match(line)
        if m_fig:
            close_list()
            alt = html_escape(m_fig.group(1), quote=True)
            src = html_escape(m_fig.group(2), quote=True)
            caption = m_fig.group(3)
            if caption:
                out.append(f'  <figure class="figure"><img src="{src}" alt="{alt}"><figcaption class="figure-caption">{md_inline(caption)}</figcaption></figure>')
            else:
                out.append(f'  <figure class="figure"><img src="{src}" alt="{alt}"></figure>')
            i += 1
            continue

        # Fenced code block, opening (§6.3). An optional language hint
        # right after the backticks, no space, becomes an informational
        # class="language-xxx" — no syntax highlighting is applied.
        m_fence = _CODE_FENCE_RE.match(line)
        if m_fence:
            close_list()
            lang = m_fence.group(1)
            lang_class = f' class="language-{html_escape(lang, quote=True)}"' if lang else ''
            out.append(f'  <pre><code{lang_class}>')
            in_code_block = True
            i += 1
            continue

        # Blockquote (§6.3): consecutive >-prefixed lines merge into one
        # paragraph, the same way ordinary paragraph lines do (§6.1) — a
        # single quote of a single paragraph, not multi-paragraph or
        # nested (§15).
        if line.startswith('>'):
            close_list()
            quote_lines = [strip_ws(line[1:])]
            i += 1
            while i < n and rstrip_ws(lines[i]).startswith('>'):
                quote_lines.append(strip_ws(rstrip_ws(lines[i])[1:]))
                i += 1
            out.append(f'  <blockquote><p>{md_inline(" ".join(quote_lines))}</p></blockquote>')
            continue

        # Table
        if line.strip().startswith('|') and i + 1 < n and is_table_separator(lines[i + 1]):
            close_list()
            header_cells = parse_table_row(line)
            out.append('  <table class="comparison-table">')
            out.append('    <thead>')
            out.append('      <tr>')
            for cell in header_cells:
                out.append(f'        <th>{md_inline(cell)}</th>')
            out.append('      </tr>')
            out.append('    </thead>')
            out.append('    <tbody>')
            i += 2
            while i < n and lines[i].strip().startswith('|'):
                row_cells = parse_table_row(lines[i])
                out.append('      <tr>')
                for cell in row_cells:
                    out.append(f'        <td>{md_inline(cell)}</td>')
                out.append('      </tr>')
                i += 1
            out.append('    </tbody>')
            out.append('  </table>')
            continue

        # Raw HTML (line starting with a block-level tag, or an inline
        # tag left unclosed -- the opening of a multi-line block)
        if _is_raw_html_line(line):
            close_list()
            out.append(rstrip_ws(raw))
            raw_html_depth = max(0, _html_tag_depth_delta(line))
            i += 1
            continue

        # Ordered lists
        m_ol = re.match(r'^\d+\.\s+(.*)', line)
        if m_ol:
            if in_list != 'ol':
                close_list()
                out.append('  <ol>')
                in_list = 'ol'
            out.append(f'    <li>{md_inline(m_ol.group(1))}</li>')
            i += 1
            continue

        # Unordered lists
        m_ul = re.match(r'^-\s+(.*)', line)
        if m_ul:
            if in_list != 'ul':
                close_list()
                out.append('  <ul>')
                in_list = 'ul'
            out.append(f'    <li>{md_inline(m_ul.group(1))}</li>')
            i += 1
            continue

        # Footnotes (definitions)
        # [ \t]*, not \s* — \s matches U+00A0 like str.strip() does, which
        # would swallow a non-breaking space right after the ':' instead
        # of preserving it as the footnote body's first character (§7.6).
        m_ref = re.match(r'^\[\^([\w]+)\]:[ \t]*(.*)', line)
        if m_ref:
            close_list()
            num, txt = m_ref.group(1), m_ref.group(2)
            out.append(f'  <p><sup>[^{num}]</sup>: {md_inline(txt)}</p>')
            i += 1
            continue

        # Regular paragraph: merge consecutive lines with no blank line
        # between them into a single paragraph (spec §6.1) — a lone line
        # break is not a paragraph break in Markdown.
        close_list()
        para_lines = [line]
        i += 1
        while i < n and _is_paragraph_continuation(rstrip_ws(lines[i]), lines, i, n):
            para_lines.append(rstrip_ws(lines[i]))
            i += 1
        out.append(f'  <p>{md_inline(" ".join(para_lines))}</p>')

    close_list()
    html = '\n'.join(out)
    html = apply_typo(typo_engine, html, disabled)

    return html


# ============================================================================
# EXTENDED MARKDOWN PARSER
# ============================================================================

class Slide:
    def __init__(self, slide_type='standard'):
        self.slide_type = slide_type  # 'cover', 'standard', 'series-nav', 'full-article'
        self.tag = None
        self.h2 = None
        self.h1 = None
        self.summary = None
        self.fact_label = None
        self.fact_content = None
        self.source = None
        self.highlight = None
        self.highlight_caption = None
        self.comment = None  # Review note (GLOSSARY.md) — parsed, never rendered
        self.extra_content = None  # series-nav/full-article only: unrecognized lines (fatal)
        self.article_file = None  # For full-article
        self.raw_meta = {}  # Raw metadata


def parse_metadata_block(text):
    """Parses the <!-- lwp:meta --> ... --- block at the top of the file."""
    meta = {}
    lines = strip_ws(text).split('\n')
    for line in lines:
        line = strip_ws(line)
        if line == '---':
            break
        if line.startswith('<!--') or line.endswith('-->'):
            continue
        if ':' in line:
            key, _, value = line.partition(':')
            meta[key.strip()] = strip_ws(value)
    return meta


def parse_markdown_extended(md_text):
    """Parses an extended Markdown file and returns
    (meta, slides, has_meta_block, content_before_meta).

    has_meta_block is False when no <!-- lwp:meta --> block was found at
    all (as opposed to one that parsed to an empty dict) — callers that
    must enforce §22.7 (a file must start with <!-- lwp:meta -->) need to
    tell the two apart, callers that don't (like audit, which never
    blocks) can just ignore it. content_before_meta is whatever non-blank
    text precedes the marker ('' when the file starts with it) — §22.7
    makes that fatal at build time too: it used to be silently discarded,
    which turned a stray first line into invisible data loss.
    """
    # Extract the meta block
    meta = {}
    has_meta_block = False
    content_before_meta = ''
    meta_match = re.search(r'<!--\s*lwp:meta\s*-->(.*?)(?:^|\n)---', md_text, re.DOTALL)
    if meta_match:
        has_meta_block = True
        content_before_meta = md_text[:meta_match.start()].strip()
        meta = parse_metadata_block(meta_match.group(1))
        # Strip the meta block from the text
        md_text = md_text[meta_match.end():]

    # Split into slides on --- (alone on its own line, surrounded by blank lines)
    # Uses a regex that captures the separators
    parts = re.split(r'\n---\n', md_text)

    slides = []
    for part in parts:
        part = strip_ws(part)
        if not part:
            continue

        slide = None

        # Detect the slide type
        slide_type_match = re.search(r'<!--\s*lwp:slide:\s*(\S+)\s*-->', part)
        if slide_type_match:
            slide_type = slide_type_match.group(1)
            slide = Slide(slide_type)
        elif '<!-- lwp:slide -->' in part:
            slide = Slide('standard')
        else:
            # With no marker, this is either orphan content or the first part
            # Ignore it if empty, otherwise treat it as a standard slide
            if part.strip():
                slide = Slide('standard')
            else:
                continue

        # For series-nav and full-article, read the directives. Anything
        # else in these slides is collected as extra_content — fatal at
        # validation (it used to be silently dropped, invisible data
        # loss). `comment:` is recognized on every slide type (GLOSSARY),
        # these two included.
        if slide.slide_type in ('series-nav', 'full-article'):
            extra_lines = []
            for line in part.split('\n'):
                stripped = strip_ws(line)
                if not stripped or stripped.startswith('<!-- lwp:slide'):
                    continue
                comment_match = re.match(r'^comment:[ \t]*(.*)', stripped)
                if comment_match:
                    slide.comment = comment_match.group(1)
                    continue
                if slide.slide_type == 'full-article':
                    article_match = re.match(r'^article:\s*(.+)$', stripped)
                    if article_match:
                        slide.article_file = article_match.group(1).strip()
                        continue
                extra_lines.append(stripped)
            if extra_lines:
                slide.extra_content = '\n'.join(extra_lines)
            slides.append(slide)
            continue

        # For cover and standard, parse the fields
        lines = part.split('\n')
        content_lines = []
        in_content = False

        for line in lines:
            stripped = strip_ws(line)

            # Ignore slide markers
            if stripped.startswith('<!-- lwp:slide'):
                continue

            # Detect key: value fields
            # [ \t]*, not \s* — \s matches U+00A0 like str.strip() does,
            # which would swallow a non-breaking space right after the
            # ':' instead of preserving it as the value's first character
            # (§7.6).
            field_match = re.match(r'^(tag|summary|fact-label|source|highlight|highlight-caption|comment):[ \t]*(.*)', stripped)
            if field_match and not in_content:
                key = field_match.group(1)
                value = field_match.group(2)
                if key == 'tag':
                    slide.tag = value
                elif key == 'summary':
                    slide.summary = value
                elif key == 'fact-label':
                    slide.fact_label = value
                elif key == 'source':
                    slide.source = value
                elif key == 'highlight':
                    slide.highlight = value
                elif key == 'highlight-caption':
                    slide.highlight_caption = value
                elif key == 'comment':
                    slide.comment = value  # review note — never rendered (GLOSSARY.md)
            # `#` only ever means "this cover's own title" and `##` only
            # ever means "this non-cover slide's own title" — the other
            # heading level can never legitimately set anything here (a
            # non-cover slide is never rendered from slide.h1, a cover
            # never from slide.h2 — render_slide() treats any slide_type
            # other than 'cover' as standard, an unrecognized type
            # included, since nothing validates that token; matched here
            # for the two to agree), so it must fall through to content
            # immediately rather than being silently captured into an
            # attribute nothing ever reads.
            elif (slide.slide_type == 'cover' and stripped.startswith('# ')
                  and not stripped.startswith('## ') and not in_content and slide.h1 is None):
                slide.h1 = strip_ws(stripped[2:])
            elif (slide.slide_type != 'cover' and stripped.startswith('## ')
                  and not in_content and slide.h2 is None):
                slide.h2 = strip_ws(stripped[3:])
            else:
                # This is content (the fact-box)
                if stripped:
                    in_content = True
                    content_lines.append(line)
                elif in_content:
                    content_lines.append('')

        # Free-form content becomes the fact-box
        if content_lines:
            slide.fact_content = strip_ws('\n'.join(content_lines))

        slides.append(slide)

    return meta, slides, has_meta_block, content_before_meta


def _is_safe_relative_filename(value):
    """True if `value` is a bare filename with no directory component —
    rejects absolute paths and any `../` traversal. series.json and the
    article: field are attacker-reachable (LLM-edited content, unattended
    CI) and get joined into real filesystem paths (Path(dir) / value) with
    no other containment check — Path('/x') / '/etc/passwd' silently
    discards the left side and resolves to '/etc/passwd', so this check is
    the first thing standing between that input and an arbitrary file
    read/write. It is a name-shape check only: it cannot see that a bare
    name is a symlink pointing outside the tree — _resolve_contained()
    below is the realpath barrier that catches that. `.` and `..` both
    satisfy `value == Path(value).name` yet are directories (a bare `..`
    used to crash with IsADirectoryError), and a NUL byte would raise a
    raw ValueError at open() time — both are rejected here explicitly."""
    if not value or value in ('.', '..') or '\x00' in value:
        return False
    return value == Path(value).name


def _resolve_contained(base_dir, value):
    """Resolve base_dir/value and return the real path only if it stays
    inside base_dir — otherwise None. This is the barrier the name-shape
    check (_is_safe_relative_filename) cannot provide: a bare filename
    that is itself a symlink into an outside file or directory passes the
    name check, and every read/copy site would otherwise follow it. A git
    repo can carry such symlinks, so an unattended build of an
    attacker-authored series would leak host files into the published
    output without this."""
    base = Path(base_dir).resolve()
    target = (base / value).resolve()
    if target == base or base in target.parents:
        return target
    return None


def validate_slides(slides, filename, has_meta_block=True, content_before_meta=''):
    """Rejects the parser edge cases the spec (§22) says must be fatal,
    instead of letting them silently corrupt or truncate the build:

    - the file has no <!-- lwp:meta --> block at all (§22.7)
    - the file has no slides at all (§22.10)
    - a cover slide with content after its fields (it has no fact-box to
      put that content in, so it would otherwise vanish silently, §22.12)
    - a full-article slide missing its required article: field (otherwise
      the raw {FULL_ARTICLE_PLACEHOLDER} leaks into the published HTML)
    - more than one full-article slide (otherwise str.replace() on the
      shared placeholder duplicates the first article over the rest and
      silently drops the others, §22.8)
    - more than one series-nav slide (§22.9)
    """
    if not has_meta_block:
        print(f'[ERROR] {filename}: file must start with a <!-- lwp:meta --> block.',
              file=sys.stderr)
        sys.exit(1)

    # §22.7: nothing but blank lines may precede the marker (a BOM is
    # already absorbed at read time, §13.1). This content used to be
    # silently discarded — invisible data loss for a stray first line.
    if content_before_meta:
        preview = content_before_meta.splitlines()[0][:60]
        print(f'[ERROR] {filename}: content found before the <!-- lwp:meta --> '
              f'block (starting with: "{preview}"). The file must start with the '
              f'marker; only blank lines may precede it.', file=sys.stderr)
        sys.exit(1)

    if not slides:
        print(f'[ERROR] {filename}: file has no slides.', file=sys.stderr)
        sys.exit(1)

    full_article_positions = []
    series_nav_positions = []

    for i, slide in enumerate(slides, 1):
        if slide.slide_type == 'cover' and slide.fact_content:
            print(f'[ERROR] {filename}: slide {i} (cover) has content after its '
                  f'fields, but a cover slide has no fact-box.', file=sys.stderr)
            sys.exit(1)

        # A cover renders only tag / # title / summary (+ comment, never
        # rendered anywhere). The other standard-slide fields are parsed
        # but never rendered on a cover — warn, don't fail: toggling a
        # slide between standard and cover while drafting is a normal
        # workflow, and the extra fields cost nothing.
        if slide.slide_type == 'cover':
            ignored = [name for name, value in (
                ('fact-label', slide.fact_label), ('source', slide.source),
                ('highlight', slide.highlight),
                ('highlight-caption', slide.highlight_caption)) if value is not None]
            if ignored:
                print(f'[WARNING] {filename}: slide {i} (cover) has field(s) '
                      f'{", ".join(ignored)} — parsed but never rendered on a '
                      f'cover slide.', file=sys.stderr)

        # series-nav / full-article: any line that isn't a recognized
        # directive (article:, comment:) would be silently dropped from
        # the rendering — fatal instead (§22.9/§22.8).
        if slide.slide_type in ('series-nav', 'full-article') and slide.extra_content:
            preview = slide.extra_content.splitlines()[0][:60]
            print(f'[ERROR] {filename}: slide {i} ({slide.slide_type}) has '
                  f'content that this slide type never renders (starting '
                  f'with: "{preview}").', file=sys.stderr)
            sys.exit(1)

        if slide.slide_type == 'full-article':
            full_article_positions.append(i)
            if not slide.article_file:
                print(f'[ERROR] {filename}: slide {i} is a full-article slide '
                      f'without an article: field.', file=sys.stderr)
                sys.exit(1)
            if not _is_safe_relative_filename(slide.article_file):
                print(f'[ERROR] {filename}: slide {i} has an unsafe article: '
                      f'value "{slide.article_file}" (must be a plain filename, '
                      f'no path separators, no "..").', file=sys.stderr)
                sys.exit(1)

        if slide.slide_type == 'series-nav':
            series_nav_positions.append(i)

    if len(full_article_positions) > 1:
        print(f'[ERROR] {filename}: {len(full_article_positions)} full-article '
              f'slides found (slides {full_article_positions}), only one is '
              f'allowed per article.', file=sys.stderr)
        sys.exit(1)

    if len(series_nav_positions) > 1:
        print(f'[ERROR] {filename}: {len(series_nav_positions)} series-nav '
              f'slides found (slides {series_nav_positions}), only one is '
              f'allowed per article.', file=sys.stderr)
        sys.exit(1)


# ============================================================================
# SLIDE HTML RENDERING
# ============================================================================

def render_slide(slide, slide_num, total_slides, typo_engine, strings, disabled=None):
    """Generates the HTML for a slide."""
    num_str = f'{slide_num:02d} / {total_slides:02d}'

    if slide.slide_type == 'cover':
        tag = apply_typo(typo_engine, slide.tag or '', disabled)
        h1 = apply_typo(typo_engine, slide.h1 or '', disabled)
        summary = apply_typo(typo_engine, slide.summary or '', disabled)

        parts = [f'<section class="slide slide-cover" id="s{slide_num}">']
        parts.append(f'  <span class="slide-num">{num_str}</span>')
        if tag:
            parts.append(f'  <span class="slide-tag">{tag}</span>')
        parts.append(f'  <h1>{h1}</h1>')
        if summary:
            parts.append(f'  <p class="summary">{summary}</p>')
        parts.append('</section>')
        return '\n'.join(parts)

    elif slide.slide_type == 'series-nav':
        # Will be generated later by the navigation engine
        title = strings.get('series_nav_title', 'This series')
        return f'<section class="slide" id="s{slide_num}-series">\n  <h2>{title}</h2>\n  <div class="series-list">\n{{SERIES_NAV_PLACEHOLDER}}\n  </div>\n</section>'

    elif slide.slide_type == 'full-article':
        # Content will be injected later
        tag_text = strings.get('full_article_tag', 'Full article')
        return f'<section class="slide full-article" id="s{slide_num}">\n  <span class="slide-num">{num_str}</span>\n  <span class="slide-tag">{tag_text}</span>\n{{FULL_ARTICLE_PLACEHOLDER}}\n</section>'

    else:  # standard
        tag = apply_typo(typo_engine, slide.tag or '', disabled)
        h2 = apply_typo(typo_engine, slide.h2 or '', disabled)
        summary = apply_typo(typo_engine, slide.summary or '', disabled)

        parts = [f'<section class="slide" id="s{slide_num}">']
        parts.append(f'  <span class="slide-num">{num_str}</span>')
        if tag:
            parts.append(f'  <span class="slide-tag">{tag}</span>')
        if h2:
            parts.append(f'  <h2>{h2}</h2>')
        if summary:
            parts.append(f'  <p class="summary">{summary}</p>')

        # Highlight — no empty caption span when there is no caption
        # (§12.3: the caption is emitted only if present)
        if slide.highlight:
            highlight = apply_typo(typo_engine, slide.highlight, disabled)
            caption = apply_typo(typo_engine, slide.highlight_caption or '', disabled)
            caption_html = f'<span class="highlight-caption">{caption}</span>' if caption else ''
            parts.append(f'  <div class="highlight"><span class="highlight-figure">{highlight}</span>{caption_html}</div>')

        # Fact-box
        if slide.fact_content:
            content_html = convert_markdown(slide.fact_content, typo_engine, disabled)
            if slide.fact_label:
                label = apply_typo(typo_engine, slide.fact_label, disabled)
                parts.append(f'  <div class="fact-box">')
                parts.append(f'    <div class="fact-label">{label}</div>')
                # A single wrapping <div> (not a <p>) around the converted
                # content, regardless of what it starts with: fact-box body
                # text isn't always a bare paragraph — a heading (#/##/###)
                # or a list can legitimately open it too, and a <p> can't
                # validly contain block-level children (a browser silently
                # closes it right before one, which would both break the
                # visual structure and stop the .fact-content CSS scoping
                # below from reaching anything past that point). Font-size/
                # color inherit from the wrapping div, so this is visually
                # identical to the old per-<p> class for plain-paragraph
                # content — the fix only changes anything for non-paragraph
                # content.
                parts.append(f'    <div class="fact-content">{content_html}</div>')
                parts.append(f'  </div>')
            else:
                # No fact-label: free-form text, no box (spec 4.3) — but
                # still wrapped in a .slide-body div so a heading in the
                # body (a `#`/`##`/`###`, §22.2) can be scoped SMALLER than
                # the slide's own `##` title. Without the wrapper the body
                # heading was a bare <h1>/<h2>, a sibling of the slide
                # title, indistinguishable by selector — a body `#` then
                # rendered at cover-title size (clamp(28px,…,52px)), bigger
                # than the slide's own title. The div carries no font-size
                # itself, so plain paragraphs render exactly as before.
                parts.append(f'  <div class="slide-body">{content_html}</div>')

        # Source
        if slide.source:
            source_label = strings.get('source_label', 'Source')
            source_line = apply_typo(typo_engine, f'{source_label} : {slide.source}', disabled)
            parts.append(f'  <p class="source">{source_line}</p>')

        parts.append('</section>')
        return '\n'.join(parts)


# ============================================================================
# SERIES NAVIGATION
# ============================================================================

def build_series_nav(current_file, series_data, strings, typo_engine):
    """Generates the navigation block HTML for the current article.

    typo_engine here is always the *build's* engine, never the hosting
    article's own article_typo_engine: a `typo: off` on article X only
    scopes to X's own page content (§4.5) — X's fragments reused
    elsewhere, including every entry rendered here (even X's own), follow
    the normal build-wide rules, exactly like build_index()'s cards."""
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data
    read = strings.get('series_read', 'Read the article')
    current_status = strings.get('series_current_status', 'Currently reading')
    back = strings.get('series_back_to_index', 'Back to index')
    parts = []
    for entry in articles:
        # card_label/nav_title/nav_desc are already resolved by
        # resolve_article_fields() (series.json > article meta > fallback
        # chain, §20.3.1).
        label = apply_typo(typo_engine, entry.get('card_label', ''))
        # No empty <div class="series-label"> when there is no label
        label_html = f'      <div class="series-label">{label}</div>\n' if label else ''
        title = apply_typo(typo_engine, entry['nav_title'])
        desc = apply_typo(typo_engine, entry['nav_desc'])
        if entry['page_dest'] == current_file:
            parts.append(TEMPLATE_SERIES_NAV_ITEM_CURRENT.format(
                label_html=label_html,
                title=title,
                desc=desc,
                status=current_status))
        else:
            parts.append(TEMPLATE_SERIES_NAV_ITEM_LINK.format(
                file=html_escape(entry['page_dest'], quote=True),
                label_html=label_html,
                title=title,
                desc=desc,
                read=read))
    parts.append(TEMPLATE_SERIES_NAV_BACK.format(back=back))
    return '\n'.join(parts)


# ============================================================================
# INDEX PAGE
# ============================================================================

def build_index(series_data, css, typo_engine, strings, lang='fr', index_extra='', build_stamp=''):
    """Generates the index page."""
    meta = series_meta_of(series_data)
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data

    title = apply_typo(typo_engine, meta.get('title', strings.get('series_untitled_fallback', 'Article series')))
    subtitle = apply_typo(typo_engine, meta.get('subtitle', ''))
    version = meta.get('version', '')
    intro = apply_typo(typo_engine, meta.get('intro', ''))

    # <title> is RCDATA: unlike {{series_title}} (rendered inside the page
    # body, where raw HTML is allowed by design, same as a slide's own
    # slide_title — spec §4.3), a value here containing a literal
    # </title> would close the element early and let anything after it
    # execute as real markup.
    title_clean = strip_ws(re.sub(r'<[^<>]+>', ' ', title))

    # Cards
    read = strings.get('series_read', 'Read the article')
    cards = []
    for entry in articles:
        # card_title/card_desc/card_label are already fully resolved by
        # resolve_article_fields() (series.json > article meta > fallback,
        # §20.3.1) — no fallback logic needed here.
        label = apply_typo(typo_engine, entry.get('card_label', ''))
        card_title = apply_typo(typo_engine, entry.get('card_title', ''))
        card_desc = apply_typo(typo_engine, entry.get('card_desc', ''))
        # href is an attribute context: entry['page_dest'] is validated to be a
        # plain filename (validate_series), but it's escaped here too as
        # defense in depth against a future validation gap.
        label_html = f'\n  <div class="article-number">{label}</div>' if label else ''
        card = f'''<a href="{html_escape(entry['page_dest'], quote=True)}" class="article-card">{label_html}
  <div class="article-title">{card_title}</div>
  <div class="article-desc">{card_desc}</div>
  <div class="article-cta">→ {read}</div>
</a>'''
        cards.append(card)

    # Index footer — the series-wide author/license (series_meta only:
    # per-article values belong on the articles' own pages). Raw HTML
    # passthrough like every visible rendering (§6.2).
    index_footer = ''
    footer_author = apply_typo(typo_engine, meta.get('author', ''))
    footer_license = apply_typo(typo_engine, meta.get('license', ''))
    footer_parts = []
    if footer_author:
        footer_parts.append(f'  <div class="footer-byline">{footer_author}</div>')
    if footer_license:
        footer_parts.append(f'  <div class="footer-license">{footer_license}</div>')
    if footer_parts:
        index_footer = '<footer class="page-footer">\n' + '\n'.join(footer_parts) + '\n</footer>'

    # Interface strings on the SKELETON first (template + the user's
    # index_extra fragment, which is a template file, not content), then
    # every data placeholder in a SINGLE pass (fill_placeholders), so a
    # literal {{str_KEY}} / {{css}} / {{cards}} inside series_meta or card
    # text stays literal instead of being re-substituted into the
    # tag-stripped <title> or a card (§18.4).
    html = apply_strings(TEMPLATE_INDEX, strings)
    index_extra = apply_strings(index_extra, strings)
    # No visible empty pill when series_meta has no version: drop the
    # whole span (the index markup is fixed, §18.2, so this line-level
    # removal can't break a user template).
    if not version:
        html = html.replace('\n  <span class="version-tag">{{series_version}}</span>', '')
    html = fill_placeholders(html, {
        'lang': lang, 'title': title_clean, 'css': css,
        'series_title': title, 'series_subtitle': subtitle,
        'series_version': version, 'series_intro': intro,
        'cards': '\n'.join(cards), 'index_footer': index_footer,
        'js_index': apply_strings(TEMPLATE_INDEX_JS, strings),
        'index_extra': index_extra, 'build_stamp': build_stamp,
    })

    validate_html(html, 'index.html')
    return html


def build_readme(series_data, sd, output_dir, strings):
    """Generates README.md content: series title/subtitle/intro from
    series_meta, then a numbered list of articles linking to their built
    HTML file (spec §8.3)."""
    meta = series_meta_of(series_data)
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data

    title = meta.get('title', strings.get('series_untitled_fallback', 'Article series'))
    subtitle = meta.get('subtitle', '')
    intro = meta.get('intro', '')

    lines = [f'# {title}']
    if subtitle:
        lines.append('')
        lines.append(subtitle)
    if intro:
        lines.append('')
        lines.append(intro)
    lines.append('')
    lines.append('## Articles')
    lines.append('')
    for i, entry in enumerate(articles, 1):
        article_title = entry.get('nav_title', entry.get('page_dest', ''))
        article_desc = entry.get('nav_desc', '')
        # as_posix(): os.path.relpath yields backslashes on Windows,
        # which are broken Markdown link separators.
        link = Path(os.path.relpath(output_dir / entry['page_dest'], start=sd)).as_posix()
        if article_desc:
            lines.append(f'{i}. [{article_title}]({link}) — {article_desc}')
        else:
            lines.append(f'{i}. [{article_title}]({link})')
    lines.append('')

    return '\n'.join(lines)


# ============================================================================
# HTML OUTPUT VALIDATION
# ============================================================================

# Elements that never take a closing tag in HTML5, with or without a
# trailing "/>" — must not be pushed on the balance-checking stack below.
VOID_ELEMENTS = {
    'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
    'link', 'meta', 'param', 'source', 'track', 'wbr',
}


class _HtmlBalanceChecker(HTMLParser):
    """Tracks a stack of open tags to catch mismatched/unclosed tags in
    generated HTML. <script>/<style> content is handled as raw text by
    HTMLParser itself, so JS containing `<`/`>` (comparisons, etc.) is not
    mistaken for markup."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []
        self.errors = []

    def handle_starttag(self, tag, attrs):
        if tag not in VOID_ELEMENTS:
            self.stack.append(tag)

    def handle_endtag(self, tag):
        if tag in VOID_ELEMENTS:
            return
        if not self.stack:
            self.errors.append(f'unexpected closing </{tag}> with no matching open tag')
            return
        if self.stack[-1] != tag:
            self.errors.append(
                f'</{tag}> does not match the currently open <{self.stack[-1]}>'
            )
            return
        self.stack.pop()


def validate_html(html_text, filename):
    """Rejects generated HTML that isn't well-formed (mismatched or
    unclosed tags) — a bug in a template or in convert_markdown() must
    never silently ship a broken page. Structural check only: stdlib
    html.parser has no notion of full HTML5 conformance, only tag
    balance, but that is exactly the class of defect a rendering bug in
    this codebase would produce."""
    checker = _HtmlBalanceChecker()
    checker.feed(html_text)
    checker.close()
    if checker.stack:
        unclosed = ', '.join(f'<{t}>' for t in reversed(checker.stack))
        checker.errors.append(f'unclosed tag(s) at end of document: {unclosed}')
    if checker.errors:
        print(f'[ERROR] {filename}: the generated HTML is not well-formed — '
              f'this almost always means unbalanced raw HTML in the source '
              f'for this page (an unclosed or mismatched tag, e.g. a <div> in '
              f'a fact-box or full-article that is never closed). Fix the tag '
              f'balance in the source and rebuild:', file=sys.stderr)
        for e in checker.errors:
            print(f'  - {e}', file=sys.stderr)
        sys.exit(1)


# ============================================================================
# BUILD ENGINE
# ============================================================================

def typo_disabled_rules(meta):
    """Reads an article's typo-units/typo-thousands meta fields (§4.5) and
    returns the set of built-in rule names to skip on that article's own
    page. 'off' (case-insensitive) is the only value that disables a rule;
    anything else, or the field's absence, leaves it enabled (default).
    The names must match the "name" of the corresponding rule in
    language/*.json (§19.1) — nbsp_before_unit/nbsp_after_operator for
    typo-units, nbsp_thousands_separator for typo-thousands. The third,
    blanket meta field (typo: off, disabling every rule for the article,
    not just these two) is handled separately in build_article via
    article_typo_engine, since it needs to swap in a `None` engine rather
    than name individual rules."""
    disabled = set()
    if str(meta.get('typo-units', '')).strip().lower() == 'off':
        disabled.add('nbsp_before_unit')
        disabled.add('nbsp_after_operator')
    if str(meta.get('typo-thousands', '')).strip().lower() == 'off':
        disabled.add('nbsp_thousands_separator')
    return disabled


def build_article(source_path, articles_dir, series_data, current_file, css, nav_js, typo_engine, strings, lang='fr', build_stamp=''):
    """Builds an HTML page for an article."""
    md_text = read_text_file(source_path)
    meta, slides, has_meta_block, content_before_meta = parse_markdown_extended(md_text)
    validate_slides(slides, source_path.name, has_meta_block, content_before_meta)
    disabled_rules = typo_disabled_rules(meta)
    # typo: off (§4.5) is this article's own --no-typography: skip the
    # engine entirely for its page, the same `None` the CLI flag passes
    # for a whole build, not just the two rules disabled_rules can name.
    article_typo_engine = None if str(meta.get('typo', '')).strip().lower() == 'off' else typo_engine

    total_slides = len(slides)
    slide_htmls = []

    for i, slide in enumerate(slides, 1):
        html = render_slide(slide, i, total_slides, article_typo_engine, strings, disabled_rules)
        slide_htmls.append(html)

    # Join the slides
    slides_html = '\n\n'.join(slide_htmls)

    # Inject the series navigation — the build-wide typo_engine, not
    # article_typo_engine: this block's entries aren't "this article's
    # own page content" even when it's this article's own entry (§4.5).
    series_nav_html = build_series_nav(current_file, series_data, strings, typo_engine)
    slides_html = slides_html.replace('{SERIES_NAV_PLACEHOLDER}', series_nav_html)

    # Inject the full article. A missing file is fatal (§22.8): the page
    # would otherwise be published with the literal placeholder text in
    # place of the article, and exit 0 — a corrupted page shipped green.
    for i, slide in enumerate(slides):
        if slide.slide_type == 'full-article' and slide.article_file:
            # Realpath containment on top of the name-shape guard: the
            # name check already ran at parse time, but a bare name that
            # is a symlink pointing outside articles/ passes it and would
            # otherwise be read and embedded verbatim into the page.
            article_path = _resolve_contained(articles_dir, slide.article_file)
            if article_path is None:
                print(f'[ERROR] {source_path.name}: article file "{slide.article_file}" '
                      f'resolves outside articles/ (symlink or traversal).',
                      file=sys.stderr)
                sys.exit(1)
            if not article_path.exists():
                print(f'[ERROR] {source_path.name}: article file not found: '
                      f'{slide.article_file} (referenced by its full-article slide).',
                      file=sys.stderr)
                sys.exit(1)
            article_md = read_text_file(article_path)
            article_html = convert_markdown(article_md, article_typo_engine, disabled_rules)
            slides_html = slides_html.replace('{FULL_ARTICLE_PLACEHOLDER}', article_html)

    # Page title — the already-resolved page_title (series.json > article
    # meta > cover slide's own slide_title > page_dest, see
    # resolve_article_fields()), not a fresh re-read of the meta block
    # here: series.json's own override would never reach this function
    # otherwise.
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data
    own_entry = next((e for e in articles if e.get('page_dest') == current_file), None)
    title = own_entry['page_title'] if own_entry else meta.get('page_title', current_file)
    # Strip HTML tags from the title
    title_clean = strip_ws(re.sub(r'<[^<>]+>', ' ', title))
    title_clean = apply_typo(article_typo_engine, title_clean, disabled_rules)

    # <head> metadata — author and description, both attribute contexts:
    # tag-stripped (they may legitimately carry inline HTML for the
    # visible renderings, §6.2, but an attribute can't) and quote-escaped.
    # Omitted entirely when empty, never an empty content="".
    meta_head = ''
    if own_entry:
        for name, value in (('author', own_entry.get('author', '')),
                            ('description', own_entry.get('page_desc', ''))):
            if value:
                clean = strip_ws(re.sub(r'<[^<>]+>', ' ', value))
                clean = apply_typo(article_typo_engine, clean, disabled_rules)
                meta_head += f'<meta name="{name}" content="{html_escape(clean, quote=True)}">\n'

    # Page footer — byline (author, date) + license, visible renderings:
    # raw HTML passthrough like all body content (§6.2), typography
    # applied via this article's own engine (it IS this page's content).
    page_footer = ''
    if own_entry:
        author = apply_typo(article_typo_engine, own_entry.get('author', ''), disabled_rules)
        date = apply_typo(article_typo_engine, own_entry.get('date', ''), disabled_rules)
        license_text = apply_typo(article_typo_engine, own_entry.get('license', ''), disabled_rules)
        byline = ' — '.join(part for part in (author, date) if part)
        parts = []
        if byline:
            parts.append(f'  <div class="footer-byline">{byline}</div>')
        if license_text:
            parts.append(f'  <div class="footer-license">{license_text}</div>')
        if parts:
            page_footer = '<footer class="page-footer">\n' + '\n'.join(parts) + '\n</footer>'

    # Draft banner — only ever reachable under --include-drafts (drafts
    # are filtered out of the build entirely otherwise). Inline-styled
    # for the same staleness reason as the build stamp (see
    # build_stamp_html): a series' own templates/style.css predating this
    # feature has no .draft-banner rule, and a preview must NEVER look
    # like a publication because of a stale stylesheet.
    draft_banner = ''
    if own_entry and own_entry.get('draft'):
        banner_text = strings.get('draft_banner', 'Draft')
        banner_style = (
            'position:absolute;top:14px;left:50%;transform:translateX(-50%);'
            'background:#ff4757;color:white;padding:3px 12px;border-radius:4px;'
            'font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;'
            'z-index:60;pointer-events:none;'
            "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;"
        )
        draft_banner = f'<div class="draft-banner" style="{banner_style}">{banner_text}</div>'

    # Assemble the page. Interface strings are applied to the SKELETON
    # (template — nav_js got its own pass at load time) before any
    # author-provided content is injected; then every remaining data
    # placeholder is filled in a SINGLE pass (fill_placeholders), so a
    # value that itself contains a {{...}} token — e.g. a literal {{css}}
    # typed into an article's page_title or page_desc — is emitted as-is
    # and never re-substituted. The old sequential str.replace chain
    # re-scanned each injected value, letting author content inject the
    # stylesheet/other markers into the tag-stripped <title> and escaped
    # <meta> sinks, bypassing their guard (§18.4).
    html = apply_strings(TEMPLATE_PAGE, strings)
    html = fill_placeholders(html, {
        'lang': lang, 'title': title_clean, 'meta_head': meta_head,
        'css': css, 'slides': slides_html, 'page_footer': page_footer,
        'js_nav': nav_js, 'build_stamp': build_stamp,
        'draft_banner': draft_banner,
    })

    validate_html(html, current_file)
    return html


def copy_images(articles_dir, output_dir):
    """Copies the img/ directory if it exists.

    Merges into an existing img_dst (dirs_exist_ok) instead of wiping it
    first: a mistyped --output pointing at an unrelated existing directory
    must never delete a pre-existing img/ there.

    Symlinks that escape img/ are refused, not followed: copytree's
    default (symlinks=False) copies a link's *referent content*, so a
    committed `img/leak.png -> /etc/passwd` (or a directory symlink) would
    otherwise be published into public/img/ — arbitrary host-file
    exfiltration from an attacker-authored series built unattended. A
    symlink whose realpath stays inside img/ is harmless and kept."""
    img_src = articles_dir / 'img'
    img_dst = output_dir / 'img'
    if not (img_src.exists() and img_src.is_dir()):
        return
    src_root = img_src.resolve()

    def _refuse_escaping_symlinks(dir_path, names):
        ignored = set()
        for name in names:
            entry = Path(dir_path) / name
            if entry.is_symlink():
                target = entry.resolve()
                if not (target == src_root or src_root in target.parents):
                    print(f'  [WARNING] img/: skipped symlink escaping the '
                          f'image directory: {entry.relative_to(img_src)}',
                          file=sys.stderr)
                    ignored.add(name)
        return ignored

    shutil.copytree(img_src, img_dst, dirs_exist_ok=True,
                    ignore=_refuse_escaping_symlinks)
    print(f'  Images copied: {img_dst}')


def load_series_data(series_dir):
    """Loads series.json."""
    series_file = series_dir / 'series.json'
    if not series_file.exists():
        print(f'[ERROR] series.json not found in {series_dir}', file=sys.stderr)
        sys.exit(1)
    try:
        data = json.loads(read_text_file(series_file))
    except (ValueError, RecursionError) as e:
        # ValueError covers json.JSONDecodeError; RecursionError guards a
        # deeply-nested array/object (e.g. "["*100000) from crashing the
        # JSON parser with a raw traceback instead of a clean [ERROR].
        print(f'[ERROR] {series_file}: invalid JSON ({e}).', file=sys.stderr)
        sys.exit(1)
    articles = data.get('articles', data) if isinstance(data, dict) else data
    if not isinstance(articles, list) or not all(isinstance(e, dict) for e in articles):
        print(f'[ERROR] {series_file}: "articles" must be a list of objects.',
              file=sys.stderr)
        sys.exit(1)
    return data


# Field names retired by the v1.0 nomenclature freeze (JOURNAL-1.0.md §2.1),
# mapped to their replacements — recognized only to produce a clear
# migration error instead of a mystifying "missing required field".
_LEGACY_SERIES_FIELDS = {'source': 'page_source', 'file': 'page_dest'}


# series_meta string leaves used by build_index / resolve_article_fields.
_SERIES_META_STRING_FIELDS = ('title', 'subtitle', 'version', 'intro', 'author', 'license')


def series_meta_of(series_data):
    """The `series_meta` object, validated. A non-dict series_meta (or a
    non-string leaf like `title: 123`) used to crash later at a .get() or
    re.sub() with a raw traceback; reject it here with a clean error, the
    same bar §20.5 sets for the rest of series.json."""
    if not isinstance(series_data, dict):
        return {}
    meta = series_data.get('series_meta', {})
    if not isinstance(meta, dict):
        print(f'[ERROR] series.json: "series_meta" must be an object '
              f'(got {type(meta).__name__}).', file=sys.stderr)
        sys.exit(1)
    for field in _SERIES_META_STRING_FIELDS:
        if field in meta and meta[field] is not None and not isinstance(meta[field], str):
            print(f'[ERROR] series.json: "series_meta.{field}" must be a string '
                  f'(got {type(meta[field]).__name__}).', file=sys.stderr)
            sys.exit(1)
    return meta


def validate_series(articles):
    """Rejects series.json structural errors (§20.3): `page_source` must
    be present, non-empty, a plain filename (no path separators, no "..")
    and end in .md on every entry — otherwise the build crashes on a raw
    KeyError instead of a clear message, or (page_source being joined
    into a real filesystem path with no other containment check) a
    malicious or LLM-mangled entry reads an arbitrary file outside
    articles/ (Path(dir) / value silently ignores `dir` when `value` is
    an absolute path).

    `page_dest` is NOT required here (§20.3.1) — it resolves later, once
    resolve_article_fields() has had a chance to read the article's own
    meta block or derive it from `page_source`. An EXPLICIT `page_dest`
    already in series.json still gets the same safety/extension check
    right here, since that doesn't depend on reading anything else;
    uniqueness of the final, resolved `page_dest` across every entry is
    checked at the end of resolve_article_fields() instead, once every
    entry actually has one.

    page_title/card_title/card_desc/card_label/nav_title/nav_desc are NOT
    checked here either — per §20.3.1 they're optional overrides of the
    same field in the article's own meta block, and validating them
    requires reading that meta block first, which this function
    (series.json-only) can't do; see resolve_article_fields()."""
    for i, entry in enumerate(articles, 1):
        # An entry must be a JSON object; a bare string/number/list here
        # would crash at the first entry.get() or field access with a raw
        # traceback instead of the clean error §20.3 promises for a
        # semi-trusted series.json.
        if not isinstance(entry, dict):
            print(f'[ERROR] series.json: entry {i} must be an object '
                  f'(got {type(entry).__name__}).', file=sys.stderr)
            sys.exit(1)
        # Every known field below is text: a wrong (truthy non-string)
        # type — a number, list or object — used to sail past this
        # validation and detonate downstream at a re.sub / Path() / join
        # sink as a traceback. Reject it here with a clean message.
        for field in _SERIES_STRING_FIELDS:
            if field in entry and entry[field] is not None and not isinstance(entry[field], str):
                print(f'[ERROR] series.json: entry {i} field "{field}" must be '
                      f'a string (got {type(entry[field]).__name__}).', file=sys.stderr)
                sys.exit(1)
        for legacy, renamed in _LEGACY_SERIES_FIELDS.items():
            if legacy in entry:
                print(f'[ERROR] series.json: entry {i} uses "{legacy}", '
                      f'renamed to "{renamed}" in v1.0 — just rename the '
                      f'key, the value is unchanged.', file=sys.stderr)
                sys.exit(1)
        if not entry.get('page_source'):
            print(f'[ERROR] series.json: entry {i} is missing required '
                  f'field "page_source".', file=sys.stderr)
            sys.exit(1)
        if not _is_safe_relative_filename(entry['page_source']):
            print(f'[ERROR] series.json: entry {i} has an unsafe '
                  f'"page_source" value "{entry["page_source"]}" (must be a '
                  f'plain filename, no path separators, no "..").', file=sys.stderr)
            sys.exit(1)
        if not entry['page_source'].lower().endswith('.md'):
            print(f'[ERROR] series.json: entry {i} has a "page_source" value '
                  f'"{entry["page_source"]}" that does not end in .md.', file=sys.stderr)
            sys.exit(1)
        if entry.get('page_dest') is not None:
            if not _is_safe_relative_filename(entry['page_dest']):
                print(f'[ERROR] series.json: entry {i} has an unsafe '
                      f'"page_dest" value "{entry["page_dest"]}" (must be a '
                      f'plain filename, no path separators, no "..").', file=sys.stderr)
                sys.exit(1)
            if not entry['page_dest'].lower().endswith(('.html', '.htm')):
                print(f'[ERROR] series.json: entry {i} has a "page_dest" value '
                      f'"{entry["page_dest"]}" that does not end in .html or .htm.', file=sys.stderr)
                sys.exit(1)


_DISPLAY_OVERRIDE_FIELDS = ('page_title', 'card_title', 'card_desc', 'card_label', 'nav_title', 'nav_desc')

# Every series.json entry field that must be a string when present.
# `draft` is deliberately excluded: it is coerced with str().lower() and
# so tolerates any type (a non-"true" value simply isn't a draft, §20.6).
_SERIES_STRING_FIELDS = (
    'page_source', 'page_dest', 'page_title', 'page_desc',
    'card_title', 'card_desc', 'card_label', 'nav_title', 'nav_desc',
    'author', 'license', 'date', 'comment',
)


def _find_cover_slide(slides):
    """First cover slide, if any — the natural, already-authored source
    for a couple of the fallbacks below (its own slide_title/summary),
    since a well-formed article almost always has one even if it never
    sets any of the more specific display fields."""
    return next((s for s in slides if s.slide_type == 'cover'), None)


def resolve_article_fields(articles, articles_dir, series_meta=None):
    """Resolves `page_dest` and the display/editorial fields for every
    entry, per §20.3.1. Mutates each entry in place so downstream
    renderers (build_article, build_series_nav, build_index,
    build_readme) can read the fields directly, with every
    override/fallback already applied — none of them need to know this
    mechanism exists.

    Must run once, after validate_series and before any of those
    renderers — build_series_nav in particular renders every OTHER
    article's nav_title/nav_desc on the page being built, not just the
    current one, so every entry needs to be resolved up front, not
    lazily.

    Resolution order, per field, most specific wins:

      page_dest   : series.json > article meta (`page_dest:`) > derived
                    from `page_source` (.md -> .html)
      page_title  : series.json > article meta > the cover slide's own
                    slide_title > the resolved `page_dest`
      page_desc   : series.json > article meta > the cover slide's summary
                    > '' (the <meta name="description"> tag is omitted)
      card_title  : series.json > article meta > page_title (resolved)
      card_desc   : series.json > article meta > the cover slide's summary
      card_label  : series.json > article meta > '' (nothing sensible to
                    extrapolate a short label from)
      nav_title   : series.json > article meta > card_title (resolved)
      nav_desc    : series.json > article meta > card_desc (resolved)
      author      : series.json > article meta > series_meta (series-wide
                    default) > '' (nothing shown)
      license     : series.json > article meta > series_meta > ''
      date        : series.json > article meta > '' (per-article only —
                    no series-wide default, and never derived from file
                    mtime: that would break byte-for-byte reproducibility)
      draft       : series.json > article meta > not a draft. Only the
                    exact value true/"true" (case-insensitive) marks a
                    draft; anything else doesn't.

    card_desc deliberately does NOT fall back through page_desc (and vice
    versa): page_desc is invisible metadata (SEO/share preview),
    card_desc is visible UI — an SEO-tuned page_desc must never leak
    onto the index cards. The titles chain (page > card > nav); the
    descriptions are parallel branches off the same cover summary. That
    asymmetry is intentional (§20.3.1).

    A page_source file that doesn't exist can't be read for its meta
    block or slides; that case is already a non-fatal warning elsewhere,
    so every field here just falls through to its filesystem-independent
    default (derived `page_dest`, or '') instead of erroring a second
    time."""
    series_meta = series_meta or {}
    for entry in articles:
        source_path = articles_dir / entry['page_source']
        meta, slides = {}, []
        if source_path.exists():
            meta, slides, _, _ = parse_markdown_extended(read_text_file(source_path))
        cover = _find_cover_slide(slides)
        cover_summary = cover.summary if cover and cover.summary else ''

        if not entry.get('page_dest'):
            entry['page_dest'] = meta.get('page_dest') or re.sub(r'\.md$', '.html', entry['page_source'], flags=re.IGNORECASE)
            if not _is_safe_relative_filename(entry['page_dest']) or not entry['page_dest'].lower().endswith(('.html', '.htm')):
                print(f'[ERROR] {entry["page_source"]}: resolved "page_dest" value '
                      f'"{entry["page_dest"]}" is not a safe .html/.htm filename '
                      f'(from the article\'s own meta block).', file=sys.stderr)
                sys.exit(1)

        if not entry.get('page_title'):
            entry['page_title'] = meta.get('page_title') or (cover.h1 if cover and cover.h1 else '') or entry['page_dest']
        if not entry.get('page_desc'):
            entry['page_desc'] = meta.get('page_desc') or cover_summary

        if not entry.get('card_title'):
            entry['card_title'] = meta.get('card_title') or entry['page_title']
        if not entry.get('card_desc'):
            entry['card_desc'] = meta.get('card_desc') or cover_summary
        if not entry.get('card_label'):
            entry['card_label'] = meta.get('card_label', '')

        if not entry.get('nav_title'):
            entry['nav_title'] = meta.get('nav_title') or entry['card_title']
        if not entry.get('nav_desc'):
            entry['nav_desc'] = meta.get('nav_desc') or entry['card_desc']

        if not entry.get('author'):
            entry['author'] = meta.get('author') or series_meta.get('author', '')
        if not entry.get('license'):
            entry['license'] = meta.get('license') or series_meta.get('license', '')
        if not entry.get('date'):
            entry['date'] = meta.get('date', '')

        # series.json wins even with an explicit falsy value there, so
        # `"draft": false` in series.json can override a `draft: true`
        # left in the meta block.
        draft_value = entry['draft'] if 'draft' in entry else meta.get('draft', '')
        entry['draft'] = str(draft_value).strip().lower() == 'true'

    seen = {}
    for i, entry in enumerate(articles, 1):
        # Keyed case-insensitively: 'A.html' and 'a.html' are distinct
        # names to a URL but the same file on a Windows or default-macOS
        # filesystem — one would silently overwrite the other at build
        # time there, so the collision is fatal everywhere rather than a
        # platform-dependent data loss.
        f = entry['page_dest'].lower()
        if f in seen:
            print(f'[ERROR] series.json: duplicate page_dest "{entry["page_dest"]}" '
                  f'(articles {seen[f]} and {i} — compared case-insensitively: '
                  f'they would be the same file on Windows/macOS).', file=sys.stderr)
            sys.exit(1)
        seen[f] = i


# ============================================================================
# NAV/INDEX FINGERPRINT CACHE (for `build --only`, see specifications.md §11.3.1)
# ============================================================================
#
# build_index() and build_series_nav() both render _DISPLAY_OVERRIDE_FIELDS
# for every article, not just the one being built — build_series_nav's
# output is inlined into every OTHER article's own page too, so changing
# one article's title can make every already-built page stale, not just
# index.html. `--only <file>` skips the expensive step (re-converting
# every other article's full Markdown body) but only when none of that
# shared, cross-page data has actually changed since the last build.

def _entry_fingerprint(entry):
    """A single hash of the fields that affect index.html/series-nav for
    this entry — content itself isn't kept, so the cache file stays small
    regardless of how long a summary is."""
    parts = [entry.get(field, '') for field in _DISPLAY_OVERRIDE_FIELDS]
    return hashlib.sha256('\x00'.join(parts).encode('utf-8')).hexdigest()


def compute_nav_fingerprint(articles):
    """One fingerprint per article, keyed by `file` — comparing the full
    dict (not just the entry for the one being built) also catches an
    article added/removed, or a DIFFERENT article's meta/series.json entry
    having changed since the last build, not only the one named by
    --only."""
    return {entry['page_dest']: _entry_fingerprint(entry) for entry in articles}


def default_nav_cache_path(series_dir):
    return Path(series_dir) / '.lwp-cache' / 'nav.json'


def load_nav_cache(path):
    """None means "no usable cache" (missing, unreadable, or corrupt) —
    the caller's job is to treat that as "not safe to skip anything",
    never to guess."""
    try:
        return json.loads(Path(path).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return None


def save_nav_cache(path, fingerprint):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(fingerprint, indent=2, sort_keys=True), encoding='utf-8')


def resolve_paths(series_dir, args):
    """Resolves paths from environment variables and arguments."""
    sd = Path(series_dir).resolve()

    articles_dir = Path(os.environ.get('LWP_ARTICLES_DIR', sd / 'articles'))
    templates_dir = Path(os.environ.get('LWP_TEMPLATES_DIR', sd / 'templates'))
    lang_dir = Path(os.environ.get('LWP_LANGUAGE_DIR', sd / 'language'))
    output_dir = Path(args.get('--output', os.environ.get('LWP_OUTPUT_DIR', sd / 'public')))
    lang = args.get('--lang', os.environ.get('LWP_LANG', 'fr'))
    language_file = args.get('--language-file')

    return sd, articles_dir, templates_dir, lang_dir, output_dir, lang, language_file


# Matches build_stamp_html()'s own output exactly (a single, entirely
# self-generated element) — used by cmd_check to ignore the marker when
# comparing against disk, see its own comment for why that's necessary.
# [^>]* rather than a literal attribute string: the div carries its own
# inline style (see build_stamp_html), so matching only on the class
# hook keeps this working regardless of attribute order. Deliberately
# does NOT also swallow a surrounding newline: the div sits on its own
# template line (`{{build_stamp}}` alone between two literal newlines),
# so removing just the div reproduces exactly what an unstamped build
# already produces at that spot (an empty line, not a missing one) —
# chewing an extra \n here would under-count against that baseline and
# cause every check to report a spurious drift.
_BUILD_STAMP_RE = re.compile(r'<div[^>]*class="build-stamp"[^>]*>.*?</div>')


def build_stamp_html(version, minimal=False):
    """--build-stamp / --build-stamp-minimal (§11.3.2): a discreet, opt-in
    "did I actually just rebuild this" marker in the page's own header —
    the real-world need it addresses is a stale browser tab or an old
    deploy that LOOKS current at a glance. Never on by default: it makes
    every build non-reproducible byte-for-byte (a fresh timestamp every
    run), which most workflows (including `check`, see cmd_check)
    explicitly don't want.

    `minimal` drops the timestamp (and version): a build date/time is
    data that may or may not be sensitive to publish (it can reveal when
    a document was prepared), so a series that wants the freshness marker
    without that disclosure gets a fixed "Compiled with lightwebpres."
    instead — no version either, kept symmetric with dropping the date
    rather than a partial disclosure.

    position: absolute, not fixed: this belongs in the page's own header
    (specifically requested — visible only while scrolled to the top,
    same as any other header content, never pinned over the rest of the
    page while reading). With no positioned ancestor, absolute resolves
    against the initial containing block — anchored to the top of the
    document, so it scrolls away exactly like ordinary content, not the
    viewport-pinned behavior `fixed` would give.

    Styled entirely inline, not via a `.build-stamp` rule in style.css:
    a series with its own templates/style.css (customized, or simply
    scaffolded before this option existed) has no way to pick up a new
    built-in rule short of refresh-templates (§9.4) — the marker would
    render as a plain, undiscreet block-flow line (full width, default
    dark text, pushing the first slide down) instead of the intended
    small corner overlay. Inline style has no such dependency."""
    if minimal:
        text = 'Compiled with lightwebpres.'
    else:
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        text = f'Compiled at {now} with lightwebpres v{version}.'
    style = (
        # Literal hex, not var(--ink-muted): the same staleness risk applies to
        # a series' own custom property definitions, not just its rules.
        'position:absolute;top:16px;left:20px;font-size:11px;color:#6b6b7d;'
        'letter-spacing:0.3px;opacity:0.75;z-index:50;pointer-events:none;'
        "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;"
    )
    return f'<div class="build-stamp" style="{style}">{text}</div>'


def strip_build_stamp(html):
    return _BUILD_STAMP_RE.sub('', html)


def load_build_context(series_dir, args):
    """Shared setup for build and check (§11.3/§11.4): resolves paths,
    loads the language pack/typo engine, the CSS/nav.js (built-in or
    overridden, §9.1/§9.2), and series.json (validated, display fields
    resolved). The two commands used to duplicate this ~20-line block,
    which meant a new build-time option (--no-typography) had to be
    added to both by hand — centralizing it here means the next one
    only needs to land once.

    --no-typography (§4.5/§19.6) skips the engine entirely: every
    typo_engine use already goes through apply_typo(), so None here
    means no rule anywhere ever touches the text — the strongest
    guarantee that a source's existing spacing (including any
    non-breaking space already in it) reaches the output completely
    unchanged, not just that the new rules stay quiet."""
    sd, articles_dir, templates_dir, lang_dir, output_dir, lang, language_file = resolve_paths(series_dir, args)

    language_pack = load_language(lang_dir, lang, language_file)
    typo_engine = None if args.get('--no-typography') else TypoEngine(language_pack)
    strings = language_pack.get('strings', {})

    css = compose_series_stylesheet(templates_dir)
    nav_js_file = templates_dir / 'nav.js'
    nav_js = read_text_file(nav_js_file) if nav_js_file.exists() else TEMPLATE_NAV_JS
    nav_js = apply_strings(nav_js, strings)

    series_data = load_series_data(sd)
    series_meta = series_meta_of(series_data)
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data
    validate_series(articles)
    resolve_article_fields(articles, articles_dir, series_meta)

    # Draft articles are excluded from the build entirely — no page, no
    # index card, no entry in the other articles' series-nav blocks —
    # unless --include-drafts (authors, GUI preview). Filtering the list
    # that series_data itself references (in place, not a copy) keeps
    # every downstream renderer consistent: they all re-derive the list
    # from series_data. It also means the nav fingerprint is computed on
    # the filtered list, so toggling an article's draft status changes
    # the cache's key set and correctly forces a full build over the
    # --only fast path.
    if not args.get('--include-drafts'):
        skipped = [e['page_dest'] for e in articles if e.get('draft')]
        articles[:] = [e for e in articles if not e.get('draft')]
        for f in skipped:
            print(f'  [draft] {f} skipped (build with --include-drafts to preview it)')

    # Every listed page_source must exist, checked up front and fatal
    # (§20.3): building around a missing source used to leave the entry's
    # index card, series-nav entries and README line pointing at a page
    # that was never built — dead links shipped with exit code 0. Failing
    # here, before anything is written, also means no partial output.
    missing = [e['page_source'] for e in articles
               if not (articles_dir / e['page_source']).exists()]
    if missing:
        for name in missing:
            print(f'[ERROR] Source not found: {articles_dir / name} '
                  f'(listed in series.json).', file=sys.stderr)
        sys.exit(1)

    return SimpleNamespace(
        sd=sd, articles_dir=articles_dir, templates_dir=templates_dir,
        lang_dir=lang_dir, output_dir=output_dir, lang=lang,
        language_file=language_file, typo_engine=typo_engine,
        strings=strings, css=css, nav_js=nav_js, series_data=series_data,
        articles=articles,
    )


def _cmd_build_only(ctx, only_file, nav_cache_path, fresh_fingerprint, build_stamp=''):
    """The fast path for `build --only`: the caller has already confirmed
    nav/index-affecting metadata is unchanged since the last build, so
    only the named article's own page needs re-converting — index.html,
    README.md, and images are cheap regardless of series size, so they're
    always redone rather than also trying to skip them."""
    entry = next((e for e in ctx.articles if only_file in (e['page_dest'], e['page_source'])), None)
    if entry is None:
        print(f'[ERROR] --only {only_file!r} matches no article (by file or source).', file=sys.stderr)
        sys.exit(1)

    source_path = ctx.articles_dir / entry['page_source']
    if not source_path.exists():
        print(f'[ERROR] Source not found: {source_path}', file=sys.stderr)
        sys.exit(1)

    print(f'Incremental build: {ctx.sd} (nav/index unaffected since the last build)')
    ctx.output_dir.mkdir(parents=True, exist_ok=True)

    print(f'  {entry["page_dest"]} ← {entry["page_source"]}')
    html = build_article(source_path, ctx.articles_dir, ctx.series_data, entry['page_dest'], ctx.css, ctx.nav_js, ctx.typo_engine, ctx.strings, ctx.lang, build_stamp)
    (ctx.output_dir / entry['page_dest']).write_text(html, encoding='utf-8')

    index_extra_file = ctx.templates_dir / 'index_extra.html'
    index_extra = read_text_file(index_extra_file) if index_extra_file.exists() else ''
    print('  index.html')
    index_html = build_index(ctx.series_data, ctx.css, ctx.typo_engine, ctx.strings, ctx.lang, index_extra, build_stamp)
    (ctx.output_dir / 'index.html').write_text(index_html, encoding='utf-8')

    readme = build_readme(ctx.series_data, ctx.sd, ctx.output_dir, ctx.strings)
    (ctx.sd / 'README.md').write_text(readme, encoding='utf-8')

    copy_images(ctx.articles_dir, ctx.output_dir)

    save_nav_cache(nav_cache_path, fresh_fingerprint)
    print(f'Incremental build complete: {entry["page_dest"]} + index -> {ctx.output_dir}')


def cmd_build(series_dir, args):
    """build command."""
    ctx = load_build_context(series_dir, args)
    # Opt-in, off by default (§11.3.2): embedding a live timestamp makes
    # every build non-reproducible byte-for-byte, which most workflows
    # (starting with `check`, see cmd_check) explicitly rely on NOT
    # happening. --build-stamp-minimal wins if both are passed: the
    # explicit ask for the version-and-timestamp-free variant is a
    # privacy choice, and a privacy choice should never be silently
    # overridden by the richer flag also being present.
    if args.get('--build-stamp-minimal'):
        build_stamp = build_stamp_html(VERSION, minimal=True)
    elif args.get('--build-stamp'):
        build_stamp = build_stamp_html(VERSION)
    else:
        build_stamp = ''

    nav_cache_path = args.get('--nav-cache') or default_nav_cache_path(ctx.sd)
    fresh_fingerprint = compute_nav_fingerprint(ctx.articles)

    only_file = args.get('--only')
    if only_file:
        cached_fingerprint = load_nav_cache(nav_cache_path)
        if cached_fingerprint == fresh_fingerprint:
            _cmd_build_only(ctx, only_file, nav_cache_path, fresh_fingerprint, build_stamp)
            return
        reason = 'no usable cache found' if cached_fingerprint is None else 'nav/index-affecting metadata changed since the last build'
        print(f'[INFO] --only requested but not safe ({reason}) — doing a full build instead.')

    print(f'Build: {ctx.sd}')
    print(f'  Articles: {ctx.articles_dir}')
    print(f'  Output: {ctx.output_dir}')
    print(f'  Lang: {ctx.lang}')

    # Load the optional index page extension (raw HTML+JS, inserted as-is
    # right before </body> — the only extension point for the index page,
    # since style.css/nav.js don't cover site-specific index features)
    index_extra_file = ctx.templates_dir / 'index_extra.html'
    index_extra = read_text_file(index_extra_file) if index_extra_file.exists() else ''

    # Create the output directory
    ctx.output_dir.mkdir(parents=True, exist_ok=True)

    # Build each article (every page_source was checked to exist by
    # load_build_context — fatal before any output is written)
    for entry in ctx.articles:
        source_file = entry['page_source']
        output_file = entry['page_dest']
        source_path = ctx.articles_dir / source_file

        print(f'  {output_file} ← {source_file}')
        html = build_article(source_path, ctx.articles_dir, ctx.series_data, output_file, ctx.css, ctx.nav_js, ctx.typo_engine, ctx.strings, ctx.lang, build_stamp)

        output_path = ctx.output_dir / output_file
        output_path.write_text(html, encoding='utf-8')

    # Build the index
    print('  index.html')
    index_html = build_index(ctx.series_data, ctx.css, ctx.typo_engine, ctx.strings, ctx.lang, index_extra, build_stamp)
    (ctx.output_dir / 'index.html').write_text(index_html, encoding='utf-8')

    # Generate the README (spec §8.3)
    readme = build_readme(ctx.series_data, ctx.sd, ctx.output_dir, ctx.strings)
    (ctx.sd / 'README.md').write_text(readme, encoding='utf-8')

    # Copy the images
    copy_images(ctx.articles_dir, ctx.output_dir)

    save_nav_cache(nav_cache_path, fresh_fingerprint)

    print(f'Build complete: {len(ctx.articles)} articles + index -> {ctx.output_dir}')


def cmd_check(series_dir, args):
    """check command — compares the existing output with what the build
    would produce: every article page, index.html AND README.md. The two
    latter used to be skipped, which left a hole in the CI gate: a
    series_meta change (title, intro, article order) alters only the
    index/README, and check stayed green over a stale publication."""
    ctx = load_build_context(series_dir, args)

    ok_count = 0
    diff_count = 0

    def compare(name, generated, existing_path):
        nonlocal ok_count, diff_count
        if not existing_path.exists():
            print(f'[NEW] {name} does not exist yet')
            diff_count += 1
            return
        # Never generated here, on either side of the comparison: a build
        # stamp's timestamp is different on every single run by design, so
        # comparing it against anything (including itself, moments later)
        # would always drift — check's job is real content drift, not
        # "time has passed". strip_build_stamp() on the disk copy is what
        # keeps a series built with --build-stamp still checkable.
        existing = strip_build_stamp(read_text_file(existing_path))
        if existing.strip() == generated.strip():
            print(f'[OK] {name}')
            ok_count += 1
        else:
            print(f'[DRIFT] {name}')
            diff = list(difflib.unified_diff(
                existing.strip().splitlines(), generated.strip().splitlines(),
                lineterm='', n=1))
            for line in diff[:20]:
                print(' ', line)
            diff_count += 1

    for entry in ctx.articles:
        source_path = ctx.articles_dir / entry['page_source']
        generated = build_article(source_path, ctx.articles_dir, ctx.series_data, entry['page_dest'], ctx.css, ctx.nav_js, ctx.typo_engine, ctx.strings, ctx.lang)
        compare(entry['page_dest'], generated, ctx.output_dir / entry['page_dest'])

    index_extra_file = ctx.templates_dir / 'index_extra.html'
    index_extra = read_text_file(index_extra_file) if index_extra_file.exists() else ''
    compare('index.html',
            build_index(ctx.series_data, ctx.css, ctx.typo_engine, ctx.strings, ctx.lang, index_extra),
            ctx.output_dir / 'index.html')
    compare('README.md',
            build_readme(ctx.series_data, ctx.sd, ctx.output_dir, ctx.strings),
            ctx.sd / 'README.md')

    print(f'{ok_count} file(s) OK, {diff_count} file(s) different.')
    if diff_count == 0:
        print('All files are up to date.')
    else:
        sys.exit(1)


