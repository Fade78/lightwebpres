# §9.5.3 — facets. Past a dozen or so palettes a gallery stops being a
# thing you read and becomes a thing you search, so every theme carries
# the two axes a reader actually narrows on. Both are derived, not
# hand-maintained per theme where that can be avoided:
#
#   polarity   light | dark      — already known: the dark_background flag
#   intensity  sober | vivid | mono — declared, since "how loud is this"
#                                  is an editorial judgement, not a number
#   hue        computed from the background, so it can never contradict
#              the palette it describes
#
# Hue is deliberately CALCULATED rather than declared: a hand-written
# label drifts the moment someone tweaks a colour, and there is no reason
# to trust prose over the value itself.
# Boundaries in CIELAB hue angle, not RGB. RGB hue cannot tell a pale
# cream from a full orange — both sit at the same angle — so naming from
# it labelled Solarized's paper "orange", which no reader would say.
# Calibrated by measuring the angle of known references rather than from
# memory: CIELAB's angles are not the ones RGB intuition suggests (a full
# blue sits near 297°, not 240°, and cyan near 227°).
#
# Facet VALUES are in English, like every other identifier the CLI takes
# (`themes --hue green`, §11.9). The gallery is a French page and shows
# French labels, but it holds them separately from the data-* values it
# filters on — a display string and a key are not the same thing.
HUE_NAMES = (
    (38, 'red'), (78, 'orange'), (120, 'yellow'), (185, 'green'),
    (262, 'cyan'), (303, 'blue'), (330, 'violet'), (358, 'magenta'), (360, 'red'),
)
# Below this chroma a background reads as paper or ink, never as a hue.
NEUTRAL_CHROMA = 18.0

# Every value each facet can take, in the order a listing should show
# them (hue follows the colour wheel, not the alphabet). Single source of
# truth for the `themes` command's validation and for its grouped output,
# so a new hue band cannot be added to HUE_NAMES without appearing here.
FACET_VALUES = {
    'polarity': ('light', 'dark'),
    'intensity': ('sober', 'vivid', 'mono'),
    'hue': ('neutral', 'red', 'orange', 'yellow', 'green',
            'cyan', 'blue', 'violet', 'magenta'),
}


def _lab(hex_colour):
    """sRGB hex to CIELAB. Only used to name a facet, so D65/2° and the
    textbook constants are ample."""
    rgb = [int(hex_colour.lstrip('#')[i:i + 2], 16) / 255 for i in (0, 2, 4)]
    r, g, b = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in rgb]
    x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047
    y = 0.2126 * r + 0.7152 * g + 0.0722 * b
    z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883
    fx, fy, fz = [t ** (1 / 3) if t > 0.008856 else 7.787 * t + 16 / 116 for t in (x, y, z)]
    return 116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)


def theme_hue_family(theme):
    """Names the hue family of a theme's BACKGROUND — what a reader sees
    first, and what they mean by "a green theme". Computed in CIELAB so
    the answer matches perception: a pale cream has a hue ANGLE like a
    full orange but almost no chroma, and is called 'neutral'."""
    import math
    _, a, b = _lab(theme['page'])
    if math.hypot(a, b) < NEUTRAL_CHROMA:
        return 'neutral'
    angle = math.degrees(math.atan2(b, a)) % 360
    for bound, name in HUE_NAMES:
        if angle < bound:
            return name
    return 'red'


def theme_facets(theme):
    """The three facets of a THEMES entry, as the gallery (§11.7) and the
    `themes` command (§11.9) both present them — one function, so a
    browser picker and a terminal picker can never disagree."""
    return {
        'polarity': 'dark' if theme.get('dark_background') else 'light',
        'intensity': theme.get('intensity', 'sober'),
        'hue': theme_hue_family(theme),
    }


def themes_matching(filters):
    """The THEMES entries whose facets satisfy every filter in `filters`
    (a facet-name -> value mapping; a None or absent value matches
    anything). Returns a list of (slug, theme, facets) in table order."""
    out = []
    for slug, theme in THEMES.items():
        facets = theme_facets(theme)
        if all(want is None or facets[name] == want for name, want in filters.items()):
            out.append((slug, theme, facets))
    return out


# Marks where the built-in portion of templates/style.css ends and a site's
# own customizations begin. `install` writes it at the end of the file with
# nothing after it; `refresh-templates` (§11.6) uses it to update the
# built-in rules above the marker while preserving anything appended below
# it verbatim, instead of guessing the boundary from a CSS selector that may
# legitimately also appear in the built-in CSS (see specifications.md §9.4).
TEMPLATE_STYLE_CUSTOM_MARKER = '/* === Personnalisations locales : refresh-templates conserve tout ce qui suit cette ligne === */'

# Records which THEMES entry (§9.5) a templates/style.css was generated
# with, right after the file's header line — absent for the default
# theme. refresh-templates (§9.5.4) reads it back to reapply the same
# theme instead of silently reverting to the default when it regenerates
# the built-in portion of the file.
TEMPLATE_STYLE_THEME_MARKER_RE = re.compile(r'^/\* lightwebpres-theme: (\S+) \*/$', re.MULTILINE)

# Same marker, but swallowing its line ending, for REMOVING it. The
# search regex above cannot do that job: `$` stops before the newline, so
# substituting it away leaves the blank line behind. Harmless once, but
# `set-theme` (§11.10) rewrites the marker every time it runs, and the
# blanks accumulate — after a few theme changes the file no longer
# matches its standard form and set-theme starts demanding --force
# against its own output.
TEMPLATE_STYLE_THEME_MARKER_LINE_RE = re.compile(r'^/\* lightwebpres-theme: \S+ \*/\n', re.MULTILINE)


# §9.5.2 — the neutral overlays and the cover, per background polarity.
# The stylesheet expresses its rules, surfaces and recessed grounds as
# translucent overlays so they tint whatever is underneath instead of
# being fixed greys. Which DIRECTION they must go depends on the
# palette: over a light page a surface is a white veil and a rule a
# black one; over a dark page it is exactly the reverse, and a white
# surface veil turns a card into an unreadable white block. A theme
# therefore declares `dark_background: True` when its --light is not,
# in fact, light, and gets the second set. Nothing else changes.
#
# NOT named `dark`: that key already holds the palette's dark tone in
# every THEMES entry, so a flag by that name reads as the colour string
# and every theme silently becomes dark-backgrounded. Caught exactly
# that way while building this — hence the explicit name and the test
# that pins a known light theme to the light preset.
#
# Until this existed, every theme was forced to be light-backgrounded —
# which is why the nine oldest ones still are, Dracula and Tokyo Night
# included, despite being dark schemes upstream. They were not converted
# afterwards: they read as a light-page interpretation of those palettes,
# and enough dark-backgrounded themes now exist that nothing is missing.
SURFACE_PRESETS = {
    False: {
        'rule': 'rgba(0, 0, 0, 0.10)',
        'rule-strong': 'rgba(0, 0, 0, 0.16)',
        'surface': 'rgba(255, 255, 255, 0.72)',
        'sunken': 'rgba(0, 0, 0, 0.045)',
        # The cover inverts the page: the palette's dark tone, with its
        # light tone as text.
        'cover-bg': 'var(--ink)',
        'cover-fg': 'var(--page)',
        'cover-fg-faint': 'rgba(255, 255, 255, 0.34)',
        # Floating round controls: near-opaque over a light page.
        'control': 'rgba(255, 255, 255, 0.92)',
        'control-soft': 'rgba(255, 255, 255, 0.75)',
    },
    True: {
        'rule': 'rgba(255, 255, 255, 0.14)',
        'rule-strong': 'rgba(255, 255, 255, 0.24)',
        # Barely-there veil: on a dark ground a card reads as a slight
        # lift, never as a pale block.
        'surface': 'rgba(255, 255, 255, 0.055)',
        'sunken': 'rgba(0, 0, 0, 0.30)',
        # Not var(--ink) — on a dark theme that variable holds the TEXT
        # colour, so using it as a background would invert the cover into
        # a pale panel. A deeper veil of the page itself instead.
        'cover-bg': 'rgba(0, 0, 0, 0.45)',
        'cover-fg': 'var(--ink)',
        'cover-fg-faint': 'rgba(255, 255, 255, 0.30)',
        # A lift out of the dark ground, not a white pill on top of it.
        'control': 'rgba(255, 255, 255, 0.13)',
        'control-soft': 'rgba(255, 255, 255, 0.09)',
    },
}


def theme_surface_properties(theme):
    """The nine overlay/cover/control values for a THEMES entry, chosen
    by its `dark_background` flag (absent = light). The two sets share
    their keys exactly — that is what lets apply_theme() substitute one
    for the other without knowing which polarity it is handling."""
    return SURFACE_PRESETS[bool(theme.get('dark_background', False))]


def theme_fact_properties(theme):
    """Resolves a THEMES entry's fact-box strong-emphasis properties
    (§9.1) to concrete CSS values, keyed by the --fact-strong-* suffix
    they feed. Returns a dict rather than a tuple: there are six of them
    now, and six positional values that must be unpacked in the right
    order at three call sites is a defect waiting to happen.

    Four axes, independent by design — a theme can be bold with no
    highlight, or un-bold with a green one, or underlined and nothing
    else:

      weight/style        pass through as-is
      highlight           a role name from this theme's own colours, or
                          None; becomes var(--role) so a later override
                          of that role still applies, or 'transparent'
      ink                 the text ON that marker (see below)
      decoration          'underline' or None -> 'none'
      decoration-color    a role name, or None -> currentColor, i.e. the
                          text's own colour, which is the classic look

    Missing keys default to the engine's own un-themed rendering, so an
    entry that sets none of them looks exactly as it did before any of
    this existed."""
    highlight_role = theme.get('fact_highlight', 'marker')
    decoration_role = theme.get('fact_decoration_color')
    # The text sitting ON that highlight. The rule used to set only a
    # background, which silently assumed dark text on a bright marker —
    # true on a light theme, false on a dark one, where --ink holds the
    # LIGHT text colour: measured at a contrast ratio of 1.00, i.e.
    # invisible. On a dark theme --page is the dark ground, so it is
    # exactly the ink needed here. With no highlight there is no marker
    # to sit on and the text keeps the body colour.
    if not highlight_role:
        ink = 'inherit'
    elif theme.get('dark_background'):
        ink = 'var(--page)'
    else:
        ink = 'var(--ink)'
    return {
        'weight': theme.get('fact_weight', 'bold'),
        'style': theme.get('fact_style', 'normal'),
        'highlight': f'var(--{highlight_role})' if highlight_role else 'transparent',
        'ink': ink,
        'decoration': theme.get('fact_decoration') or 'none',
        'decoration-color': f'var(--{decoration_role})' if decoration_role else 'currentColor',
    }


def fact_treatment_label(theme):
    """One French sentence saying how a theme renders **bold** inside a
    fact-box (§9.1), for themes-gallery (§11.7).

    The gallery applied these properties to its mock-up and never said a
    word about them, so nothing anywhere told a reader that a theme can
    be bold WITHOUT a highlight, or un-bold WITH a coloured one. Every
    distinct combination in the table was invisible: you had to squint at
    a two-line preview and guess."""
    weight = theme.get('fact_weight', 'bold')
    style = theme.get('fact_style', 'normal')
    role = theme.get('fact_highlight', 'marker')

    faces = []
    if weight == 'bold':
        faces.append('gras')
    if style == 'italic':
        faces.append('italique')
    face = ' '.join(faces) if faces else 'sans changement de graisse'
    face = face[0].upper() + face[1:]

    parts = [face, f'surlign&eacute; <code>--{role}</code>' if role else 'sans surlignage']
    # Only mentioned when present: naming the absence of an underline on
    # every one of the built-in themes would bury the axes that differ.
    if theme.get('fact_decoration') == 'underline':
        colour = theme.get('fact_decoration_color')
        parts.append(f'soulign&eacute; <code>--{colour}</code>' if colour else 'soulign&eacute;')
    return ', '.join(parts)


def apply_theme(css_text, theme_key):
    """Rewrites the six palette declarations (PALETTE_ROLES),
    the six --fact-strong-* ones (§9.1), and the nine
    overlay/cover/control ones (§9.5.2 — --rule, --rule-strong,
    --surface, --sunken, --cover-bg, --cover-fg, --cover-fg-faint,
    --control, --control-soft) in `css_text`'s :root block to
    THEMES[theme_key]'s values (§9.5.1), and records theme_key in the
    marker right after the file's header line.

    The overlays are part of the substitution because a theme on a dark
    background needs them inverted; leaving them fixed is what confined
    every theme to a light page.

    Only the FIRST occurrence of each declaration is touched (count=1) —
    the built-in :root block always comes before a personalization
    section (§9.4) in the file, by construction, so this can never reach
    into custom CSS the author appended after the marker, even if it
    happens to redeclare one of these names.

    A declaration this cannot find is left alone and REPORTED, never
    silently skipped — see unsubstituted_declarations(), which set-theme
    (§11.10) uses to say which values kept their old contents.

    Assumes theme_key is a valid THEMES key; callers validate first so
    the error message can name the invalid input directly (§9.5.1)."""
    theme = THEMES[theme_key]
    # Scoped to the :root block (root_block_span) rather than the whole
    # file: further down, the generated stylesheet documents these very
    # declarations inside a comment, and confining the rewrite is what
    # keeps documentation from being edited as if it were code.
    span = root_block_span(css_text)
    if span is None:
        head, root, tail = css_text, '', ''
    else:
        head, root, tail = css_text[:span[0]], css_text[span[0]:span[1]], css_text[span[1]:]

    for var in PALETTE_ROLES:
        pattern = r'(--%s:\s*)#[0-9A-Fa-f]{3,8}(\s*;)' % var
        root = re.sub(pattern, lambda m: m.group(1) + theme[var] + m.group(2), root, count=1)

    for var, value in (
        # Keyed by suffix, so adding an emphasis axis needs no change
        # here at all — which is the point of returning a mapping.
        *((f'fact-strong-{k}', v) for k, v in theme_fact_properties(theme).items()),
        # The overlays and the cover (§9.5.2). Substituted like the rest,
        # so a dark-backgrounded theme gets veils that go the right way
        # instead of a white card on a black page.
        *theme_surface_properties(theme).items(),
    ):
        pattern = r'(--%s:\s*)[^;]+(;)' % re.escape(var)
        root = re.sub(pattern, lambda m, value=value: m.group(1) + value + m.group(2), root, count=1)

    css_text = head + root + tail
    css_text = TEMPLATE_STYLE_THEME_MARKER_LINE_RE.sub('', css_text, count=1)
    header_end = css_text.index('\n') + 1
    css_text = css_text[:header_end] + f'/* lightwebpres-theme: {theme_key} */\n' + css_text[header_end:]
    return css_text


def root_block_span(css_text):
    """(start, end) of the first `:root { ... }` block's contents, or
    None when there is none.

    Theme substitution is confined to it. Without that confinement it
    operated on the whole file and relied on the real :root simply coming
    FIRST, since only the first occurrence of each declaration is
    rewritten — an ordering assumption, not a guarantee. The generated
    stylesheet now carries paste-ready recipes further down (§9.1) that
    are literally `:root { --fact-strong-highlight: transparent; }` inside
    a comment, so a file whose own :root was removed would have had its
    documentation rewritten as if it were code."""
    opening = css_text.find(':root')
    if opening == -1:
        return None
    brace = css_text.find('{', opening)
    close = css_text.find('}', brace)
    if brace == -1 or close == -1:
        return None
    return brace + 1, close


def unsubstituted_declarations(css_text):
    """The theme declarations apply_theme() would NOT find in `css_text`,
    in the order it tries them.

    Substitution rewrites declarations that already exist; it never adds
    one. On a stylesheet whose :root has been reworked, a declaration
    that is gone, renamed, or written in another notation simply keeps
    whatever it had — and the file still ends up stamped with the new
    theme's marker. `set-theme --force` on a style.css with no :root at
    all wrote a file announcing `lightwebpres-theme: nord` that contained
    not one of Nord's values, and said only that the result "may" be
    partly recoloured. Naming the misses turns a vague caveat into a
    fact."""
    span = root_block_span(css_text)
    root = css_text[span[0]:span[1]] if span else ''

    missing = []
    for var in PALETTE_ROLES:
        if not re.search(r'--%s:\s*#[0-9A-Fa-f]{3,8}\s*;' % var, root):
            missing.append(f'--{var}')
    # Any theme's mapping has the same keys, so the first entry stands
    # for all of them — no separate list to keep in step.
    sample = theme_fact_properties(next(iter(THEMES.values())))
    for var in (*(f'fact-strong-{k}' for k in sample), *SURFACE_PRESETS[False]):
        if not re.search(r'--%s:\s*[^;]+;' % re.escape(var), root):
            missing.append(f'--{var}')
    return missing


def detect_theme(css_text):
    """Returns the theme slug apply_theme() recorded in `css_text` (only
    looking at the built-in portion, before the personalization marker
    of §9.4, so a coincidentally similar comment in an author's own CSS
    can never be mistaken for it), or None — default theme, or a file
    that predates this feature."""
    builtin_part = css_text.split(TEMPLATE_STYLE_CUSTOM_MARKER, 1)[0]
    m = TEMPLATE_STYLE_THEME_MARKER_RE.search(builtin_part)
    return m.group(1) if m else None


def theme_state(css_text):
    """Inspects a templates/style.css and answers the two questions
    `set-theme` (§11.10) has to ask before touching it:

      slug      which theme it currently carries — a THEMES key, or None
                for the default theme (no marker).
      standard  whether its built-in portion is EXACTLY what this
                executable would generate for that theme. False means
                someone edited the built-in CSS by hand, so substituting
                the theme variables may leave the file half-recoloured:
                a declaration rewritten to `rgb(...)` or moved out of
                :root no longer matches the patterns apply_theme() looks
                for, and would silently keep its old value.
      reason    a short explanation when standard is False, for the
                error message to quote; '' otherwise.

    Rules the author appended AFTER the personalization marker (§9.4) are
    none of this function's business — that is the supported way to
    customize, and it never makes a file non-standard.

    Returns (slug, standard, reason)."""
    slug = detect_theme(css_text)
    if slug is not None and slug not in THEMES:
        return slug, False, f'it records theme {slug!r}, which this version does not know'

    marker_pos = css_text.find(TEMPLATE_STYLE_CUSTOM_MARKER)
    if marker_pos == -1:
        return slug, False, ('it has no personalization marker, so the built-in CSS '
                             'cannot be told apart from your own rules')

    builtin = css_text[:marker_pos + len(TEMPLATE_STYLE_CUSTOM_MARKER)]
    expected = apply_theme(TEMPLATE_STYLE, slug) if slug else TEMPLATE_STYLE
    expected_end = expected.find(TEMPLATE_STYLE_CUSTOM_MARKER) + len(TEMPLATE_STYLE_CUSTOM_MARKER)
    if builtin != expected[:expected_end]:
        return slug, False, ('its built-in CSS differs from this version of lightwebpres '
                             '(edited by hand, or written by another version)')
    return slug, True, ''


