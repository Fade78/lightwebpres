def cmd_install(target_dir, args):
    """init command — creates the directory structure."""
    td = Path(target_dir).resolve()
    lang = args.get('--lang', 'fr')
    force = bool(args.get('--force'))
    theme_key = args.get('--theme')
    gitlab_ci = bool(args.get('--gitlab-ci'))

    if td.exists() and any(td.iterdir()) and not force:
        log('error', f'{td} is not empty. Use an empty or new directory, or pass --force.')
        sys.exit(1)

    if not _VALID_LANG_RE.fullmatch(str(lang)):
        log('error', f'--lang: invalid language value {str(lang)!r} '
            f'(letters, digits, "-" and "_" only).')
        sys.exit(1)

    if theme_key is not None and theme_key not in THEMES:
        log('error', f'Unknown theme: {theme_key!r}. Valid themes: {", ".join(sorted(THEMES))}')
        sys.exit(1)

    # Create the directories
    _mkdir(td / 'sources', parents=True, exist_ok=True)
    _mkdir(td / 'templates', exist_ok=True)
    _mkdir(td / 'language', exist_ok=True)
    _mkdir(td / 'public', exist_ok=True)

    # The author's surface (§9 rewrite), and ONLY the author's surface:
    # settings.conf, every property commented at its value under the
    # chosen theme, and an empty custom.css for rules. No style.css — the
    # stylesheet is composed in memory at build time and never owned by
    # anyone but the tool. An optional templates/index_extra.html is
    # inserted as-is into the index page if the author creates one (no
    # default content, nothing to extract).
    #
    # nav.js and the two language packs are NOT written any more, and
    # this is the repair to the cause of B32. They were copied in byte
    # for byte identical to what the executable already holds, so the
    # copy was never a customisation — only a snapshot that the build
    # then preferred to the executable's own, freezing the series at the
    # version of the day. Autonomy does not need them either: `init`
    # copies the executable itself further down, and the executable
    # contains all three. `template show` and `template write` hand them
    # over to whoever actually wants one.
    _write_file(td / 'templates' / SETTINGS_FILENAME,
                build_settings_scaffold(theme_key))
    _write_file(td / 'templates' / CUSTOM_CSS_FILENAME, CUSTOM_CSS_STUB)

    # Empty series.json
    series_json = {
        "series_meta": {
            "title": "My article series",
            "subtitle": "Series subtitle",
            "version": "v0.1",
            "intro": "Series introduction.",
            "author": "",
            "license": ""
        },
        "articles": []
    }
    _write_file(td / 'series.json',
                json.dumps(series_json, ensure_ascii=False, indent=2))

    # .gitlab-ci.yml — opt-in only (--gitlab-ci): init never assumes a
    # GitLab deployment, so a project doesn't end up depending on GitLab
    # just from having been scaffolded (see specifications.md §11.1). The
    # chosen --lang is baked into the CI build command: it's the one place
    # a scaffolded project's language persists, since a plain build/demo
    # otherwise defaults to fr (both packs are always installed, language
    # is a per-build choice — §7.1).
    if gitlab_ci:
        _write_file(td / '.gitlab-ci.yml', TEMPLATE_GITLAB_CI.format(lang=lang))

    # Copy the executable itself into the directory, for standalone use
    # (the series directory shouldn't have to depend on lightwebpres being
    # installed system-wide or found elsewhere on PATH).
    exe_src = Path(__file__).resolve()
    exe_dst = td / 'lightwebpres'
    if exe_src.is_file() and exe_src != exe_dst:
        _copy(exe_src, exe_dst)
        if not _LOG_STATE['dry_run']:
            exe_dst.chmod(exe_dst.stat().st_mode | 0o111)

        # The copy above is a copy of a GPL-covered program, and section 4
        # requires whoever conveys it to pass the License on with it. People
        # publish their series repositories -- the .gitlab-ci.yml this same
        # command can write exists to encourage exactly that -- so leaving
        # these out would put users in breach through no fault of their own,
        # for a file they did not ask to receive. Written only alongside the
        # executable, never on their own: without the program there is
        # nothing here for them to convey.
        _write_file(td / 'COPYING', LICENSE_GPL_TEXT)
        _write_file(td / 'COPYING.EXCEPTION', LICENSE_EXCEPTION_TEXT)

    progress(f'Installed: {td}')
    if theme_key:
        progress(f'  theme: {THEMES[theme_key]["label"]}')
    progress(f'  sources/   — your .md files')
    progress(f'  templates/  — {SETTINGS_FILENAME} (uncomment a value to pin it),')
    progress(f'              {CUSTOM_CSS_FILENAME} (your own rules)')
    progress(f'  language/   — empty: the typography rules and interface '
             f'strings come from the executable')
    progress(f'  public/     — generated HTML (build output)')
    progress(f'  series.json — article list')
    if gitlab_ci:
        progress(f'  .gitlab-ci.yml — CI pipeline')
    progress(f'  lightwebpres — the executable itself, for standalone use')
    if not gitlab_ci:
        progress()
        progress('No .gitlab-ci.yml (opt-in only — pass --gitlab-ci to install one).')
    progress()
    progress('Next steps:')
    progress(f'  1. Create articles in {td}/sources/')
    progress(f'  2. Add entries to {td}/series.json')
    progress(f'  3. Run: lightwebpres build {td}')
    progress()
    # Where the guidance goes now that the files themselves are gone: the
    # navigation script and the language packs live inside the executable
    # and are used from there. Named here because `init` is where someone
    # reads what a series is made of, and a file they cannot see is a file
    # they will not think to ask for.
    progress('The navigation script and the language packs stay in the '
             'executable and are used from it:')
    progress('  lightwebpres template show nav.js     — read one')
    progress('  lightwebpres template write nav.js .  — take a copy into '
             'this series')
    progress('A copy stops following the tool\'s fixes, and every build '
             'says so until you remove it.')


# ============================================================================
# TEMPLATE SHOW / WRITE — the files the tool keeps
# ============================================================================

# The three files the executable owns, and no longer hands out. `init`
# used to write all three into every series, byte for byte identical to
# what the executable already contained -- so the copy was never a
# customisation, only a snapshot, and from then on the build used the
# snapshot. A behaviour the tool fixed reached nobody who already had a
# series: three fixes in v0.39.0 landed nowhere, reported three times as
# "it still does not work" (BACKLOG B32).
#
# They stay reachable, because being unable to get at them would be a
# real loss -- someone who wants to rewrite the keyboard handling has
# nowhere else to start, and `template update` never created a missing
# nav.js, only replaced an existing one. So: `show` prints one, `write`
# installs one where the build will read it.
#
# Both exist on purpose, and the reason is not symmetry. Reading is the
# commoner need -- what does the B key do -- and `show` serves it with no
# series in play at all. Writing needs the LAYOUT, which is knowledge
# this program has and its user does not: nav.js goes under templates/,
# a pack under language/, and LWP_TEMPLATES_DIR / LWP_LANGUAGE_DIR can
# move either. `show > file` would leave the path to the author, and a
# path one directory off is a file that sits there doing nothing, with
# no error -- the silent no-op this codebase spends its time killing.
# `write` makes the ACT explicit and the PATH the tool's business.
def tool_owned_files():
    """{filename: (contents, which directory it belongs in)}.

    A closed set of three. `settings.conf` and `custom.css` are not in it
    and must not be: they belong to the author, and `template update`
    already creates them when they are missing."""
    return {
        'nav.js': (TEMPLATE_NAV_JS, 'templates'),
        'fr.json': (LANG_FR, 'language'),
        'en.json': (LANG_EN, 'language'),
    }


def _tool_owned_or_die(name):
    """The contents and home of `name`, or a fatal error naming the set."""
    files = tool_owned_files()
    if name not in files:
        log('error', f'{name!r} is not a file this executable owns. '
            f'It ships {", ".join(sorted(files))} — settings.conf and '
            f'{CUSTOM_CSS_FILENAME} are yours, and `template update` '
            f'creates them if they are missing.')
        sys.exit(1)
    return files[name]


def cmd_template_show(name, args):
    """`template show <file>` — prints one tool-owned file on stdout.

    Reads nothing and writes nothing: the answer is inside this
    executable, so the command needs no series and works from anywhere.
    That is the point of having it alongside `write` — someone who wants
    to know what a key does should not have to scaffold a series to find
    out, nor end up owning a frozen copy for having asked."""
    contents, _home = _tool_owned_or_die(name)
    sys.stdout.write(contents)


def cmd_template_write(name, args, target_dir):
    """`template write <file> [dir]` — installs one tool-owned file where
    the build reads it, through the same path resolution the build uses
    (LWP_TEMPLATES_DIR / LWP_LANGUAGE_DIR included), so what it writes
    cannot land somewhere the build ignores.

    It refuses to overwrite without --force, because an existing file at
    that path may be someone's work, and it says what the copy costs at
    the moment the cost is taken on. That sentence is the whole lesson of
    B32: the trap was never the copy, it was that nobody knew they had
    one. Asked for by name and told the price, it is a choice."""
    contents, home = _tool_owned_or_die(name)
    _sd, _articles, templates_dir, lang_dir, _out, _lang, _lf = resolve_paths(
        target_dir, args)
    # An existing series, or nothing. Without this the command cheerfully
    # scaffolds a lone templates/nav.js in an empty directory and then
    # announces that the build will use it -- a promise about a build
    # that cannot happen there. `template update` has always refused the
    # same way, and the two commands write to the same directory.
    if not templates_dir.is_dir():
        log('error', f'{templates_dir} not found — `template write` puts a '
            f'file into an existing series, it does not make one. Run '
            f'`lightwebpres init` there first, or `template show {name}` '
            f'if you only want to read the file.')
        sys.exit(1)
    dest_dir = templates_dir if home == 'templates' else lang_dir
    dest = dest_dir / name
    if dest.exists() and not args.get('--force'):
        log('error', f'{dest} already exists. Pass --force to replace it '
            f'(there is no backup: use `template show {name}` to compare '
            f'first if you have changed it).')
        sys.exit(1)
    _mkdir(dest_dir, parents=True, exist_ok=True)
    _write_file(dest, contents)
    # Past tense only when it happened. --dry-run journals the write
    # through the helper as "would write", and a summary saying "Wrote"
    # over that journal is the half a reader believes.
    if _LOG_STATE['dry_run']:
        progress(f'Would write {dest}')
        progress()
        progress(f'The build would then use that copy of {name} instead of '
                 f'the one built into the executable, and would say so on '
                 f'every run.')
        return
    progress(f'Wrote {dest}')
    progress()
    progress(f'The build will now use this copy of {name} instead of the '
             f'one built into the executable.')
    progress('It will not follow the tool\'s fixes any more, and every '
             'build will say so until you remove it or take a newer one.')


def cmd_refresh_templates(target_dir, args):
    """refresh-templates command (§11.6). Under the composed-stylesheet
    model only nav.js is a tool-owned file on disk that upgrades can
    refresh: the stylesheet is composed at build time from the current
    executable, so it is always fresh by construction, and the author's
    settings.conf / custom.css are never the tool's to touch.

    --scaffold is the one exception, and it is opt-in: it regenerates the
    settings.conf commented surface for the current theme — new properties
    appear, gone ones vanish — while keeping every uncommented line the
    author pinned. That is the action audit points to when the commented
    values drift from the declared theme, and the only supported way to see
    a new version's properties without hand-merging.

    A legacy templates/style.css is reported, not migrated: its values are
    the author's decisions, and moving them is theirs to do — audit names
    every variable rename to make that mechanical."""
    # Through the build's own resolver, so this command looks where the
    # build looks. It used to read `td / 'templates'` directly while the
    # language half (added with the tool-owned-file removal) honoured
    # LWP_LANGUAGE_DIR -- one function reading one of the two variables,
    # which is worse than reading neither: it works until the day someone
    # moves the other directory.
    _sd, _articles, templates_dir, lang_dir, _out, _lang, _lf = resolve_paths(
        target_dir, args)
    if not templates_dir.is_dir():
        log('error', f'{templates_dir} not found. Run init first.')
        sys.exit(1)

    # No `up_to_date` list any more: the only thing that ever went in it
    # was a nav.js identical to the built-in one, and an identical copy
    # is now REMOVED rather than left alone and reported as fine. It was
    # never fine -- it was the freeze, waiting for the next release.
    refreshed = []
    settings_path = templates_dir / SETTINGS_FILENAME

    if args.get('--scaffold'):
        if not settings_path.exists():
            log('error', f'{settings_path} not found — nothing to regenerate. '
                  f'Run init (or template update without --scaffold to '
                  f'create a fresh one).')
            sys.exit(1)
        old = read_text_file(settings_path)
        theme_key, _ = parse_settings_text(old)
        pins = pinned_settings(old)
        new = build_settings_scaffold(theme_key, pinned=pins)
        if new == old:
            progress(f'templates/{SETTINGS_FILENAME} is already current. '
                  f'Nothing written.')
            return
        _write_file(settings_path, new)
        kept = len(pins)
        unknown = [k for k in pins if k not in PROPERTY_REGISTRY]
        progress(f'Regenerated templates/{SETTINGS_FILENAME} for theme '
              f'{theme_key or "default"}: commented surface refreshed, '
              f'{kept} pinned value(s) kept.')
        if unknown:
            log('warn', f'{len(unknown)} pinned property(ies) no longer exist '
                  f'and were moved to the trailing section, commented out: '
                  f'{", ".join(unknown)}. A build would reject them; delete '
                  f'or rename them (audit names the replacements).')
        progress()
        progress('Run build again to apply.')
        return

    legacy = templates_dir / 'style.css'
    if legacy.exists():
        log('warn', f'templates/style.css is no longer read (the stylesheet '
              f'is composed at build time). Your values belong in '
              f'{SETTINGS_FILENAME}, your rules in {CUSTOM_CSS_FILENAME}; '
              f'run audit for the variable renames, then delete it.')

    settings_path = templates_dir / SETTINGS_FILENAME
    if not settings_path.exists():
        # A series scaffolded before the rewrite: give it the new surface,
        # default theme — writing a file that does not exist breaks no
        # ownership promise.
        _write_file(settings_path, build_settings_scaffold(None))
        refreshed.append(f'templates/{SETTINGS_FILENAME} (new, default theme)')
    custom_path = templates_dir / CUSTOM_CSS_FILENAME
    if not custom_path.exists():
        _write_file(custom_path, CUSTOM_CSS_STUB)
        refreshed.append(f'templates/{CUSTOM_CSS_FILENAME} (new, empty)')

    # The tool's own files, which `init` no longer hands out (B32). A copy
    # IDENTICAL to the built-in one is removed rather than left alone, and
    # that is lossless by construction: identical, it changes nothing about
    # the build except which side of the comparison the bytes come from,
    # and its only remaining effect is to freeze the series the day the
    # executable moves on. Removing it is how a series scaffolded before
    # this version repairs itself, without anything of the author's being
    # touched -- which is §9.4.3's principle, not an exception to it.
    #
    # A copy that DIFFERS is kept. The build cannot tell "customised" from
    # "stale", so neither can this command, and the one that guesses wrong
    # destroys work. nav.js keeps its replace-with-a-.bak path because
    # `template update` is the command that means "give me the tool's
    # version"; the language packs are only reported, because their `rules`
    # replace the base set wholesale and overwriting one erases whatever
    # the author added.
    removed, kept = [], []
    nav_path = templates_dir / 'nav.js'
    if nav_path.exists():
        old_nav = read_text_file(nav_path)
        if old_nav == TEMPLATE_NAV_JS:
            _remove(nav_path)
            removed.append('templates/nav.js (was identical to the '
                           'built-in one)')
        else:
            # Saved, then removed. The outcome is what this command has
            # always produced -- the build runs the tool's navigation and
            # the author's version is preserved beside it -- reached by
            # having no file rather than by holding a copy, which is the
            # only difference and the whole point: a copy would go stale
            # again at the next release.
            _write_file(templates_dir / 'nav.js.bak', old_nav)
            removed.append('templates/nav.js (yours saved as '
                           'templates/nav.js.bak)')
            _remove(nav_path)

    for pack_name, builtin in sorted({'fr.json': LANG_FR,
                                      'en.json': LANG_EN}.items()):
        pack_path = lang_dir / pack_name
        if not pack_path.exists():
            continue
        if read_text_file(pack_path) == builtin:
            _remove(pack_path)
            removed.append(f'language/{pack_name} (was identical to the '
                           f'built-in pack)')
        else:
            kept.append(f'language/{pack_name} — differs from the built-in '
                        f'pack, so it may be yours. Compare with '
                        f'`lightwebpres template show {pack_name}`, then '
                        f'delete it to follow the tool again.')

    # Past tense only when it happened. --dry-run journals every write
    # and removal through the helpers, and a summary saying "Removed"
    # over a journal saying "would remove" is the summary a reader
    # believes.
    done = 'Would remove' if _LOG_STATE['dry_run'] else 'Removed'
    if removed:
        progress(f'{done} — the executable carries these, and the build '
                 f'{"would use" if _LOG_STATE["dry_run"] else "now uses"} '
                 f'them from there:')
        for item in removed:
            progress(f'  {item}')
    if refreshed:
        progress('Would refresh:' if _LOG_STATE['dry_run'] else 'Refreshed:')
        for item in refreshed:
            progress(f'  {item}')
    if kept:
        progress('Kept:')
        for item in kept:
            progress(f'  {item}')
    if not (removed or refreshed or kept):
        # Since v0.40.0 this is the NORMAL state of a healthy series, not
        # an unusual one, so it has to be said: a command that printed
        # only "run build again" would read as one that failed quietly.
        progress('Nothing to update — this series holds none of the '
                 'tool\'s files, which is where they belong. Your '
                 f'{SETTINGS_FILENAME} and {CUSTOM_CSS_FILENAME} are '
                 'untouched, as always.')
    progress()
    progress('Run build again to apply the refreshed templates.')


