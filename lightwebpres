def resolve_notes_settings(meta, series_meta, source_name):
    """`notes_placement` and `notes_tooltip`: the STRUCTURAL half of the
    notes cascade (ARCHI-NOTES §5) — built-in default, then `series_meta`,
    then the article's own meta block. The same shape `author`, `license`
    and `date` already have; nothing new is invented.

    It does not run through the theme layers, and the reason is mechanical
    rather than a matter of taste: the theme engine composes CSS, and CSS
    cannot move an element from one container into another. A theme could
    not honour a placement even if it were handed one. What a theme DOES
    get is the appearance — the `note`, `note.local` and `note.page`
    components, on the ordinary property cascade.

    A wrong value is a build error naming the article, the same bar every
    other typed value in this tool is held to: silently falling back to the
    default would leave an author reading a page that ignores what they
    asked for, with nothing to tell them why."""
    def pick(key, allowed, default):
        for source, origin in ((meta, source_name), (series_meta, 'series.json')):
            if key in source and str(source[key]).strip():
                value = str(source[key]).strip().lower()
                if value not in allowed:
                    log('error', f'{origin}: {key}: {value!r} is not a valid '
                          f'value ({" | ".join(sorted(allowed))}).')
                    sys.exit(1)
                return value
        return default

    placement = pick('notes_placement', ('local', 'page'), 'local')
    tooltip = pick('notes_tooltip', ('on', 'off'), 'off')
    return placement, tooltip == 'on'


def resolve_slide_page_numbers(meta, series_meta, source_name, args):
    """Whether the engraved top-right slide number (.slide-num) is rendered.

    Cascade (most specific wins), mirroring resolve_notes_settings():
    article front-matter > CLI `--slides-page-numbers` > series.json >
    built-in default (off). The bottom-left live counter (.slide-counter) is
    independent and always shown, so turning this off never loses the
    current/total information — it only drops the static, redundant mark.

    A wrong value is a build error naming the origin, the same bar every
    other typed value in this tool is held to."""
    def parse(value, origin):
        s = str(value).strip().lower()
        if s not in ('on', 'off', 'true', 'false', 'yes', 'no', '1', '0'):
            log('error', f'{origin}: slide_page_numbers: {value!r} is not a '
                  f'valid value (on | off).')
            sys.exit(1)
        return s in ('on', 'true', 'yes', '1')

    if 'slide_page_numbers' in meta and str(meta['slide_page_numbers']).strip():
        return parse(meta['slide_page_numbers'], source_name)
    cli = args.get('--slides-page-numbers') if args else None
    if cli is not None:
        return parse(cli, 'command line')
    if ('slide_page_numbers' in series_meta
            and str(series_meta['slide_page_numbers']).strip()):
        return parse(series_meta['slide_page_numbers'], 'series.json')
    return False


def render_slide(slide, slide_num, total_slides, typo_engine, strings,
                  disabled=None, notes=None, absorb_punct=False,
                  inline_images=False, sources_dir=None, show_slide_num=False,
                  slide_id=None):
    """Generates the HTML for a slide.

    `slide_id` is the card's identity (§12.1.1): what its author declared
    in `slug:`. Required, and deliberately so — it used to default to the
    card's rank, which was harmless while the rank WAS an identity and is
    a silent lie now that nothing derives one. A caller with no page-wide
    view (the theme gallery's panels) names its own; a build passes what
    resolve_page_slide_ids worked out, because uniqueness is a property of
    the page and cannot be decided here."""
    if 'excluded' in _slide_tag_set(slide):
        return ''
    tags = slide.tags if isinstance(slide.tags, (list, tuple)) else sorted(_slide_tag_set(slide))
    data_tags = html_escape(' '.join(tags), quote=True)
    num_str = f'{slide_num:02d} / {total_slides:02d}'
    ident = html_escape(slide_id, quote=True)
    # No alias span. A card's id was its rank once, and every card
    # carried an empty span holding that old name so a link shared before
    # the change still landed. There is nothing left to alias: an id is
    # what the author declared, and the rank is not a name any card has
    # ever had under this rule.
    # The engraved top-right number is opt-in (off by default): the live
    # bottom-left counter already carries current/total, so the static mark
    # is redundant presentation most authors don't want.

    if slide.slide_type == 'cover':
        kicker = apply_typo(typo_engine, escape_amps(slide.kicker or ''), disabled)
        h1 = apply_typo(typo_engine, escape_amps(slide.h1 or ''), disabled)
        summary = apply_typo(typo_engine, escape_amps(slide.summary or ''), disabled)

        parts = [f'<section class="slide slide-cover" id="{ident}" '
                 f'data-tags="{data_tags}">']
        if show_slide_num:
            parts.append(f'  <span class="slide-num">{num_str}</span>')
        if kicker:
            parts.append(f'  <span class="slide-kicker">{kicker}</span>')
        parts.append(f'  <h1>{h1}</h1>')
        if summary:
            parts.append(f'  <p class="summary">{summary}</p>')
        if slide.note:
            parts.append(f'  <div class="speaker-note" hidden>{html_escape(slide.note, quote=False)}</div>')
        parts.append('</section>')
        return '\n'.join(parts)

    elif slide.slide_type == 'series-nav':
        # Will be generated later by the navigation engine
        title = strings.get('series_nav_title', 'This series')
        # `slide-series-nav` is new, and it is what the id used to say.
        # The share button read `/^s\d+$/` to mean "a card worth linking
        # to", which excluded this one only because its id happened to end
        # in `-series`. An id derived from what the author wrote says
        # nothing about type, so the type has to say itself.
        return (f'<section class="slide slide-series-nav" id="{ident}" '
                f'data-tags="{data_tags}">\n  <h2 data-lwp-i18n="series_nav_title">{title}</h2>\n'
                f'  <div class="series-list">\n{{SERIES_NAV_PLACEHOLDER}}\n'
                f'  </div>\n</section>')

    elif slide.slide_type == 'full-article':
        # Content will be injected later
        tag_text = strings.get('full_article_kicker', 'Full article')
        return (f'<section class="slide full-article" id="{ident}" '
                f'data-tags="{data_tags}">\n'
                + (f'  <span class="slide-num">{num_str}</span>\n'
                   if show_slide_num else '')
                + f'  <span class="slide-kicker" data-lwp-i18n="full_article_kicker">{tag_text}</span>\n'
                # Keyed by RANK, deliberately, and it is the one thing here
                # that still is. This token never reaches a reader: it is
                # minted and consumed inside one function, and the rank is
                # the only key guaranteed both unique and free of anything
                # an author could type — a declared slug may contain a `}`
                # right where this token ends.
                + f'{{FULL_ARTICLE_PLACEHOLDER:s{slide_num}}}\n</section>')

    else:  # standard
        kicker = apply_typo(typo_engine, escape_amps(slide.kicker or ''), disabled)
        h2 = apply_typo(typo_engine, escape_amps(slide.h2 or ''), disabled)
        summary = apply_typo(typo_engine, escape_amps(slide.summary or ''), disabled)

        parts = [f'<section class="slide" id="{ident}" '
                 f'data-tags="{data_tags}">']
        if show_slide_num:
            parts.append(f'  <span class="slide-num">{num_str}</span>')
        if kicker:
            parts.append(f'  <span class="slide-kicker">{kicker}</span>')
        if h2:
            parts.append(f'  <h2>{h2}</h2>')
        if summary:
            parts.append(f'  <p class="summary">{summary}</p>')

        # Highlight — no empty caption span when there is no caption
        # (§12.3: the caption is emitted only if present)
        if slide.highlight:
            highlight = apply_typo(typo_engine, escape_amps(slide.highlight), disabled)
            caption = apply_typo(typo_engine, escape_amps(slide.highlight_caption or ''), disabled)
            caption_html = f'<span class="highlight-caption">{caption}</span>' if caption else ''
            parts.append(f'  <div class="highlight"><span class="highlight-figure">{highlight}</span>{caption_html}</div>')

        # Fact-box
        if slide.fact_content:
            # A card is its own numbering locality under `local` placement:
            # the slide number is what makes the anchors unique in the page
            # while the reader sees 1, 2, 3 in every card (ARCHI-NOTES §4).
            # The locality is the card's identity, not its rank, so a
            # note's anchor travels with the card the way the card's own
            # does. Reordering a page used to repoint every note anchor
            # in it, for the same reason it repointed every card link.
            #
            # The `else` is a fallback for a caller with no page-wide
            # view, and a mutation proved it unreachable from a build:
            # the render loop always hands a scope down. Kept for the
            # same reason `slide_id` has a default — a preview or a
            # test that renders one card still gets a coherent page —
            # and labelled so nobody reads a passing suite as covering
            # it.
            slide_notes = notes if notes is not None else NoteScope(ident)
            content_html = convert_markdown(slide.fact_content, typo_engine,
                                            disabled, slide_notes, strings,
                                            absorb_punct=absorb_punct,
                                            inline_images=inline_images,
                                            sources_dir=sources_dir)
            if slide.fact_label:
                label = apply_typo(typo_engine, escape_amps(slide.fact_label), disabled)
                fact_classes = 'fact-box'
                if slide.fact_variant:
                    # The source names a MEANING (`fact-variant: warning`);
                    # what it looks like is the theme's or the author's to
                    # define, as a .fact--warning rule in custom.css — so a
                    # theme change carries the variant with it. The name
                    # becomes a CSS class, and is validated as one.
                    if not re.fullmatch(r'[a-z][a-z0-9-]*', slide.fact_variant):
                        raise PropertyError(
                            f'fact-variant: {slide.fact_variant!r} is not a '
                            f'valid variant name ([a-z][a-z0-9-]*)')
                    fact_classes += f' fact--{slide.fact_variant}'
                parts.append(f'  <div class="{fact_classes}">')
                parts.append(f'    <div class="fact-label">{label}</div>')
                # A single wrapping <div> (not a <p>) around the converted
                # content, regardless of what it starts with: fact-box body
                # text isn't always a bare paragraph — a heading (#/##/###)
                # or a list can legitimately open it too, and a <p> can't
                # validly contain block-level children (a browser silently
                # closes it right before one, which would both break the
                # visual structure and stop the .fact-content CSS scoping
                # below from reaching anything past that point). Font-size/
                # color inherit from the wrapping div, so this is visually
                # identical to the old per-<p> class for plain-paragraph
                # content — the fix only changes anything for non-paragraph
                # content.
                parts.append(f'    <div class="fact-content">{content_html}</div>')
                parts.append(f'  </div>')
            else:
                # No fact-label: free-form text, no box (spec 4.3) — but
                # still wrapped in a .slide-body div so a heading in the
                # body (a `#`/`##`/`###`, §22.2) can be scoped SMALLER than
                # the slide's own `##` title. Without the wrapper the body
                # heading was a bare <h1>/<h2>, a sibling of the slide
                # title, indistinguishable by selector — a body `#` then
                # rendered at cover-title size (clamp(28px,…,52px)), bigger
                # than the slide's own title. The div carries no font-size
                # itself, so plain paragraphs render exactly as before.
                parts.append(f'  <div class="slide-body">{content_html}</div>')

        # Source
        if slide.source:
            source_label = strings.get('source_label', 'Source')
            source_line = apply_typo(
                typo_engine, escape_amps(f'{source_label} : {slide.source}'),
                disabled)
            parts.append(f'  <p class="source">{source_line}</p>')

        # Speaker note — parsed, never shown to the reader; the presenter
        # panel (key N) reads it back out of the DOM.
        if slide.note:
            parts.append(f'  <div class="speaker-note" hidden>{html_escape(slide.note, quote=False)}</div>')

        parts.append('</section>')
        return '\n'.join(parts)


