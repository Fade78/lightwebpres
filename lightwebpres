def cmd_audit(series_dir, args):
    """audit command — flags editorial conventions that are not respected.

    Unlike check (which compares the generated HTML with the existing one),
    audit never compiles anything and never makes the command fail: page
    layout (number and position of cover slides, see specifications.md
    §22.13) remains entirely the author's responsibility. audit only prints
    informational warnings.
    """
    sd, articles_dir, templates_dir, lang_dir, output_dir, lang, language_file = resolve_paths(series_dir, args)
    series_data = load_series_data(sd)
    series_meta = series_meta_of(series_data)
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data
    # entry['page_dest'] below needs the resolution §20.3.1 describes
    # (derived from `page_source` when series.json omits it, the common
    # case) — without this, an entry that legitimately has no explicit
    # `page_dest` crashes audit with a raw KeyError instead of a warning.
    # Drafts are NOT filtered out here: audit is an authoring tool, and
    # work-in-progress articles are exactly what it should look at.
    validate_series(articles)
    resolve_article_fields(articles, articles_dir, series_meta)

    warnings = 0

    for entry in articles:
        source_path = articles_dir / entry['page_source']
        if not source_path.exists():
            print(f'[ERROR] {entry["page_dest"]}: page_source not found ({source_path})', file=sys.stderr)
            continue

        md_text = read_text_file(source_path)
        meta, slides, has_meta_block, _ = parse_markdown_extended(md_text)

        has_cover = any(s.slide_type == 'cover' for s in slides)
        if not has_cover:
            print(f'[WARNING] {entry["page_dest"]}: no cover slide')
            warnings += 1
        elif slides[0].slide_type != 'cover':
            print(f'[WARNING] {entry["page_dest"]}: the first slide is not a cover (found: {slides[0].slide_type})')
            warnings += 1

        # §20.3.1: page_desc resolves to '' only when no description
        # exists at ANY level (series.json, meta block, cover summary) —
        # the page then ships without a <meta name="description">. Warn
        # rather than invent one from other display fields: descriptions
        # are not silently substituted across display contexts.
        if not entry.get('page_desc'):
            print(f'[WARNING] {entry["page_dest"]}: no description anywhere '
                  f'(page_desc, meta block, or cover summary) — the page will '
                  f'have no <meta name="description">')
            warnings += 1

    warnings += audit_presentation(templates_dir)

    if warnings == 0:
        print('No warnings: all editorial conventions are respected.')
    else:
        print(f'{warnings} warning(s). Reminder: audit never blocks the build, page layout remains the author\'s responsibility.')


# Every variable name that ever existed and no longer does, with where its
# job went. One flat table serving one audit warning: a rename that breaks
# quietly is the worst kind, and this is what makes it audible. The
# --fact-strong-* and --link-decoration-color names survived the rewrite
# unchanged, so they are not here.
RETIRED_VARIABLES = {
    # v0.12.0 colour-name renames (kept: an old sheet may carry them still)
    '--yellow': '--color-mark', '--dark': '--color-ink',
    '--grey': '--color-ink-quiet', '--light': '--color-page',
    '--green': '--color-affirm',
    # §9-rewrite renames: palette
    '--page': '--color-page', '--ink': '--color-ink',
    '--ink-muted': '--color-ink-quiet', '--marker': '--color-mark',
    '--accent': '--color-call (or the component axis: --footnote-call-fg, '
                '--verdict-partial-fg, --nav-btn-ring...)',
    '--positive': '--color-affirm (or --verdict-yes-fg)',
    # §9-rewrite: overlays dissolved into component properties
    '--rule': 'per-component: --slide-rule-fg, --footer-rule-fg, '
              '--table-rule-fg...',
    '--rule-strong': 'per-component: --quote-rule-fg, --card-rule-fg, '
                     '--nav-btn-rule-fg...',
    '--surface': 'per-component: --fact-bg, --article-bg, --card-bg...',
    '--sunken': 'per-component: --code-bg, --table-head-bg...',
    '--cover-bg': '--cover-bg-from / --cover-bg-to (a flat fill has equal '
                  'stops)',
    '--cover-fg': '--cover-fg', '--cover-fg-faint': '--cover-num-fg',
    '--control': '--nav-btn-bg', '--control-soft': '--nav-btn-bg-soft',
}


def audit_presentation(templates_dir):
    """The presentation-layer part of audit (§11.5): warns, never blocks.

    Three eyes. A legacy style.css, no longer read, with the rename table
    for whatever it references. Retired variable names inside custom.css,
    which would otherwise fail silently — a var() referencing nothing
    paints nothing and says nothing. And a settings scaffold whose
    commented values were generated under a different theme than the one
    the file now declares, so an author uncommenting a line would pin a
    value from a theme they left."""
    warnings = 0

    def _retired_in(text):
        return sorted({old for old in RETIRED_VARIABLES
                       if f'var({old})' in text or f'{old}:' in text},
                      key=len, reverse=True)

    legacy = templates_dir / 'style.css'
    if legacy.exists():
        warnings += 1
        print(f'[WARNING] templates/style.css exists but is no longer read: '
              f'the stylesheet is composed at build time. Move your values '
              f'to {SETTINGS_FILENAME}, your rules to {CUSTOM_CSS_FILENAME}, '
              f'then delete it.')
        found = _retired_in(read_text_file(legacy))
        if found:
            for old in found:
                print(f'          {old} -> {RETIRED_VARIABLES[old]}')

    custom_path = templates_dir / CUSTOM_CSS_FILENAME
    if custom_path.exists():
        found = _retired_in(read_text_file(custom_path))
        if found:
            warnings += 1
            print(f'[WARNING] templates/{CUSTOM_CSS_FILENAME}: these variables '
                  f'no longer exist, so the declarations using them are '
                  f'silently ignored:')
            for old in found:
                print(f'          {old} -> {RETIRED_VARIABLES[old]}')

    settings_path = templates_dir / SETTINGS_FILENAME
    if settings_path.exists():
        text = read_text_file(settings_path)
        try:
            declared, props = parse_settings_text(text)
        except PropertyError as exc:
            warnings += 1
            print(f'[WARNING] templates/{SETTINGS_FILENAME}: {exc}')
        else:
            m = re.search(r'^# scaffold-for: (\S+)$', text, re.MULTILINE)
            scaffold_for = m.group(1) if m else None
            declared_name = declared or 'default'
            if scaffold_for and scaffold_for != declared_name:
                warnings += 1
                print(f'[WARNING] templates/{SETTINGS_FILENAME}: the commented '
                      f'values were generated for theme {scaffold_for!r} but '
                      f'the file now declares {declared_name!r}. Uncommenting '
                      f'a line would pin a value from the old theme. '
                      f'Regenerate a fresh scaffold to compare when in doubt.')
            try:
                layers = [theme_property_layer(declared)] if declared else []
                layers.append(props)
                resolve_theme_properties(*layers)
            except PropertyError as exc:
                warnings += 1
                print(f'[WARNING] templates/{SETTINGS_FILENAME}: {exc}')

    return warnings


