# The seven palette variables, in the order a reader meets them on the page:
# the ground, then the two inks, then the furniture (§9.1).
#
# These are ROLE names. They were colour names until v0.12.0 — --yellow,
# --dark, --grey, --light, --green — because they were named after their
# values in the very first theme. Those names then lied on every theme
# that moved away from that palette: --yellow held a dark olive on Pop
# Lemon (a yellow marker on a yellow page is invisible), and --light held
# a near-black on every dark theme while --dark held the TEXT colour.
# A name that has to be un-learned to be used is worse than no name.
#
# A palette colour cannot be named after a component, because each one
# serves several: --marker draws the fact-box rule, the cover kicker, the
# header underline, the active nav dot and the emphasized column. The
# component-scoped properties are separate and keep their own names in
# the engine's registry (--cover-bg-from, --fact-strong-*, --fact-bg...).
PALETTE_ROLES = ('page', 'ink', 'ink-muted', 'marker', 'accent', 'positive',
                 'nav')

# The settings.conf property each old role name corresponds to — what the
# gallery shows under a swatch, because that is the name an author can
# actually type.
PROPERTY_NAME_OF_ROLE = {
    'page': 'color.page', 'ink': 'color.ink', 'ink-muted': 'color.ink-quiet',
    'marker': 'color.mark', 'accent': 'color.call', 'positive': 'color.affirm',
    'nav': 'color.nav',
}

# What each one does, for themes-gallery (§11.7).
PALETTE_ROLE_LABELS = {
