.series-link {
  border-style: solid;
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  transition: transform 0.15s, box-shadow 0.15s;
}
.series-link:hover, .series-link:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.12);
}
.series-link:focus-visible { outline-style: solid; outline-offset: 2px; }
.series-label { margin-bottom: 4px; }
.series-title { margin-bottom: 4px; }
.series-desc { margin-bottom: 8px; }

/* --- Navigation chrome. The opacities below fade a control's glyph, not
   running text, which is why they are allowed to stay literal. --- */
.nav-buttons {
  position: fixed;
  bottom: 24px;
  right: 28px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 200;
}
.nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border-style: solid;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0,0,0,0.10);
  transition: opacity 0.2s, transform 0.15s, box-shadow 0.15s;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.nav-btn:hover {
  transform: scale(1.08);
  box-shadow: 0 4px 14px rgba(0,0,0,0.15);
}
.nav-btn:active { transform: scale(0.96); }
.nav-btn:focus-visible { outline-style: solid; outline-offset: 2px; }
.nav-btn.disabled { opacity: 0.25; cursor: default; pointer-events: none; }
.nav-btn-home { font-size: 17px; }
.nav-dots {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  z-index: 150;
}
.nav-dots a {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: block;
  transition: background 0.2s, transform 0.2s;
}
.nav-dots a:hover { transform: scale(1.3); }
.nav-dots a.active { transform: scale(1.3); }

