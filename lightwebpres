# INDEX PAGE
# ============================================================================

def _page_footer(author, license_text, date=None):
    """One footer helper for every page: `<footer class="page-footer">`
    with an optional byline (author, date) and a license line.

    `author`, `license_text` and `date` arrive escaped and
    typography-processed — the callers pass fully-typed raw HTML, like
    every visible rendering (§6.2). A part is omitted when empty: no empty
    byline line, no empty license line, and no footer at all when nothing
    is left.
    """
    byline = ' — '.join(part for part in (author, date) if part)
    parts = []
    if byline:
        parts.append(f'  <div class="footer-byline">{byline}</div>')
    if license_text:
        parts.append(f'  <div class="footer-license">{license_text}</div>')
    if not parts:
        return ''
    return '<footer class="page-footer">\n' + '\n'.join(parts) + '\n</footer>'


def build_index(series_data, css, typo_engine, strings, lang='fr', index_extra='',
                build_stamp='', theme_runtime=None, style_context=None,
                language_runtime=None):
    """Generates the index page.

    The index is a page of the same site as the articles: it shares
    TEMPLATE_PAGE, and its own body (header, intro, cards, footer) goes
    into {{content}} exactly where an article's slides go."""
    meta = series_meta_of(series_data)
    articles = _series_entries(series_data)
    series_tag_values = series_tags(series_data)

    title = apply_typo(typo_engine, escape_amps(
        meta.get('title', strings.get('series_untitled_fallback',
                                      'Article series'))))
    subtitle = apply_typo(typo_engine, escape_amps(meta.get('subtitle', '')))
    version = meta.get('version', '')
    intro = apply_typo(typo_engine, escape_amps(meta.get('intro', '')))

    # <title> is RCDATA: unlike the series title (rendered inside the page
    # body, where raw HTML is allowed by design, same as a slide's own
    # slide_title — spec §4.3), a value here containing a literal
    # </title> would close the element early and let anything after it
    # execute as real markup.
    title_clean = strip_ws(re.sub(r'<[^<>]+>', ' ', title))

    # Cards
    read = strings.get('series_read', 'Read the article')
    cards = []
    for entry in articles:
        # card_title/card_desc/card_label are already fully resolved by
        # resolve_article_fields() (series.json > article meta > fallback,
        # §20.3.1) — no fallback logic needed here.
        label = apply_typo(typo_engine, escape_amps(entry.get('card_label', '')))
        card_title = apply_typo(typo_engine, escape_amps(entry.get('card_title', '')))
        card_desc = apply_typo(typo_engine, escape_amps(entry.get('card_desc', '')))
        # href is an attribute context: entry['page_dest'] is validated to be a
        # plain filename (validate_series), but it's escaped here too as
        # defense in depth against a future validation gap.
        label_html = f'\n  <div class="article-number">{label}</div>' if label else ''
        card = f'''<a href="{html_escape(entry['page_dest'], quote=True)}" class="article-card"{_entry_tag_attributes(entry)}>{label_html}
  <div class="article-title">{card_title}</div>
  <div class="article-desc">{card_desc}</div>
  <div class="article-cta">→ <span data-lwp-i18n="series_read">{read}</span></div>
</a>'''
        cards.append(card)

    # Index footer — the series-wide author/license (series_meta only:
    # per-article values belong on the articles' own pages). The index
    # has no per-page date, so the byline is author alone — the same
    # helper as the articles' own footers.
    footer_author = apply_typo(typo_engine, escape_amps(meta.get('author', '')))
    footer_license = apply_typo(typo_engine, escape_amps(meta.get('license', '')))
    index_footer = _page_footer(footer_author, footer_license)

    # Interface strings on the SKELETON first (template + the user's
    # index_extra fragment, which is a template file, not content), then
    # every data placeholder in a SINGLE pass (fill_placeholders), so a
    # literal {{str_KEY}} / {{css}} / {{content}} inside series_meta or
    # card text stays literal instead of being re-substituted into the
    # tag-stripped <title> or a card (§18.4).
    html = apply_strings(TEMPLATE_PAGE, strings, html_context=True)
    index_extra = apply_strings(index_extra, strings, html_context=True)
    # No visible empty pill when series_meta has no version: the span is
    # emitted here rather than in the template, so nothing has to be
    # deleted and the template stays the same for every series.
    header_parts = ['<div class="header">',
                    f'  <h1>{title}</h1>',
                    f'  <p class="subtitle">{subtitle}</p>']
    if version:
        header_parts.append(f'  <span class="version-tag">{version}</span>')
    header_parts.append('</div>')

    # The index's own body — everything an article's {{content}} would be:
    # header, intro, cards. The series footer goes in {{page_footer}},
    # the placeholder the article pages fill with their own footer.
    content = '\n'.join([
        '\n'.join(header_parts),
        '',
        '<div class="intro">',
        f'  <p>{intro}</p>',
        '</div>',
        '',
        '\n'.join(cards),
    ])

    html = fill_placeholders(html, {
        'lang': lang, 'title': title_clean, 'css': css,
        'body_class': 'index-page',
        'default_tag': html_escape(meta.get('default_tag', 'default'), quote=True),
        'series_tags': html_escape(' '.join(series_tag_values), quote=True),
        'article_tags': '',
        'tag_preview': html_escape(tag_preview_data(series_data), quote=True),
        'meta_head': '', 'draft_banner': '',
        'content': content, 'page_footer': index_footer,
        'js_nav': apply_strings(TEMPLATE_NAV_JS, strings),
        'build_stamp': build_stamp, 'index_extra': index_extra,
        'lightwebpres_version': VERSION,
        'language_runtime': language_runtime or '',
        'theme_runtime': _theme_runtime_markup(theme_runtime, style_context),
    })

    validate_html(html, 'index.html')
    return html


def build_readme(series_data, sd, output_dir, strings):
    """Generates README.md content: series title/subtitle/intro from
    series_meta, then a numbered list of articles linking to their built
    HTML file (spec §8.3)."""
    meta = series_meta_of(series_data)
    articles = _series_entries(series_data)

    title = meta.get('title', strings.get('series_untitled_fallback', 'Article series'))
    subtitle = meta.get('subtitle', '')
    intro = meta.get('intro', '')

    lines = [f'# {title}']
    if subtitle:
        lines.append('')
        lines.append(subtitle)
    if intro:
        lines.append('')
        lines.append(intro)
    lines.append('')
    lines.append('## Articles')
    lines.append('')
    for i, entry in enumerate(articles, 1):
        article_title = entry.get('nav_title', entry.get('page_dest', ''))
        article_desc = entry.get('nav_desc', '')
        # as_posix(): os.path.relpath yields backslashes on Windows,
        # which are broken Markdown link separators.
        link = Path(os.path.relpath(output_dir / entry['page_dest'], start=sd)).as_posix()
        if article_desc:
            lines.append(f'{i}. [{article_title}]({link}) — {article_desc}')
        else:
            lines.append(f'{i}. [{article_title}]({link})')
    lines.append('')

    return '\n'.join(lines)


# ============================================================================
# HTML OUTPUT VALIDATION
# ============================================================================

# Elements that never take a closing tag in HTML5, with or without a
# trailing "/>" — must not be pushed on the balance-checking stack below.
VOID_ELEMENTS = {
    'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
    'link', 'meta', 'param', 'source', 'track', 'wbr',
}


class _HtmlBalanceChecker(HTMLParser):
    """Tracks a stack of open tags to catch mismatched/unclosed tags in
    generated HTML. <script>/<style> content is handled as raw text by
    HTMLParser itself, so JS containing `<`/`>` (comparisons, etc.) is not
    mistaken for markup."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []
        self.errors = []

    def handle_starttag(self, tag, attrs):
        if tag not in VOID_ELEMENTS:
            self.stack.append(tag)

    def handle_endtag(self, tag):
        if tag in VOID_ELEMENTS:
            return
        if not self.stack:
            self.errors.append(f'unexpected closing </{tag}> with no matching open tag')
            return
        if self.stack[-1] != tag:
            self.errors.append(
                f'</{tag}> does not match the currently open <{self.stack[-1]}>'
            )
            return
        self.stack.pop()


_RELATIVE_SRC_RE = re.compile(
    r'<img\b[^>]*?\bsrc\s*=\s*'
    r'(?:(?:"(?P<double>[^"]*)")|(?:\'(?P<single>[^\']*)\')|'
    r'(?P<bare>[^\s"\'=`<>]+))',
    re.IGNORECASE)
_ABSOLUTE_SRC_RE = re.compile(r'^(?:data:|https?://|//)', re.IGNORECASE)


def validate_self_contained(html, filename):
    """Fatal if a page built with --inline-images still points outside itself.

    The option's whole contract is that the file travels alone (§8.4), and
    `img/` is deliberately not copied when it is on — so a surviving
    relative `src` is not a cosmetic miss, it is a dangling reference in a
    page that claims to have none. It went unnoticed for as long as it did
    because a `public/img/` left behind by an earlier ordinary build keeps
    the image showing; the breakage only appears on a clean deploy, which
    is exactly when this option is reached for (BACKLOG B23).

    Raw HTML written by the author (§6.2) is not converted and so is not
    inlined either; it is caught here rather than silently shipped, and the
    message says what to do about it."""
    stray = []
    for match in _RELATIVE_SRC_RE.finditer(html):
        src = next(value for value in (
            match.group('double'), match.group('single'), match.group('bare'))
            if value is not None)
        if not _ABSOLUTE_SRC_RE.match(src):
            stray.append(src)
    if not stray:
        return
    log('error', f'{filename}: --inline-images left {len(stray)} image(s) '
                 f'pointing outside the page ({", ".join(stray[:3])}'
                 f'{", …" if len(stray) > 3 else ""}). The image directory is '
                 'not copied when this option is on, so the page would ship '
                 'broken. Raw <img> written as HTML is never inlined — use '
                 'Markdown image syntax, or build without --inline-images.')
    sys.exit(1)


# CommonMark's two autolink forms, as they survive into the assembled
# page: an absolute URI, and an email address. Both are refused (see
# validate_html) — this exists so the refusal can name what the author
# typed. Deliberately narrow: a scheme is letters then `:`, an address
# has an `@` and no space, and neither may contain `<`, `>` or a space,
# so a `<` in ordinary prose cannot be dragged into a false match.
_AUTOLINK_RE = re.compile(
    r'<((?:[a-zA-Z][a-zA-Z0-9+.-]*:|[^\s<>@]+@)[^\s<>]*)>')


def validate_html(html_text, filename):
    """Rejects generated HTML that isn't well-formed (mismatched or
    unclosed tags) — a bug in a template or in convert_markdown() must
    never silently ship a broken page. Structural check only: stdlib
    html.parser has no notion of full HTML5 conformance, only tag
    balance, but that is exactly the class of defect a rendering bug in
    this codebase would produce."""
    checker = _HtmlBalanceChecker()
    checker.feed(html_text)
    checker.close()
    if checker.stack:
        unclosed = ', '.join(f'<{t}>' for t in reversed(checker.stack))
        checker.errors.append(f'unclosed tag(s) at end of document: {unclosed}')
    if checker.errors:
        # An autolink is not a mismatched tag, and saying so sends the
        # author looking for a `<div>` they never wrote. `<https://x.test>`
        # and `<contact@x.test>` are CommonMark's autolink syntax, which
        # this grammar does not accept because §6.2 gives `<...>` to raw
        # inline HTML — the two syntaxes want the same two characters, and
        # only one of them can have them. Refusing is right; blaming the
        # wrong thing is not. Read off the SOURCE rather than off the
        # checker's stack, because the stack holds what a tag parser made
        # of it (a tag named `https:`) and the author needs to be shown
        # what they typed.
        autolinks = _AUTOLINK_RE.findall(html_text)
        if autolinks:
            first = autolinks[0]
            # Two forms, two remedies, and only one of them is a Markdown
            # link: `[…](…)` is restricted to http(s) (see md_inline), so
            # telling someone to write `[a@b](mailto:a@b)` would be
            # advice that does not work -- which is the whole defect
            # being repaired here, one level down.
            if first.lower().startswith(('http://', 'https://')):
                remedy = f'Write `[{first}]({first})` instead.'
            else:
                remedy = ('A Markdown link only takes an http(s) address, '
                          'so for anything else write the raw HTML: '
                          f'`<a href="{first}">{first}</a>` — or simply '
                          'leave the address as plain text.')
            log('error',
                f'{filename}: `<{first}>` is a Markdown autolink, and this '
                f'format does not read one: `<...>` is raw inline HTML here '
                f'(§6.2), so a tag parser sees an element that is never '
                f'closed. {remedy}')
            sys.exit(1)
        log('error', f'{filename}: the generated HTML is not well-formed — '
              f'this almost always means unbalanced raw HTML in the source '
              f'for this page (an unclosed or mismatched tag, e.g. a <div> in '
              f'a fact-box or full-article that is never closed). Fix the tag '
              f'balance in the source and rebuild:')
        for e in checker.errors:
            log('error', f'  - {e}')
        sys.exit(1)


# ============================================================================
# BUILD ENGINE
# ============================================================================

# What each opt-out switches off, in CATEGORIES rather than in rule
# names. `typo_units` is a bundle of two, and saying so here is the
# honest form: `nbsp_after_operator` puts a space after x or ~, which is
# not a unit rule, but it has always travelled with the field and the
# field's name is the one authors have written.
TYPO_OPT_OUTS = {
    'typo_units': ('unit', 'operator'),
    'typo_thousands': ('thousands',),
}


def typo_disabled_rules(meta, engine=None, source=''):
    """Reads an article's typo_units/typo_thousands meta fields (§4.5) and
    returns the set of rule names to skip on that article's own page.
    'off' (case-insensitive) is the only value that disables a rule;
    anything else, or the field's absence, leaves it enabled (default).

    Resolved through the ENGINE's categories, not through a list of
    names. It used to name three: nbsp_before_unit, nbsp_after_operator
    and nbsp_thousands_separator. All three exist in the French pack and
    only one of them in the English, which named its unit rules
    nbsp_before_metric_unit and nbsp_before_unit_word and has no
    thousands rule at all -- so `typo_units: off` left both English unit
    rules running and `typo_thousands: off` was a silent no-op. Measured:
    "3 kW" and "5 million" both kept their non-breaking space under
    `--lang en` with the field set. A pack states what its rules are for;
    the opt-out reads it, and reaches a pack nobody here has seen.

    A switch that finds NOTHING to disable warns. Resolving through
    categories fixed one silent no-op and opened another: a pack whose
    rules carry no `category` -- one written by hand, or copied into a
    series by an `init` older than v0.40.0 -- yields an empty set, so the
    field is read, accepted, and ignored. Measured on a series holding a
    v0.39.0 pack: `typo_units: off` still produced `170<nbsp>millions`.
    The build says so now, because §2.4's promise that nothing is a
    silent no-op is not a promise about options only.

    Warned once per field per build, not once per article: the cause is
    the pack in force, and a series that sets the field on every article
    would otherwise print the same line twenty-eight times. The set that
    remembers lives on the ENGINE, which is built once per build, so
    nothing here is module state to reset.

    The third, blanket meta field (typo: off, disabling every rule for
    the article, not just these two) is handled separately in
    build_article via article_typo_engine, since it needs to swap in a
    `None` engine rather than name individual rules."""
    disabled = set()
    if engine is None:
        return disabled
    for field, categories in TYPO_OPT_OUTS.items():
        if str(meta.get(field, '')).strip().lower() != 'off':
            continue
        found = set()
        for category in categories:
            found |= engine.categories.get(category, set())
        if not found:
            warned = getattr(engine, '_opt_out_warned', None)
            if warned is None:
                warned = engine._opt_out_warned = set()
            if field not in warned:
                warned.add(field)
                where = f'{source}: ' if source else ''
                named = ', '.join(f'"{c}"' for c in categories)
                log('warn', f'{where}{field}: off has nothing to disable — '
                    f'no rule in the language pack in force declares a '
                    f'{named} category, so the field is read and does '
                    f'nothing. A pack from before v0.40.0 has no '
                    f'categories: delete it to use the built-in one, or '
                    f'add a "category" to the rules it carries.')
        disabled |= found
    return disabled


def typo_engine_for_slide(slide, fallback, lang_tag_engines=None):
    """Selects the first language pack named by a slide tag.

    Tags are ordered as written, so a slide carrying several non-language
    tags remains unaffected, while a deliberately multi-language slide has a
    deterministic winner. Slides without a mapped language tag use the
    build's `--lang` engine.
    """
    for tag in slide.tags or ('default',):
        if lang_tag_engines and tag in lang_tag_engines:
            return lang_tag_engines[tag]
    return fallback


def build_article(source_path, sources_dir, series_data, current_file, css, nav_js, typo_engine, strings, lang='fr', build_stamp='', style_context=None, include_nav=True, absorb_punct=False, inline_images=False, args=None, lang_tag_engines=None, theme_runtime=None, language_runtime=None):
    """Builds an HTML page for an article."""
    md_text = read_text_file(source_path)
    meta, slides, has_meta_block, content_before_meta = parse_markdown_extended(md_text)
    validate_slides(slides, source_path.name, has_meta_block, content_before_meta)

    # The article layer of the cascade: style.* meta keys restyle THIS page,
    # recomposed over the same series layers. Same vocabulary, same types,
    # same errors as settings.conf — and the error names the file, because a
    # property mistake in one article must never read as a build mystery.
    try:
        page_props = page_style_properties(meta, source_path.name)
        if page_props and style_context is not None:
            css = compose_with(style_context, page_props)
    except PropertyError as exc:
        log('error', f'{source_path.name}: {exc}')
        sys.exit(1)
    theme_runtime_markup = _theme_runtime_markup(
        theme_runtime, style_context, page_props)

    # absorb-punct applies only when the mark carries a ground (the bg is
    # not transparent) AND the property is on. A page can pin either, so
    # this is resolved here against the page's own cascade, not passed in.
    if style_context is not None:
        try:
            layers = [*style_context[0], *([page_props] if page_props else [])]
            resolved = resolve_theme_properties(*layers)
            bg = resolved.get('fact.strong.bg', '')
            if (resolved.get('fact.strong.absorb-punct') == 'on'
                    and not bg.endswith('00')):
                absorb_punct = True
        except PropertyError:
            pass

    disabled_rules = typo_disabled_rules(meta, typo_engine, source_path.name)
    disabled_by_engine = {typo_engine: disabled_rules}

    def disabled_for(engine):
        # Each selected pack resolves the article's bundles against its own
        # category names; the fallback result also preserves `typo: off`.
        if engine is None:
            return disabled_rules
        if engine not in disabled_by_engine:
            disabled_by_engine[engine] = typo_disabled_rules(
                meta, engine, source_path.name)
        return disabled_by_engine[engine]

    # typo: off (§4.5) is this article's own --no-typography: skip the
    # engine entirely for its page, the same `None` the CLI flag passes
    # for a whole build, not just the two rules disabled_rules can name.
    article_typo_engine = None if str(meta.get('typo', '')).strip().lower() == 'off' else typo_engine
    article_lang_tag_engines = (lang_tag_engines
                                if article_typo_engine is not None else {})

    # Notes: where the bodies land, and whether the call carries the text
    # as well. One page-wide scope under `page`, one scope per locality
    # under `local` -- which is what makes the numbering restart in each
    # card while the anchors stay unique to the document.
    notes_placement, notes_tooltip = resolve_notes_settings(
        meta, series_meta_of(series_data), source_path.name)
    page_notes = (NoteScope('p', tooltip=notes_tooltip, endnotes=True, deferred=True)
                  if notes_placement == 'page' else None)

    # `excluded` is a source-level omission, not a runtime filter: no section,
    # anchor, note scope, or slide number is created for it.
    visible_slides = [slide for slide in slides if 'excluded' not in slide.tags]
    own_entry = next((entry for entry in _series_entries(series_data)
                      if entry.get('page_dest') == current_file), None)
    if not visible_slides and (own_entry is None
                               or own_entry.get('status') != 'ignored'):
        log('warn', f'{source_path.name}: no non-excluded slide can be '
            'displayed; the generated article page will contain no slide.')
    total_slides = len(visible_slides)
    show_slide_num = resolve_slide_page_numbers(
        meta, series_meta_of(series_data), source_path.name, args)
    # Identities for the whole page, before any card is rendered: a card's
    # id has to be unique across the page, so it cannot be decided card by
    # card (§12.1.1).
    slug_prefix = resolve_slug_prefix(meta, series_meta_of(series_data),
                                      source_path.name)
    try:
        identities = resolve_page_slide_ids(visible_slides, slug_prefix,
                                            source_path.name)
    except PropertyError as exc:
        log('error', f'{source_path.name}: {exc}')
        sys.exit(1)

    slide_htmls = []

    # Instance tags and fact variants are validated during rendering; their
    # errors carry the article's name for the same reason the style.* ones
    # do above.
    try:
        for i, slide in enumerate(visible_slides, 1):
            slide_typo_engine = typo_engine_for_slide(
                slide, article_typo_engine, article_lang_tag_engines)
            slide_disabled_rules = disabled_for(slide_typo_engine)
            slide_notes = (page_notes if page_notes is not None
                           else NoteScope(identities[i - 1],
                                          tooltip=notes_tooltip))
            html = render_slide(slide, i, total_slides, slide_typo_engine,
                                strings, slide_disabled_rules, slide_notes,
                                absorb_punct=absorb_punct,
                                inline_images=inline_images,
                                sources_dir=sources_dir,
                                show_slide_num=show_slide_num,
                                slide_id=identities[i - 1])
            slide_htmls.append(html)
    except PropertyError as exc:
        log('error', f'{source_path.name}: {exc}')
        sys.exit(1)

    # Join the slides
    slides_html = '\n\n'.join(slide_htmls)

    # Inject the series navigation — the build-wide typo_engine, not
    # article_typo_engine: this block's entries aren't "this article's
    # own page content" even when it's this article's own entry (§4.5).
    # --no-nav: the placeholder is replaced by an empty string,
    # leaving the container (<h2> + <div class="series-list">) in the HTML,
    # empty but not an error.
    if include_nav:
        series_nav_html = build_series_nav(current_file, series_data, strings, typo_engine)
    else:
        series_nav_html = ''
    slides_html = slides_html.replace('{SERIES_NAV_PLACEHOLDER}', series_nav_html)

    # Inject the full articles. A missing file is fatal (§22.8): the page
    # would otherwise be published with the literal placeholder text in
    # place of the article, and exit 0 — a corrupted page shipped green.
    #
    # One marker per slide, carrying that slide's number. A single shared
    # marker was why a page could hold only one long-form piece: a global
    # str.replace() put the FIRST article into every marker, so a second
    # one was duplicated over and its own text silently dropped. The rule
    # that came out of it — "only one full-article per page" — was never a
    # decision about the format, only a guard around that substitution.
    articles_here = sum(1 for s in visible_slides
                        if s.slide_type == 'full-article')
    for i, slide in enumerate(visible_slides, 1):
        if slide.slide_type == 'full-article' and slide.article_file:
            # Realpath containment on top of the name-shape guard: the
            # name check already ran at parse time, but a bare name that
            # is a symlink pointing outside sources/ passes it and would
            # otherwise be read and embedded verbatim into the page.
            article_path = _resolve_contained(sources_dir, slide.article_file)
            if article_path is None:
                log('error', f'{source_path.name}: article file "{slide.article_file}" '
                      f'resolves outside sources/ (symlink or traversal).')
                sys.exit(1)
            if not article_path.exists():
                log('error', f'{source_path.name}: article file not found: '
                      f'{slide.article_file} (referenced by its full-article slide).')
                sys.exit(1)
            article_md = read_text_file(article_path)
            # Name the file the author has to open. The deck's own text is
            # already covered upstream; without this the long-form file --
            # where most of the prose lives -- surfaced a bad instance or
            # block tag as a bare Python traceback naming no source at all.
            try:
                # The anchor prefix stays `article` while the page has one
                # long-form piece, and is disambiguated by slide only when
                # it has several. Not tidiness: `#note-article-3` is a URL
                # a reader can have bookmarked or a correspondent can have
                # been sent, and moving every one of them to buy
                # uniqueness a single-article page does not need would
                # break inbound links for a capability that page is not
                # using. A second article on the page does move the
                # first's anchors, which is the honest cost of the two of
                # them having to share a document.
                article_notes = (
                    page_notes if page_notes is not None
                    else NoteScope('article' if articles_here == 1
                                   else f'article-{identities[i - 1]}',
                                   tooltip=notes_tooltip))
                slide_typo_engine = typo_engine_for_slide(
                    slide, article_typo_engine, article_lang_tag_engines)
                article_disabled_rules = disabled_for(slide_typo_engine)
                # inline_images/sources_dir travel here too. Omitting them
                # was not a missing feature but a broken promise: the images
                # of a `full-article` include kept a relative src while
                # `public/img/` was deliberately not copied, so the one
                # option whose whole contract is "this file travels alone"
                # produced a page with a dangling reference (BACKLOG B23).
                article_html = convert_markdown(article_md, slide_typo_engine,
                                                article_disabled_rules, article_notes,
                                                strings,
                                                inline_images=inline_images,
                                                sources_dir=sources_dir)
            except PropertyError as exc:
                log('error', f'{slide.article_file}: {exc}')
                sys.exit(1)
            slides_html = slides_html.replace(
                f'{{FULL_ARTICLE_PLACEHOLDER:s{i}}}', article_html)

    # `notes_placement: page`: the whole page is one locality, so nothing
    # could be numbered until now -- a call in card 2 to a body defined in
    # card 5 has to wait for card 5 to have been read. The section itself
    # is a section of the page like the article's, with its own heading,
    # its own anchor and its own nav dot; "a separate notes page" was never
    # outside the document (ARCHI-NOTES §2).
    if page_notes is not None:
        page_notes.apply_typography(article_typo_engine, disabled_rules)
        slides_html = page_notes.resolve(slides_html)
        bodies = page_notes.render_bodies(strings)
        if bodies:
            heading = html_escape(strings.get('notes_section_title', 'Notes'))
            slides_html += (
                f'\n\n<section class="slide notes-section" id="notes" '
                f'role="doc-endnotes">\n  <h2 data-lwp-i18n="notes_section_title">{heading}</h2>\n{bodies}\n</section>')

    # Page title — the already-resolved page_title (series.json > article
    # meta > cover slide's own slide_title > page_dest, see
    # resolve_article_fields()), not a fresh re-read of the meta block
    # here: series.json's own override would never reach this function
    # otherwise.
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data
    own_entry = next((e for e in articles if e.get('page_dest') == current_file), None)
    title = own_entry['page_title'] if own_entry else meta.get('page_title', current_file)
    # Strip HTML tags from the title, then escape what is left. The tags
    # go first, so escape_amps has nothing to protect by the time it runs
    # and every `&` in the title is an `&` the author typed -- which is
    # what <title> needs, being RCDATA: a bare `&copy` there is read as
    # an entity exactly as it is in the body.
    title_clean = strip_ws(re.sub(r'<[^<>]+>', ' ', title))
    title_clean = apply_typo(article_typo_engine, escape_amps(title_clean),
                             disabled_rules)

    # <head> metadata — author and description, both attribute contexts:
    # tag-stripped (they may legitimately carry inline HTML for the
    # visible renderings, §6.2, but an attribute can't) and quote-escaped.
    # Omitted entirely when empty, never an empty content="".
    meta_head = ''
    if own_entry:
        for name, value in (('author', own_entry.get('author', '')),
                            ('description', own_entry.get('page_desc', ''))):
            if value:
                clean = strip_ws(re.sub(r'<[^<>]+>', ' ', value))
                clean = apply_typo(article_typo_engine, clean, disabled_rules)
                meta_head += f'<meta name="{name}" content="{html_escape(clean, quote=True)}">\n'

    # Page footer — byline (author, date) + license, visible renderings:
    # raw HTML passthrough like all body content (§6.2), typography
    # applied via this article's own engine (it IS this page's content).
    page_footer = ''
    if own_entry:
        author = apply_typo(article_typo_engine,
                            escape_amps(own_entry.get('author', '')),
                            disabled_rules)
        date = apply_typo(article_typo_engine,
                          escape_amps(own_entry.get('date', '')),
                          disabled_rules)
        license_text = apply_typo(article_typo_engine,
                                  escape_amps(own_entry.get('license', '')),
                                  disabled_rules)
        page_footer = _page_footer(author, license_text, date)

    # Draft banner — only ever reachable under --include-drafts (drafts
    # are filtered out of the build entirely otherwise). Inline-styled
    # for the same staleness reason as the build stamp (see
    # build_stamp_html): a series' own templates/style.css predating this
    # feature has no .draft-banner rule, and a preview must NEVER look
    # like a publication because of a stale stylesheet.
    draft_banner = ''
    if own_entry and own_entry.get('status') == 'draft':
        banner_text = strings.get('draft_banner', 'Draft')
        banner_style = (
            'position:absolute;top:14px;left:50%;transform:translateX(-50%);'
            'background:#ff4757;color:white;padding:3px 12px;border-radius:4px;'
            'font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;'
            'z-index:60;pointer-events:none;'
            "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;"
        )
        draft_banner = f'<div class="draft-banner" style="{banner_style}" data-lwp-i18n="draft_banner">{banner_text}</div>'

    # The stamp goes INSIDE the first card, not beside the cards in the
    # body. It inherits its colour (build_stamp_html), and on an article
    # page the two grounds it could sit on are opposites: the cover paints
    # its own ground and its own ink, and on a light theme that pair is
    # the page's pair INVERTED. Measured on nord, the body's ink is
    # #2E3440 and the cover's ground is the same #2E3440, so a stamp
    # inheriting from the body painted itself onto its own colour at
    # 1.00:1. In the first card it inherits the card's ink over the card's
    # ground, which is the pair the contrast audit already covers.
    #
    # `position: absolute` resolves against the card (`.slide` is
    # relative) instead of the initial containing block, and the first
    # card starts at the top of the document, so the corner it lands in
    # is the same corner.
    stamp_in_body = build_stamp
    if build_stamp:
        slides_html, moved = re.subn(
            r'(<section\b[^>]*>)',
            # No separator: strip_build_stamp() must restore the page
            # byte for byte, or `check` reports the whitespace it left
            # behind as drift on a series built with the flag.
            lambda mo: mo.group(1) + build_stamp, slides_html, count=1)
        if moved:
            stamp_in_body = ''

    # Assemble the page. Interface strings are applied to the SKELETON
    # (template — nav_js got its own pass at load time) before any
    # author-provided content is injected; then every remaining data
    # placeholder is filled in a SINGLE pass (fill_placeholders), so a
    # value that itself contains a {{...}} token — e.g. a literal {{css}}
    # typed into an article's page_title or page_desc — is emitted as-is
    # and never re-substituted. The old sequential str.replace chain
    # re-scanned each injected value, letting author content inject the
    # stylesheet/other markers into the tag-stripped <title> and escaped
    # <meta> sinks, bypassing their guard (§18.4).
    html = apply_strings(TEMPLATE_PAGE, strings, html_context=True)
    series_meta = series_meta_of(series_data)
    series_tag_values = series_tags(series_data)
    html = fill_placeholders(html, {
        'lang': lang, 'title': title_clean, 'meta_head': meta_head,
        'css': css, 'body_class': '',
        'default_tag': html_escape(series_meta.get('default_tag', 'default'),
                                   quote=True),
        'series_tags': html_escape(' '.join(series_tag_values), quote=True),
        'article_tags': html_escape(
            ' '.join(own_entry.get('_lwp_article_tags', ())
                     if own_entry else ()), quote=True),
        'tag_preview': html_escape(tag_preview_data(series_data), quote=True),
        'content': slides_html, 'page_footer': page_footer,
         'js_nav': nav_js, 'build_stamp': stamp_in_body,
         'draft_banner': draft_banner, 'index_extra': '',
         'lightwebpres_version': VERSION,
         'language_runtime': language_runtime or '',
         'theme_runtime': theme_runtime_markup,
    })

    validate_html(html, current_file)
    if inline_images:
        validate_self_contained(html, current_file)
    return html


def _encode_inline_image(src, sources_dir):
    """Encodes an image file as a base64 data URI for --inline-images.

    `src` is the path as written in the Markdown (`img/foo.png`), resolved
    against `sources_dir` (where the img/ directory lives). Returns the
    data URI string, or None if the file cannot be read — in which case
    the caller leaves the original `src` in place so the broken link is
    visible (a missing image inlined as nothing would hide the error).

    `src` is attacker-reachable — an LLM-authored article, a CMS export, a
    cloned series repo — and it is NOT a bare filename, so the name-shape
    check does not apply: `img/foo.png` is the ordinary case. The realpath
    barrier is the one that fits, and it was missing. `Path(dir) / '/etc/
    passwd'` discards the left side, and the extractor regex permits both a
    leading `/` and `..`, so a build with --inline-images read any file the
    build user could open and base64'd it into the published page. It also
    walked straight past copy_images' symlink guard, which refuses the same
    escape on the non-inline path and whose docstring names this exact
    threat. Refused and warned rather than fatal, to match that guard: a
    series that builds with a warning must not become unbuildable because
    of the flag that packages it."""
    contained = _resolve_contained(sources_dir, src)
    if contained is None:
        # Same shape as copy_images' sibling warning. The level is 'warn',
        # and the spelling is the whole of it: an unknown level is DROPPED
        # SILENTLY, so a log('warning', ...) here would refuse the read and
        # tell nobody -- and 'info' would print but never reach audit's
        # collector, which hooks the 'warn' branch only.
        log('warn', f'skipped image escaping the article '
            f'directory: {src}')
        return None
    try:
        data = contained.read_bytes()
    except (OSError, ValueError):
        return None
    mime = mimetypes.guess_type(src)[0] or 'application/octet-stream'
    return f'data:{mime};base64,{base64.b64encode(data).decode("ascii")}'


def symlink_escapes(entry, root):
    """True if `entry` is a symlink resolving outside `root`.

    One rule, two callers: `copy_images` refuses on it while copying, and
    `audit` scans on it without copying. Extracted rather than restated,
    because a security rule written twice is a security rule that will
    diverge -- exactly the defect recorded at B25 for the zip guard, and
    not one to reproduce while closing another."""
    if not entry.is_symlink():
        return False
    target = entry.resolve()
    return target == root or root not in target.parents


def audit_image_symlinks(sources_dir):
    """Warns about image symlinks that escape img/, without copying anything.

    `copy_images` raises this warning too, but only while writing, so
    `audit` never saw it: the finding is about the SOURCES an author
    committed, not about the act of copying, and it belongs where an
    author asks what is wrong with their series."""
    img_src = sources_dir / 'img'
    if not (img_src.exists() and img_src.is_dir()):
        return 0
    root = img_src.resolve()
    found = 0
    for entry in sorted(img_src.rglob('*')):
        if symlink_escapes(entry, root):
            found += 1
            log('warn', f'img/: symlink escaping the image directory, it '
                        f'would not be published: {entry.relative_to(img_src)}')
    return found


def copy_images(sources_dir, output_dir):
    """Copies the img/ directory if it exists.

    Merges into an existing img_dst (dirs_exist_ok) instead of wiping it
    first: a mistyped --output pointing at an unrelated existing directory
    must never delete a pre-existing img/ there.

    Symlinks that escape img/ are refused, not followed: copytree's
    default (symlinks=False) copies a link's *referent content*, so a
    committed `img/leak.png -> /etc/passwd` (or a directory symlink) would
    otherwise be published into public/img/ — arbitrary host-file
    exfiltration from an attacker-authored series built unattended. A
    symlink whose realpath stays inside img/ is harmless and kept.

    Returns the paths it published, relative to output_dir. The manifest
    is built from THIS list rather than from a scan of the destination.
    Scanning the destination re-blesses whatever is already sitting there,
    so an image deleted from the source stayed declared by every later
    build, never reached the orphan list, and stayed published forever —
    including a photograph withdrawn on purpose."""
    img_src = sources_dir / 'img'
    img_dst = output_dir / 'img'
    if not (img_src.exists() and img_src.is_dir()):
        return []
    if _resolve_contained(sources_dir, 'img') is None:
        log('warn', 'img/: skipped image directory escaping the source '
            'directory (symlink).')
        return []
    _reject_symlink_components(img_dst, 'image output directory')
    src_root = img_src.resolve()
    refused = set()

    def _refuse_escaping_symlinks(dir_path, names):
        ignored = set()
        for name in names:
            entry = Path(dir_path) / name
            if symlink_escapes(entry, src_root):
                log('warn', f'img/: skipped symlink escaping the '
                      f'image directory: {entry.relative_to(img_src)}')
                ignored.add(name)
                refused.add(entry)
        return ignored

    _copytree(img_src, img_dst, dirs_exist_ok=True,
              ignore=_refuse_escaping_symlinks)
    progress(f'  Images copied: {img_dst}')
    # What was published: the source tree minus what the guard refused. A
    # refused entry is checked against the path AND its parents, because a
    # refused directory symlink takes everything under it with it.
    published = []
    for p in sorted(img_src.rglob('*')):
        if refused.intersection({p, *p.parents}):
            continue
        if p.is_file():
            published.append(str(Path('img') / p.relative_to(img_src)))
    return published


def load_series_data(series_dir):
    """Loads series.json."""
    series_file = series_dir / 'series.json'
    if not series_file.exists():
        log('error', f'series.json not found in {series_dir}')
        sys.exit(1)
    try:
        data = json.loads(read_text_file(series_file))
    except (ValueError, RecursionError) as e:
        # ValueError covers json.JSONDecodeError; RecursionError guards a
        # deeply-nested array/object (e.g. "["*100000) from crashing the
        # JSON parser with a raw traceback instead of a clean [ERROR].
        log('error', f'{series_file}: invalid JSON ({e}).')
        sys.exit(1)
    articles = data.get('articles', data) if isinstance(data, dict) else data
    if not isinstance(articles, list) or not all(isinstance(e, dict) for e in articles):
        log('error', f'{series_file}: "articles" must be a list of objects.')
        sys.exit(1)
    return data


def series_themes_of(series_data):
    """Returns the optional root runtime-theme selection from series.json."""
    if not isinstance(series_data, dict) or 'themes' not in series_data:
        return None
    themes = series_data['themes']
    if not isinstance(themes, list) or not themes:
        raise PropertyError('series.json: "themes" must be a non-empty list '
                            'of strings')
    for index, value in enumerate(themes):
        if not isinstance(value, str) or not value.strip():
            raise PropertyError(f'series.json: "themes" item {index} must be '
                                'a non-empty string')
    return themes


# Field names retired in v0.7.0 by the nomenclature freeze that 1.0 will
# GUARANTEE -- the freeze was performed then, 1.0 is when it becomes a
# compatibility promise (spec §13.9),
# mapped to their replacements — recognized only to produce a clear
# migration error instead of a mystifying "missing required field".
_LEGACY_SERIES_FIELDS = {'source': 'page_source', 'file': 'page_dest'}


# series_meta string leaves used by build_index / resolve_article_fields.
_SERIES_META_STRING_FIELDS = (
    'title', 'subtitle', 'version', 'intro', 'author', 'license',
    'default_tag',
)


def series_meta_of(series_data):
    """The `series_meta` object, validated. A non-dict series_meta (or a
    non-string leaf like `title: 123`) used to crash later at a .get() or
    re.sub() with a raw traceback; reject it here with a clean error, the
    same bar §20.5 sets for the rest of series.json."""
    if not isinstance(series_data, dict):
        return {}
    meta = series_data.get('series_meta', {})
    if not isinstance(meta, dict):
        log('error', f'series.json: "series_meta" must be an object '
              f'(got {type(meta).__name__}).')
        sys.exit(1)
    for field in _SERIES_META_STRING_FIELDS:
        if field in meta and meta[field] is not None and not isinstance(meta[field], str):
            log('error', f'series.json: "series_meta.{field}" must be a string '
                  f'(got {type(meta[field]).__name__}).')
            sys.exit(1)
    if 'default_tag' in meta:
        meta['default_tag'] = normalize_default_tag(
            meta['default_tag'], 'series.json: series_meta.default_tag')
    lang_tags = meta.get('lang_tags', {})
    if lang_tags is None:
        lang_tags = {}
    if not isinstance(lang_tags, dict):
        log('error', f'series.json: "series_meta.lang_tags" must be an object '
              f'(got {type(lang_tags).__name__}).')
        sys.exit(1)
    normalized_lang_tags = {}
    for tag, pack in lang_tags.items():
        if not isinstance(tag, str) or not isinstance(pack, str):
            log('error', 'series.json: "series_meta.lang_tags" must map '
                  'string tags to string language pack names.')
            sys.exit(1)
        canonical = tag.strip().casefold()
        pack = pack.strip()
        if (not canonical or canonical.startswith('_')
                or not _TAG_TOKEN_RE.fullmatch(canonical)):
            log('error', f'series.json: series_meta.lang_tags has invalid tag '
                  f'{tag!r}.')
            sys.exit(1)
        if (not pack
                or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', pack)):
            log('error', f'series.json: series_meta.lang_tags[{tag!r}] has an '
                  f'invalid language pack name {pack!r}.')
            sys.exit(1)
        normalized_lang_tags[canonical] = pack
    meta['lang_tags'] = normalized_lang_tags
    return meta


def validate_series(articles):
    """Rejects series.json structural errors (§20.3): `page_source` must
    be present, non-empty, a plain filename (no path separators, no "..")
    and end in .md on every entry — otherwise the build crashes on a raw
    KeyError instead of a clear message, or (page_source being joined
    into a real filesystem path with no other containment check) a
    malicious or LLM-mangled entry reads an arbitrary file outside
    sources/ (Path(dir) / value silently ignores `dir` when `value` is
    an absolute path).

    `page_dest` is NOT required here (§20.3.1) — it resolves later, once
    resolve_article_fields() has had a chance to read the article's own
    meta block or derive it from `page_source`. An EXPLICIT `page_dest`
    already in series.json still gets the same safety/extension check
    right here, since that doesn't depend on reading anything else;
    uniqueness of the final, resolved `page_dest` across every entry is
    checked at the end of resolve_article_fields() instead, once every
    entry actually has one.

    page_title/card_title/card_desc/card_label/nav_title/nav_desc are NOT
    checked here either — per §20.3.1 they're optional overrides of the
    same field in the article's own meta block, and validating them
    requires reading that meta block first, which this function
    (series.json-only) can't do; see resolve_article_fields()."""
    for i, entry in enumerate(articles, 1):
        # An entry must be a JSON object; a bare string/number/list here
        # would crash at the first entry.get() or field access with a raw
        # traceback instead of the clean error §20.3 promises for a
        # semi-trusted series.json.
        if not isinstance(entry, dict):
            log('error', f'series.json: entry {i} must be an object '
                  f'(got {type(entry).__name__}).')
            sys.exit(1)
        # Every known field below is text: a wrong (truthy non-string)
        # type — a number, list or object — used to sail past this
        # validation and detonate downstream at a re.sub / Path() / join
        # sink as a traceback. Reject it here with a clean message.
        for field in _SERIES_STRING_FIELDS:
            if field in entry and entry[field] is not None and not isinstance(entry[field], str):
                log('error', f'series.json: entry {i} field "{field}" must be '
                      f'a string (got {type(entry[field]).__name__}).')
                sys.exit(1)
        for legacy, renamed in _LEGACY_SERIES_FIELDS.items():
            if legacy in entry:
                log('error', f'series.json: entry {i} uses "{legacy}", '
                      f'renamed to "{renamed}" in v0.7.0 — just rename the '
                      f'key, the value is unchanged.')
                sys.exit(1)
        if not entry.get('page_source'):
            log('error', f'series.json: entry {i} is missing required '
                  f'field "page_source".')
            sys.exit(1)
        if not _is_safe_relative_filename(entry['page_source']):
            log('error', f'series.json: entry {i} has an unsafe '
                  f'"page_source" value "{entry["page_source"]}" (must be a '
                  f'plain filename, no path separators, no "..").')
            sys.exit(1)
        if not entry['page_source'].lower().endswith('.md'):
            log('error', f'series.json: entry {i} has a "page_source" value '
                  f'"{entry["page_source"]}" that does not end in .md.')
            sys.exit(1)
        if entry.get('page_dest') is not None:
            if not _is_safe_relative_filename(entry['page_dest']):
                log('error', f'series.json: entry {i} has an unsafe '
                      f'"page_dest" value "{entry["page_dest"]}" (must be a '
                      f'plain filename, no path separators, no "..").')
                sys.exit(1)
            if not entry['page_dest'].lower().endswith(('.html', '.htm')):
                log('error', f'series.json: entry {i} has a "page_dest" value '
                      f'"{entry["page_dest"]}" that does not end in .html or .htm.')
                sys.exit(1)


_DISPLAY_OVERRIDE_FIELDS = ('page_title', 'card_title', 'card_desc', 'card_label', 'nav_title', 'nav_desc')

# Every series.json entry field that must be a string when present.
# `status` is among them, unlike the boolean it replaced: three named words
# have a wrong value to reject, where a boolean coerced with str().lower()
# tolerated any type at all because everything that was not "true" simply
# was not a draft (§20.6).
_SERIES_STRING_FIELDS = (
    'page_source', 'page_dest', 'page_title', 'page_desc',
    'card_title', 'card_desc', 'card_label', 'nav_title', 'nav_desc',
    'author', 'license', 'date', 'comment', 'status',
)

# What an article is worth to the series it is listed in (§20.6). Three
# degrees of participation, and the middle one is the only one that used to
# exist:
#
#   active   built, carded, navigated, counted — the default, and what an
#            entry that says nothing means
#   draft    counted, but built only under --include-drafts, and then with
#            a banner so a preview is never mistaken for a publication
#   ignored  out of the chain entirely: never built whatever the flags,
#            never carded, never navigated, and not counted anywhere
#
# `ignored` is what makes the field worth having. Taking an article out of
# a series used to mean deleting its entry, which threw away every field
# that entry carried; now it is one word, and the configuration survives.
ARTICLE_STATUSES = ('active', 'draft', 'ignored')
DEFAULT_ARTICLE_STATUS = 'active'


def _find_cover_slide(slides):
    """First cover slide, if any — the natural, already-authored source
    for a couple of the fallbacks below (its own slide_title/summary),
    since a well-formed article almost always has one even if it never
    sets any of the more specific display fields."""
    return next((s for s in slides
                 if s.slide_type == 'cover'
                 and 'excluded' not in _slide_tag_set(s)), None)


# Where a resolved value came from, as `series-info` reports it (§11.11).
# A closed vocabulary, shared with `theme-info`'s own answer to the same
# question, so a consumer that shows provenance writes ONE piece of code:
#
#   series   the series-level file decided it — the article's entry in
#            series.json
#   article  the article's own meta block decided it
#   content  derived from the article's own content — the cover slide's
#            heading, or its summary
#   derived  computed from another resolved field — page_dest from
#            page_source with the extension swapped, card_title from
#            page_title, nav_desc from card_desc
#   default  the built-in fallback, including "resolves to empty" for a
#            field like card_label, which has nothing to extrapolate from
_FIELD_ORIGINS = ('series', 'article', 'content', 'derived', 'default')

# `author` and `license` reach one level the display fields do not have:
# `series_meta`, a series-wide default the author wrote for every article
# at once. It is neither this entry's series.json line (`series`) nor a
# built-in fallback (`default`), so it needed a word of its own before
# `resolve` (§11.12) could report those fields at all — the decision
# §11.11 said had to come before the keys. `series-info` still does not
# report them, and its vocabulary is still the five above.
_SERIES_DEFAULT_ORIGIN = 'series-default'

# The resolved fields whose provenance `series-info` reports, in cascade
# order. `status` is recorded too but kept out of this tuple: `series-info`
# reports it in its own key, beside the fields rather than among them
# (§11.11). The editorial three are out for the reason just given —
# `resolve` reaches them by name, one at a time.
_RESOLVED_FIELDS = ('page_dest', 'page_title', 'page_desc', 'card_title',
                    'card_desc', 'card_label', 'nav_title', 'nav_desc')
_EDITORIAL_FIELDS = ('author', 'license', 'date')


def _read_article_source(path):
    """The article's own text, or None when this pass cannot have it: the
    file is absent, unreadable, or not valid UTF-8.

    None is not a verdict. A `page_source` that does not exist is a fatal
    `build`/`check` error (§20.3), checked a few lines after this runs;
    undecodable bytes die with read_text_file's clean message when the
    article is actually read for building. Here the only consequence is
    that every field falls through to a filesystem-independent level
    instead of the same fault being reported twice — or once, too early,
    for a command that reads without building (§11.11)."""
    try:
        return Path(path).read_text(encoding='utf-8-sig')
    except (OSError, ValueError):   # missing, unreadable, or not UTF-8
        return None


def resolve_article_fields(articles, sources_dir, series_meta=None, strict_tags=True):
    """Resolves `page_dest` and the display/editorial fields for every
    entry, per §20.3.1. Mutates each entry in place so downstream
    renderers (build_article, build_series_nav, build_index,
    build_readme) can read the fields directly, with every
    override/fallback already applied — none of them need to know this
    mechanism exists.

    Returns, per entry and in the same order, what the resolution knew
    while it ran and the mutated entry cannot say afterwards: which level
    of the cascade each value came from, and whether the article's own
    file could be read at all. `build` and `check` ignore it; it is what
    `series-info` (§11.11) reports, and it is returned from HERE rather
    than recomputed by that command precisely so there is one cascade in
    this program and not two that drift.

    Must run once, after validate_series and before any of those
    renderers — build_series_nav in particular renders every OTHER
    article's nav_title/nav_desc on the page being built, not just the
    current one, so every entry needs to be resolved up front, not
    lazily.

    Resolution order, per field, most specific wins:

      page_dest   : series.json > article meta (`page_dest:`) > derived
                    from `page_source` (.md -> .html)
      page_title  : series.json > article meta > the cover slide's own
                    slide_title > the resolved `page_dest`
      page_desc   : series.json > article meta > the cover slide's summary
                    > '' (the <meta name="description"> tag is omitted)
      card_title  : series.json > article meta > page_title (resolved)
      card_desc   : series.json > article meta > the cover slide's summary
      card_label  : series.json > article meta > '' (nothing sensible to
                    extrapolate a short label from)
      nav_title   : series.json > article meta > card_title (resolved)
      nav_desc    : series.json > article meta > card_desc (resolved)
      author      : series.json > article meta > series_meta (series-wide
                    default) > '' (nothing shown)
      license     : series.json > article meta > series_meta > ''
      date        : series.json > article meta > '' (per-article only —
                    no series-wide default, and never derived from file
                    mtime: that would break byte-for-byte reproducibility)
      status      : series.json > article meta > 'active' (§20.6). One of
                    active | draft | ignored; anything else is a fatal
                    error naming the article.

    card_desc deliberately does NOT fall back through page_desc (and vice
    versa): page_desc is invisible metadata (SEO/share preview),
    card_desc is visible UI — an SEO-tuned page_desc must never leak
    onto the index cards. The titles chain (page > card > nav); the
    descriptions are parallel branches off the same cover summary. That
    asymmetry is intentional (§20.3.1).

    A page_source file that can't be read — absent, unreadable, or not
    UTF-8 — can't be read for its meta block or slides either; every
    field then falls through to its filesystem-independent default
    (derived `page_dest`, or '') instead of the same fault being reported
    twice. Absence is fatal to build/check a few lines later, in
    load_build_context; undecodable bytes die with read_text_file's clean
    message when the article is read for building."""
    series_meta = series_meta or {}
    resolution = []
    for entry in articles:
        source_path = _resolve_contained(sources_dir, entry['page_source'])
        text = (_read_article_source(source_path)
                if source_path is not None else None)
        meta, slides = {}, []
        if text is not None:
            meta, slides, _, _ = parse_markdown_extended(text)
        entry['_lwp_article_tags'] = normalize_article_tags(
            meta.get('tags', ''), entry['page_source'], strict=strict_tags)
        entry['_lwp_slide_tags'], entry['_lwp_tag_slides'] = (
            _collect_article_slide_details(
                slides, entry['page_source'], strict=strict_tags))
        entry['_lwp_default_tag'] = series_meta.get('default_tag', 'default')
        cover = _find_cover_slide(slides)
        cover_summary = cover.summary if cover and cover.summary else ''
        origins = {}
        candidates = {}

        def take(field, content=None, derived=None, series_default=None):
            """One field's cascade, and the level the retained value came
            from. The order is §20.3.1's, and it is written once here
            rather than once per field so a level cannot be recorded as
            one thing and resolved as another.

            `None` means the level does not exist for this field, `''`
            means it exists and is empty — a distinction the resolution
            itself does not need (both fall through) but the report does:
            `card_label` has no content level at all, while `page_desc`
            has one that a coverless article leaves empty, and showing
            them alike would invent a level.

            Every level is recorded, not just the winner: `resolve`
            (§11.12) reports the losing ones too, because a value alone
            does not explain why the line an author just wrote changed
            nothing. Recorded HERE, from the same list the loop walks, so
            a level cannot be offered as a candidate and skipped as a
            resolver."""
            tried = [('series', entry.get(field) or ''),
                     ('article', meta.get(field) or '')]
            for level, value in ((_SERIES_DEFAULT_ORIGIN, series_default),
                                 ('content', content), ('derived', derived)):
                if value is not None:
                    tried.append((level, value))
            candidates[field] = tried
            for level, value in tried:
                if value:
                    origins[field] = level
                    return value
            origins[field] = 'default'
            return ''

        entry['page_dest'] = take('page_dest', derived=re.sub(
            r'\.md$', '.html', entry['page_source'], flags=re.IGNORECASE))
        if origins['page_dest'] != 'series':
            # An explicit page_dest in series.json was already checked by
            # validate_series; one that arrives here came from the meta
            # block or from page_source, and gets the same check now.
            if not _is_safe_relative_filename(entry['page_dest']) or not entry['page_dest'].lower().endswith(('.html', '.htm')):
                log('error', f'{entry["page_source"]}: resolved "page_dest" value '
                      f'"{entry["page_dest"]}" is not a safe .html/.htm filename '
                      f'(from the article\'s own meta block).')
                sys.exit(1)

        entry['page_title'] = take('page_title',
                                   content=(cover.h1 if cover and cover.h1 else ''),
                                   derived=entry['page_dest'])
        entry['page_desc'] = take('page_desc', content=cover_summary)

        entry['card_title'] = take('card_title', derived=entry['page_title'])
        entry['card_desc'] = take('card_desc', content=cover_summary)
        entry['card_label'] = take('card_label')

        entry['nav_title'] = take('nav_title', derived=entry['card_title'])
        entry['nav_desc'] = take('nav_desc', derived=entry['card_desc'])

        # The editorial three take the same path as the rest, with one
        # level the display fields do not have: `series-default`, the
        # series-wide value in `series_meta`. `series-info` does not
        # report them (§11.11); `resolve` does, which is what made the
        # sixth word of the provenance vocabulary necessary — a value
        # written by the author for the whole series is neither this
        # article's series.json line nor a built-in fallback.
        entry['author'] = take('author',
                               series_default=series_meta.get('author', ''))
        entry['license'] = take('license',
                                series_default=series_meta.get('license', ''))
        entry['date'] = take('date')

        # `status` goes through `take` like every other field, and that is
        # the point of it being three named words rather than a boolean:
        # none of them is falsy, so nothing has to distinguish "written
        # false" from "not written". The predecessor field needed its own
        # presence-based branch for exactly that reason.
        # Lowercased like every other closed vocabulary here (the notes
        # settings do the same): the value is a word the format fixes,
        # not text the author composed, so its capitalisation carries
        # nothing worth failing over.
        entry['status'] = (take('status') or DEFAULT_ARTICLE_STATUS).strip().lower()
        if entry['status'] not in ARTICLE_STATUSES:
            # The same bar every other typed value here is held to: a wrong
            # value is named, not silently treated as the default — which
            # would leave an author reading a series that ignores what they
            # asked for, with nothing to say why.
            log('error', f'{entry["page_source"]}: status: '
                  f'{entry["status"]!r} is not a valid value '
                  f'({" | ".join(ARTICLE_STATUSES)}).')
            sys.exit(1)

        resolution.append({'source_read': text is not None, 'origins': origins,
                           'candidates': candidates})

    seen = {}
    for i, entry in enumerate(articles, 1):
        # Keyed case-insensitively: 'A.html' and 'a.html' are distinct
        # names to a URL but the same file on a Windows or default-macOS
        # filesystem — one would silently overwrite the other at build
        # time there, so the collision is fatal everywhere rather than a
        # platform-dependent data loss.
        f = entry['page_dest'].lower()
        if f in seen:
            log('error', f'series.json: duplicate page_dest "{entry["page_dest"]}" '
                  f'(articles {seen[f]} and {i} — compared case-insensitively: '
                  f'they would be the same file on Windows/macOS).')
            sys.exit(1)
        seen[f] = i

    return resolution


# ============================================================================
# NAV/INDEX FINGERPRINT CACHE (for `build --only`, see specifications.md §11.3.1)
# ============================================================================
#
# build_index() and build_series_nav() both render _DISPLAY_OVERRIDE_FIELDS
# for every article, not just the one being built — build_series_nav's
# output is inlined into every OTHER article's own page too, so changing
# one article's title can make every already-built page stale, not just
# index.html. `--only <file>` skips the expensive step (re-converting
# every other article's full Markdown body) but only when none of that
# shared, cross-page data has actually changed since the last build.

def _entry_fingerprint(entry):
    """A single hash of the fields that affect index.html/series-nav for
    this entry — content itself isn't kept, so the cache file stays small
    regardless of how long a summary is. Runtime tag metadata is included
    because it is embedded in both card types."""
    parts = [entry.get(field, '') for field in _DISPLAY_OVERRIDE_FIELDS]
    parts.extend([
        ' '.join(entry.get('_lwp_article_tags', ())),
        ' '.join(entry.get('_lwp_slide_tags', ())),
        json.dumps(entry.get('_lwp_tag_slides', ()), ensure_ascii=False,
                   sort_keys=True),
        entry.get('_lwp_default_tag', 'default'),
    ])
    return hashlib.sha256('\x00'.join(parts).encode('utf-8')).hexdigest()


def compute_nav_fingerprint(articles):
    """One fingerprint per article, keyed by `file` — comparing the full
    dict (not just the entry for the one being built) also catches an
    article added/removed, or a DIFFERENT article's meta/series.json entry
    having changed since the last build, not only the one named by
    --only."""
    return {entry['page_dest']: _entry_fingerprint(entry) for entry in articles}


def default_nav_cache_path(series_dir):
    return Path(series_dir) / '.lwp-cache' / 'nav.json'


def load_nav_cache(path):
    """None means "no usable cache" (missing, unreadable, or corrupt) —
    the caller's job is to treat that as "not safe to skip anything",
    never to guess."""
    try:
        return json.loads(Path(path).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return None


def save_nav_cache(path, fingerprint):
    path = Path(path)
    _mkdir(path.parent, parents=True, exist_ok=True)
    _write_file(path, json.dumps(fingerprint, indent=2, sort_keys=True))


def _reject_symlink_components(path, label):
    """Refuses output paths that cross an existing symlink.

    The output directory may be chosen outside the series, but a repository
    must not be able to turn the default ``public/`` path into an arbitrary
    write target through a committed symlink.
    """
    candidate = Path(path)
    absolute = candidate if candidate.is_absolute() else Path.cwd() / candidate
    current = Path(absolute.anchor)
    for part in absolute.parts:
        if part == absolute.anchor:
            continue
        current /= part
        try:
            escaped = current.is_symlink()
        except OSError as exc:
            log('error', f'{label} cannot be inspected at {current}: {exc}')
            sys.exit(1)
        if escaped:
            log('error', f'{label} crosses symlink {current}; refusing to write.')
            sys.exit(1)


def resolve_paths(series_dir, args):
    """Resolves paths from environment variables and arguments."""
    sd = Path(series_dir).resolve()

    sources_dir = Path(os.environ.get('LWP_SOURCES_DIR', sd / 'sources'))
    templates_dir = Path(os.environ.get('LWP_TEMPLATES_DIR', sd / 'templates'))
    lang_dir = Path(os.environ.get('LWP_LANGUAGE_DIR', sd / 'language'))
    output_dir = Path(args.get('--output', os.environ.get('LWP_OUTPUT_DIR', sd / 'public')))
    lang = args.get('--lang', os.environ.get('LWP_LANG', 'fr'))
    if not _VALID_LANG_RE.fullmatch(str(lang)):
        log('error', f'--lang/LWP_LANG: invalid language value {str(lang)!r} '
              f'(letters, digits, "-" and "_" only).')
        sys.exit(1)
    language_file = args.get('--language-file')
    _reject_symlink_components(output_dir, 'output directory')

    return sd, sources_dir, templates_dir, lang_dir, output_dir, lang, language_file


# Matches build_stamp_html()'s own output exactly (a single, entirely
# self-generated element) — used by cmd_check to ignore the marker when
# comparing against disk, see its own comment for why that's necessary.
# [^>]* rather than a literal attribute string: the div carries its own
# inline style (see build_stamp_html), so matching only on the class
# hook keeps this working regardless of attribute order. Deliberately
# does NOT also swallow a surrounding newline: the div sits on its own
# template line (`{{build_stamp}}` alone between two literal newlines),
# so removing just the div reproduces exactly what an unstamped build
# already produces at that spot (an empty line, not a missing one) —
# chewing an extra \n here would under-count against that baseline and
# cause every check to report a spurious drift.
_BUILD_STAMP_RE = re.compile(r'<div[^>]*class="build-stamp"[^>]*>.*?</div>')


def build_stamp_html(version, minimal=False):
    """--build-stamp / --build-stamp-minimal (§11.3.2): a discreet, opt-in
    "did I actually just rebuild this" marker in the page's own header —
    the real-world need it addresses is a stale browser tab or an old
    deploy that LOOKS current at a glance. Never on by default: it makes
    every build non-reproducible byte-for-byte (a fresh timestamp every
    run), which most workflows (including `check`, see cmd_check)
    explicitly don't want.

    `minimal` drops the timestamp (and version): a build date/time is
    data that may or may not be sensitive to publish (it can reveal when
    a document was prepared), so a series that wants the freshness marker
    without that disclosure gets a fixed "Compiled with lightwebpres."
    instead — no version either, kept symmetric with dropping the date
    rather than a partial disclosure.

    position: absolute, not fixed: this belongs in the page's own header
    (specifically requested — visible only while scrolled to the top,
    same as any other header content, never pinned over the rest of the
    page while reading). With no positioned ancestor, absolute resolves
    against the initial containing block — anchored to the top of the
    document, so it scrolls away exactly like ordinary content, not the
    viewport-pinned behavior `fixed` would give.

    Styled entirely inline, not via a `.build-stamp` rule in style.css:
    a series with its own templates/style.css (customized, or simply
    scaffolded before this option existed) has no way to pick up a new
    built-in rule short of refresh-templates (§9.4) — the marker would
    render as a plain, undiscreet block-flow line (full width, default
    dark text, pushing the first slide down) instead of the intended
    small corner overlay. Inline style has no such dependency.

    `color: inherit` and no opacity, which is what makes it READABLE. It
    used to paint a literal `#6B6B7D` at 0.75 opacity — a grey chosen
    against no particular ground. Measured against the built-in
    themes, that pair cleared 4.5:1 on none of them and 3:1 on five,
    bottoming out at 1.27:1 on pop-red; it was reported, accurately, as
    invisible. Inheriting the body's ink instead gives the stamp exactly
    the contrast the theme is already audited for (7.06:1 at worst,
    catppuccin), and it does so for a theme the tool has never seen,
    which no fixed grey and no fixed opacity can: the minimum opacity
    clearing 4.5:1 across the built-ins is 0.818, and a custom palette
    sitting at the 4.5:1 floor is put under it by any fade at all.
    Discretion is the 11px and the corner, not a colour nobody can
    read."""
    if minimal:
        text = 'Compiled with lightwebpres.'
    else:
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        text = f'Compiled at {now} with lightwebpres v{version}.'
    style = (
        # `inherit`, not the quiet ink and not a literal: the staleness risk
        # that rules out a `.build-stamp` rule rules out `var(--...)` too --
        # a series' own style.css may predate any property named here --
        # and inheritance is the one channel that has always worked, since
        # every style.css this tool ever wrote sets a colour on `body`.
        'position:absolute;top:16px;left:20px;font-size:11px;color:inherit;'
        'letter-spacing:0.3px;z-index:50;pointer-events:none;'
        "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;"
    )
    return f'<div class="build-stamp" style="{style}">{text}</div>'


def strip_build_stamp(html):
    return _BUILD_STAMP_RE.sub('', html)


def load_lang_tag_engines(series_meta, lang_dir, default_lang,
                          default_engine):
    """Loads the optional per-slide typography packs from `lang_tags`.

    The build's `--lang` pack remains the fallback. A mapping value is the
    language-pack name (`fr`, `en`, or a JSON file in `language/`); mapping a
    tag to the fallback pack reuses the already loaded engine, including a
    custom `--language-file` override.
    """
    mapping = series_meta.get('lang_tags', {}) if series_meta else {}
    engines = {}
    for tag, pack in mapping.items():
        if default_engine is None:
            engines[tag] = None
        elif pack.casefold() == str(default_lang).casefold():
            engines[tag] = default_engine
        else:
            engines[tag] = TypoEngine(load_language(lang_dir, pack))
    return engines


def load_build_context(series_dir, args, include_ignored=False, strict_tags=True,
                       warn_tag_coverage=True):
    """Shared setup for build and check (§11.3/§11.4): resolves paths,
    loads the language pack/typo engine, the CSS/nav.js (built-in or
    overridden, §9.1/§9.2), and series.json (validated, display fields
    resolved). The two commands used to duplicate this ~20-line block,
    which meant a new build-time option (--no-typography) had to be
    added to both by hand — centralizing it here means the next one
    only needs to land once.

    --no-typography (§4.5/§19.6) skips the engine entirely: every
    typo_engine use already goes through apply_typo(), so None here
    means no rule anywhere ever touches the text — the strongest
    guarantee that a source's existing spacing (including any
    non-breaking space already in it) reaches the output completely
    unchanged, not just that the new rules stay quiet."""
    sd, sources_dir, templates_dir, lang_dir, output_dir, lang, language_file = resolve_paths(series_dir, args)

    language_pack = load_language(lang_dir, lang, language_file)
    typo_engine = None if args.get('--no-typography') else TypoEngine(language_pack)
    strings = language_pack.get('strings', {})
    explicit_lang = (args.get('--lang') is not None
                     or os.environ.get('LWP_LANG') is not None)
    language_runtime = _language_runtime_markup(
        lang_dir, lang, language_pack, language_file,
        auto=not explicit_lang)

    try:
        style_context = series_style_context(templates_dir)
        css = compose_with(style_context)
    except PropertyError as exc:
        log('error', f'templates/{SETTINGS_FILENAME}: {exc}')
        sys.exit(1)
    series_data = load_series_data(sd)
    series_meta = series_meta_of(series_data)
    try:
        settings_file = _resolve_contained(templates_dir, SETTINGS_FILENAME)
        effective_theme = None
        if settings_file is not None and settings_file.exists():
            effective_theme, _ = parse_settings_text(
                read_text_file(settings_file))
        series_json_themes = series_themes_of(series_data)
        runtime_option = args.get('--themes')
        runtime_source = '--themes'
        if runtime_option is None:
            runtime_option = series_json_themes
            runtime_source = 'series.json: "themes"'
        # Every build ships the essential bundle by default so the reader
        # always has a high-contrast, dark-ground and print-friendly
        # alternative (§9.3.7). `--no-essential-theme` opts out; an explicit
        # `--themes` or `series.json["themes"]` still adds to the set.
        if not args.get('--no-essential-theme'):
            if runtime_option is None:
                runtime_option = ['essential']
                runtime_source = '--themes'
            elif isinstance(runtime_option, list):
                runtime_option = ['essential'] + runtime_option
            else:
                runtime_option = 'essential,' + runtime_option
        theme_runtime = build_theme_runtime(
            runtime_option, effective_theme, runtime_source)
    except PropertyError as exc:
        log('error', str(exc))
        sys.exit(1)
    nav_js_file = _resolve_contained(templates_dir, 'nav.js')
    if nav_js_file is None and (templates_dir / 'nav.js').exists():
        log('error', 'templates/nav.js resolves outside templates/ '
            '(symlink); refusing to publish its contents.')
        sys.exit(1)
    if nav_js_file is not None and nav_js_file.exists():
        on_disk = read_text_file(nav_js_file)
        # nav.js is tool-owned (§9.4.3), and a copy of it on disk is a
        # copy that can fall behind. The build cannot tell "stale" from
        # "customised" -- it only knows "differs" -- so it uses the file
        # as it finds it and says so.
        #
        # At WARNING level, not info, and the difference is the whole
        # point: info is silenced by --quiet, which is what a pipeline
        # runs, so this said nothing where it most needed to. Three
        # behaviour fixes shipped in v0.39.0 -- the cursor, the
        # drag-select, the F key on the index -- reached no existing
        # series, and the only line that mentioned it was the one
        # nobody saw.
        if on_disk != TEMPLATE_NAV_JS:
            log('warn', 'templates/nav.js differs from this '
                'executable\'s built-in version, and the build is using '
                'yours — run `lightwebpres template update .` to go back '
                'to the built-in one (yours is kept as nav.js.bak; '
                'settings.conf and {custom_css} are never touched)'
                .format(custom_css=CUSTOM_CSS_FILENAME))
        nav_js = on_disk
    else:
        nav_js = TEMPLATE_NAV_JS

    # The same for the language packs, which said NOTHING at all. They
    # are the same shape as nav.js -- shipped by the tool, copied whole
    # into the series by `init`, used from disk if present -- and they
    # carry rules and interface strings, so a stale one silently keeps
    # an old typography and an old vocabulary. `typo_units: off` learning
    # to reach any pack (§19.2) is exactly the kind of repair that never
    # arrives while nobody is told.
    shipped_packs = {'fr.json': LANG_FR, 'en.json': LANG_EN}
    on_disk_packs = sorted(lang_dir.glob('*.json')) if lang_dir.is_dir() else []
    for pack in on_disk_packs:
        pack_name = pack.name
        builtin = shipped_packs.get(pack_name)
        if builtin is None:
            continue      # a pack the tool does not ship is the author's
        if read_text_file(pack) != builtin:
            # Naming the commands, because the previous wording told the
            # reader WHAT to do ("copy the built-in one over it") and not
            # WITH WHAT, at a moment when three commands could do it. The
            # deletion comes first: it is the state this tool now wants a
            # series to be in, and it is what the one person who hit this
            # worked out for himself, by hand, from a message that did not
            # say it.
            log('warn', f'language/{pack_name} differs from this '
                f'executable\'s built-in pack, and the build is using '
                f'yours. If you did not change it on purpose, delete it — '
                f'the built-in pack is used when the file is absent, and '
                f'`lightwebpres template update .` removes it for you when '
                f'the two are identical. To compare first: `lightwebpres '
                f'template show {pack_name}`. To take the built-in one: '
                f'`lightwebpres template write {pack_name} . --force`.')
    nav_js = apply_strings(nav_js, strings)

    lang_tag_engines = load_lang_tag_engines(
        series_meta, lang_dir, lang, typo_engine)
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data
    validate_series(articles)
    resolve_article_fields(articles, sources_dir, series_meta,
                           strict_tags=strict_tags)

    # Two filters, and they are not the same rule (§20.6).
    #
    # `ignored` leaves the chain outright — no page, no index card, no nav
    # entry, and not counted for anything, whatever the flags. There is no
    # option to build one: an article the author has taken out of the
    # series is out of it, and an escape hatch would make `ignored` a
    # second `draft` instead of the thing that has no effect at all.
    #
    # `draft` is excluded from the OUTPUT unless --include-drafts (authors,
    # GUI preview) but stays part of the series otherwise — which is why
    # the index tally below is taken between the two filters.
    #
    # Both filter the list series_data itself references (in place, not a
    # copy) so every downstream renderer stays consistent: they all
    # re-derive the list from series_data. It also means the nav
    # fingerprint is computed on the filtered list, so changing an
    # article's status changes the cache's key set and correctly forces a
    # full build over the --only fast path.
    ignored = [e['page_dest'] for e in articles if e['status'] == 'ignored']
    if include_ignored:
        # Audit renders these pages, but their siblings must still see the
        # normal series data: ignored entries stay out of index and nav.
        build_articles = [e for e in articles if e['status'] != 'ignored']
        if isinstance(series_data, dict):
            series_data = dict(series_data)
            series_data['articles'] = build_articles
        else:
            series_data = build_articles
    else:
        articles[:] = [e for e in articles if e['status'] != 'ignored']
        build_articles = articles
        for f in ignored:
            progress(f'  [ignored] {f} is not part of this series')

    # The list as the SERIES declares it — after `ignored`, before `draft`.
    # This is what the index-name rule counts (§11.3.3): a draft is still an
    # article of the series, so a two-article series where one is a draft
    # still has an index worth protecting, and the collision is decided the
    # same way whether or not --include-drafts is passed. An ignored article
    # is not an article of the series at all, so it does not count.
    claim_articles = list(build_articles)

    if not args.get('--include-drafts') and not args.get('--drafts-only'):
        skipped = [e['page_dest'] for e in build_articles
                   if e['status'] == 'draft']
        build_articles[:] = [e for e in build_articles
                             if e['status'] != 'draft']
        for f in skipped:
            progress(f'  [draft] {f} skipped (build with --include-drafts to preview it)')

    # The selected default must exist in the output this invocation is about
    # to write. Ignored articles and omitted drafts cannot satisfy it.
    validate_series_default_tag(series_data)
    if warn_tag_coverage:
        warn_tag_visibility(series_data)

    # Every listed page_source must exist, checked up front and fatal
    # (§20.3): building around a missing source used to leave the entry's
    # index card, series-nav entries and README line pointing at a page
    # that was never built — dead links shipped with exit code 0. Failing
    # here, before anything is written, also means no partial output.
    # _resolve_contained, not a bare join: the name-shape check at parse time
    # rejects `..` and separators, but a plain name that IS a symlink out of
    # sources/ passes it and gets read and published. §22.9 already promises
    # this pairing for sources/; page_source was the one field without it.
    missing = []
    for entry in build_articles:
        source_path = _resolve_contained(sources_dir, entry['page_source'])
        if source_path is None:
            log('error', f'Source escapes sources/: {sources_dir / entry["page_source"]} '
                f'(listed in series.json).')
            sys.exit(1)
        if not source_path.exists():
            missing.append(entry['page_source'])
    if missing:
        for name in missing:
            log('error', f'Source not found: {sources_dir / name} '
                  f'(listed in series.json).')
        sys.exit(1)

    return SimpleNamespace(
        sd=sd, sources_dir=sources_dir, templates_dir=templates_dir,
        lang_dir=lang_dir, output_dir=output_dir, lang=lang,
        language_file=language_file, typo_engine=typo_engine,
        strings=strings, css=css, nav_js=nav_js, series_data=series_data,
        articles=articles, claim_articles=claim_articles,
        style_context=style_context, args=args,
        lang_tag_engines=lang_tag_engines, theme_runtime=theme_runtime,
        language_runtime=language_runtime,
    )


def resolve_index_claim(claim_articles, built_articles=None):
    """§11.3.3 — the article, if any, whose resolved page_dest is the very
    name `build` writes the series index to. Returns that entry, or None.

    The name is what the collision is: the article page was written
    first, the index landed on top of it, exit code 0, no warning — a
    series declaring three articles shipped two. Same class of defect as
    §22.8 (a page published broken while the build reports success),
    applied to a name clash.

    What to do about it depends on the number of articles, and that is
    not a concession — it is what the index is worth in each case. With
    more than one article the index carries real information (the list),
    so overwriting it is a loss: fatal, here, before anything is written.
    With exactly one, the index would list a single entry and adds
    nothing; the caller lets the article take the name and skips the
    index (announced in the build output, never in silence).

    A one-article series is a brick as much as a site: it may land in a
    directory whose index is kept some other way — by hand, by another
    generator, or because other articles already live there — and the
    author then leaves the default name and claims nothing. Or it is
    alone, and index.html is the name that means something. The name
    chosen IS the statement of intent, and the tool has no business
    guessing otherwise.

    Compared case-insensitively, for the same reason the duplicate
    page_dest check is (see resolve_article_fields): 'Index.html' and
    'index.html' are two names to a URL but one file on Windows and
    default macOS, so the clash is decided identically everywhere rather
    than being silent data loss on some filesystems only.

    Shared by build and check: refusing in one and diffing against an
    arrangement the other will not build would leave check reporting a
    drift that no rebuild can ever settle.

    TWO lists, because the count and the outcome are different questions
    (§20.6). `claim_articles` is the series as it declares itself —
    `ignored` entries removed, drafts still in it — and it is what decides
    whether the index is worth protecting: a draft is an article of the
    series, so the collision is fatal or not regardless of
    --include-drafts, which is what keeps a build and a build --include-drafts
    from disagreeing about whether a series.json is legal at all.
    `built_articles` is what will actually be written; a claimant that is a
    draft left out of this build claims nothing today, and the index gets
    generated as usual."""
    if built_articles is None:
        built_articles = claim_articles
    claimant = next((e for e in claim_articles
                     if e['page_dest'].lower() == 'index.html'), None)
    if claimant is not None and len(claim_articles) > 1:
        log('error', f'series.json: article "{claimant["page_source"]}" resolves '
              f'to page_dest "{claimant["page_dest"]}", which collides with the '
              f'series index — with {len(claim_articles)} articles the index carries '
              f'the article list, so one of the two pages would overwrite the '
              f'other. Give this article another page_dest (in series.json, in '
              f'its own meta block, or by renaming the source); only a '
              f'one-article series may take the index name.')
        sys.exit(1)
    return claimant if claimant in built_articles else None


def _no_index_notice(claimant):
    """The one-article branch of §11.3.3, said out loud. Someone whose
    index stopped being generated has to be able to see why from the
    build output alone, without going to the specification."""
    return (f'  [no index] {claimant["page_dest"]} is {claimant["page_source"]}\'s '
            f'own page — a series index would list that one article and nothing '
            f'else, so none is generated.')


def _resolve_only_entry(ctx, only_file):
    """Resolves `--only` after the same status filters as the build loop.

    `load_build_context` removes ordinary drafts unless they were explicitly
    included, while `--drafts-only` is applied by the full-build loop. Keeping
    the selection here makes the cached path obey both forms instead of
    quietly rebuilding a published article from a draft-only request.
    """
    if ctx.args.get('--drafts-only'):
        eligible = [e for e in ctx.articles if e.get('status') == 'draft']
    else:
        eligible = ctx.articles
    entry = next((e for e in eligible
                  if only_file in (e['page_dest'], e['page_source'])), None)
    if entry is None:
        log('error', f'--only {only_file!r} matches no article (by file or source).')
        sys.exit(1)
    return entry


def _cmd_build_only(ctx, only_file, nav_cache_path, fresh_fingerprint, build_stamp=''):
    """The fast path for `build --only`: the caller has already confirmed
    nav/index-affecting metadata is unchanged since the last build, so
    only the named article's own page needs re-converting — index.html,
    README.md, and images are cheap regardless of series size, so they're
    always redone rather than also trying to skip them."""
    entry = _resolve_only_entry(ctx, only_file)

    source_path = _resolve_contained(ctx.sources_dir, entry['page_source'])
    if source_path is None:
        log('error', f'Source escapes sources/: {ctx.sources_dir / entry["page_source"]} '
            f'(listed in series.json).')
        sys.exit(1)
    if not source_path.exists():
        log('error', f'Source not found: {ctx.sources_dir / entry["page_source"]}')
        sys.exit(1)

    progress(f'Incremental build: {ctx.sd} (nav/index unaffected since the last build)')
    _mkdir(ctx.output_dir, parents=True, exist_ok=True)

    progress(f'  {entry["page_dest"]} ← {entry["page_source"]}')
    html = build_article(source_path, ctx.sources_dir, ctx.series_data, entry['page_dest'], ctx.css, ctx.nav_js, ctx.typo_engine, ctx.strings, ctx.lang, build_stamp, style_context=ctx.style_context, include_nav=not ctx.args.get('--no-nav'), inline_images=ctx.args.get('--inline-images', False), args=ctx.args, lang_tag_engines=ctx.lang_tag_engines, theme_runtime=ctx.theme_runtime, language_runtime=ctx.language_runtime)
    _write_file(ctx.output_dir / entry['page_dest'], html)

    # Same §11.3.3 branch as the full build — the fast path writes the
    # index too, so leaving it out here would drop the index straight
    # back onto the article page it just wrote.
    claimant = resolve_index_claim(ctx.claim_articles, ctx.articles)
    if claimant is None and not ctx.args.get('--no-index'):
        index_extra_file = ctx.templates_dir / 'index_extra.html'
        index_extra = read_text_file(index_extra_file) if index_extra_file.exists() else ''
        progress('  index.html')
        index_html = build_index(ctx.series_data, ctx.css, ctx.typo_engine, ctx.strings, ctx.lang, index_extra, build_stamp, theme_runtime=ctx.theme_runtime, style_context=ctx.style_context, language_runtime=ctx.language_runtime)
        ok, detail = validate_page_scripts(index_html)
        if not ok:
            log('error', 'Build aborted: index.html contains invalid JavaScript.\n%s'
                % (detail,))
            sys.exit(1)
        _write_file(ctx.output_dir / 'index.html', index_html)
    elif claimant is not None:
        progress(_no_index_notice(claimant))

    if not ctx.args.get('--no-readme'):
        readme = build_readme(ctx.series_data, ctx.sd, ctx.output_dir, ctx.strings)
        _write_file(ctx.sd / 'README.md', readme)

    # --inline-images: images are embedded as base64 data URIs, so the
    # img/ directory is not copied to the output.
    images = []
    if not ctx.args.get('--inline-images'):
        images = copy_images(ctx.sources_dir, ctx.output_dir)

    save_nav_cache(nav_cache_path, fresh_fingerprint)
    _write_manifest(ctx.output_dir, ctx.articles,
                    include_index=claimant is None and not ctx.args.get('--no-index'),
                    images=images)
    tail = ' + index' if claimant is None and not ctx.args.get('--no-index') else ''
    progress(f'Incremental build complete: {entry["page_dest"]}{tail} -> {ctx.output_dir}')

    # Keep the fast path's result-opening behavior identical to a full build.
    if ctx.args.get('--open'):
        import webbrowser
        index_url = (ctx.output_dir / 'index.html').resolve().as_uri()
        webbrowser.open(index_url)


def cmd_completion(args):
    """completion --shell bash|zsh — prints a shell completion script.

    The script completes subcommands (series, theme, template),
    root shortcuts (init, build, verify, ...), and options (--lang,
    --output, --theme, ...). Install with:

        eval "$(lightwebpres completion --shell bash)"

    or for zsh:

        eval "$(lightwebpres completion --shell zsh)"

    The script is self-contained: it reads the command list from the
    generated text, so it stays correct without a separate file."""
    shell = args.get('--shell', 'bash')
    if shell not in ('bash', 'zsh'):
        log('error', f"Unknown shell: {shell!r}. Valid values: bash, zsh")
        sys.exit(1)

    # Collect the command names from the tables (single source of truth).
    root_cmds = sorted(_SHORTCUTS)
    series_verbs = sorted(_SERIES_VERBS)
    theme_verbs = sorted(_THEME_VERBS)
    template_verbs = sorted(_TEMPLATE_VERBS)
    # Before a command has been named, the ONLY options the tool reads are
    # the globals: `lightwebpres --polarity dark verify` does not reach
    # parse_cli_options at all, it answers "Unknown command: --polarity".
    # Offering the union here was offering a word the tool cannot parse in
    # that position.
    root_opts = ' '.join(sorted(_GLOBAL_OPTIONS))

    # Derived from the tables and NOTHING else, which is what the GUIDE
    # and the spec both promise. Appending by hand offered `theme set`,
    # which the tool refuses by name ("the theme node is the catalogue and
    # never modifies a series"), and listed `theme` twice under `series`,
    # where _SERIES_VERBS already has it. A completion that offers a
    # refused command is worse than one that offers nothing: it is the
    # program telling you to type what the program will reject.
    root_list = ' '.join(root_cmds + ['series', 'theme', 'template'])
    series_list = ' '.join(series_verbs)
    theme_list = ' '.join(theme_verbs)
    template_list = ' '.join(template_verbs)
    # The closed set `template show`/`write` accept, offered where the
    # shell would otherwise offer every file in the directory.
    owned_list = ' '.join(sorted(tool_owned_files()))

    # What each command ACCEPTS, from the same table the parser refuses
    # against. Offering the union was the program telling you to type what
    # the program will reject: reported from a real shell, `build --` put
    # `--polarity`, `--hue`, `--family`, `--shell` and `--format` in front
    # of someone, and `build --polarity` then answered "not an option of
    # `build`".
    #
    # Keyed by what a user TYPES, not by the dispatch key: `series build`
    # and `build` are one command and two paths, and a table indexed by
    # the internal name could not say so.
    def offers(key):
        return ' '.join(sorted(_COMMAND_OPTIONS.get(key, set())
                               | _GLOBAL_MODIFIERS | {'--help'}))

    per_command = {}
    for token, key in _SHORTCUTS.items():
        per_command[token] = offers(key)
    for node, verbs in (('series', _SERIES_VERBS), ('theme', _THEME_VERBS),
                        ('template', _TEMPLATE_VERBS)):
        for verb, key in verbs.items():
            per_command[f'{node} {verb}'] = offers(key)
    # The one three-word path, mirroring the special case _resolve_command
    # makes for it: `series theme` reads the series' theme and `series theme
    # set` writes it, and they are two commands with two option sets. Keyed
    # on the reading command's path, the writing one was offered `--format`,
    # which it refuses, and never offered `--theme`, which is the whole
    # point of typing it.
    per_command['series theme set'] = offers('set-theme')
    # And the second one, for the same reason: `series slug` lists what the
    # cards are called and `series slug set` writes into the author's
    # files, and `--format` belongs to the reading command alone. The path
    # rewrite in the script below is what stops `--format` being offered
    # after `set`; this entry is what makes the answer come from the table
    # rather than from the default arm, which happens to hold the right
    # answer today only because `assign-slug` takes no option of its own.
    per_command['series slug set'] = offers('assign-slug')
    # A node with no verb yet. `series --quiet build` is not a command --
    # _resolve_command reads the second word as the verb and answers
    # "Unknown series verb: `series --quiet`" -- so the only option a bare
    # node takes is the one it answers: --help.
    for _node in ('series', 'theme', 'template'):
        per_command[_node] = '--help'
    # Longest path first, so `series build` is matched before `series`.
    cases = '\n'.join(
        f'            {path!r}) opts="{opts}" ;;'.replace("'", '"')
        for path, opts in sorted(per_command.items(),
                                 key=lambda kv: (-kv[0].count(' '), kv[0])))

    if shell == 'bash':
        hook = 'complete -F _lightwebpres_completion lightwebpres'
    else:
        # The function below is written in bash's completion dialect --
        # COMP_WORDS, COMP_CWORD, COMPREPLY, compgen -- none of which zsh
        # provides. `compdef` on such a function binds a widget that dies
        # on its first line. bashcompinit installs the shims that make the
        # dialect work, and it is the whole reason the zsh output was not
        # merely the bash output with a different last line.
        hook = (
            'autoload -U +X compinit && compinit\n'
            'autoload -U +X bashcompinit && bashcompinit\n'
            'compdef _lightwebpres_completion lightwebpres'
        )

    script = f'''# lightwebpres completion for {shell}
# Generated by `lightwebpres completion --shell {shell}`.
# Install: eval "$(lightwebpres completion --shell {shell})"
# Or add to ~/.bashrc / ~/.zshrc.

_lightwebpres_completion() {{
    local cur="${{COMP_WORDS[COMP_CWORD]}}"
    COMPREPLY=()

    # Root-level: commands OR global options (--help, --version, --lang, ...)
    if [ "$COMP_CWORD" -eq 1 ]; then
        if [[ "$cur" == --* ]]; then
            COMPREPLY=($(compgen -W "{root_opts}" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "{root_list}" -- "$cur"))
        fi
        return 0
    fi

    # series <verb>
    if [ "${{COMP_WORDS[1]}}" = "series" ] && [ "$COMP_CWORD" -eq 2 ] \
       && [[ "$cur" != --* ]]; then
        COMPREPLY=($(compgen -W "{series_list}" -- "$cur"))
        return 0
    fi

    # theme <verb>
    if [ "${{COMP_WORDS[1]}}" = "theme" ] && [ "$COMP_CWORD" -eq 2 ] \
       && [[ "$cur" != --* ]]; then
        COMPREPLY=($(compgen -W "{theme_list}" -- "$cur"))
        return 0
    fi

    # template <verb> (two-word)
    if [ "${{COMP_WORDS[1]}}" = "template" ] && [ "$COMP_CWORD" -eq 2 ] \
       && [[ "$cur" != --* ]]; then
        COMPREPLY=($(compgen -W "{template_list}" -- "$cur"))
        return 0
    fi

    # template show|write <file>: a closed set of three, not the filesystem
    if [ "${{COMP_WORDS[1]}}" = "template" ] && [ "$COMP_CWORD" -eq 3 ] \
       && [[ "$cur" != --* ]] \
       && {{ [ "${{COMP_WORDS[2]}}" = "show" ] || [ "${{COMP_WORDS[2]}}" = "write" ]; }}; then
        COMPREPLY=($(compgen -W "{owned_list}" -- "$cur"))
        return 0
    fi

    # The two three-word paths: `series theme set` and `series slug set`
    if [ "${{COMP_WORDS[1]}}" = "series" ] \
       && {{ [ "${{COMP_WORDS[2]}}" = "theme" ] || [ "${{COMP_WORDS[2]}}" = "slug" ]; }} \
       && [ "$COMP_CWORD" -eq 3 ] && [[ "$cur" != --* ]]; then
        COMPREPLY=($(compgen -W "set" -- "$cur"))
        return 0
    fi

    # Options (any position after the command) — the ones THIS command
    # takes, from the same table the parser refuses against.
    if [[ "$cur" == --* ]]; then
        local path="${{COMP_WORDS[1]}}"
        if [ "$COMP_CWORD" -gt 2 ]; then
            case "$path" in
                series|theme|template) path="${{COMP_WORDS[1]}} ${{COMP_WORDS[2]}}" ;;
            esac
        fi
        if {{ [ "$path" = "series theme" ] || [ "$path" = "series slug" ]; }} \
           && [ "${{COMP_WORDS[3]}}" = "set" ]; then
            path="$path set"
        fi
        local opts=""
        case "$path" in
{cases}
            *) opts="{root_opts}" ;;
        esac
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
        return 0
    fi

    # File/directory completion for positional args
    COMPREPLY=($(compgen -f -- "$cur"))
}}

{hook}
'''

    print(script)


_MANIFEST_NAME = '.lwp-manifest.json'


def _safe_manifest_path(output_dir, value):
    """Returns a manifest path only while it stays inside ``output_dir``.

    Manifests are generated state, not an authority to delete arbitrary
    filesystem paths. Reject absolute paths, traversal, and symlinked
    targets before ``clean --force`` can act on them.
    """
    if not isinstance(value, str) or not value:
        return None
    normalized = value.replace('\\', '/')
    if (normalized.startswith('/')
            or re.match(r'^[A-Za-z]:', normalized)):
        return None
    parts = PurePosixPath(normalized).parts
    if not parts or any(part in ('', '.', '..') for part in parts):
        return None
    candidate = Path(output_dir).joinpath(*parts)
    try:
        if candidate.is_symlink():
            return None
        root = Path(output_dir).resolve()
        resolved = candidate.resolve()
    except OSError:
        return None
    if resolved == root or root not in resolved.parents:
        return None
    return candidate


def _manifest_paths(manifest, key, output_dir, manifest_path):
    """Validates one manifest path list and returns it as a set."""
    values = manifest.get(key, [])
    if not isinstance(values, list):
        log('error', f'Invalid {manifest_path}: `{key}` must be a list.')
        sys.exit(1)
    for value in values:
        if _safe_manifest_path(output_dir, value) is None:
            log('error', f'Invalid {manifest_path}: unsafe path {value!r} '
                f'in `{key}`.')
            sys.exit(1)
    return set(values)


def _write_manifest(output_dir, articles_built, include_index=True,
                    images=()):
    """Writes .lwp-manifest.json in public/ listing every file the build
    produced, so `clean` can purge orphans without guessing.

    Carries the PREVIOUS build's list forward under `previous`, because
    that is what makes `clean` answerable. A manifest alone only says what
    exists now; the pair says what stopped existing, and only the second
    question has an answer that can be acted on without touching a file
    the tool never made."""
    files = [e['page_dest'] for e in articles_built]
    if include_index:
        files.append('index.html')
    # What copy_images says it published, from the SOURCE. This used to
    # walk output_dir/img instead, which answers "what is there" when the
    # question a manifest exists to answer is "what did this build make".
    # The two differ by exactly the file the author deleted.
    files.extend(images)
    previous = []
    existing = output_dir / _MANIFEST_NAME
    if existing.exists():
        try:
            prior = json.loads(read_text_file(existing))
            # The union: a file this build stopped producing must stay
            # accountable across several builds, or two rebuilds in a row
            # lose track of it and it is published forever.
            previous = sorted(set(prior.get('files', []))
                              | set(prior.get('previous', [])))
        except (ValueError, OSError):
            previous = []
    manifest = {'schema': 'lightwebpres.manifest/1', 'files': files,
                'previous': previous}
    _write_file(output_dir / _MANIFEST_NAME,
                json.dumps(manifest, indent=2, ensure_ascii=False))


def cmd_clean(series_dir, args):
    """clean command — purges public/ of files
    that are no longer produced by the build, using the manifest written by
    the last build. Dry-run by default: --force deletes for real."""
    sd = Path(series_dir).resolve() if series_dir else Path(
        os.environ.get('LWP_SERIES_DIR', '.')).resolve()
    output_path = Path(args.get('--output') or os.environ.get(
        'LWP_OUTPUT_DIR', str(sd / 'public')))
    _reject_symlink_components(output_path, 'clean output directory')
    output_dir = output_path.resolve()
    # Belt and braces behind the manifest difference above. `build --output
    # <series root>` is accepted, which puts a manifest at the root; a later
    # clean aimed there by --output or LWP_OUTPUT_DIR would be operating on
    # a directory full of sources. `init` refuses a non-empty directory
    # without --force; the command that DELETES had no equivalent check.
    for marker in ('series.json', 'sources', 'templates'):
        if (output_dir / marker).exists():
            log('error', f'{output_dir} holds `{marker}`, so it is a series '
                f'directory and not a build output. Refusing to clean it: '
                f'point --output or LWP_OUTPUT_DIR at the built site.')
            sys.exit(1)
    manifest_path = output_dir / _MANIFEST_NAME
    if not manifest_path.exists():
        log('error', f'No manifest found at {manifest_path}. '
              f'Run `lightwebpres build` first: clean only removes what a '
              f'build has declared, and a manifest is how it declares it.')
        sys.exit(1)
    try:
        manifest = json.loads(read_text_file(manifest_path))
    except (OSError, ValueError) as exc:
        log('error', f'Invalid manifest {manifest_path}: {exc}')
        sys.exit(1)
    if not isinstance(manifest, dict):
        log('error', f'Invalid manifest {manifest_path}: expected an object.')
        sys.exit(1)
    current = _manifest_paths(manifest, 'files', output_dir, manifest_path)
    previous = _manifest_paths(manifest, 'previous', output_dir, manifest_path)

    # An orphan is a file a PREVIOUS build declared and this one no longer
    # does. Not "everything undeclared" -- that was the rule until it was
    # measured, and it deleted CNAME, .nojekyll, robots.txt, 404.html, a
    # hand-written stylesheet and a whole .git/ from an output directory,
    # because a static site's output is where deployment sidecars live and
    # no build ever declares those. With the output directory pointed at
    # the series root it took the articles, series.json, the templates, the
    # language packs and the bundled executable with it.
    #
    # Reading the difference instead makes the code do what this command's
    # own error message above, and specifications.md, have always said:
    # clean removes what a build declared and stopped declaring. A file no
    # build ever made is never a candidate, which is the whole guarantee.
    orphans = []
    for rel in sorted(previous - current):
        path = _safe_manifest_path(output_dir, rel)
        if path is None:
            log('error', f'Manifest path became unsafe: {rel!r}')
            sys.exit(1)
        if path.is_file():
            orphans.append((rel, path))

    if not orphans:
        print('No orphan files to clean.')
        return

    force = args.get('--force')
    if force:
        # _remove journals under --dry-run and returns without touching the
        # disk, so the words here have to follow it. Saying "removed" over a
        # file that is still there is the same defect in prose that calling
        # unlink() under --dry-run was in code.
        dry = _LOG_STATE['dry_run']
        verb, summary = ('would remove', 'Would clean') if dry else (
            'removed', 'Cleaned')
        for rel, path in orphans:
            _remove(path)
            print(f'  {verb} {rel}')
        print(f'{summary} {len(orphans)} orphan file(s) from {output_dir}.')
    else:
        # Dry-run by default: list what would be removed.
        print(f'{len(orphans)} orphan file(s) would be removed from '
              f'{output_dir}:')
        for rel, _ in orphans:
            print(f'  {rel}')
        print('Run with --force to remove them.')


def _cmd_watch_poll(sources, interval=0.5, refresh=None):
    """Yields when any watched path changed, refreshing paths after changes.

    A refresh lets directory creation wake the first rebuild and makes files
    created there visible to later polling cycles. It remains a simple stdlib
    polling loop, with no watchdog dependency.
    """
    import time
    paths = list(sources)
    mtimes = {}
    while True:
        changed = []
        for path in paths:
            try:
                m = path.stat().st_mtime
            except OSError:
                m = 0
            if path not in mtimes:
                mtimes[path] = m
            elif m != mtimes[path]:
                mtimes[path] = m
                changed.append(path)
        if changed:
            if refresh is not None:
                paths = list(refresh())
                for path in paths:
                    if path not in mtimes:
                        try:
                            mtimes[path] = path.stat().st_mtime
                        except OSError:
                            mtimes[path] = 0
            yield changed
        time.sleep(interval)


def _watch_paths(series_dir, args):
    """Returns every path whose change can alter a build watched by `watch`.

    Keep this on the same resolver as `build`: a series may move its sources,
    templates, or language packs through environment variables, and an
    explicit language file may live outside all three directories. Directory
    entries are included so creating/removing an input wakes the first rebuild.
    """
    sd, sources_dir, templates_dir, lang_dir, _, _, language_file = resolve_paths(
        series_dir, args)
    paths = {sd / 'series.json', sources_dir, templates_dir, lang_dir}
    for root in (sources_dir, templates_dir, lang_dir):
        if root.is_dir():
            paths.update(root.rglob('*'))
    if language_file:
        paths.add(Path(language_file))
    return sorted(paths, key=str)


def cmd_watch(series_dir, args):
    """watch command — polls the sources and
    rebuilds on every change. --serve (opt-in) starts a local HTTP server
    on 127.0.0.1:--port. --open opens the browser. Ctrl-C exits 0."""
    import http.server
    import webbrowser
    import threading

    sd = Path(series_dir).resolve() if series_dir else Path(
        os.environ.get('LWP_SERIES_DIR', '.')).resolve()
    output_dir = Path(args.get('--output') or os.environ.get(
        'LWP_OUTPUT_DIR', str(sd / 'public'))).resolve()
    port = int(args.get('--port', '8000'))

    # Build once first, so the output exists before serving.
    build_args = dict(args)
    build_args.pop('--serve', None)
    build_args.pop('--port', None)
    build_args.pop('--open', None)
    print(f'[watch] initial build of {sd}')
    cmd_build(str(sd), build_args)

    # Start the HTTP server if --serve.
    if args.get('--serve'):
        import functools
        handler = functools.partial(http.server.SimpleHTTPRequestHandler,
                                    directory=str(output_dir))
        httpd = http.server.HTTPServer(('127.0.0.1', port), handler)
        threading.Thread(target=httpd.serve_forever, daemon=True).start()
        url = f'http://127.0.0.1:{port}/'
        print(f'[watch] serving {output_dir} at {url}')
        if args.get('--open'):
            webbrowser.open(url)
    elif args.get('--open'):
        # No serve, but --open: open the file directly.
        index = output_dir.resolve() / 'index.html'
        if index.exists():
            webbrowser.open(index.resolve().as_uri())

    # Gather the same resolved inputs that build consumes. Refreshing after a
    # change makes files created after watch started visible to later polls.
    refresh_watch_paths = lambda: _watch_paths(str(sd), build_args)
    sources = refresh_watch_paths()

    print(f'[watch] polling {len(sources)} source path(s). Ctrl-C to stop.')
    try:
        for changed in _cmd_watch_poll(sources, refresh=refresh_watch_paths):
            names = ', '.join(p.name for p in changed)
            print(f'[watch] {names} changed — rebuilding...')
            try:
                cmd_build(str(sd), build_args)
                print('[watch] rebuilt.')
            except SystemExit as exc:
                log('error', f'build failed (exit code {exc.code}); '
                    f'watching continues.')
            except Exception as exc:
                log('error', f'build failed: {exc}')
    except KeyboardInterrupt:
        print('\n[watch] stopped.')
        return 0


def cmd_build(series_dir, args):
    """build command."""
    ctx = load_build_context(series_dir, args)
    # Validate the one <script> every article page embeds (the nav script) once,
    # before writing anything. We check the raw, un-escaped string we generate
    # — not the page body — so author content (e.g. a <script> written in
    # markdown, whose & and < get HTML-escaped) can never trip the guard.
    ok, detail = validate_page_scripts('<script>' + ctx.nav_js + '</script>')
    if not ok:
        log('error', 'Build aborted: the generated nav script is invalid '
            'JavaScript.\n%s' % (detail,))
        sys.exit(1)
    # Opt-in, off by default (§11.3.2): embedding a live timestamp makes
    # every build non-reproducible byte-for-byte, which most workflows
    # (starting with `check`, see cmd_check) explicitly rely on NOT
    # happening. --build-stamp-minimal wins if both are passed: the
    # explicit ask for the version-and-timestamp-free variant is a
    # privacy choice, and a privacy choice should never be silently
    # overridden by the richer flag also being present.
    if args.get('--build-stamp-minimal'):
        build_stamp = build_stamp_html(VERSION, minimal=True)
    elif args.get('--build-stamp'):
        build_stamp = build_stamp_html(VERSION)
    else:
        build_stamp = ''

    # §11.3.3, decided before anything is written and before the --only
    # fast path (which writes the index too): more than one article
    # claiming index.html is fatal in there, exactly one gets the name and
    # no series index is produced.
    claimant = resolve_index_claim(ctx.claim_articles, ctx.articles)

    nav_cache_path = args.get('--nav-cache') or default_nav_cache_path(ctx.sd)
    fresh_fingerprint = compute_nav_fingerprint(ctx.articles)

    only_file = args.get('--only')
    if only_file:
        # Validate the designation before consulting the cache. A cache miss
        # may trigger a full build, but it must not turn an invalid --only
        # request into an unrelated successful build.
        _resolve_only_entry(ctx, only_file)
    if only_file:
        cached_fingerprint = load_nav_cache(nav_cache_path)
        if cached_fingerprint == fresh_fingerprint:
            _cmd_build_only(ctx, only_file, nav_cache_path, fresh_fingerprint, build_stamp)
            return
        reason = 'no usable cache found' if cached_fingerprint is None else 'nav/index-affecting metadata changed since the last build'
        log('info', f'--only requested but not safe ({reason}) — doing a full build instead.')

    progress(f'Build: {ctx.sd}')
    progress(f'  Articles: {ctx.sources_dir}')
    progress(f'  Output: {ctx.output_dir}')
    progress(f'  Lang: {ctx.lang}')

    # Load the optional index page extension (raw HTML+JS, inserted as-is
    # right before </body> — the only extension point for the index page,
    # since settings.conf/nav.js don't cover site-specific index features)
    index_extra_file = ctx.templates_dir / 'index_extra.html'
    index_extra = read_text_file(index_extra_file) if index_extra_file.exists() else ''

    _mkdir(ctx.output_dir, parents=True, exist_ok=True)

    # Build each article (every page_source was checked to exist by
    # load_build_context — fatal before any output is written)
    include_nav = not args.get('--no-nav')
    # --drafts-only: build only status: draft articles. The
    # index and nav still point to every article, so links may reach pages
    # that were not built — accepted, it is a preview not a publication.
    articles_to_build = ctx.articles
    if args.get('--drafts-only'):
        articles_to_build = [e for e in ctx.articles if e.get('status') == 'draft']
        if not articles_to_build:
            log('error', 'No draft articles found in this series.')
            sys.exit(1)
    for entry in articles_to_build:
        source_file = entry['page_source']
        output_file = entry['page_dest']
        source_path = _resolve_contained(ctx.sources_dir, source_file)
        if source_path is None:
            log('error', f'Source escapes sources/: {ctx.sources_dir / source_file} '
                f'(listed in series.json).')
            sys.exit(1)

        progress(f'  {output_file} ← {source_file}')
        html = build_article(source_path, ctx.sources_dir, ctx.series_data, output_file, ctx.css, ctx.nav_js, ctx.typo_engine, ctx.strings, ctx.lang, build_stamp, style_context=ctx.style_context, include_nav=include_nav, inline_images=ctx.args.get('--inline-images', False), args=ctx.args, lang_tag_engines=ctx.lang_tag_engines, theme_runtime=ctx.theme_runtime, language_runtime=ctx.language_runtime)

        _write_file(ctx.output_dir / output_file, html)

    # Build the index — unless a lone article has claimed its name
    # (§11.3.3), in which case the page just written IS what lives there
    # and dropping an index on top of it would destroy it.
    # --no-index: skip index.html generation entirely.
    if claimant is None and not args.get('--no-index'):
        progress('  index.html')
        index_html = build_index(ctx.series_data, ctx.css, ctx.typo_engine, ctx.strings, ctx.lang, index_extra, build_stamp, theme_runtime=ctx.theme_runtime, style_context=ctx.style_context, language_runtime=ctx.language_runtime)
        ok, detail = validate_page_scripts(index_html)
        if not ok:
            log('error', 'Build aborted: index.html contains invalid JavaScript.\n%s'
                % (detail,))
            sys.exit(1)
        _write_file(ctx.output_dir / 'index.html', index_html)
    elif claimant is not None:
        progress(_no_index_notice(claimant))
    # --no-readme: skip README.md generation.
    if not args.get('--no-readme'):
        readme = build_readme(ctx.series_data, ctx.sd, ctx.output_dir, ctx.strings)
        _write_file(ctx.sd / 'README.md', readme)

    # Copy the images (unless --inline-images: images are embedded as
    # base64 data URIs, so the img/ directory is not copied to the output).
    images = []
    if not args.get('--inline-images'):
        images = copy_images(ctx.sources_dir, ctx.output_dir)

    save_nav_cache(nav_cache_path, fresh_fingerprint)

    # Manifest for `clean`: lists every file this build
    # produced in public/, so clean can purge orphans without guessing.
    _write_manifest(ctx.output_dir, ctx.articles,
                    include_index=claimant is None and not args.get('--no-index'),
                    images=images)

    tail = ' + index' if claimant is None and not args.get('--no-index') else ''
    progress(f'Build complete: {len(articles_to_build)} articles{tail} -> {ctx.output_dir}')

    # --open: open the result in the browser.
    if args.get('--open'):
        import webbrowser
        index_url = (ctx.output_dir / 'index.html').resolve().as_uri()
        webbrowser.open(index_url)


def cmd_check(series_dir, args):
    """check command — compares the existing output with what the build
    would produce: every article page, index.html AND README.md. The two
    latter used to be skipped, which left a hole in the CI gate: a
    series_meta change (title, intro, article order) alters only the
    index/README, and check stayed green over a stale publication."""
    ctx = load_build_context(series_dir, args)
    # Decided up front, as in cmd_build: a series.json that build refuses
    # is refused here too, with the same message and before any per-file
    # line is printed, rather than after a screenful of comparisons that
    # describe an arrangement no build will produce.
    claimant = resolve_index_claim(ctx.claim_articles, ctx.articles)

    ok_count = 0
    diff_count = 0

    def compare(name, generated, existing_path):
        nonlocal ok_count, diff_count
        if not existing_path.exists():
            print(f'[NEW] {name} does not exist yet')
            diff_count += 1
            return
        # Never generated here, on either side of the comparison: a build
        # stamp's timestamp is different on every single run by design, so
        # comparing it against anything (including itself, moments later)
        # would always drift — check's job is real content drift, not
        # "time has passed". strip_build_stamp() on the disk copy is what
        # keeps a series built with --build-stamp still checkable.
        existing = strip_build_stamp(read_text_file(existing_path))
        if existing.strip() == generated.strip():
            print(f'[OK] {name}')
            ok_count += 1
        else:
            print(f'[DRIFT] {name}')
            diff = list(difflib.unified_diff(
                existing.strip().splitlines(), generated.strip().splitlines(),
                lineterm='', n=1))
            for line in diff[:20]:
                print(' ', line)
            diff_count += 1

    for entry in ctx.articles:
        source_path = _resolve_contained(ctx.sources_dir, entry['page_source'])
        if source_path is None:
            log('error', f'Source escapes sources/: {ctx.sources_dir / entry["page_source"]} '
                f'(listed in series.json).')
            sys.exit(1)
        generated = build_article(source_path, ctx.sources_dir, ctx.series_data, entry['page_dest'], ctx.css, ctx.nav_js, ctx.typo_engine, ctx.strings, ctx.lang, style_context=ctx.style_context, include_nav=not args.get('--no-nav'), inline_images=ctx.args.get('--inline-images', False), args=args, lang_tag_engines=ctx.lang_tag_engines, theme_runtime=ctx.theme_runtime, language_runtime=ctx.language_runtime)
        compare(entry['page_dest'], generated, ctx.output_dir / entry['page_dest'])

    # §11.3.3: when a lone article's page_dest IS index.html, `build`
    # produces no series index at all — that file is the article's own
    # page, already compared in the loop above. Rendering an index here
    # and diffing it against that page would report a [DRIFT] on a series
    # that is correctly built and that no rebuild could ever settle: the
    # CI gate would stay red for as long as the arrangement lasts.
    if claimant is None:
        index_extra_file = ctx.templates_dir / 'index_extra.html'
        index_extra = read_text_file(index_extra_file) if index_extra_file.exists() else ''
        compare('index.html',
                build_index(ctx.series_data, ctx.css, ctx.typo_engine, ctx.strings, ctx.lang, index_extra, theme_runtime=ctx.theme_runtime, style_context=ctx.style_context, language_runtime=ctx.language_runtime),
                ctx.output_dir / 'index.html')
    compare('README.md',
            build_readme(ctx.series_data, ctx.sd, ctx.output_dir, ctx.strings),
            ctx.sd / 'README.md')

    print(f'{ok_count} file(s) OK, {diff_count} file(s) different.')
    if diff_count == 0:
        print('All files are up to date.')
    else:
        sys.exit(1)


# ============================================================================
# AUDIT COMMAND
# ============================================================================

def audit_meta_keys(filename, meta):
    """A key in an lwp:meta block that nothing reads.

    The format is loud about a misspelled SLIDE field: it becomes free
    text, and on a cover that is a fatal build error naming the field and
    listing the valid ones. A misspelled META key is the opposite -- it is
    accepted in silence, has no effect, and the page ships with a title
    that fell back to something else. `page-title:` for `page_title:` costs
    nothing at build time and everything on the published page.

    This is the only place in the tool that says so, and it warns rather
    than blocks, which is the whole shape of `audit`: an unrecognized key
    does not stop the tool working (§9.5.6), it only fails to do what its
    author meant. The nearest valid name is offered because the failure
    mode is a typo, not an invention.

    `style.*` keys are skipped: they are the article property layer, with
    their own vocabulary and their own errors, which are fatal and precise
    already.
    """
    warnings = 0
    for key in meta:
        if key in ARTICLE_META_KEYS or key.startswith('style.'):
            continue
        near = difflib.get_close_matches(key, sorted(ARTICLE_META_KEYS),
                                         n=1, cutoff=0.6)
        hint = f' Did you mean `{near[0]}:`?' if near else ''
        log('warn', f'{filename}: `{key}:` is not a meta field — '
                    f'nothing reads it and it has no effect.{hint}')
        warnings += 1
    return warnings


# A `[^...]` the engine will NOT read as a note (ARCHI-NOTES §4). Both
# note rules -- md_inline()'s call substitution and _NOTE_DEF_RE -- spell
# the label `\w+`, so an accent passes and a hyphen, a space or a dot does
# not: the whole construct then falls through as ordinary text. The class
# excludes brackets and is capped at 32 characters because a label is a key
# someone typed; past that length a match is a sentence that happens to
# open with `[^`, not a typo. `(?!\()` drops `[^a-b](https://...)`:
# md_inline()'s link rule runs BEFORE its note rule and turns that shape
# into a perfectly good link -- measured, and the one false positive worth
# a rule of its own.
_NOTE_SUSPECT_RE = re.compile(r'\[\^([^\[\]\n]{1,32})\](?!\()')

# md_inline()'s inline-code rule, and it has to stay the same rule: it is
# what keeps a regex character class written `[^a-z]` inside backticks out
# of the report below.
_CODE_SPAN_RE = re.compile(r'(?<!\\)`([^`]+?)(?<!\\)`')


def unrecognized_note_labels(text):
    """Every `[^...]` in `text` that the converter will not read as a note.

    The one defect in this format that reaches the READER in silence. A
    misspelled slide field becomes free text and on a cover says so
    fatally; an unknown meta key is named by audit_meta_keys(); an unknown
    slide type is refused. But `[^a-b]` is neither an error nor a note: the
    call ships as the literal string `[^a-b]` inside the sentence and its
    body renders as an ordinary paragraph reading `[^a-b]: ...`, with build
    and audit both silent and both exiting 0. Someone finds out by reading
    the published page.

    This one re-scans the source where its neighbours convert, and the
    defect itself is the reason: the converter never sees these labels, so
    it has nothing to report about them. Reading the source is also all
    that is needed -- the fault is a shape, settled before anything is
    rendered.

    What is skipped is what the converter would not treat as a note
    either, so that acting on a warning is always the right move:

    - fenced code blocks and inline code spans, where `[^a-z]` is content
      and stays content;
    - raw HTML blocks, passed through verbatim: NOTHING in one is a note,
      a good label no more than a bad one, so the label is not what is
      wrong there. A body in that position is audit_notes()'s `swallowed`
      finding; a call in that position is still nobody's.

    Returns [(label, is_body), ...], each label once per kind, in source
    order. `is_body` marks a definition line -- flush left and followed by
    `:`, the two things _NOTE_DEF_RE requires -- because a call and a body
    fail visibly differently on the page and want different advice.
    """
    raw_html_depth = 0
    in_code_block = False
    found = []
    seen = set()
    # The block states are convert_markdown()'s, tested in its order: a
    # fence opener inside raw HTML opens nothing, and a raw HTML line
    # inside a fence is content.
    for raw in text.split('\n'):
        line = rstrip_ws(raw)
        if raw_html_depth > 0:
            raw_html_depth = max(0, raw_html_depth + _html_tag_depth_delta(line))
            continue
        if in_code_block:
            if line == '```':
                in_code_block = False
            continue
        if _CODE_FENCE_RE.match(line):
            in_code_block = True
            continue
        if _is_raw_html_line(line):
            raw_html_depth = max(0, _html_tag_depth_delta(line))
            continue
        # Blanked, not cut, one space per character, so the definition test
        # below still finds column 0 where the source put it.
        line = _CODE_SPAN_RE.sub(lambda m: ' ' * len(m.group(0)), line)
        # A backtick still standing here opened or closed a span whose
        # other half is on a neighbouring line -- md_inline() reads a
        # paragraph merged, this loop reads it a line at a time. What is
        # code on such a line cannot be decided from the line, so the line
        # is not read at all. A blind spot on purpose rather than a guess:
        # checked against convert_markdown()'s own output over the prose in
        # this repository, a line at a time plus this rule reports exactly
        # what the converter leaves literal, while every wider window
        # invented warnings about text the converter had safely put inside
        # <code>.
        if re.search(r'(?<!\\)`', line):
            continue
        for m in _NOTE_SUSPECT_RE.finditer(line):
            label = m.group(1)
            if re.fullmatch(r'\w+', label):
                continue
            is_body = m.start() == 0 and line[m.end():m.end() + 1] == ':'
            if (label, is_body) in seen:
                continue
            seen.add((label, is_body))
            found.append((label, is_body))
    return found


# The markup a structural field will NOT render, and the fields that carry
# it. A field is a VALUE -- one physical line, taken verbatim -- while the
# free text beside it is Markdown, and nothing in the file marks the border.
# Worse, the border is not where an author would guess: a field passes raw
# HTML straight through (`page_title: A<br>B` is in the README), so someone
# who finds that markup "works" in a field generalises, and `**gras**` ships
# to the reader as five literal characters.
#
# Only PAIRED markers are looked for. `2 ** 8` and `**kwargs` in a caption
# are arithmetic and Python, not a lost emphasis, and warning on them would
# be the noise that gets a check switched off.
_FIELD_MARKUP_RES = (
    ('a `**bold**` pair', re.compile(r'\*\*(?=\S)(.+?)(?<=\S)\*\*')),
    ('an `*italic*` pair', re.compile(r'(?<!\*)\*(?=\S)([^*]+?)(?<=\S)\*(?!\*)')),
    ('a backtick pair', re.compile(r'`(?=\S)([^`]+?)(?<=\S)`')),
    ('a `[text](url)` link', re.compile(r'\[[^\]\n]+\]\([^)\s]+\)')),
)

# Which named field each slide attribute is, so the warning names what the
# author typed rather than what the parser calls it.
_FIELD_ATTRS = (
    ('kicker', 'kicker'), ('summary', 'summary'),
    ('fact-label', 'fact_label'), ('source', 'source'),
    ('highlight', 'highlight'), ('highlight-caption', 'highlight_caption'),
    ('# title', 'h1'), ('## title', 'h2'),
)


def unrendered_field_markup(slides):
    """Every structural field carrying markup that will ship literally.

    Reported on a 28-article corpus where 32 fields had accumulated it
    unnoticed -- including `source:` lines, which is exactly where a reader
    checking a claim looks. `build`, `verify` and `audit` were all green,
    the HTML was well formed, and nothing distinguished those pages from
    correct ones without extracting the visible text and reading it.

    This reads the parsed slides rather than the source, because a field's
    value is what the parser kept: the same `**` inside the free text below
    it is a real emphasis, and only the parse says which side of the line a
    given occurrence fell on.

    Returns [(slide_number, field_name, marker)], each field once, on its
    first marker -- one mistake, one finding, and the author will see the
    rest of the line when they open it.
    """
    found = []
    for number, slide in enumerate(slides, 1):
        for name, attr in _FIELD_ATTRS:
            value = getattr(slide, attr, None)
            if not value:
                continue
            for marker, pattern in _FIELD_MARKUP_RES:
                if pattern.search(value):
                    found.append((number, name, marker))
                    break
    return found


def audit_notes(entry, meta, series_meta, slides, sources_dir):
    """The three ways a note can be broken without the build noticing
    (ARCHI-NOTES §4). None of them is fatal: the input contract does not
    break over an editorial slip, and this is the command that exists for
    that class.

    The localities are the real ones — one scope per card and one for the
    long-form file under `local` placement, one for the whole page under
    `page` — because a call and its body being in different cards is a
    defect under one placement and perfectly fine under the other. Getting
    that wrong in either direction would make the report useless.

    It converts rather than re-scanning. A second regex pass over the
    source would drift from what the build actually does — and the case
    this is most needed for, a definition swallowed by a raw HTML block,
    is precisely one only the converter can see."""
    placement, _ = resolve_notes_settings(meta, series_meta, entry['page_source'])
    localities = []
    if placement == 'page':
        scope = NoteScope('p', deferred=True)
        for i, slide in enumerate(slides, 1):
            if slide.fact_content:
                localities.append(('the page', scope, slide.fact_content))
        for slide in slides:
            if slide.slide_type == 'full-article' and slide.article_file:
                path = _resolve_contained(sources_dir, slide.article_file)
                if path is not None and path.exists():
                    text = audit_read(path)
                    if text is not None:
                        localities.append(('the page', scope, text))
    else:
        for i, slide in enumerate(slides, 1):
            if slide.fact_content:
                localities.append((f'slide {i}', NoteScope(f's{i}'), slide.fact_content))
        for slide in slides:
            if slide.slide_type == 'full-article' and slide.article_file:
                path = _resolve_contained(sources_dir, slide.article_file)
                if path is not None and path.exists():
                    text = audit_read(path)
                    if text is not None:
                        localities.append((slide.article_file,
                                           NoteScope('article'), text))

    converted = []
    for where, scope, text in localities:
        try:
            converted.append(convert_markdown(text, None, None, scope, {}))
        except PropertyError:
            # A bad instance tag in the same text. It is a build error and
            # the build will name it; audit is not the place to duplicate
            # that, and it must not die on the way to its own findings.
            continue
    # A deferred scope has collected but numbered nothing — the page is
    # what closes it. Close it here the same way build_article() does, or
    # every call would read as never made and every body as never called.
    if placement == 'page' and localities:
        localities[0][1].resolve('\n'.join(converted))

    warnings = 0
    # Read before the findings that need a scope: this one is about what
    # the source says, the others about what conversion made of it. Not
    # folded into the loop below, which dedupes by scope -- under `page`
    # placement every locality shares one, and folding would look at the
    # first card only.
    for where, _, text in localities:
        for label, is_body in unrecognized_note_labels(text):
            if is_body:
                log('warn', f'{entry["page_source"]}: [^{label}]: in '
                            f'{where} is not a note body — a label is word '
                      f'characters only (letters, digits, underscore, '
                      f'accents included; not `-`, space or punctuation), '
                      f'so the line renders as an ordinary paragraph, the '
                      f'label in plain view.')
            else:
                log('warn', f'{entry["page_source"]}: [^{label}] in '
                            f'{where} is not a note call — a label is word '
                      f'characters only (letters, digits, underscore, '
                      f'accents included; not `-`, space or punctuation), '
                      f'so it ships to the reader as literal text. Rename '
                      f'it, or wrap it in backticks if it is meant to read '
                      f'as it stands.')
            warnings += 1
    seen = set()
    for where, scope, _ in localities:
        if id(scope) in seen:
            continue
        seen.add(id(scope))
        for label in scope.orphan_calls():
            log('warn', f'{entry["page_source"]}: [^{label}] is called in '
                        f'{where} but has no body — the marker renders without a '
                  f'link, and the reader cannot reach the source.')
            warnings += 1
        for label in scope.unreferenced_bodies():
            log('warn', f'{entry["page_source"]}: [^{label}] has a body in '
                        f'{where} that nothing calls — it renders at the end of the '
                  f'block, numbered after a number no marker carries.')
            warnings += 1
        for label in scope.swallowed:
            log('warn', f'{entry["page_source"]}: [^{label}]: sits inside a '
                        f'raw HTML block in {where} — raw HTML is passed through '
                  f'verbatim, so it ships as literal text, not as a note.')
            warnings += 1
    return warnings


def audit_article_tags(filename, meta):
    """Reports malformed article-level filter tags without blocking audit."""
    warnings = 0
    raw = str(meta.get('tags', '') or '').strip()
    for token in raw.split():
        canonical = token.casefold()
        if (canonical.startswith('_')
                or not _TAG_TOKEN_RE.fullmatch(canonical)):
            log('warn', f'{filename}: article tags: invalid tag {token!r} '
                '(build will reject this tags: value).')
            warnings += 1
        elif canonical == 'excluded':
            log('warn', f'{filename}: article tags: "excluded" is only a '
                'slide omission; use status: ignored for an article.')
            warnings += 1
    return warnings


def audit_series_default_tag(series_data):
    """Reports malformed ``series_meta.default_tag`` without stopping audit."""
    meta = (series_data.get('series_meta', {})
            if isinstance(series_data, dict) else {})
    if not isinstance(meta, dict) or 'default_tag' not in meta:
        return 0
    raw = str(meta.get('default_tag') or '').strip()
    tokens = raw.split()
    warnings = 0
    for token in tokens:
        canonical = token.casefold()
        if (canonical.startswith('_')
                or not _TAG_TOKEN_RE.fullmatch(canonical)):
            log('warn', f'series.json: series_meta.default_tag: invalid tag '
                f'{token!r}.')
            warnings += 1
        elif canonical == 'excluded':
            log('warn', 'series.json: series_meta.default_tag cannot be '
                '"excluded".')
            warnings += 1
    if len(tokens) != 1:
        log('warn', 'series.json: series_meta.default_tag must contain '
            'exactly one tag.')
        warnings += 1
    return warnings


def audit_slide_tags(filename, slides, series_meta, lang_dir, default_lang,
                     language_file=None):
    """Audits the slide-tag vocabulary without duplicating build validation.

    `build` must reject malformed tags; `audit` instead reports every bad
    token and keeps going so an author can fix a whole article in one pass.
    Language-pack references are similarly advisory here: built-in French and
    English packs always exist, while other names need a file in `language/`.
    """
    warnings = 0
    lang_tags = series_meta.get('lang_tags', {}) if series_meta else {}

    def pack_exists(pack):
        if pack.casefold() in ('fr', 'en'):
            return True
        if language_file and pack.casefold() == str(default_lang).casefold():
            return Path(language_file).exists()
        return bool(lang_dir and (Path(lang_dir) / f'{pack}.json').exists())

    missing_packs = {}
    for tag, pack in lang_tags.items():
        if not pack_exists(pack):
            missing_packs[tag] = pack
            log('warn', f'{filename}: series_meta.lang_tags tag '
                        f'{tag!r} points to missing language pack {pack!r} in '
                  f'language/.')
            warnings += 1

    for number, slide in enumerate(slides, 1):
        raw = str(slide.tags or '').strip()
        if not raw:
            continue
        for token in raw.split():
            canonical = token.casefold()
            if (canonical.startswith('_')
                    or not _TAG_TOKEN_RE.fullmatch(canonical)):
                log('warn', f'{filename}: slide {number}: invalid tag '
                            f'{token!r} (build will reject this tags: value).')
                warnings += 1
            elif canonical in missing_packs:
                log('warn', f'{filename}: slide {number} uses language '
                            f'tag {canonical!r}, but its pack '
                      f'{missing_packs[canonical]!r} is missing.')
                warnings += 1
    return warnings


# Files `audit` has already refused THIS RUN, so one unreadable article is
# named once instead of once per pass that reaches for it. Cleared when a
# run starts, and that is not tidiness: the executable is also loaded as a
# MODULE by the web interface, where the process outlives a command. A memo
# that survived the run would keep calling a file unreadable after its
# author had fixed it and asked again -- a report that cannot be corrected,
# which is worse than the repeated line it exists to avoid.
_AUDIT_UNREADABLE = set()


def audit_read(path):
    """`path` as text, or None when it cannot be read as text.

    `read_text_file` refuses and EXITS -- the right answer for a build,
    which has nothing to produce from a file it cannot decode, and the
    wrong one for a command whose whole contract is to report and keep
    going. Measured before this existed: one article saved in the wrong
    encoding took `audit` down at exit 1 with no summary at all, on the
    same run where §11.5 and the guide both promise exit 0 whatever it
    finds. A reader who cannot be read is a finding, not a stop.

    The refusal has already named the file on stderr; the caller's job is
    to count it and carry on to the next article.

    Refusals are remembered for the run, because `audit` reads the same
    article from several passes -- the syntax pass, the note localities,
    the render -- and one unreadable file otherwise names itself once per
    pass. Three identical [ERROR] lines about one file is the same noise
    the warning counter is careful to avoid, arriving by another door."""
    if path in _AUDIT_UNREADABLE:
        return None
    try:
        return read_text_file(path)
    except SystemExit:
        _AUDIT_UNREADABLE.add(path)
        return None


def audit_by_rendering(series_dir, args, caller_named_the_cause=False):
    """Renders the series in memory and reports what only a render can say.

    `verify` already renders without writing -- it builds the HTML and
    compares it to the disk copy. This is the same machinery pointed at a
    different question: not "does the output match" but "what did composing
    it have to complain about".

    Returns the number of warnings the render raised. The HTML is thrown
    away; nothing is written, and `--dry-run` is irrelevant here because
    there was never anything to suppress.

    A render that cannot finish is itself the finding. `build_article`
    exits on a fatal fault -- a pinned property that no longer exists, an
    unbalanced tag, an unreadable include -- and audit used to miss every
    one of those too, reporting `No warnings` on a series no build could
    produce. The SystemExit is caught so audit keeps its promise never to
    block, and counted so `--strict` still fails on it."""
    # Drafts and drafts-only are BUILD scopes, not audit scopes: §20.6 says
    # nothing is excluded from an audit, drafts least of all, since a draft
    # is precisely the article still being worked on. Rendering under the
    # build's own filters made that false for every fault only a render can
    # see -- measured, the same cover fault warned on an active article and
    # was silent on a draft, with `--strict` green either way and no
    # `--include-drafts` on audit to reach it.
    args = dict(args)
    args['--include-drafts'] = True
    args.pop('--drafts-only', None)
    # audit_presentation has already reported a legacy templates/style.css,
    # and said more about it than the build path does.
    # No parallel tally beside the sink. These four findings used to be
    # printed and counted by hand, which made them the only warnings in
    # the program that two mechanisms had to agree about; they go through
    # log() like everything else and the sink counts them once.
    with collect_warnings(
            already_said=('templates/style.css is no longer read',)) as sink:
        try:
            ctx = load_build_context(series_dir, args, include_ignored=True,
                                     strict_tags=False,
                                     warn_tag_coverage=False)
        except SystemExit:
            # The message is already on stderr, printed by whatever refused.
            # Saying so here is what stops the summary from contradicting it
            # -- unless the caller has already named the cause article by
            # article, which it does for a missing page_source. Repeating it
            # here would be the double count `already_said` exists to stop,
            # arriving through the one door that mechanism does not cover.
            if not caller_named_the_cause:
                log('warn', 'the series does not build: the error above '
                    'is fatal, and no page would be produced. audit does '
                    'not block, but this is not an editorial remark.')
            return len(sink.messages)

        # The index claim is the BUILD's decision, not this render's.
        # Rendering with drafts is right -- a draft is exactly the article
        # still being worked on -- but letting a DRAFT named index.html
        # claim the index takes build_index, and templates/index_extra.html
        # with it, out of the audit: measured, a fatal in that file made
        # `build` exit 1 while audit reported "No warnings". Blinding the
        # pass to a whole page is the failure it was written to remove, so
        # the claim is resolved against what a build would actually ship.
        shipped = [e for e in ctx.articles
                   if e['status'] not in ('draft', 'ignored')]
        claimant = resolve_index_claim(ctx.claim_articles, shipped)

        # Per article, so a fatal names the page that carries it -- and so
        # one bad article does not hide every article after it. A draft
        # gets its own sentence: `build` would not produce that page at
        # all, so saying "the series does not build" over it would be
        # false, and a false finding is worse than a missing one.
        for entry in ctx.articles:
            source_path = _resolve_contained(ctx.sources_dir, entry['page_source'])
            if source_path is None or not source_path.exists():
                # The syntax pass already counted a missing ignored source;
                # there is nothing for this render pass to compose.
                continue
            try:
                build_article(
                    source_path, ctx.sources_dir,
                    ctx.series_data, entry['page_dest'], ctx.css, ctx.nav_js,
                    ctx.typo_engine, ctx.strings, ctx.lang,
                    style_context=ctx.style_context,
                    inline_images=ctx.args.get('--inline-images', False),
                    args=args, lang_tag_engines=ctx.lang_tag_engines,
                    theme_runtime=ctx.theme_runtime,
                    language_runtime=ctx.language_runtime)
            except SystemExit:
                if entry['status'] == 'draft':
                    log('warn', f'{entry["page_source"]}: this draft does '
                        f'not render — the error above is fatal. A build '
                        f'without --include-drafts would not produce it, so '
                        f'the series still builds; this page does not.')
                else:
                    log('warn', f'{entry["page_source"]}: the series does '
                        f'not build — the error above is fatal, and this '
                        f'page would not be produced. audit does not block, '
                        f'but this is not an editorial remark.')
        if claimant is None:
            try:
                extra = ctx.templates_dir / 'index_extra.html'
                build_index(ctx.series_data, ctx.css, ctx.typo_engine,
                            ctx.strings, ctx.lang,
                            read_text_file(extra) if extra.exists() else '',
                            theme_runtime=ctx.theme_runtime,
                            style_context=ctx.style_context,
                            language_runtime=ctx.language_runtime)
            except SystemExit:
                log('warn', 'the series index does not build — the error '
                    'above is fatal, and index.html would not be produced.')
    return len(sink.messages)


# ----------------------------------------------------------------------------
# The judgement pass of `audit` (§9.5.6): what the RESOLVED sheet makes
# unusable, as opposed to merely bold.
#
# Everything else in this tool judges the FORM of a theme: a property that
# does not exist, a reference cycle, a colour that is not a colour, a unit
# nobody defined. All four are fatal, and none of them is about what the
# page looks like. Measured before this pass, the other half was entirely
# unguarded: `page.fg` set to exactly `page.bg` (1.00:1), a progress dot
# painted the colour of its own rail, a bold run invisible on its own
# highlight, `note.size: 3px` — all four composed, built, and exited 0,
# `--strict` included.
#
# The line this pass may not cross is written in §9.5.6 and is the whole
# reason the thresholds below are measured rather than chosen:
#
#     A test may refuse what stops the tool working. It may never refuse
#     what a theme looks like.
#
# B5 and B18 decided that a theme is NOT required to reach AA, and a
# substantial part of the delivered catalogue is deliberately under AA on
# its secondary text. Warning on "below AA" would therefore harass shipped
# themes and contradict a written decision. So each threshold here
# is set BELOW everything the catalogue measures, and the measurement is
# recorded next to it: a threshold that makes a delivered theme warn is a
# wrong threshold, because it turns the report into noise and B5 into a
# dead letter.
#
# The three thresholds, each with the measurement that fixed it (run over
# THEMES with resolve_theme_properties + measure_contrast):
#
#   navigation 3:1, and it is not a new number. It is WCAG 1.4.11, it is
#              the one hard floor §9.5.6 allows, and it is already a test
#              on the delivered themes — never on what an author writes.
#              Measured over the built-in themes AND the default sheet, the
#              closest is pop-lime's current-slide dot at 3.1712:1.
#   text       1.5:1. Measured 2026-08-18 over the delivered catalogue,
#              the worst text pair was nord's "yes" verdict at 1.7866:1 —
#              deliberately low, and legitimate, since a verdict also
#              carries a shape marker (WCAG 1.4.1). 1.5 sits below it with
#              room left, so it can only fire on something worse than
#              anything the project ships. The NUMBER of pairs is not
#              written here: it moves with every site added to
#              CONTRAST_SITES, and the sweep test recomputes it anyway.
#   size       12px, the design floor the registry already states and a
#              test already pins on the defaults. Measured 2026-08-18 over
#              the built-in themes AND the default sheet, the catalogue's
#              smallest floor is exactly 12.00px — nord's `kicker.size`,
#              `max(12px, 1.5vmin)` — so the threshold sits ON it and
#              nothing delivered trips it. 1,856 of the 2,030 size readings
#              resolve to a floor; the rest are `em`, which is a fact about
#              the templates rather than about the registry.
#
#              Two earlier claims here were wrong and are worth keeping as
#              a warning about this number. One said 1,824 readings, from a
#              count taken when the registry held fewer size properties.
#              The other said 0 readings resolved, written during a repair
#              that had `max` refuse whenever one argument was relative —
#              which is how the entire catalogue briefly stopped being
#              measurable. The floor of a `max` is the largest of its
#              arguments' floors, and a relative term floors at zero.
#
# Sites are NOT enumerated here. The pass reuses CONTRAST_SITES through
# measure_contrast(), which is the same "hook the funnel, not the sites"
# rule _WARN_SINK follows: a site added tomorrow is judged tomorrow, with
# nobody having to remember this place.
# ----------------------------------------------------------------------------

# A text pair below this is not an audacious palette, it is text the reader
# cannot find. See the measurement above: the catalogue's own floor is
# 1.7866:1, so this fires only under everything the project delivers.
ILLEGIBLE_TEXT_RATIO = 1.5

# The design's readability floor, in CSS pixels. Stated once in the
# registry test on the defaults ("below 12px the reference becomes the
# smallest element on the card"); this is the same decision applied to the
# layer the author writes, where nothing enforced it.
READABLE_TEXT_PX = 12.0


def navigation_contrast_sites():
    """The sites whose failure leaves the reader unable to navigate.

    Derived from the palette role, never listed here. §9.5.7 gives
    `color.nav` exactly one job — the furniture that MOVES the reader —
    and names four pieces: the active progress dot, the two focus rings,
    and the rule under a series-nav card. So "painted by nav" and "is a
    navigation control" are one statement, and a ring added tomorrow is
    judged tomorrow without anyone editing this function.

    Three of those four reach this floor, and the fourth is exempt by a
    written decision rather than by omission: `series-nav.link.rule-fg` is
    not in CONTRAST_SITES at all. SC 1.4.11 asks 3:1 of what is REQUIRED
    to identify a component, and a card is identified by its title, which
    IS measured — the reason sits beside the key in CONTRAST_UNMEASURED,
    next to the same call for a button's edge and an index card's. A
    colour property in neither that table nor the site list is a
    measurement nobody made, and a test walks the registry against both,
    so this cannot quietly become one. Saying "three pieces" here made a
    written exemption read as a hole.

    Three other non-text sites are outside this floor, and the reason is
    the same one for all three: they are not navigation. Nothing moves
    the reader with them, so `color.nav` does not paint them and the
    derivation above does not reach them — no exemption is needed and
    none is written.

      - `table.col-snap.rule-fg` takes `mark`. It edges a column that
        already carries its own tinted ground, and that ground is what
        identifies the column.
      - `link.decoration-color` takes `ink`: a body link inherits the ink
        around it (§9.5.3).
      - `fact.strong.decoration-color` takes the emphasis colour itself,
        on a run that already carries weight and usually a ground
        (§9.5.5).

    They are measured like everything else and reported like everything
    else; what they are not is controls, and this floor is about
    controls."""
    return [site for site in CONTRAST_SITES
            if site.kind != 'text'
            and PROPERTY_REGISTRY[site.fg].default == 'nav']


def _top_level_args(text):
    """`text` split on the commas that are not inside parentheses.

    A CSS function argument can itself be a function -- `max(1rem,
    min(2vw, 20px))` -- so splitting on every comma reads `min(2vw` as an
    argument and drops the rest. Depth counting is the whole of it."""
    args, depth, start = [], 0, 0
    for i, ch in enumerate(text):
        if ch == '(':
            depth += 1
        elif ch == ')':
            depth -= 1
        elif ch == ',' and depth == 0:
            args.append(text[start:i])
            start = i + 1
    args.append(text[start:])
    return [a.strip() for a in args if a.strip()]


def _absolute_size_px(value):
    """A resolved font size in px, or None when it is relative to inherited.

    `em` is skipped rather than guessed at, and that is a correctness
    requirement, not caution: `footnote-call.size` is `0.72em` on all built-in
    themes, and resolving it against an assumed 16px root reads 11.52px —
    a guard that did so would open by warning on the entire catalogue for
    a size that renders perfectly. What the parent is, is a fact about the
    templates; the registry does not know it, so this does not pretend to.

    `clamp`, `min` and `max` are three different questions and were once
    answered as one, by taking the first argument of whichever appeared.
    That is right for `clamp(a, b, c)`, whose floor is `a`. It is wrong
    both ways for the others, and measured: `max(9px, 1rem)` renders at
    16px and warned, `min(20px, 4vw)` can render at 8px and said nothing.
    The question is always the SMALLEST size the rule can render, and the
    three functions answer it differently. A `clamp(a, b, c)` floors at
    `a`. A `max` floors at the largest of its arguments' floors -- and a
    relative argument floors at zero, since a viewport can be arbitrarily
    small, so it is IGNORED rather than fatal to the reading:
    `max(8px, 6.1vmin)` really can render at 8px, which is the whole
    catalogue's idiom and the case worth judging. A `min` floors at the
    smallest, so one relative argument puts its floor at zero and there is
    nothing to say: it is not judged.

    An earlier repair had `max` refuse as soon as one argument was
    relative, on the argument that an unknown could lift the render above
    the floor. That confuses the rendered value with the floor, and it
    measured: it turned the floor off for 91% of the readings the older,
    cruder rule got right. The rule is not "refuse when unsure" — it is
    "a relative term contributes zero", which is exactly what it does."""
    v = value.strip()
    m = re.match(r'^(clamp|min|max)\((.*)\)$', v, re.S)
    if m:
        fn, args = m.group(1), _top_level_args(m.group(2))
        if not args:
            return None
        if fn == 'clamp':
            return _absolute_size_px(args[0])
        floors = [_absolute_size_px(a) for a in args]
        if fn == 'max':
            known = [f for f in floors if f is not None]
            return max(known) if known else None
        return None if any(f is None for f in floors) else min(floors)
    if re.search(r'[\d.]\s*(?:em|ex|ch|%)', v):
        return None
    return length_px(v, 16.0)


def judge_resolved_theme(resolved):
    """The three ways a composed sheet stops working, measured on `resolved`.

    Returns [(key, message)] — `key` identifies the faulty PROPERTY so the
    caller can report each one once. Grouping matters: `page.fg` set to its
    own background fails at eight sites at once, and eight warnings for one
    typo is how a report stops being read. The worst pair is the one
    reported, because it is the one the fix has to clear.

    Nothing here is graded, ranked or scored. Each finding is a thing that
    does not work — an invisible control, text nobody can find, a size
    below the floor — never a thing that could be prettier."""
    worst = {}

    def keep(key, ratio, message):
        if key not in worst or ratio < worst[key][0]:
            worst[key] = (ratio, message)

    measured = measure_contrast(resolved)

    # 1. Navigation the reader can no longer see. `non_text` failures ARE
    #    the pairs under 3:1 — that bar is CONTRAST_LEVELS' own, so the
    #    floor here and the floor §9.5.6 states can never drift apart — and
    #    navigation_contrast_sites() narrows them to the furniture that
    #    orients the reader. A dot nobody can see is not a bold palette, it
    #    is the control that says which slide is open, in pieces.
    bar = CONTRAST_LEVELS['non_text']['aa']
    navigation = {site.fg for site in navigation_contrast_sites()}
    for rec in measured['non_text']['failures']:
        if rec['foreground'] not in navigation:
            continue
        keep(('control', rec['foreground']), rec['ratio'],
             f"`{rec['foreground']}` is at {rec['ratio']:.2f}:1 against "
             f"{rec['ground_color']} — the {rec['site']} is how the reader "
             f"knows where they are, and under {bar:g}:1 they cannot see it "
             f"(§9.5.6). Repaint `{rec['foreground']}`, or set `color.nav`, "
             f"which it follows by default. This one is not a matter of "
             f"taste: a control nobody can see is a control that is broken.")

    # 2. Text indistinguishable from what it sits on. Deliberately NOT the
    #    AA bar: §9.5.2 and B5 let a theme sit under AA on purpose, and a
    #    large part of the catalogue does — measured 2026-08-18, 22 of the
    #    57 delivered themes carried at least one text pair under AA. (An
    #    earlier version of this comment said six, a figure no reading of
    #    the catalogue produces.) This fires far below that, where the
    #    question stops being how bold the palette is and becomes whether
    #    the words are on the page at all.
    for category in ('body_text', 'large_text'):
        for rec in measured[category]['failures']:
            if rec['ratio'] >= ILLEGIBLE_TEXT_RATIO:
                continue
            keep(('text', rec['foreground']), rec['ratio'],
                 f"`{rec['foreground']}` is at {rec['ratio']:.2f}:1 against "
                 f"{rec['ground_color']} — the {rec['site']} is all but the "
                 f"same colour as what it sits on, so the words are on the "
                 f"page and out of reach. Repaint `{rec['foreground']}`. "
                 f"This is not the theme being bold: the whole delivered "
                 f"catalogue stays above 1.78:1 at every text site.")

    # 3. Sizes under the readability floor. Judged on the resolved value,
    #    so a size an author pins in settings.conf or in one article's
    #    `style.*` is measured exactly like a theme's own.
    for name, prop in PROPERTY_REGISTRY.items():
        if prop.css != 'font-size':
            continue
        px = _absolute_size_px(resolved[name])
        if px is None or px >= READABLE_TEXT_PX:
            continue
        keep(('size', name), px,
             f"`{name}` resolves to {px:g}px, under the {READABLE_TEXT_PX:g}px "
             f"readability floor of the design — nothing in the {len(THEMES)} "
             f"delivered themes goes below it. Raise `{name}`: at this size "
             f"the text "
             f"ships, and is smaller than every piece of apparatus around it.")

    return [(key, message) for key, (_, message) in
            sorted(worst.items(), key=lambda item: item[1][0])]


def audit_resolved_theme(templates_dir, articles, sources_dir):
    """Judges the sheet the series actually composes, series then article.

    The other checks in `audit` read the source; this one reads the RESULT
    of the cascade — theme, then `templates/settings.conf`, then one
    article's `style.*` block — because that is the only place the defect
    exists. `settings.conf` naming a valid property, with a valid colour,
    that happens to be the background it will be painted on, is correct at
    every layer and unreadable once composed.

    An article is judged against its OWN sheet and reports only what the
    series sheet did not already say: a fault the series carries belongs to
    `settings.conf`, and repeating it under every article that inherits it
    would bury the one article that actually broke something.

    Stays silent when composition fails outright. A property that does not
    exist, a cycle, an unparsable colour are fatal, and the render pass has
    already put them on stderr under their own file name; a second, vaguer
    complaint here would only compete with the message that names the line.
    """
    warnings = 0

    # The layers, assembled here rather than through series_style_context():
    # that function also warns about a legacy style.css (audit_presentation
    # already reports it) and exits on a symlinked custom.css. Neither
    # belongs to a pass that measures colours, and audit must not exit.
    try:
        settings_file = _resolve_contained(templates_dir, SETTINGS_FILENAME)
        theme_key, props = (
            parse_settings_text(read_text_file(settings_file))
            if settings_file is not None and settings_file.exists()
            else (None, {}))
        layers = [theme_property_layer(theme_key)] if theme_key else []
        layers.append(props)
        series_resolved = resolve_theme_properties(*layers)
    except (PropertyError, KeyError, OSError, SystemExit):
        return 0

    series_findings = judge_resolved_theme(series_resolved)
    for _, message in series_findings:
        log('warn', f'templates/{SETTINGS_FILENAME}: {message}')
        warnings += 1

    already = {key for key, _ in series_findings}
    for entry in articles:
        source_path = _resolve_contained(sources_dir, entry['page_source'])
        if source_path is None or not source_path.exists():
            continue
        try:
            meta, _, _, _ = parse_markdown_extended(
                audit_read(source_path) or '')
            page_props = page_style_properties(meta, entry['page_source'])
            if not page_props:
                continue
            resolved = resolve_theme_properties(*layers, page_props)
        except (PropertyError, KeyError, OSError, SystemExit):
            continue
        for key, message in judge_resolved_theme(resolved):
            if key in already:
                continue
            log('warn', f'{entry["page_source"]}: {message}')
            warnings += 1

    return warnings


def cmd_audit(series_dir, args):
    """audit command — reports what is wrong with a series, and never blocks.

    Both check and audit render without writing, and the difference is what
    they do with the result: check renders to COMPARE the HTML against
    public/, audit renders to REPORT. The HTML is discarded here, no file
    is written, and the command exits 0 whatever it finds unless --strict.

    This docstring said "audit never compiles anything" for as long as that
    was true, and stayed after it stopped being -- in the function that
    implements the change. Page layout (number and position of cover
    slides, see specifications.md §22.13) remains entirely the author's
    responsibility.
    """
    _AUDIT_UNREADABLE.clear()
    sd, sources_dir, templates_dir, lang_dir, output_dir, lang, language_file = resolve_paths(series_dir, args)
    series_data = load_series_data(sd)
    default_tag_warnings = audit_series_default_tag(series_data)
    try:
        series_meta = series_meta_of(series_data)
    except SystemExit:
        raw_meta = series_data.get('series_meta', {}) if isinstance(series_data, dict) else {}
        series_meta = raw_meta if isinstance(raw_meta, dict) else {}
    articles = series_data.get('articles', series_data) if isinstance(series_data, dict) else series_data
    if args.get('--templates'):
        # `--templates` restricts audit to the
        # presentation/template layer and skips per-article editorial checks.
        articles = []
    # entry['page_dest'] below needs the resolution §20.3.1 describes
    # (derived from `page_source` when series.json omits it, the common
    # case) — without this, an entry that legitimately has no explicit
    # `page_dest` crashes audit with a raw KeyError instead of a warning.
    # Nothing is filtered out here — not drafts, not ignored articles.
    # audit is an authoring tool, and work in progress is exactly what it
    # should look at.
    validate_series(articles)
    resolve_article_fields(articles, sources_dir, series_meta, strict_tags=False)

    warnings = default_tag_warnings
    if not args.get('--templates'):
        warnings += warn_tag_visibility(series_data, entries=articles,
                                        audit=True)
    # Set when this pass has already named, article by article, something
    # that will also stop the render dead: a source that is missing, or one
    # that cannot be read as text. The render pass then keeps quiet about
    # the cause instead of counting it a second time.
    named_the_cause = False

    # An `ignored` article produces nothing and warns about nothing, so
    # every other check below stays quiet about it forever (§20.6). That
    # silence is the whole point of the status and also its one hazard —
    # an article can sit out of the chain for months while its author
    # remembers writing it. Named once, here, because audit is where
    # advice belongs and because nothing else in the tool will ever
    # mention it again.
    for entry in articles:
        if entry['status'] == 'ignored':
            progress(f"[NOTE] {entry['page_source']}: status is `ignored` — it is "
                     f"in series.json but out of the chain: never built, never "
                     f"listed, never counted.")

    for entry in articles:
        source_path = _resolve_contained(sources_dir, entry['page_source'])
        if source_path is None:
            log('error', f'{entry["page_dest"]}: page_source escapes sources/ '
                f'({sources_dir / entry["page_source"]})')
            warnings += 1
            named_the_cause = True
            continue
        if not source_path.exists():
            log('error', f'{entry["page_dest"]}: page_source not found ({source_path})')
            # Counted, or the summary contradicts the line above it -- the
            # exact defect the fatal-render finding was written to kill,
            # still alive twenty lines higher in the same function. It was
            # reachable through an `ignored` article, whose missing source
            # never reaches the render either, since `ignored` is out of the
            # chain: audit printed an [ERROR], then "No warnings", and
            # `--strict` exited 0.
            warnings += 1
            named_the_cause = True
            continue

        md_text = audit_read(source_path)
        if md_text is None:
            warnings += 1
            named_the_cause = True
            continue
        # Instance tags are author interventions that survive every theme
        # change; audit enumerates them (never blocks) so an author changing
        # themes knows where to look. The visibility is what makes literals
        # in article text acceptable at all (§9).
        #
        # Scanned over the deck AND every long-form file it pulls in: the
        # census used to read page_source alone, so the file holding most of
        # the prose was the one place it never looked. `align` is in the
        # alternation for the same reason — a census that silently omits a
        # tag family is worse than no census.
        census_text = md_text
        for name in re.findall(r'^\s*article:\s*(\S+)\s*$', md_text, re.M):
            extra = _resolve_contained(sources_dir, name)
            if extra is not None and extra.exists():
                census_text += '\n' + (audit_read(extra) or '')
        instance_tags = re.findall(
            r'\{(color|font|align|sc|u|strike|mono)[:}]', census_text)
        if instance_tags:
            counts = ', '.join(f'{instance_tags.count(t)} {t}'
                               for t in sorted(set(instance_tags)))
            print(f"[NOTE] {entry['page_source']}: "
                  f"{len(instance_tags)} instance tag(s) ({counts}) — "
                  f"author interventions that survive theme changes.")
        meta, slides, has_meta_block, _ = parse_markdown_extended(md_text)
        warnings += audit_meta_keys(entry['page_source'], meta)
        warnings += audit_article_tags(entry['page_source'], meta)
        warnings += audit_slide_tags(
            entry['page_source'], slides, series_meta, lang_dir, lang,
            language_file)

        has_cover = any(s.slide_type == 'cover' for s in slides)
        if not has_cover:
            log('warn', f'{entry["page_dest"]}: no cover slide')
            warnings += 1
        elif slides[0].slide_type != 'cover':
            log('warn', f'{entry["page_dest"]}: the first slide is not a cover (found: {slides[0].slide_type})')
            warnings += 1

        for number, field, marker in unrendered_field_markup(slides):
            warnings += 1
            log('warn', f'{entry["page_source"]}: slide {number}, '
                        f'`{field}` contains {marker}, which a field does not '
                  f'render — it ships to the reader as the characters you '
                  f'typed. A field is a value; Markdown lives in the free '
                  f'text below it (§6.1).')

        warnings += audit_notes(entry, meta, series_meta, slides,
                                sources_dir)

        # §20.3.1: page_desc resolves to '' only when no description
        # exists at ANY level (series.json, meta block, cover summary) —
        # the page then ships without a <meta name="description">. Warn
        # rather than invent one from other display fields: descriptions
        # are not silently substituted across display contexts.
        if not entry.get('page_desc'):
            log('warn', f'{entry["page_dest"]}: no description anywhere '
                        f'(page_desc, meta block, or cover summary) — the page will '
                  f'have no <meta name="description">')
            warnings += 1

    warnings += audit_presentation(templates_dir)
    warnings += audit_resolved_theme(templates_dir, articles, sources_dir)

    # What only a render can say (BACKLOG B19/B24).
    #
    # Everything above reads the syntax tree. A whole class of fault is born
    # later, when the page is actually composed -- a missing language pack,
    # fields parsed on a cover and never rendered, an image escaping the
    # article directory -- and `audit` was blind to all of it while `build`
    # printed it plainly. Measured before this pass: four such warnings a
    # series can raise that audit never saw, plus one fatal (a pinned
    # property that no longer exists) it also missed.
    #
    # That mattered beyond tidiness because `--strict` is documented as a
    # CI gate: a pipeline could be green while a build of the same series
    # warned. So audit renders the series in memory, discards the HTML, and
    # keeps what the render said.
    #
    # The cost is that audit now takes about as long as a build. That is the
    # trade the owner made explicitly: a build is fast on a human scale, a
    # missed audit is not cheap.
    if not args.get('--templates'):
        warnings += audit_image_symlinks(sources_dir)
        warnings += audit_by_rendering(series_dir, args, named_the_cause)

    if warnings == 0:
        print('No warnings: all editorial conventions are respected.')
    else:
        print(f'{warnings} warning(s). Reminder: audit never blocks the build, page layout remains the author\'s responsibility.')
        # --strict: make audit fail on warnings, so a CI
        # can enforce editorial conventions. Without it, audit always exits 0.
        if args.get('--strict'):
            sys.exit(1)


# Every variable name that ever existed and no longer does, with where its
# job went. One flat table serving one audit warning: a rename that breaks
# quietly is the worst kind, and this is what makes it audible. Most
# --fact-strong-* names and --link-decoration-color survived the rewrite
# unchanged; the two that did not are listed. (An earlier version of this
# comment claimed they all survived — the silent failure the table exists
# to kill, caught in test review.)
RETIRED_VARIABLES = {
    # The skeleton's own layout width, retired when the measure became an
    # ordinary property (B13). Reachable from any author's custom.css, so
    # its absence here meant a width that silently stopped applying.
    '--content-max': '--page-content-max',
    # v0.12.0 colour-name renames (kept: an old sheet may carry them still)
    '--yellow': '--color-mark', '--dark': '--color-ink',
    '--grey': '--color-ink-quiet', '--light': '--color-page',
    '--green': '--color-affirm',
    # §9-rewrite renames: palette
    '--page': '--color-page', '--ink': '--color-ink',
    '--ink-muted': '--color-ink-quiet', '--marker': '--color-mark',
    '--accent': '--color-call (or the component axis: --footnote-call-fg, '
                '--verdict-partial-fg, --nav-btn-ring...)',
    '--positive': '--color-affirm (or --verdict-yes-fg)',
    # §9-rewrite: overlays dissolved into component properties
    '--rule': 'per-component: --slide-rule-fg, --footer-rule-fg, '
              '--table-rule-fg...',
    '--rule-strong': 'per-component: --quote-rule-fg, --card-rule-fg, '
                     '--nav-btn-rule-fg...',
    '--surface': 'per-component: --fact-bg, --article-bg, --card-bg...',
    '--sunken': 'per-component: --code-bg, --table-head-bg...',
    '--cover-bg': '--cover-bg-from / --cover-bg-to (a flat fill has equal '
                  'stops)',
    '--cover-fg-faint': '--cover-num-fg',
    '--control': '--nav-btn-bg', '--control-soft': '--nav-btn-bg-soft',
    '--fact-strong-highlight': '--fact-strong-bg',
    '--fact-strong-ink': '--fact-strong-fg',
}


def audit_presentation(templates_dir):
    """The presentation-layer part of audit (§11.5): warns, never blocks.

    What it looks at, in the order the templates directory gives it. A
    legacy style.css, no longer read, with the rename table for whatever
    it references. Retired variable names inside custom.css, which would
    otherwise fail silently — a var() referencing nothing paints nothing
    and says nothing. Then settings.conf, which carries three findings of
    its own: a file that cannot be read as text (counted here, already
    named on stderr by the reader that refused it, and the reason this
    function returns rather than reading on); a syntax or property error,
    reported with the build's own message and blocking nothing here; and
    a commented surface generated under a different theme than the one the
    file now declares, so an author uncommenting a line would pin a value
    from a theme they left.

    This docstring said "Three eyes" and described three of the five, so
    the two belonging to settings.conf were invisible to anyone reading
    the function's contract rather than its body. §9.4.4 counts a fourth
    eye on this surface — the resolved sheet — and that one is genuinely
    not here: audit_resolved_theme() measures colours, and this function
    stays the one that only reads files."""
    warnings = 0

    def _retired_in(text):
        return sorted({old for old in RETIRED_VARIABLES
                       if f'var({old})' in text or f'{old}:' in text},
                      key=len, reverse=True)

    legacy = templates_dir / 'style.css'
    if legacy.exists():
        warnings += 1
        log('warn', f'templates/style.css exists but is no longer read: '
                    f'the stylesheet is composed at build time. Move your values '
              f'to {SETTINGS_FILENAME}, your rules to {CUSTOM_CSS_FILENAME}, '
              f'then delete it.')
        legacy_text = audit_read(legacy)
        if legacy_text is None:
            warnings += 1
            log('warn', f'templates/style.css cannot be read as text, so '
                        f'it was not checked for retired variable names. The error '
                  f'above names the file.')
        found = _retired_in(legacy_text or '')
        if found:
            for old in found:
                print(f'          {old} -> {RETIRED_VARIABLES[old]}')

    custom_path = templates_dir / CUSTOM_CSS_FILENAME
    if custom_path.exists():
        custom_text = audit_read(custom_path)
        if custom_text is None:
            # Counted, and this is the one that mattered: the only pass that
            # used to catch an unreadable custom.css was the render, and
            # `--templates` does not render. A refused read that nothing
            # counts turns into `[ERROR]` on stderr followed by `No warnings`
            # on stdout, with `--strict` green -- the summary contradicting a
            # message two lines above it, on a series `build` refuses.
            warnings += 1
            log('warn', f'templates/{CUSTOM_CSS_FILENAME} cannot be read '
                        f'as text, so it was not checked for retired variable '
                  f'names — and the build will refuse it. The error above '
                  f'names the file.')
        found = _retired_in(custom_text or '')
        if found:
            warnings += 1
            log('warn', f'templates/{CUSTOM_CSS_FILENAME}: these variables '
                        f'no longer exist, so the declarations using them are '
                  f'silently ignored:')
            for old in found:
                print(f'          {old} -> {RETIRED_VARIABLES[old]}')

    settings_path = templates_dir / SETTINGS_FILENAME
    if settings_path.exists():
        text = audit_read(settings_path)
        if text is None:
            return warnings + 1
        try:
            declared, props = parse_settings_text(text)
        except PropertyError as exc:
            warnings += 1
            log('warn', f'templates/{SETTINGS_FILENAME}: {exc}')
        else:
            m = re.search(r'^# scaffold-for: (\S+)$', text, re.MULTILINE)
            scaffold_for = m.group(1) if m else None
            declared_name = declared or 'default'
            if scaffold_for and scaffold_for != declared_name:
                warnings += 1
                log('warn', f'templates/{SETTINGS_FILENAME}: the commented '
                            f'values were generated for theme {scaffold_for!r} but '
                      f'the file now declares {declared_name!r}. Uncommenting '
                      f'a line would pin a value from the theme you left. '
                      f'Run `lightwebpres template update --scaffold` to '
                      f'realign the commented surface, keeping every line '
                      f'you pinned.')
            try:
                layers = [theme_property_layer(declared)] if declared else []
                layers.append(props)
                resolve_theme_properties(*layers)
            except PropertyError as exc:
                warnings += 1
                log('warn', f'templates/{SETTINGS_FILENAME}: {exc}')

    return warnings


