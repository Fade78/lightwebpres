TEMPLATE_NAV_JS = r'''document.addEventListener('DOMContentLoaded', function() {
(function(){
  var slides   = Array.prototype.slice.call(document.querySelectorAll('section.slide'));
  var current  = 0;
  var isScrolling = false;
  var btnPrev    = document.getElementById('navPrev');
  var btnNext    = document.getElementById('navNext');
  var btnHome    = document.getElementById('navHome');
  var navDots    = document.querySelector('.nav-dots');

  if (navDots) {
    slides.forEach(function(s, i) {
      var a = document.createElement('a');
      a.href = '#' + (s.id || ('s'+(i+1)));
      var tagEl = s.querySelector('.slide-tag');
      var headEl = s.querySelector('h2, h1');
      a.title = tagEl ? tagEl.textContent : (headEl ? headEl.textContent : ('{{str_nav_dot_fallback}} ' + (i+1)));
      a.addEventListener('click', function(e){ e.preventDefault(); goTo(i); });
      navDots.appendChild(a);
    });
  }
  var dots = navDots ? Array.prototype.slice.call(navDots.querySelectorAll('a')) : [];

  function goTo(idx) {
    idx = Math.max(0, Math.min(slides.length - 1, idx));
    if (idx === current && isScrolling) return;
    current = idx;
    isScrolling = true;
    slides[idx].scrollIntoView({ behavior: 'smooth', block: 'start' });
    updateUI();
    setTimeout(function(){ isScrolling = false; }, 700);
  }

  function updateUI() {
    btnPrev.classList.toggle('disabled', current === 0);
    btnNext.classList.toggle('disabled', current === slides.length - 1);
    dots.forEach(function(d, i){ d.classList.toggle('active', i === current); });
  }

  btnPrev.addEventListener('click', function(){ goTo(current - 1); });
  btnNext.addEventListener('click', function(){ goTo(current + 1); });
  if (btnHome) {
    btnHome.addEventListener('click', function(){ window.location.href = 'index.html'; });
  }

  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown') {
      e.preventDefault(); goTo(current + 1);
    } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
      e.preventDefault(); goTo(current - 1);
    } else if (e.key === 'Home') {
      e.preventDefault(); window.location.href = 'index.html';
    }
  });

  function detectCurrent() {
    if (isScrolling) return;
    var scrollY = window.scrollY || window.pageYOffset;
    var winH    = window.innerHeight;
    var best    = 0;
    var bestDist = Infinity;
    slides.forEach(function(s, i) {
      var rect = s.getBoundingClientRect();
      var center = rect.top + rect.height / 2;
      var dist = Math.abs(center - winH / 2);
      if (dist < bestDist) { bestDist = dist; best = i; }
    });
    if (best !== current) { current = best; updateUI(); }
  }

  var scrollTimer = null;
  window.addEventListener('scroll', function() {
    if (scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(detectCurrent, 80);
  }, { passive: true });

  updateUI();
})();
});

document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('section.slide[id]').forEach(function (sec) {
    var id = sec.id;
    if (!/^s\d+$/.test(id) || id === 's1') return;
    var b = document.createElement('button');
    b.className = 'fiche-share';
    b.type = 'button';
    b.textContent = '{{str_copy_link}}';
    b.setAttribute('aria-label', '{{str_copy_link_aria}}');
    b.addEventListener('click', function () {
      var url = location.origin + location.pathname + '#' + id;
      var done = function () {
        b.textContent = '{{str_copy_link_done}}';
        setTimeout(function () { b.textContent = '{{str_copy_link}}'; }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done, function () { prompt('{{str_copy_prompt}}', url); });
      } else {
        prompt('{{str_copy_prompt}}', url);
      }
    });
    var h = sec.querySelector('h2');
    if (h) { sec.insertBefore(b, h); } else { sec.insertBefore(b, sec.firstChild); }
  });
});
'''

