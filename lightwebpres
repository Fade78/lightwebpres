# The four columns of a row, in reading order: what a reader meets first,
# then the working surface, then the two places a note's body can live.
THEMES_GALLERY_PANELS = (
    ('cover',   'Cover'),
    ('card',    'Card, with a note'),
    ('notes',   'Notes section'),
    ('article', 'Full article'),
)


def build_theme_preview_document(theme_key, panel='card'):
    """A complete, standalone card document for `theme_key` — the same
    parser, the same renderer and the same stylesheet a build uses.

    This is what makes the gallery's claim true. The preview used to be a
    hand-written imitation with its own .preview-* rules, and it drifted
    twice without anyone noticing: once it painted every dark theme with a
    light page's overlays, and once it laid the key figure out as a
    left-aligned row with an arrow between figure and caption — an element
    render_slide() has never emitted. A copy that has to be kept in step
    by hand will not be; running the real thing removes the question.

    Rendered inside an iframe by the caller, at the panel's real width and
    at scale 1.0 — no geometric shrink. The previous gallery rendered at
    1100px and scaled 0.34, which is fine for judging a palette and
    useless for judging a note: 14px text lands at under 5 screen pixels.
    Every glyph here is at its true size, so the rule weight, the plate
    edge and the note's own measure are all readable.

    The cost, and it should be said rather than discovered: 340px is below
    every clamp() breakpoint, so each theme shows at its NARROW-viewport
    type scale — a cover title at the 28px floor rather than the ~50px it
    reaches on a desktop. What the panel is for survives that intact:
    colour, ground, rule, and the proportion between the levels.

    `panel` selects which surface is shown:
      cover   — the cover slide, its gradient and its inverted ink
      card    — a standard card carrying a note at its foot
      notes   — the page-wide notes section of `notes-placement: page`
      article — the long-form article, which the gallery never showed
    """
    language_pack = load_language(None, 'en')
    typo_engine = TypoEngine(language_pack)
    strings = language_pack.get('strings', {})
    _, slides, _, _ = parse_markdown_extended(TEMPLATE_THEMES_GALLERY_MOCK)

    if panel == 'cover':
        body = render_slide(slides[0], 1, len(slides), typo_engine, strings)
    elif panel == 'card':
        body = render_slide(slides[1], 2, len(slides), typo_engine, strings)
    elif panel == 'notes':
        # The real object, fed the real bodies: a scope that has been
        # called once per body, so the return links are there too.
        scope = NoteScope('p', endnotes=True, deferred=True)
        for i, text in enumerate(TEMPLATE_THEMES_GALLERY_NOTE_BODIES, 1):
            scope.define(f'n{i}', apply_typo(typo_engine, text))
            scope.resolve(f'\x02n{i}\x02')
        heading = html_escape(strings.get('notes_section_title', 'Notes'))
        body = (f'<section class="slide notes-section" id="notes" '
                f'role="doc-endnotes">\n  <h2>{heading}</h2>\n'
                f'{scope.render_bodies(strings)}\n</section>')
    elif panel == 'article':
        article = convert_markdown(TEMPLATE_THEMES_GALLERY_ARTICLE,
                                   typo_engine, None, NoteScope('article'), strings)
        body = (f'<section class="slide full-article" id="s1">\n'
                f'  <span class="slide-tag">'
                f'{html_escape(strings.get("full_article_tag", "Full article"))}'
                f'</span>\n{article}\n</section>')
    else:
        raise ValueError(f'unknown preview panel: {panel!r}')

    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">'
        f'<style>{compose_stylesheet(resolve_theme_properties(theme_property_layer(theme_key)))}</style>'
        # min-height: 100vh is LEFT ALONE: 100vh resolves to the panel's
        # own height, so the section fills its window and centres in it
        # exactly as it does on a real page. Only two things are
        # overridden -- the page must not scroll inside a static panel,
        # and the slide separator would draw a second line right where the
        # panel's own border already is.
        '<style>html,body{overflow:hidden}.slide{border-bottom-width:0}</style>'
        # A section's own top rule sits at y=0 with nothing above it, so
        # the panel's rounded border clips the one line the panel is meant
        # to show. A strip of bare page above it puts the rule and the
        # plate edge both inside the window.
        + ('<style>body{padding-top:14px}</style>' if panel == 'notes' else '')
        + f'</head><body>{body}</body></html>'
    )


def cmd_themes_gallery(output_path, args):
    """themes-gallery command — generates a self-contained HTML page
    documenting every THEMES entry (§9.5), built purely from that data so
    it can never drift from what `install --theme` actually applies."""
    out = Path(output_path).resolve()

    cards = []
    for slug, theme in THEMES.items():
        facets = theme_facets(theme)
        # No variables are injected by hand: the composed sheet carries every
        # property into the preview document's own stylesheet, exactly as it
        # does for an installed series. Every bug this file has had in the
        # preview came from maintaining a second copy of that wiring.
        panels = ''.join(
            TEMPLATE_THEMES_GALLERY_PANEL.format(
                caption=caption,
                label=html_escape(theme['label'], quote=True),
                preview_doc=html_escape(
                    build_theme_preview_document(slug, panel), quote=True))
            for panel, caption in THEMES_GALLERY_PANELS
        )
        # Built from PALETTE_ROLES rather than spelled out in the
        # template, so a role can never be renamed in one place and left
        # behind in the other — which is how the swatches came to
        # announce variable names in the first place.
        swatches = ''.join(
            f'\n        <li class="swatch">'
            f'<span class="swatch-chip" style="background:{theme[role]}"></span>'
            f'<span class="swatch-text">'
            f'<div class="swatch-role">{PALETTE_ROLE_LABELS[role]}</div>'
            f'<div class="swatch-var">{PROPERTY_NAME_OF_ROLE[role]}</div>'
            f'<div class="swatch-hex">{theme[role]}</div>'
            f'</span></li>'
            for role in PALETTE_ROLES
        )
        cards.append(TEMPLATE_THEMES_GALLERY_CARD.format(
            panels=panels,
            swatches=swatches,
            fact_treatment=fact_treatment_label(theme),
            polarity=facets['polarity'],
            intensity=facets['intensity'],
            hue=facets['hue'],
            label=theme['label'],
            source=theme['source'],
            note=note_to_html(theme['note']),
            note_good_class=' theme-note--good' if theme.get('note_good') else '',
            slug=slug,
        ))

    html = TEMPLATE_THEMES_GALLERY_HEAD + ''.join(cards) + TEMPLATE_THEMES_GALLERY_FOOT
    out.write_text(html, encoding='utf-8')
    print(f'Generated: {out}')


