    # Check that install has been run
    if not (td / 'templates' / 'style.css').exists():
        print(f'[ERROR] {td} has not been installed. Run first: lightwebpres install {td}', file=sys.stderr)
        sys.exit(1)

    articles_dir = td / 'articles'

    demo_filenames = ['first.md', 'first_article.md', 'middle.md', 'middle_article.md',
                       'last.md', 'last_article.md', 'img/demo-figure.svg']
    existing = [f for f in demo_filenames if (articles_dir / f).exists()]
    if existing:
        print(f'[ERROR] {td}/articles already has demo file(s): {", ".join(existing)}. '
              f'Remove them first, or run demo in an empty series.', file=sys.stderr)
        sys.exit(1)

    # demo rewrites series.json wholesale below — never over real work
    # (the no-clobber guarantee, §11.2). Right after install the file only
    # holds scaffold boilerplate with an empty articles list; the moment
    # it lists articles, it's a series in progress and demo must refuse.
    series_file = td / 'series.json'
    if series_file.exists():
        try:
            existing_series = json.loads(read_text_file(series_file))
        except (json.JSONDecodeError, UnicodeDecodeError):
            existing_series = None
        if isinstance(existing_series, dict):
            existing_articles = existing_series.get('articles', [])
        else:
            existing_articles = existing_series if isinstance(existing_series, list) else []
        if existing_articles:
            print(f'[ERROR] {series_file} already lists {len(existing_articles)} '
                  f'article(s) — demo would overwrite it. Run demo in a fresh '
                  f'series, or remove those entries first.', file=sys.stderr)
            sys.exit(1)

    # Article 1: first — every display field set explicitly, as a
    # reference showing every one of them (§20.2/§20.3.1). Neither
    # `page_source` nor `page_dest` belong in this block: `page_source`
    # is always this file itself (nothing to say), and `page_dest` — like
    # every field below — has a sensible default (derived from
    # `page_source`) so it's left out here on purpose too, demonstrated
    # instead via series.json (see below).
    demo1 = '''<!-- lwp:meta -->
