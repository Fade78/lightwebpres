def theme_property_layer(theme_key):
    """A THEMES entry as a property layer for the engine.

    What dark_background used to switch behind the theme's back, the layer
    now says: the furniture veils invert, the cover stops inverting (its
    ground is a deeper veil of the page, its ink the pale text colour), and
    the two measured cover opacities are restated against the actual palette
    instead of assuming the default one."""
    t = THEMES[theme_key]
    dark = bool(t.get('dark_background'))
    layer = {
        'color.page': t['page'], 'color.ink': t['ink'],
        'color.ink-quiet': t['ink-muted'], 'color.mark': t['marker'],
        'color.call': t['accent'], 'color.affirm': t['positive'],
        'color.nav': t['nav'],
    }
    if dark:
        layer.update(DARK_FURNITURE_PROPS)
        layer.update({
            'cover.bg.from': '#00000073',        # rgba(0,0,0,.45) over the page
            'cover.fg': 'ink',
            'cover.summary.fg': t['ink'] + 'C7',   # the measured 0.78
            'cover.num.fg': '#FFFFFF8F',           # the measured 0.56
        })
    else:
        # The default literal assumes the default palette; restate it
        # against this theme's page so the 0.78 measurement follows.
        layer['cover.summary.fg'] = t['page'] + 'C7'

    layer['fact.strong.weight'] = t.get('fact_weight', 'bold')
    layer['fact.strong.style'] = t.get('fact_style', 'normal')
    # An entry may say `fact_highlight: None` — no ground at all, which is
    # not the same as saying nothing (the default is the mark ground). Five
    # catalogue themes use it; the first port run turned them yellow.
    highlight = t.get('fact_highlight', 'marker')
    if highlight in (None, 'transparent'):
        layer['fact.strong.bg'] = 'transparent'
        layer['fact.strong.fg'] = 'ink'
        # No ground to halo: the side padding reads as a stray space
        # before the comma that follows a **bold**, so it is zero here.
        # An author can still pin fact.strong.pad to override.
        layer['fact.strong.pad'] = '0'
    else:
        layer['fact.strong.bg'] = _ROLE_TO_COLOR[highlight]
        # Text on a bright ground takes the dark tone: page on a dark
        # theme IS the dark tone, ink on a light one.
        layer['fact.strong.fg'] = 'page' if dark else 'ink'
    if t.get('fact_decoration'):
        layer['fact.strong.decoration'] = t['fact_decoration']
        if t.get('fact_decoration_color'):
            layer['fact.strong.decoration-color'] = (
                _ROLE_TO_COLOR[t['fact_decoration_color']])

    layer.update(THEME_NOTE_PROPS.get(theme_key, {}))
    layer.update(THEME_TYPOGRAPHY.get(theme_key, {}))
    layer.update(THEME_PROPERTY_OVERRIDES.get(theme_key, {}))
    return layer


_THEME_RUNTIME_DEFAULT = 'default'
_THEME_RUNTIME_CUSTOM_VAR = re.compile(r'(?<![\w-])(--[\w-]+)\s*:')


def _theme_runtime_resolved(theme_key):
    """The catalogue layer a browser must apply for one runtime theme.

    `default` is the empty layer: it is the sheet the engine ships before a
    named palette is selected. Runtime values are resolved here, not in the
    browser, so the executable remains the single implementation of the
    typed property cascade. The page's series and article layers stay out of
    this result and are marked separately by `_theme_runtime_markup`.
    """
    layers = [] if theme_key == _THEME_RUNTIME_DEFAULT else [
        theme_property_layer(theme_key)]
    return resolve_theme_properties(*layers)


def _theme_runtime_parts(option, source):
    """Normalizes the CLI string or the JSON list into selector tokens."""
    if isinstance(option, str):
        parts = option.split(',')
    elif isinstance(option, (list, tuple)):
        parts = []
        for index, value in enumerate(option):
            if not isinstance(value, str):
                raise PropertyError(f'{source} item {index} must be a string')
            parts.extend(value.split(','))
    else:
        raise PropertyError(f'{source} must be a comma-separated string or '
                           f'a list of strings')
    parts = [part.strip() for part in parts]
    if not parts or any(not part for part in parts):
        raise PropertyError(f'{source} contains an empty theme selector')
    return parts


def _theme_runtime_selector_ids(selector, source):
    """Expands one slug, special label, or facet selector."""
    folded = selector.casefold()
    if folded == 'all':
        return list(THEMES)
    if folded == 'essential':
        return list(ESSENTIAL_THEME_IDS)
    if selector in THEMES:
        return [selector]
    if ':' not in selector:
        raise PropertyError(f'{source} contains unknown theme selector '
                           f'{selector!r}')

    name, value = selector.split(':', 1)
    name = name.strip().casefold()
    value = value.strip().casefold()
    facet = _RUNTIME_THEME_FACET_ALIASES.get(name)
    if facet is None:
        raise PropertyError(f'{source} contains unknown theme facet '
                           f'{name!r} in {selector!r}')
    if value not in FACET_VALUES[facet]:
        valid = ', '.join(FACET_VALUES[facet])
        raise PropertyError(f'{source} contains unknown {facet} value '
                           f'{value!r} in {selector!r}; valid values: {valid}')
    matches = [slug for slug, _theme, _facets in themes_matching({facet: value})]
    if not matches:
        raise PropertyError(f'{source} selector {selector!r} matched no themes')
    return matches


def _theme_runtime_ids(option, primary, source='--themes'):
    """Returns ordered runtime theme ids, primary first.

    `option` is either the CLI's comma-separated value or the root
    `series.json["themes"]` list. The effective `theme:` from settings is
    always first, even when every selector omits it; a series without that
    line uses the synthetic `default` id.
    """
    primary_id = primary or _THEME_RUNTIME_DEFAULT
    ids = [primary_id]
    for selector in _theme_runtime_parts(option, source):
        for slug in _theme_runtime_selector_ids(selector, source):
            if slug not in ids:
                ids.append(slug)
    return ids


def build_theme_runtime(option, primary, source='--themes'):
    """Builds the compact, page-independent part of the theme switch data.

    Variable names are emitted once and each alternative carries only the
    indexed values that differ from the effective primary theme. The static
    page already contains the primary theme's fully composed sheet, so the
    browser can remove the previous inline overrides and restore that sheet
    before applying another alternative.
    """
    if option is None:
        return None
    ids = _theme_runtime_ids(option, primary, source)
    variables = [p.var for p in THEME_SHARED_PROPS]
    keys = [p.key for p in THEME_SHARED_PROPS]
    for component in THEME_COMPONENTS:
        for prop in component.props:
            variables.append(prop.var)
            keys.append(prop.key)
    primary_values = _theme_runtime_resolved(primary or _THEME_RUNTIME_DEFAULT)
    primary_values = [primary_values[key] for key in keys]
    themes = []
    for theme_id in ids:
        resolved = _theme_runtime_resolved(theme_id)
        values = [resolved[key] for key in keys]
        changes = [[i, value] for i, (old, value)
                   in enumerate(zip(primary_values, values)) if old != value]
        if theme_id == _THEME_RUNTIME_DEFAULT:
            label, family = 'Default', 'default'
        else:
            theme = THEMES[theme_id]
            label, family = theme['label'], theme['family']
        themes.append({
            'slug': theme_id, 'label': label, 'family': family,
            'values': changes,
            # The picker is a small gallery, not a list of anonymous names.
            # Resolve the same cover ground and ink used by the page here so
            # the browser does not grow a second theme cascade just to paint
            # a button preview.
            'preview': {
                'background': resolved['page.bg'],
                'gradient': {
                    'angle': resolved['cover.bg.angle'],
                    'from': resolved['cover.bg.from'],
                    'to': resolved['cover.bg.to'],
                },
                'foreground': resolved['cover.fg'],
            },
        })
    return {'version': 1, 'primary': ids[0], 'vars': variables,
            'themes': themes}


def _theme_runtime_markup(runtime, style_context=None, page_props=None):
    """Adds page-owned variable indices to the runtime payload.

    The generated sheet contains the effective primary theme plus series and
    article pins. Runtime theme values must not replace those pins. Variables
    declared by custom.css are treated as pins too: arbitrary CSS stays the
    author's last word even when it uses a registry variable through a
    custom declaration.
    """
    if runtime is None:
        return ''
    pinned = set()
    if style_context is not None:
        layers, custom_css = style_context
        if layers:
            # series_style_context appends settings.conf's properties last.
            pinned.update(layers[-1])
        for var in _THEME_RUNTIME_CUSTOM_VAR.findall(custom_css):
            key = VAR_TO_KEY.get(var)
            if key:
                pinned.add(key)
    if page_props:
        pinned.update(page_props)
    indices = {p.key: i for i, p in enumerate(THEME_SHARED_PROPS)}
    for component in THEME_COMPONENTS:
        for prop in component.props:
            indices[prop.key] = len(indices)
    data = dict(runtime)
    data['pinned'] = sorted(indices[key] for key in pinned if key in indices)
    # Defense in depth: escape `<` so a `</script>` inside any JSON string
    # value can never close the script block and run as markup. The payload
    # currently carries only hardcoded catalogue strings, but this guard
    # makes that invariant explicit at the emission site rather than
    # relying on it holding forever.
    payload = json.dumps(data, ensure_ascii=True, separators=(',', ':'))
    payload = payload.replace('<', '\\u003c')
    return ('<script id="lwp-theme-data" type="application/json">' +
            payload + '</script>\n')


def _language_runtime_markup(lang_dir, default_lang, default_pack,
                            language_file=None, auto=False):
    """Embeds the interface strings needed by the browser.

    Typography rules stay build-time data. The browser only needs the two
    interface vocabularies, so a locale choice cannot accidentally re-run a
    trusted regex pack against authored content. The default pack is included
    under its requested id as well: a custom ``--lang`` such as ``de`` must
    keep its existing static-page behaviour when browser selection is locked.
    """
    packs = {}
    for code in ('fr', 'en'):
        override = language_file if code.casefold() == str(default_lang).casefold() else None
        pack = load_language(lang_dir, code, override)
        packs[code] = {
            'name': pack.get('name', code),
            'strings': pack.get('strings', {}),
        }
    default_id = str(default_lang)
    if default_id not in packs:
        packs[default_id] = {
            'name': default_pack.get('name', default_id),
            'strings': default_pack.get('strings', {}),
        }
    data = {
        'version': 1,
        'default': default_id,
        'auto': bool(auto),
        'packs': packs,
    }
    payload = json.dumps(data, ensure_ascii=True, separators=(',', ':'))
    payload = payload.replace('<', '\\u003c')
    return ('<script id="lwp-language-data" type="application/json">' +
            payload + '</script>\n')


def _reference_target(prop, value):
    """The property `value` points at, or None if it is a literal.

    The axis fixes the type, the type fixes the namespace. A bare word is
    looked up there; a dotted word is a qualified reference. That is the
    whole rule — no guessing whether a value 'looks like' a key."""
    if prop.type.is_literal(value):
        return None
    if '.' in value:
        return value                  # qualified: title1.fg, cover.bg.from
    if prop.type.namespace:
        return f'{prop.type.namespace}.{value}'
    return None


def resolve_theme_properties(*layers):
    """built-in defaults -> theme -> series settings -> article. Later wins.

    Unknown keys are errors, not silence — that is the point of typing the
    surface. References are followed here and never reach the CSS."""
    raw = {k: p.default for k, p in PROPERTY_REGISTRY.items()}
    for layer in layers:
        for key, value in layer.items():
            if key not in PROPERTY_REGISTRY:
                tail = key.split('.')[-1]
                near = [k for k in PROPERTY_REGISTRY
                        if k.split('.')[-1] == tail]
                raise PropertyError(
                    f'{key}: unknown property'
                    + (f' (did you mean {near[0]}?)' if near else ''))
            raw[key] = value

    out = {}
    for key, prop in PROPERTY_REGISTRY.items():
        value, chain = raw[key], [key]
        while True:
            target = _reference_target(prop, value)
            if target is None:
                break
            if target not in PROPERTY_REGISTRY:
                raise PropertyError(
                    f'{key}: refers to unknown property {target!r}. '
                    f'A bare word is looked up in {prop.type.namespace}.*; '
                    f'a literal {prop.type.name} does not go through the '
                    f'namespace.')
            if target in chain:
                raise PropertyError(f'{key}: reference cycle '
                                    f'{" -> ".join(chain + [target])}')
            if len(chain) - 1 >= MAX_REFERENCE_HOPS:
                raise PropertyError(
                    f'{key}: reference chain deeper than '
                    f'{MAX_REFERENCE_HOPS} hops '
                    f'({" -> ".join(chain + [target])})')
            chain.append(target)
            value = raw[target]
        out[key] = prop.type.check(key, value)
    return out


_RESOLVED_DEFAULTS = None


def _all_at_default(resolved, keys):
    """True when every one of `keys` still holds what the registry gives it.

    Against the RESOLVED defaults, not the declared ones, and that
    distinction is the whole function: `transparent` is what the registry
    writes and `#00000000` is what resolution makes of it, so comparing a
    resolved value to a declared default never matches and the caller's
    condition would silently never fire. A reference default (`call`,
    `ink`) is worse still -- it declares a name and resolves to a colour.
    Resolving the empty layer set once gives the two sides the same
    vocabulary.

    A key the registry does not know answers False, not "nothing to
    compare". Skipping it would let a mistyped or untranslatable var name
    empty the comparison, and an empty `all()` is True -- the caller would
    drop a declaration precisely when it understood the least."""
    global _RESOLVED_DEFAULTS
    if _RESOLVED_DEFAULTS is None:
        _RESOLVED_DEFAULTS = resolve_theme_properties()
    keys = list(keys)
    if not keys or any(k not in PROPERTY_REGISTRY for k in keys):
        return False
    return all(resolved.get(k) == _RESOLVED_DEFAULTS.get(k) for k in keys)


def emit_theme_css(resolved):
    """The resolved property set becomes the :root block plus the rules that
    read it. Emission is derived from the registry, so completeness is
    structural: every property is consumed by construction, and nothing a
    rule consumes escapes the registry."""
    lines = [':root {', '  /* shared */']
    for p in THEME_SHARED_PROPS:
        lines.append(f'  {p.var}: {resolved[p.key]};')
    for c in THEME_COMPONENTS:
        lines.append(f'  /* {c.key} */')
        for p in c.props:
            lines.append(f'  {p.var}: {resolved[p.key]};')
    lines.append('}')

    for c in THEME_COMPONENTS:
        # Grouped by effective selector: a component's properties may land on
        # an inner element, a context, or a state — the base selector first,
        # overrides after it in declaration order.
        groups = {}
        for comp in c.composite:
            if comp.omit_when_default and _all_at_default(resolved,
                                                          comp.reads()):
                continue
            groups.setdefault(comp.selector or c.selector, []).append(
                f'  {comp.cssprop}: {comp.value};')
        for p in c.props:
            if p.css:
                sel = p.selector or c.selector
                groups.setdefault(sel, []).append(f'  {p.css}: var({p.var});')
        for sel, decls in groups.items():
            lines += [f'{sel} {{', *decls, '}']
        mark = next((p for p in c.props if p.key.endswith('.mark')), None)
        if mark:
            lines.append(
                f'{c.selector}::before {{ content: var({mark.var}); }}')
    return '\n'.join(lines)


def compose_stylesheet(resolved):
    """The full sheet for one resolved property set: the engine's :root and
    rules first, then the static skeleton — order matters, because the
    skeleton's @media overrides must beat the engine's base values, and they
    share specificity.

    The skeleton is a literal (TEMPLATE_SKELETON), not something derived at
    build time: what a reader edits there is what a page gets. The two
    invariants extraction used to enforce dynamically — no declaration driven
    on both sides, no var() but --page-content-max — are pinned by tests."""
    return emit_theme_css(resolved) + '\n' + TEMPLATE_SKELETON


# ----------------------------------------------------------------------------
# The author's surface: templates/settings.conf (values) + custom.css (rules).
# Neither is ever written by the tool except on explicit request — that
# ownership split is what deleted the customization-marker apparatus.
# ----------------------------------------------------------------------------

SETTINGS_FILENAME = 'settings.conf'
CUSTOM_CSS_FILENAME = 'custom.css'

# Created EMPTY, and that is the whole of the decision. This file is
# concatenated verbatim into every page, so anything in it is published:
# the four lines of guidance that used to sit here -- addressed to the
# AUTHOR, about the tool's own contract -- went out in every article of
# every series, forever. `settings.conf` carries five hundred comment
# lines and none of them reach a page, because settings.conf is PARSED;
# custom.css is APPENDED, and that difference is invisible until you read
# a built page.
#
# What the guidance did is still done, where guidance belongs: `init`
# prints "custom.css (your own rules)" as it creates the file, and the
# guide says the rest. The file exists to be found in a listing and
# opened; it does not exist to explain itself to a reader who never
# asked.
CUSTOM_CSS_STUB = ''


def parse_settings_text(text, source='settings.conf'):
    """(theme_slug_or_None, {property: raw value}) from an author's settings
    file. `key: value` lines, `#` comments, nothing else — a file that looks
    like properties and silently accepted CSS would be the old surface back.
    Errors name their line: the silent no-op is the failure mode this whole
    format exists to kill."""
    theme = None
    props = {}
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        if ':' not in line:
            raise PropertyError(
                f'{source}:{lineno}: not a `key: value` line: {line!r}. '
                f'CSS rules belong in {CUSTOM_CSS_FILENAME}.')
        key, value = line.split(':', 1)
        key, value = key.strip(), value.strip()
        if key == 'theme':
            if value not in THEMES:
                raise PropertyError(
                    f'{source}:{lineno}: unknown theme {value!r}. '
                    f'Run `lightwebpres theme list` for the list.')
            theme = value
        else:
            props[key] = value
    return theme, props


def build_settings_scaffold(theme_key=None, pinned=None):
    """The complete settings file, every property present and commented out
    at its value under the chosen theme. Complete outside, always: the
    author sees the whole surface with nothing to chase through an include,
    and uncommenting a line pins it across every future theme change.

    Generated from the registry — the same structure that emits the CSS — so
    it cannot drift from what the engine accepts. Values are shown RAW
    (references as bare words, `kicker.fg: ink-quiet`), because that is the
    vocabulary the author writes.

    `pinned` (a {property: raw value} dict) regenerates in place: a pinned
    property that still exists is emitted UNCOMMENTED with the author's
    value, so a version upgrade refreshes the commented surface — new
    properties appear, gone ones vanish — without losing what the author
    set. A pinned property the registry no longer knows is preserved,
    commented, in a trailing section so it is neither silently dropped nor
    left to break the build."""
    pinned = pinned or {}
    raw = {k: p.default for k, p in PROPERTY_REGISTRY.items()}
    if theme_key:
        raw.update(theme_property_layer(theme_key))

    def emit(prop_key):
        if prop_key in pinned:
            return f'{prop_key}: {pinned[prop_key]}'
        return f'# {prop_key}: {raw[prop_key]}'

    lines = [
        '# lightwebpres settings — plain `key: value` properties, one per line.',
        '# lightwebpres never writes this file (`series theme set` rewrites',
        '# only the theme line below, `template update --scaffold` refreshes',
        '# the commented surface and keeps your uncommented lines). Uncomment',
        '# a line to pin it: it survives every theme change and every upgrade.',
        f'# CSS rules belong in {CUSTOM_CSS_FILENAME}.',
        '',
        f'theme: {theme_key}' if theme_key else '# theme: <slug>   (default theme)',
        f'# scaffold-for: {theme_key or "default"}',
        '',
        '# ── shared values ──',
    ]
    for p in THEME_SHARED_PROPS:
        lines.append(emit(p.key))
    for c in THEME_COMPONENTS:
        lines.append('')
        lines.append(f'# ── {c.key} ──')
        for p in c.props:
            lines.append(emit(p.key))

    unknown = [k for k in pinned if k not in PROPERTY_REGISTRY]
    if unknown:
        lines.append('')
        lines.append(SETTINGS_RETIRED_MARKER)
        for k in unknown:
            lines.append(f'# {k}: {pinned[k]}')
    return '\n'.join(lines) + '\n'


SETTINGS_RETIRED_MARKER = ('# ── no longer recognized (kept for reference; '
                           'a build would reject these) ──')


def pinned_settings(text):
    """Everything a scaffold regeneration must carry across: the author's
    uncommented `key: value` pins (excluding `theme:`), AND the commented
    entries already parked under the retired marker — so a property the
    registry dropped survives a SECOND regeneration too. Without the
    latter, a retired pin was preserved once, then silently lost on the
    next run because a comment is indistinguishable from scaffold text —
    exactly the quiet data loss this project refuses."""
    pins = {}
    in_retired = False
    for raw in text.splitlines():
        line = raw.strip()
        if line == SETTINGS_RETIRED_MARKER:
            in_retired = True
            continue
        # Under the retired marker, an entry is commented; elsewhere a pin
        # is an uncommented line. `theme:` is never a pin.
        source = line[1:].strip() if (in_retired and line.startswith('#')) else line
        if in_retired and not line.startswith('#'):
            continue
        if not source or (not in_retired and line.startswith('#')) or ':' not in source:
            continue
        key, value = source.split(':', 1)
        key = key.strip()
        if key != 'theme':
            pins[key] = value.strip()
    return pins


def series_style_context(templates_dir):
    """(layers, custom_css_text) for one series: the resolved-once part of
    composition, so a page carrying its own style.* properties can be
    recomposed without re-reading anything."""
    # Realpath containment, the same guard sources/img/ and the `article:`
    # field already carry. Both files are read and shipped -- custom.css
    # verbatim into every page's <style> -- so a symlink here turns a build
    # into a read primitive on anything the build user can open: a CI env
    # file, an ssh key, .git-credentials.
    settings_file = _resolve_contained(templates_dir, SETTINGS_FILENAME)
    theme_key, props = (parse_settings_text(read_text_file(settings_file))
                        if settings_file is not None and settings_file.exists()
                        else (None, {}))

    legacy = templates_dir / 'style.css'
    if legacy.exists():
        log('warn', f'templates/style.css is no longer read: the stylesheet '
              f'is composed from {SETTINGS_FILENAME}. Move your values there '
              f'(audit names the variable renames) and delete it.')

    layers = [theme_property_layer(theme_key)] if theme_key else []
    layers.append(props)

    custom_file = _resolve_contained(templates_dir, CUSTOM_CSS_FILENAME)
    if custom_file is None and (templates_dir / CUSTOM_CSS_FILENAME).exists():
        log('error', f'templates/{CUSTOM_CSS_FILENAME} resolves outside '
              f'templates/ (symlink); its contents would be published '
              f'verbatim into every page.')
        sys.exit(1)
    custom = (read_text_file(custom_file)
              if custom_file is not None and custom_file.exists() else '')
    return layers, custom


def compose_with(style_context, page_props=None):
    """The CSS for one page: series layers, then the page's own properties
    (the article layer of the cascade), then the author's custom.css last so
    their rules win every same-specificity fight."""
    layers, custom = style_context
    if page_props:
        layers = [*layers, page_props]
    css = compose_stylesheet(resolve_theme_properties(*layers))
    if custom:
        css += '\n' + custom
    return css


def page_style_properties(meta, source_name):
    """The article layer: every `style.<property>` key of an lwp:meta block,
    stripped of its prefix. `style.verdict.partial.fg: #8a4b00` restyles one
    page without touching the series — same vocabulary, same types, same
    errors as settings.conf, named with the file they came from."""
    props = {}
    for key, value in meta.items():
        if key.startswith('style.'):
            prop = key[len('style.'):].strip()
            if not prop:
                raise PropertyError(f'{source_name}: empty style.* key')
            props[prop] = value
    return props


# ----------------------------------------------------------------------------
# Contrast measurement (§11.9.1): what the composed sheet actually puts on
# top of what.
#
# The accessibility level of a theme is COMPUTED, never declared. A label
# written into a THEMES entry would be right on the day it was typed and
# silent about every palette tweak afterwards, because nothing connects it
# to the colour it claims to qualify. So the numbers come through the same
# path as the rest of the engine — resolved properties, composited grounds.
#
# Two rules govern everything below, and both were learned the hard way in
# the test suite:
#
#   - Only real pairs. A sweep of every colour against every other colour
#     produces failures nobody can act on, for pairs the page never puts
#     together. A site names a foreground property, the STACK of background
#     properties under it, and where in the page that happens.
#   - Composite at 8 bits. A veil is painted source-over and the result is
#     quantised to 8-bit channels, because the screen has nowhere to keep
#     the fraction. Carried at full float precision, one focus ring in the
#     catalogue measures 3.0009:1 and passes; at the precision a reader
#     actually gets it measures 2.9970:1 and does not.
#
# The DOM containment is declared, not derived: which ground a component
# sits on is a fact about the page templates and the skeleton, and no
# amount of reading the registry recovers it. What IS derived is everything
# the registry does know — the colours, the type sizes and weights that
# decide the WCAG category, and (through CONTRAST_UNMEASURED below) the
# guarantee that no colour property is silently left out.
# ----------------------------------------------------------------------------

# WCAG 2.x, the three categories §11.9.1 reports. Large text is >= 24px, or
# >= 18.66px when bold. Non-text carrying information (SC 1.4.11) has one
# bar and no AAA level in the standard, so it is reported pass/fail rather
# than graded on a scale the standard does not define.
CONTRAST_LEVELS = {
    'body_text':  {'aa': 4.5, 'aaa': 7.0},
    'large_text': {'aa': 3.0, 'aaa': 4.5},
    'non_text':   {'aa': 3.0, 'aaa': None},
}
LARGE_TEXT_PX = 24.0
LARGE_TEXT_BOLD_PX = 18.66


def _rgba8(value):
    """An engine colour (#RRGGBBAA, or #RRGGBB) as four 0-255 channels."""
    h = value.lstrip('#')
    if len(h) == 6:
        h += 'FF'
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4, 6))


def composite_over(value, ground):
    """`value` painted source-over an opaque `ground`, quantised to 8 bits.

    What a browser does, at the precision a browser keeps. The rounding is
    not a detail: it is the difference between a ring that clears 3:1 and
    one that does not."""
    r, g, b, a = _rgba8(value)
    alpha = a / 255
    return tuple(round(c * alpha + ground[i] * (1 - alpha))
                 for i, c in enumerate((r, g, b)))


def relative_luminance(rgb):
    """WCAG relative luminance of an opaque sRGB triple."""
    def channel(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (channel(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_ratio(rgb_a, rgb_b):
    """WCAG contrast ratio between two opaque sRGB triples."""
    la, lb = relative_luminance(rgb_a), relative_luminance(rgb_b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)


def _hex6(rgb):
    return '#%02X%02X%02X' % tuple(rgb)


# The page's own canvas. `page.bg` may carry an alpha, and what shows
# through is the browser's white canvas, not nothing.
CANVAS = (255, 255, 255)


def ground_colour(resolved, stack):
    """The opaque colour under `stack`, page first then each veil in DOM
    order. `()` is the page itself."""
    ground = composite_over(resolved['page.bg'], CANVAS)
    for key in stack:
        ground = composite_over(resolved[key], ground)
    return ground


def length_px(value, base):
    """A resolved length in CSS pixels, or None when it cannot be one.

    `clamp(a, b, c)` takes `a`: the smallest size the rule can render is
    the one the category has to be decided on. `em` resolves against
    `base`, which a site states because the inherited size is a fact about
    the templates rather than about the registry."""
    value = value.strip()
    inner = re.match(r'^(?:clamp|min|max)\(\s*([^,()]+)\s*,', value)
    if inner:
        return length_px(inner.group(1), base)
    m = re.match(r'^(-?[\d.]+)(px|rem|em|pt)?$', value)
    if not m:
        return None
    number = float(m.group(1))
    unit = m.group(2) or 'px'
    return {'px': number, 'pt': number * 4 / 3,
            'rem': number * 16, 'em': number * base}[unit]


class ContrastSite:
    """One place the composed sheet lands ink (or a rule) on a ground.

    `fg` is a property key; `grounds` is a list of background stacks the
    same foreground can land on — a fact box, the article, the notes
    section. `size`/`weight` name the registry properties that govern this
    text, so the WCAG category follows the theme's own values instead of a
    constant written here: a theme that enlarges its summary gets its
    summary judged as large text, with nothing to remember to update.

    `base` is the inherited size in px, for the sites whose size comes
    from the skeleton rather than from a property, and for resolving `em`.
    `unless` switches the site off when a property says the treatment is
    not painted at all (an underline that is `none`)."""

    def __init__(self, where, fg, grounds, size=None, base=16.0, weight=None,
                 kind='text', unless=None):
        self.where = where
        self.fg = fg
        self.grounds = tuple(grounds)
        self.size = size
        self.base = base
        self.weight = weight
        self.kind = kind
        self.unless = unless          # (property, value) that switches it off

    def category(self, resolved):
        """`non_text`, or the WCAG text category this site's own type
        size and weight put it in."""
        if self.kind != 'text':
            return 'non_text'
        px = self.base
        if self.size:
            measured = length_px(resolved[self.size], self.base)
            if measured is not None:
                px = measured
        bold = (self.weight == 'bold'
                or (self.weight is not None and self.weight != 'normal'
                    and resolved.get(self.weight) == 'bold'))
        if px >= LARGE_TEXT_PX or (bold and px >= LARGE_TEXT_BOLD_PX):
            return 'large_text'
        return 'body_text'


