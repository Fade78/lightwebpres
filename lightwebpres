# THEMES / SET-THEME COMMANDS
# ============================================================================

def _facet_filters(args):
    """Reads one option per entry in FACET_VALUES out of the parsed CLI
    options, rejecting an unknown value by name rather than silently
    returning an empty list (which would read as "no theme is like that").

    Generic over FACET_VALUES on purpose: adding a facet there gives it a
    working `--facet` filter with nothing to wire here."""
    filters = {}
    for facet in FACET_VALUES:
        value = args.get(f'--{facet}')
        if value is not None and value not in FACET_VALUES[facet]:
            log('error', f'Unknown --{facet}: {value!r}. Valid values: '
                  f'{", ".join(FACET_VALUES[facet])}')
            sys.exit(1)
        filters[facet] = value
    return filters


def cmd_themes(args):
    """themes command (§11.9) — lists the built-in themes, optionally
    narrowed by facet, so a theme can be chosen from the terminal instead
    of only from the generated gallery page. Prints slugs, because a slug
    is what `init --theme` and `series theme set` take."""
    import textwrap

    filters = _facet_filters(args)
    matches = themes_matching(filters)
    active = ' '.join(f'--{k} {v}' for k, v in filters.items() if v)

    if not matches:
        # Not an error: an empty result to a legitimate question. Name
        # the combination that came up empty rather than printing nothing
        # and letting the reader wonder whether the command ran.
        print(f'No theme matches {active}.')
        print(f'Drop a filter, or run `lightwebpres theme list` for all {len(THEMES)}.')
        return

    if active:
        print(f'{len(matches)} of {len(THEMES)} themes match {active}:')
    else:
        print(f'{len(THEMES)} built-in themes:')
    print()

    for slug, theme, facets in matches:
        pair = '/'.join((facets['polarity'], facets['hue']))
        fam = facets['family'] or '?'
        print(f'  {slug}  [{pair}]  {fam}')
        # A note is stored as plain text, so it prints as-is. It used to
        # be stored as gallery HTML and cleaned here, which leaked every
        # character entity to the terminal — cleaning enumerates what it
        # already knows about, so the next markup added would have leaked
        # too. The conversion now lives at the one place that needs
        # markup (§9.5.4).
        for line in textwrap.wrap(f'{theme["label"]} — {theme["note"]}', width=_TERM_WIDTH - 4):
            print(f'      {line}')
        print()

    # Derived from FACET_VALUES, never restated. The line said
    # "polarity, intensity, hue" while a fourth facet was already
    # filterable -- the shape of drift this project keeps finding, and it
    # takes one line of the table's own data to make it impossible.
    print('Facets: ' + ', '.join(
        f'{name} ({"/".join(values)})' if len(values) <= 3 else name
        for name, values in FACET_VALUES.items()) + '.')
    print('Narrow the list with, for example:')
    print('  lightwebpres theme list --polarity dark --family light')
    print('Read one out — palette, fonts, and the contrast level it')
    print('reaches, measured — with `lightwebpres theme show <slug>`.')
    print('Apply one with `init --theme <slug>` (new series) or')
    print('`series theme set --theme <slug>` (existing one); see them rendered with')
    print('`lightwebpres theme gallery`.')


# The JSON key names are a contract with `lightwebpres-gui` (§1.2,
# §11.9.1): renaming one breaks the GUI's theme picker and nothing here
# goes red. The version in the string is what lets the GUI tell an old
# executable from a new one instead of guessing from the keys it finds.
# Bumped to /2 when `family` joined the facets. An added key is a
# contract change: a consumer that switches on the facet set -- the GUI's
# theme picker does -- is entitled to learn from this string that the set
# grew, rather than discovering it by rendering an empty column.
THEME_INFO_SCHEMA = 'lightwebpres.theme-info/4'

# The three WCAG categories, in the order the output shows them, with the
# heading each gets in the text format.
THEME_INFO_CATEGORIES = (
    ('body_text', 'Body text'),
    ('large_text', 'Large text'),
    ('non_text', 'Non-text'),
)


def _ground_label(stack):
    """A ground stack read outside-in, the way a reader meets it."""
    return ' over '.join([*reversed(stack), 'page.bg'])


def _theme_info_facets(kind, slug, resolved):
    """The facets (§9.5.2) of what was asked about.

    For a slug this is `theme_facets()` verbatim, so `themes`, the gallery
    and this command cannot disagree about the same entry. For a series
    the answer is about the EFFECTIVE theme, so polarity and hue are
    recomputed from the page a build would actually paint — pinning a dark
    `color.page` onto a light theme changes both. Family is declared and
    not derivable from anything (§9.5.2), so it stays the theme's own
    word, and is null when no theme is named."""
    if kind == 'theme':
        return theme_facets(THEMES[slug])
    page = composite_over(resolved['page.bg'], CANVAS)
    ink = composite_over(resolved['page.fg'], page)
    return {
        'polarity': ('dark' if relative_luminance(ink) > relative_luminance(page)
                     else 'light'),
        'hue': theme_hue_family({'page': _hex6(page)}),
        'family': THEMES[slug]['family'] if slug else None,
    }


def theme_info_report(kind, slug, directory, layers, pinned=(), custom_css=False):
    """Everything `theme-info` knows about one theme, as the structure
    `--format json` prints and the text format reads out.

    The palette and the font stacks are taken from the shared properties
    the registry declares, not from a list written here, so a seventh
    shared value would appear the day it exists."""
    resolved = resolve_theme_properties(*layers)
    entry = THEMES[slug] if slug else None
    return {
        'schema': THEME_INFO_SCHEMA,
        'lightwebpres_version': VERSION,
        'target': {
            'kind': kind,
            'theme': slug,
            'directory': directory,
            'pinned': list(pinned),
            'custom_css': custom_css,
        },
        'label': entry['label'] if entry else None,
        'note': entry['note'] if entry else None,
        'source': entry.get('source') if entry else None,
        'facets': _theme_info_facets(kind, slug, resolved),
        'palette': {p.key[len('color.'):]: resolved[p.key]
                    for p in THEME_SHARED_PROPS if p.key.startswith('color.')},
        'fonts': {p.key[len('font.'):]: resolved[p.key]
                  for p in THEME_SHARED_PROPS if p.key.startswith('font.')},
        'accessibility': measure_contrast(resolved),
    }


def print_theme_info_text(report):
    """The human format. It does not also try to be valid YAML: serving
    two masters would make it less readable than one and less reliable
    than the other, and `--format json` is the machine answer."""
    import textwrap

    target = report['target']
    facets = report['facets']
    # The measured pair inside the brackets, the declared family after
    # them -- the same shape `theme list` prints. Family went inside the
    # brackets for one commit and read as `[dark/red/light]`, where the
    # last word is the family `light` and every reader takes it for the
    # polarity it directly contradicts.
    measured = '/'.join(str(facets[name]) if facets[name] else '?'
                        for name in ('polarity', 'hue'))
    family = facets['family'] or '?'

    if target['kind'] == 'theme':
        print(f"Theme: {target['theme']}  [{measured}]  {family}")
        print(f"  {report['label']}")
        for line in textwrap.wrap(report['note'], width=_TERM_WIDTH - 4):
            print(f'  {line}')
    else:
        print(f"Series: {target['directory']}")
        print(f"  effective theme: "
              f"{target['theme'] or 'none (the built-in defaults)'}  "
              f"[{measured}]  {family}")
        if target['pinned']:
            print(f"  pinned in templates/{SETTINGS_FILENAME} "
                  f"({len(target['pinned'])}), and measured below:")
            for line in textwrap.wrap(', '.join(target['pinned']), width=_TERM_WIDTH - 4,
                                      break_on_hyphens=False):
                print(f'    {line}')
        else:
            print(f'  nothing pinned in templates/{SETTINGS_FILENAME}: this is '
                  f'the theme as shipped')
        if target['custom_css']:
            print(f'  templates/{CUSTOM_CSS_FILENAME} exists and is NOT '
                  f'measured — it is free')
            print('  CSS, outside the typed surface the engine can resolve.')

    print()
    print('Palette')
    for role, value in report['palette'].items():
        print(f'  {role:<10s} {value}')
    print()
    print('Fonts')
    for role, value in report['fonts'].items():
        print(f'  {role:<10s} {value}')

    print()
    print('Contrast, measured through the property registry (WCAG 2.x)')
    for name, title in THEME_INFO_CATEGORIES:
        category = report['accessibility'][name]
        worst = category['worst']
        bars = f"AA {category['threshold_aa']}:1"
        bars += (f", AAA {category['threshold_aaa']}:1"
                 if category['threshold_aaa'] is not None
                 else ', no AAA level in the standard')
        print()
        print(f"  {title:<11s} {category['level']:<4s}  "
              f"{category['pairs_measured']} pairs measured — {bars}")
        # Ratios are printed to four places and compared unrounded: 2.9970
        # rounds to 3.00 without ever reaching 3, and "3.00 is not 3.00" is
        # not a failure message anyone can act on.
        if category['failures']:
            # The worst pair IS the first failure, so it is not printed
            # twice: what a failing category owes the reader is the list.
            print(f"    {len(category['failures'])} pair(s) below "
                  f"{category['threshold_aa']}:1, worst first:")
            for pair in category['failures']:
                print(f"      {pair['ratio']:7.4f}:1  {pair['site']}")
                print(f"        {pair['foreground']} {pair['foreground_color']} "
                      f"on {_ground_label(pair['ground'])} {pair['ground_color']}")
        else:
            # Nothing to fix, so the one thing worth naming is the pair
            # that decides the level — at AA, the pair to move for AAA.
            print(f"    worst {worst['ratio']:.4f}:1  {worst['site']}")
            print(f"      {worst['foreground']} {worst['foreground_color']} on "
                  f"{_ground_label(worst['ground'])} {worst['ground_color']}")

    print()
    print('The level is computed from the resolved properties and the grounds')
    print('they are composited on — never declared in a theme. It is author')
    print('information only: no built page mentions it.')


def cmd_theme_info(positional, args):
    """theme show <slug> [<slug>…] [--all] — describes one or more built-in
    themes without installing anything (§11.9.1).

    The directory branch of the old `theme-info` is now `series theme [dir]`
    (cmd_series_theme). This command handles only built-in slugs: one, many
    (compared in the order given), or --all (every built-in theme)."""
    fmt = args.get('--format', 'text')
    if fmt not in ('text', 'json'):
        log('error', f'Unknown --format: {fmt!r}. Valid values: text, json')
        sys.exit(1)

    # Resolve the slug list: --all, or the positionals, or (legacy alias
    # compat) a single argument that might be a directory.
    if args.get('--all'):
        slugs = list(THEMES.keys())
    elif positional:
        slugs = positional
    else:
        # No positional and no --all: show usage. The old `theme-info`
        # with no arg was an error; with the new split, `theme show` needs
        # at least one slug or --all.
        log('error', '`theme show` needs at least one slug (or --all). '
              'To read the effective theme of a series, run it from inside '
              'the series, or `series theme <dir>`.')
        sys.exit(1)

    # Validate slugs: every one must be a built-in theme. A directory is no
    # longer accepted here (that's `series theme`).
    unknown = [s for s in slugs if s not in THEMES]
    if unknown:
        import textwrap
        for s in unknown:
            log('error', f'{s!r} is not a built-in theme.')
        log('error', f'The {len(THEMES)} valid slugs are:')
        for line in textwrap.wrap('  '.join(THEMES), width=_TERM_WIDTH - 4,
                                  break_on_hyphens=False):
            log('error', f'  {line}')
        sys.exit(1)

    reports = []
    for slug in slugs:
        reports.append(theme_info_report('theme', slug, None,
                                         [theme_property_layer(slug)]))

    if fmt == 'json':
        # JSON: a list when more than one, a single object when exactly one
        # (the old form, kept for script compat).
        if len(reports) == 1:
            print(json.dumps(reports[0], indent=2, ensure_ascii=False,
                             sort_keys=False))
        else:
            print(json.dumps(reports, indent=2, ensure_ascii=False,
                             sort_keys=False))
    else:
        for i, report in enumerate(reports):
            if i > 0:
                print()
            print_theme_info_text(report)


SERIES_SLUG_SCHEMA = 'lightwebpres.series-slug/1'

# The separator the parser splits on, so the writer below cuts a file
# exactly where the reader does. Two rules would eventually disagree, and
# the disagreement would be a slug written into the wrong card.
_SLIDE_SPLIT_RE = re.compile(r'\n---\n')
_SLIDE_MARKER_RE = re.compile(r'\A\s*<!--\s*lwp:slide(?::[^>]*)?\s*-->\s*$',
                              re.M)


def _split_article_parts(text):
    """(head, parts) — the meta block as written, then one string per
    card, using the parser's own separator.

    The head is returned verbatim rather than re-serialised: this
    function exists to put ONE line into someone's file, and a writer
    that reformats what it did not come for is a writer nobody trusts
    twice."""
    marker = re.search(r'<!--\s*lwp:meta\s*-->', text)
    terminator = (re.search(r'(?:^|\n)---', text[marker.end():])
                  if marker else None)
    if not terminator:
        return '', _SLIDE_SPLIT_RE.split(text)
    cut = marker.end() + terminator.end()
    return text[:cut], _SLIDE_SPLIT_RE.split(text[cut:])


def _part_with_slug(part, value):
    """`part` with a `slug:` line added, after the type marker if there is
    one and at the top otherwise.

    An unmarked part IS a standard card — that is the parser's rule, not a
    guess — so it has to be handled, and it has no marker to sit under."""
    m = _SLIDE_MARKER_RE.search(part)
    if m:
        return part[:m.end()] + f'\nslug: {value}' + part[m.end():]
    stripped = part.lstrip('\n')
    lead = part[:len(part) - len(stripped)]
    return f'{lead}slug: {value}\n{stripped}'


def _slugs_in_article(text):
    """Every card of one file, as (index into the part list, slug or '')."""
    _head, parts = _split_article_parts(text)
    out = []
    for index, part in enumerate(parts):
        if not strip_ws(part):
            continue
        found = ''
        for line in part.split('\n'):
            m = re.match(r'\A\s*slug:\s*(.*)$', line)
            if m:
                found = m.group(1).strip()
                break
        out.append((index, found))
    return out


def cmd_series_slug(series_dir, args):
    """`series slug [dir]` — every card in the series and the name it is
    published under.

    The inventory half of the identity contract (§12.1.1). `status`
    answers by ARTICLE, which is the unit series.json describes; a link
    points at a CARD, and until this command existed the only way to know
    a card's anchor was to build the page and read the HTML."""
    fmt = args.get('--format', 'text')
    if fmt not in ('text', 'json'):
        log('error', f'Unknown --format: {fmt!r}. Valid values: text, json')
        sys.exit(1)
    sd, sources_dir, _t, _o, _l, _lf, _n = resolve_paths(series_dir, args)
    series_data = load_series_data(sd)
    articles = (series_data.get('articles', series_data)
                if isinstance(series_data, dict) else series_data)
    validate_series(articles)
    report = {'schema': SERIES_SLUG_SCHEMA,
              'lightwebpres_version': VERSION,
              'target': {'kind': 'series', 'directory': str(sd)},
              'articles': []}
    for entry in articles:
        source = _resolve_contained(sources_dir, entry['page_source'])
        if source is None:
            report['articles'].append(
                {'page_source': entry['page_source'], 'source_read': False,
                 'slides': []})
            continue
        try:
            text = read_text_file(source)
        except OSError:
            report['articles'].append(
                {'page_source': entry['page_source'], 'source_read': False,
                 'slides': []})
            continue
        slides = [{'ordinal': n, 'slug': slug or None}
                  for n, (_i, slug) in enumerate(_slugs_in_article(text), 1)]
        report['articles'].append(
            {'page_source': entry['page_source'], 'source_read': True,
             'slides': slides})

    if fmt == 'json':
        print(json.dumps(report, indent=2, ensure_ascii=False))
        return
    missing = 0
    for article in report['articles']:
        print(f"\n{article['page_source']}")
        if not article['source_read']:
            print('  (could not be read)')
            continue
        for slide in article['slides']:
            if slide['slug']:
                print(f"  {slide['ordinal']:>3}  {slide['slug']}")
            else:
                missing += 1
                print(f"  {slide['ordinal']:>3}  — no slug")
    if missing:
        print(f'\n{missing} card(s) without a slug. '
              f'`lightwebpres series slug set` gives one to each.')


def cmd_assign_slug(series_dir, args):
    """`series slug set [dir]` — writes a slug into every card that has
    none.

    THE ONE COMMAND THAT EDITS AN AUTHOR'S ARTICLES. Everything else in
    this tool reads sources and writes to `public/`; `demo` creates files
    and refuses to overwrite. That is why this is a verb someone types on
    purpose and not a flag on the build: a build that rewrote its own
    inputs would surprise a read-only CI, a version-controlled tree that
    comes back dirty, and an encrypted series in the browser GUI.

    Random, not derived from the title. Once the value is in the file it
    IS the identity; deriving it would make it look as though it still
    followed the title it came from, and it does not.

    Never touches a card that already has one — including a `slug:` line
    the author left empty, which is a decision in progress, not an
    absence. `--dry-run` says what it would write and writes nothing."""
    sd, sources_dir, _t, _o, _l, _lf, _n = resolve_paths(series_dir, args)
    series_data = load_series_data(sd)
    articles = (series_data.get('articles', series_data)
                if isinstance(series_data, dict) else series_data)
    validate_series(articles)
    dry_run = bool(args.get('--dry-run'))
    written = 0
    for entry in articles:
        source = _resolve_contained(sources_dir, entry['page_source'])
        if source is None:
            log('warn', f'{sources_dir / entry["page_source"]} escapes sources/ — skipped.')
            continue
        try:
            text = read_text_file(source)
        except OSError as exc:
            log('warn', f'{source}: {exc} — skipped.')
            continue
        head, parts = _split_article_parts(text)
        present = _slugs_in_article(text)
        # Unique within the FILE, and against the skeleton's own ids: a
        # page cannot hold two things with one id, whoever minted them.
        taken = set(RESERVED_SLIDE_IDS) | {s for _i, s in present if s}
        added = 0
        for index, slug in present:
            if slug:
                continue
            value = assigned_slug(taken)
            parts[index] = _part_with_slug(parts[index], value)
            added += 1
            log('verbose', f'  {entry["page_source"]}: slide '
                           f'{index + 1} -> {value}')
        if not added:
            continue
        written += added
        if dry_run:
            log('info', f'{entry["page_source"]}: would write {added} slug(s).')
            continue
        _write_file(source, head + '\n---\n'.join(parts))
        log('info', f'{entry["page_source"]}: wrote {added} slug(s).')
    if not written:
        log('info', 'Every card already has a slug. Nothing to write.')
    elif dry_run:
        log('info', f'{written} slug(s) would be written. '
                    f'Run without --dry-run to write them.')
    else:
        log('info', f'{written} slug(s) written.')


def cmd_series_theme(series_dir, args):
    """series theme [dir] — the EFFECTIVE theme of an installed series
    (formerly `theme-info [dir]`).

    Reads the theme a series actually uses after the values it pinned in
    templates/settings.conf. This is the directory branch of the old
    `theme-info` split out as its own command, so the slug reading
    (`theme show`) and the directory reading no longer share one command
    with an ambiguous positional."""
    fmt = args.get('--format', 'text')
    if fmt not in ('text', 'json'):
        log('error', f'Unknown --format: {fmt!r}. Valid values: text, json')
        sys.exit(1)

    directory = Path(series_dir).resolve()
    templates_dir = directory / 'templates'
    if not directory.is_dir():
        log('error', f'{series_dir!r} is not a directory. '
              f'`series theme` reads the effective theme of an installed '
              f'series; to read a built-in theme, use `theme show <slug>`.')
        sys.exit(1)
    if not templates_dir.is_dir():
        log('error', f'{templates_dir} not found: {directory} is not an '
              f'installed series. Run init first.')
        sys.exit(1)

    settings_file = _resolve_contained(templates_dir, SETTINGS_FILENAME)
    text = (read_text_file(settings_file)
            if settings_file is not None and settings_file.exists() else '')
    try:
        slug, props = parse_settings_text(text)
        layers = ([theme_property_layer(slug)] if slug else []) + [props]
        custom = templates_dir / CUSTOM_CSS_FILENAME
        has_rules = custom.exists() and bool(re.sub(
            r'/\*.*?\*/', '', read_text_file(custom), flags=re.DOTALL).strip())
        report = theme_info_report(
            'series', slug, str(directory), layers, sorted(props),
            custom_css=has_rules)
    except PropertyError as exc:
        log('error', f'{exc}')
        sys.exit(1)

    if fmt == 'json':
        print(json.dumps(report, indent=2, ensure_ascii=False, sort_keys=False))
    else:
        print_theme_info_text(report)


def cmd_set_theme(target_dir, args):
    """set-theme command (§11.10) — records the theme choice by rewriting
    the ONE line of settings.conf that is the tool's to write. Everything
    the old implementation guarded against — half-recoloured files, markers
    claiming themes a file does not carry, --force — existed because the
    tool wrote into the file the author edits. It no longer does: the
    stylesheet is composed at build time, so changing theme is changing a
    word."""
    td = Path(target_dir).resolve()
    settings_path = td / 'templates' / SETTINGS_FILENAME
    new_slug = args.get('--theme')

    if new_slug is None:
        log('error', f'series theme set requires --theme <slug>. '
              f'Run `lightwebpres theme list` to list them.')
        sys.exit(1)
    if new_slug not in THEMES:
        log('error', f'Unknown theme: {new_slug!r}. '
              f'Run `lightwebpres theme list` to list the {len(THEMES)} valid slugs.')
        sys.exit(1)

    if not settings_path.parent.is_dir():
        # A directory that was never installed stays a clean error, as it
        # always was — set-theme configures a series, it does not create one.
        log('error', f'{settings_path.parent} not found. Run init first.')
        sys.exit(1)
    if not settings_path.exists():
        # Installed before the rewrite: nothing to preserve, write a fresh
        # scaffold for the chosen theme.
        _write_file(settings_path, build_settings_scaffold(new_slug))
        progress(f'Theme set: {new_slug} (fresh {SETTINGS_FILENAME} written)')
        progress('Run build again to apply the new theme.')
        return

    text = read_text_file(settings_path)
    current, _props = parse_settings_text(text)
    if current == new_slug:
        progress(f'Theme unchanged: already {new_slug}. Nothing written.')
        return

    if re.search(r'^theme:.*$', text, re.MULTILINE):
        text = re.sub(r'^theme:.*$', f'theme: {new_slug}', text,
                      count=1, flags=re.MULTILINE)
    elif re.search(r'^# theme:.*$', text, re.MULTILINE):
        # The scaffold's commented placeholder, when no theme was chosen.
        text = re.sub(r'^# theme:.*$', f'theme: {new_slug}', text,
                      count=1, flags=re.MULTILINE)
    else:
        text = f'theme: {new_slug}\n' + text
    _write_file(settings_path, text)

    progress(f'Theme changed: {current or "default"} -> {new_slug}')
    progress(f'  {settings_path}')
    progress('  Your uncommented values are untouched and still apply on top.')
    progress('  (Commented values still show the previous theme; audit notes it.)')
    progress()
    progress('Run build again to apply the new theme.')


# ============================================================================
# SERIES-INFO COMMAND (specifications.md §11.11)
# ============================================================================

# Bumped when a key changes meaning or disappears, never because one was
# added — the same promise theme-info's schema makes, so a consumer can
# test the string instead of guessing an executable's age from the keys
# it happens to find.
SERIES_INFO_SCHEMA = 'lightwebpres.series-info/2'


def series_theme(templates_dir):
    """The theme slug a build of this series would run on, or None when
    it names none — a series with no settings.conf, or one that pins
    properties without naming a theme, runs on the registry's own
    defaults (§9.3), and `null` says that better than a slug it does not
    have. Same parser as the build, so the two cannot disagree."""
    settings_file = _resolve_contained(templates_dir, SETTINGS_FILENAME)
    if settings_file is None or not settings_file.exists():
        return None
    return parse_settings_text(read_text_file(settings_file))[0]


def series_info_report(directory, series_data, articles, resolution, theme):
    """Everything `series-info` knows about one series, as `--format
    json` prints it and the text format reads out.

    Every value here comes from resolve_article_fields — the function the
    build itself calls — and every provenance from what that function
    recorded while it ran. Nothing is re-resolved: a second cascade is
    exactly what this command exists to prevent (§11.11).

    `series_meta` is reported as the file holds it, `null` for a field
    the author left out. The index's untitled fallback is deliberately
    NOT applied: it is a rendering decision, and a language-dependent one
    (§7.3), while this command takes no --lang and describes data."""
    meta = series_meta_of(series_data)
    return {
        'schema': SERIES_INFO_SCHEMA,
        'lightwebpres_version': VERSION,
        'target': {
            'kind': 'series',
            'directory': str(directory),
            'theme': theme,
        },
        'series_meta': {field: meta.get(field)
                        for field in _SERIES_META_STRING_FIELDS},
        # Three numbers because there are three degrees of participation
        # (§20.6), and they sum to the whole list — an `ignored` article is
        # still IN the series file, and a report that quietly left it out of
        # the arithmetic would make a series look smaller than it is.
        'counts': {
            status: sum(1 for entry in articles if entry['status'] == status)
            for status in ARTICLE_STATUSES
        },
        'articles': [
            {
                'page_source': entry['page_source'],
                'source_read': note['source_read'],
                'status': {'value': entry['status'],
                           'source': note['origins']['status']},
                'fields': {field: {'value': entry[field],
                                   'source': note['origins'][field]}
                           for field in _RESOLVED_FIELDS},
            }
            for entry, note in zip(articles, resolution)
        ],
    }


def print_series_info_text(report):
    """The human format. Like theme-info's, it does not also try to be a
    machine format: `--format json` is that answer."""
    import textwrap

    target = report['target']
    counts = report['counts']
    print(f"Series: {target['directory']}")
    print(f"  theme: {target['theme'] or 'none (the built-in defaults)'}")
    total = sum(counts.values())
    print(f"  {total} article(s): {counts['active']} active, "
          f"{counts['draft']} draft, {counts['ignored']} ignored")

    print()
    print('Series metadata')
    for field, value in report['series_meta'].items():
        print(f"  {field:<9s} {value if value else '(unset)'}")

    print()
    print('Articles, in series.json order — that order IS the navigation order')
    # Column width from the vocabulary itself, so a sixth provenance
    # would not silently misalign the whole listing.
    width = max(len(origin) for origin in _FIELD_ORIGINS) + 3
    for number, article in enumerate(report['articles'], 1):
        print()
        status = article['status']['value']
        mark = '' if status == 'active' else f'  [{status}]'
        print(f"  {number}. {article['page_source']} -> "
              f"{article['fields']['page_dest']['value']}{mark}")
        if not article['source_read']:
            print(f"     ! {article['page_source']} could not be read "
                  f"(absent, unreadable, or not UTF-8):")
            print("       every field below fell back to series.json "
                  "and the defaults.")
        rows = [(field, value['source'], value['value'])
                for field, value in article['fields'].items()]
        rows.append(('status', article['status']['source'], status))
        for field, source, value in rows:
            head = f"     {field:<11s} {'[' + source + ']':<{width}s} "
            body = str(value) if str(value) else '(empty)'
            for i, line in enumerate(textwrap.wrap(body, width=_TERM_WIDTH - 4)):
                print((head if i == 0 else ' ' * len(head)) + line)

    print()
    print('Each value is the one a build would use, and the bracket says which')
    print('level of the cascade it came from (§20.3.1). Nothing was built and')
    print('nothing was written.')


def cmd_series_info(series_dir, args):
    """series-info command (§11.11) — says what is in a series without
    building anything.

    A title is the result of a cascade, so reading series.json does not
    give one: a minimal entry carries `page_source` and nothing else. The
    cascade belongs to the engine, and this is how the engine hands the
    result over instead of being reached into.

    It validates nothing beyond what resolution needs: a series whose
    article file is missing is a `build` error and stays one. Here that
    article is still listed, with `source_read` false and its fields
    fallen back — a consumer asking what is in the series gets the whole
    series, plus the news that one entry could not be read, rather than
    an error and no answer at all."""
    fmt = args.get('--format', 'text')
    if fmt not in ('text', 'json'):
        log('error', f'Unknown --format: {fmt!r}. Valid values: text, json')
        sys.exit(1)

    sd, sources_dir, templates_dir, _, _, _, _ = resolve_paths(series_dir, args)
    series_data = load_series_data(sd)
    series_meta = series_meta_of(series_data)
    articles = (series_data.get('articles', series_data)
                if isinstance(series_data, dict) else series_data)
    validate_series(articles)
    # Drafts are NOT filtered out: an article kept out of the build is
    # still in the series, and a consumer must be able to show it as such
    # rather than have it vanish (§11.11).
    resolution = resolve_article_fields(articles, sources_dir, series_meta)

    try:
        theme = series_theme(templates_dir)
    except PropertyError as exc:
        log('error', f'templates/{SETTINGS_FILENAME}: {exc}')
        sys.exit(1)

    report = series_info_report(sd, series_data, articles, resolution, theme)

    # On stderr, so `--format json` stays a single JSON document on
    # stdout. Not an error: the answer for every other article is intact,
    # and this command is not a second `check`.
    for article in report['articles']:
        if not article['source_read']:
            log('warn', f'{sources_dir / article["page_source"]} could not be '
                  f'read (absent, unreadable, or not UTF-8): its fields fall '
                  f'back to series.json and the defaults.')

    if fmt == 'json':
        print(json.dumps(report, indent=2, ensure_ascii=False, sort_keys=False))
    else:
        print_series_info_text(report)


# ============================================================================
# RESOLVE COMMAND (§11.12)
# ============================================================================
#
# One name in, one answer out: what it is worth here, and which level of
# which cascade decided that. `series-info` and `theme-info` answer by
# INVENTORY — every article, every property — which is what populates an
# interface. This answers a question, and a question is not asked by
# reading two hundred lines of report.
#
# The losing levels are the feature. A value alone never explains why the
# line an author just wrote changed nothing; the chain does, by showing
# the settings.conf entry still commented out, or the series.json field
# that overrides the meta block being edited. That class of mistake
# produces no error — the mechanism worked, on an input its author had
# forgotten — so nothing but a report can catch it.

RESOLVE_SCHEMA = 'lightwebpres.resolve/1'

# Names that exist in the vocabulary but have no resolved value, and what
# to say instead. Refusing with the reason beats resolving to a lie.
_UNRESOLVABLE_NAMES = {
    'comment': ('a review note: every level parses it and no renderer '
                'ever reads it (GLOSSARY.md), so it has no resolved '
                'value. Search the sources for it instead.'),
    'tags': ('a filter vocabulary shared by an article meta block and its '
             'slide headers; ask for the article or slide source directly.'),
    'slide_title': ("not a field — a slide's own title is written `#` "
                    '(cover) or `##` (any other slide), never as a '
                    '`slide_title:` line (§22.2).'),
}

# The notes settings cascade (§6.5): the article's meta block, then the
# series-wide default in series_meta, then the built-in value. No
# per-article series.json level — unlike the display fields, these are
# not written in `articles[]`.
_NOTES_FIELD_DEFAULTS = {'notes_placement': 'local', 'notes_tooltip': 'off'}

# The typography switches (§4.5): the article's meta block and nothing
# else. A one-level cascade is still a cascade worth reporting — the
# answer "you can only set this in the meta block" is the useful half.
_TYPO_FIELD_NAMES = ('typo', 'typo_units', 'typo_thousands')

# Every name that resolves per article, whatever its own cascade — the
# display fields, the editorial three, the notes settings, the typography
# switches, plus the two that stand outside `take`: `page_source`, which
# has one level, and `status`, which `series-info` reports apart. Assembled from the
# tuples the resolvers themselves use, so a field cannot be reachable by
# one and unknown to the other.
_ARTICLE_LEVEL_NAMES = frozenset(
    _RESOLVED_FIELDS + _EDITORIAL_FIELDS + _TYPO_FIELD_NAMES
    + tuple(_NOTES_FIELD_DEFAULTS) + ('page_source', 'status',
                                      'slide_page_numbers', 'slug_prefix',
                                      'tags'))

# The complete article-level meta vocabulary, assembled from the names the
# engine actually reads rather than restated by hand -- a second list would
# be one more thing to forget. `comment` is added and is deliberately not in
# the set above: it is a review note, recognized everywhere and published
# nowhere, so nothing RESOLVES it and it must still never be reported as a
# mistake. Read by audit_meta_keys(), which is defined earlier in the file
# and resolves this at call time.
ARTICLE_META_KEYS = frozenset(_ARTICLE_LEVEL_NAMES) | {'comment'}


def _chain_link(level, value, note=None):
    """One level of a cascade, present or not. `value` is what that level
    holds AS WRITTEN — a bare reference stays a bare reference here, and
    is followed once, for the winner only."""
    link = {'level': level, 'present': bool(value),
            'value': value if value else None, 'winner': False}
    if note:
        link['note'] = note
    return link


def _crown(chain):
    """Marks the strongest present level as the winner, or the last link
    when nothing is set — the last link is always the built-in fallback,
    which is exactly what "nothing is set" resolves to."""
    for link in chain:
        if link['present']:
            link['winner'] = True
            return link
    chain[-1]['winner'] = True
    return chain[-1]


def classify_resolve_name(name):
    """Which cascade a name belongs to, from its SHAPE alone (§20.0).

    No option says which kind is meant, because the name already does:
    dotted is a theme property, snake_case an article or series field,
    kebab-case a slide field. That is the concrete payoff of the naming
    convention — a flat query namespace, with no disambiguation table to
    write and keep in step.

    Bare single words have no shape marker, so they are looked up in the
    vocabularies instead. After `comment` is excluded (above), every one
    of them belongs to exactly one level, so the lookup never has to
    choose."""
    if '.' in name:
        return 'theme-property'
    if '_' in name:
        return 'article-field'
    if '-' in name:
        return 'slide-field'
    if name in _SLIDE_FIELD_ATTRS:
        return 'slide-field'
    if name in _ARTICLE_LEVEL_NAMES or name in _SERIES_META_STRING_FIELDS:
        return 'article-field'
    return None


def resolve_theme_property(name, directory, article_meta, article_name):
    """A theme property's cascade (§9.3), strongest level first.

    The VALUE comes from resolve_theme_properties() — the function the
    build calls — so there is one cascade here and not a second one that
    drifts. What this adds is the per-level detail that function does not
    keep: which layer held what, including the layers that lost."""
    templates_dir = directory / 'templates'
    settings_file = _resolve_contained(templates_dir, SETTINGS_FILENAME)
    text = (read_text_file(settings_file)
            if settings_file is not None and settings_file.exists() else '')
    slug, pinned = parse_settings_text(text)
    theme_layer = theme_property_layer(slug) if slug else {}
    article_layer = (page_style_properties(article_meta, article_name)
                     if article_meta is not None else {})

    layers = [theme_layer, pinned] + ([article_layer] if article_meta is not None else [])
    resolved = resolve_theme_properties(*layers)   # validates the name, follows refs

    prop = PROPERTY_REGISTRY[name]
    chain = [
        _chain_link('instance', '',
                    note='per occurrence, never one value: an instance tag '
                         '(§9.6.3) styles the phrase it wraps, so no single '
                         'value could stand for the page. `audit` enumerates '
                         'them.'),
        _chain_link('article', article_layer.get(name, ''),
                    note=None if article_meta is not None else
                    'not consulted — pass --article to include a page\'s own '
                    'style.* lines'),
        _chain_link('settings', pinned.get(name, ''),
                    note=None if pinned else
                    'nothing pinned in templates/settings.conf'),
        _chain_link('theme', theme_layer.get(name, ''),
                    note=None if slug else
                    'the series names no theme, so it runs on the registry '
                    'defaults (§9.3)'),
        _chain_link('default', prop.default),
    ]
    winner = _crown(chain)

    # The written value may be a reference (§9.2). Followed once, for the
    # winner only, with the same helper the engine follows them with — so
    # the hops shown are the hops taken.
    raw = {k: p.default for k, p in PROPERTY_REGISTRY.items()}
    for layer in layers:
        raw.update(layer)
    hops, value = [], winner['value'] or prop.default
    key = name
    while True:
        target = _reference_target(prop, value)
        if target is None or target in hops:
            break
        hops.append(target)
        value = raw[target]
    return {
        'value': resolved[name],
        'source': winner['level'],
        'type': prop.type.name,
        'hops': hops,
        'chain': chain,
    }


def resolve_series_field(name, series_meta):
    """A `series_meta` field (§20.5): written once for the whole series,
    or absent. One level, and saying so is the answer."""
    chain = [_chain_link('series', series_meta.get(name, '')),
             _chain_link('default', '')]
    winner = _crown(chain)
    return {'value': winner['value'] or '', 'source': winner['level'],
            'chain': chain}


def resolve_notes_field(name, series_meta, article_meta):
    """`notes_placement` / `notes_tooltip` (§6.5). Its own cascade, and a
    shorter one than the display fields': the article's meta block, the
    series-wide default, the built-in value. Nothing in `articles[]`
    sets it."""
    chain = [
        _chain_link('article', (article_meta or {}).get(name, ''),
                    note=None if article_meta is not None else
                    'not consulted — pass --article'),
        _chain_link(_SERIES_DEFAULT_ORIGIN, series_meta.get(name, '')),
        _chain_link('default', _NOTES_FIELD_DEFAULTS[name]),
    ]
    winner = _crown(chain)
    return {'value': winner['value'], 'source': winner['level'], 'chain': chain}


def survey_slide_page_numbers(series_meta, article_meta):
    """`slide_page_numbers` (§3.3.5) for the `resolve` command. The meta
    block, the series-wide default, the built-in `off` — the CLI flag is a
    build switch, not a level this command consults."""
    chain = [
        _chain_link('article', (article_meta or {}).get('slide_page_numbers', ''),
                    note=None if article_meta is not None else
                    'not consulted — pass --article'),
        _chain_link(_SERIES_DEFAULT_ORIGIN,
                    series_meta.get('slide_page_numbers', '')),
        _chain_link('default', 'off'),
    ]
    winner = _crown(chain)
    return {'value': winner['value'], 'source': winner['level'], 'chain': chain}


def resolve_typo_field(name, article_meta):
    """A typography switch (§4.5). The meta block or nothing — and the
    useful half of the answer is that there is nowhere else to set it."""
    chain = [
        _chain_link('article', (article_meta or {}).get(name, ''),
                    note=None if article_meta is not None else
                    'not consulted — pass --article'),
        _chain_link('default', 'on',
                    note='the rule is on unless the meta block turns it off; '
                         'this field is settable in the meta block only'),
    ]
    winner = _crown(chain)
    return {'value': winner['value'], 'source': winner['level'], 'chain': chain}


def resolve_article_field(name, entry, note):
    """One display or editorial field of one article (§20.3.1), from what
    resolve_article_fields() recorded WHILE it resolved. Not re-resolved:
    a second cascade is what §11.11 exists to prevent, and the rule does
    not weaken because the question got narrower."""
    if name == 'page_source':
        # The only field with nowhere to fall back to: §20.3 requires it
        # in series.json, so it is written there or the series is invalid.
        chain = [_chain_link('series', entry['page_source'])]
        _crown(chain)
        return {'value': entry['page_source'], 'source': 'series',
                'chain': chain}

    chain = [_chain_link(level, value)
             for level, value in note['candidates'][name]]
    # `status` is the one field whose built-in fallback has a value to
    # show: every other one resolves to the empty string, and an empty
    # default link that claimed a value would be inventing one.
    chain.append(_chain_link(
        'default', DEFAULT_ARTICLE_STATUS if name == 'status' else ''))
    winner = _crown(chain)
    return {'value': entry[name], 'source': note['origins'][name], 'chain': chain}


def survey_slide_field(name, articles, sources_dir, only):
    """Where a slide-level field is actually set, across the series.

    A slide field has no cascade: it is written on a slide or it is not.
    Answering with a single value would mean inventing a winner among
    slides that never competed, so the answer is the list of sites — the
    same question ("what value, and where?") asked at the only level this
    field has."""
    attr = _SLIDE_FIELD_ATTRS[name]
    sites, unread = [], []
    for entry in articles:
        source = entry['page_source']
        if only and source != only:
            continue
        source_path = _resolve_contained(sources_dir, source)
        text = (_read_article_source(source_path)
                if source_path is not None else None)
        if text is None:
            unread.append(source)
            continue
        _, slides, _, _ = parse_markdown_extended(text)
        for number, slide in enumerate(slides, 1):
            value = getattr(slide, attr, None)
            if value:
                sites.append({
                    'article': source,
                    'slide': number,
                    'slide_type': slide.slide_type,
                    'slide_title': slide.h1 or slide.h2 or None,
                    'value': value,
                })
    return {'sites': sites}, unread


def print_resolve_text(report):
    """The human format. Strongest level first in both cascades, although
    the two are written in opposite directions elsewhere in the spec:
    someone debugging starts at the level that should have won."""
    import textwrap

    query = report['query']
    resolution = report['resolution']
    where = f" ({query['article']})" if query['article'] else ''
    print(f"{query['name']} — {query['kind'].replace('-', ' ')}{where}")

    if 'sites' in resolution:
        sites = resolution['sites']
        if not sites:
            print('  set nowhere in this series.')
            return
        print(f"  set on {len(sites)} slide(s):")
        for site in sites:
            title = f' "{site["slide_title"]}"' if site['slide_title'] else ''
            print(f"    {site['article']}  slide {site['slide']}"
                  f" ({site['slide_type']}){title}")
            for line in textwrap.wrap(str(site['value']), width=_TERM_WIDTH - 4) or ['(empty)']:
                print(f"        {line}")
        return

    print(f"  value: {resolution['value'] if resolution['value'] else '(empty)'}")
    print(f"  from:  {resolution['source']}")
    if resolution.get('hops'):
        print(f"  via:   {' -> '.join(resolution['hops'])}")
    print()
    print('  cascade, strongest first:')
    width = max(len(link['level']) for link in resolution['chain'])
    for link in resolution['chain']:
        mark = '>' if link['winner'] else ' '
        body = link['value'] if link['present'] else '—'
        print(f"  {mark} {link['level']:<{width}s}  {body}")
        if link.get('note'):
            for line in textwrap.wrap(link['note'], width=_TERM_WIDTH - 4):
                print(f"    {' ' * width}  {line}")
    print()
    print('  A level with — holds nothing; the > is the one that decided.')


def cmd_resolve(series_dir, name, args):
    """resolve command (§11.12) — what one name is worth here, and which
    level decided it.

    The shape of the name picks the cascade (§20.0), so no option has to
    say which kind of thing is being asked about. That is the convention
    paying for itself: a flat namespace with no collisions, and no
    disambiguation table to keep in step with four vocabularies."""
    fmt = args.get('--format', 'text')
    if fmt not in ('text', 'json'):
        log('error', f'Unknown --format: {fmt!r}. Valid values: text, json')
        sys.exit(1)

    if name in _UNRESOLVABLE_NAMES:
        log('error', f'{name}: {_UNRESOLVABLE_NAMES[name]}')
        sys.exit(1)

    kind = classify_resolve_name(name)
    if kind is None:
        log('error', f'{name!r}: no field or property of that name. A bare '
              f'word is looked up in the field vocabularies; a name with a '
              f'dot is a theme property, one with an underscore an article '
              f'field, one with a hyphen a slide field (§20.0).')
        sys.exit(1)

    sd, sources_dir, templates_dir, _, _, _, _ = resolve_paths(series_dir, args)
    series_data = load_series_data(sd)
    series_meta = series_meta_of(series_data)
    articles = (series_data.get('articles', series_data)
                if isinstance(series_data, dict) else series_data)
    validate_series(articles)

    only = args.get('--article')
    if only is not None and not any(e['page_source'] == only for e in articles):
        # The fix is a copy-paste, so the error hands over the strings
        # rather than pointing at the file they are in.
        log('error', f'--article {only!r}: no such article in this series. '
              f'The series carries:')
        for entry in articles:
            log('error', f'  {entry["page_source"]}')
        sys.exit(1)

    article_meta, unread = None, []
    if only is not None:
        source_path = _resolve_contained(sources_dir, only)
        text = (_read_article_source(source_path)
                if source_path is not None else None)
        if text is None:
            unread.append(only)
        else:
            article_meta, _, _, _ = parse_markdown_extended(text)
            article_meta = article_meta or {}

    try:
        if kind == 'theme-property':
            if name not in PROPERTY_REGISTRY:
                tail = name.split('.')[-1]
                near = [k for k in PROPERTY_REGISTRY if k.split('.')[-1] == tail]
                log('error', f'{name}: unknown theme property'
                      + (f' (did you mean {near[0]}?)' if near else '')
                      + '. templates/settings.conf lists every one of '
                        'them, commented out at your theme\'s values.')
                sys.exit(1)
            resolution = resolve_theme_property(name, sd, article_meta, only or name)
        elif kind == 'slide-field':
            if name not in _SLIDE_FIELD_ATTRS:
                # `comment` is a slide field and is refused above, so it
                # is not offered here: a list that named it would send
                # the reader straight into the next error.
                known = sorted(set(_SLIDE_FIELD_ATTRS) - set(_UNRESOLVABLE_NAMES))
                log('error', f'{name!r} was read as a slide field (its name is '
                      f'hyphenated, §20.0); no slide field has that name. The '
                      f'ones that resolve are: {", ".join(known)}.')
                sys.exit(1)
            resolution, unread = survey_slide_field(name, articles, sources_dir, only)
        elif name in _NOTES_FIELD_DEFAULTS:
            resolution = resolve_notes_field(name, series_meta, article_meta)
        elif name == 'slide_page_numbers':
            resolution = survey_slide_page_numbers(series_meta, article_meta)
        elif name in _TYPO_FIELD_NAMES:
            resolution = resolve_typo_field(name, article_meta)
        elif name in _SERIES_META_STRING_FIELDS and only is None:
            # `author` and `license` live at both levels. Asked WITHOUT an
            # article, the question is about the series' own value, and
            # the kind says so rather than letting a reader apply the
            # article vocabulary to a series answer.
            kind = 'series-field'
            resolution = resolve_series_field(name, series_meta)
        elif name in _ARTICLE_LEVEL_NAMES:
            if only is None:
                log('error', f'{name} is resolved per article, so `resolve` '
                      f'needs to know which one: pass --article. The series '
                      f'carries:')
                for entry in articles:
                    log('error', f'  {entry["page_source"]}')
                sys.exit(1)
            notes = resolve_article_fields(articles, sources_dir, series_meta)
            index = next(i for i, e in enumerate(articles)
                         if e['page_source'] == only)
            resolution = resolve_article_field(name, articles[index], notes[index])
        else:
            log('error', f'{name!r} was read as an article-level field (§20.0); '
                  f'no article or series field has that name.')
            sys.exit(1)
    except PropertyError as exc:
        log('error', f'{exc}')
        sys.exit(1)

    report = {
        'schema': RESOLVE_SCHEMA,
        'lightwebpres_version': VERSION,
        'query': {'name': name, 'kind': kind, 'directory': str(sd),
                  'article': only},
        'resolution': resolution,
    }

    # stderr, so `--format json` stays one JSON document on stdout, and
    # exit 0, for the reason §11.11 gives: this is not a second `check`.
    for source in unread:
        log('warn', f'{sources_dir / source} could not be read (absent, '
              f'unreadable, or not UTF-8): the levels it would have carried '
              f'are missing from the answer.')

    if fmt == 'json':
        print(json.dumps(report, indent=2, ensure_ascii=False, sort_keys=False))
    else:
        print_resolve_text(report)


# ============================================================================
# THEMES-GALLERY COMMAND
# ============================================================================

# The four columns of a row, in reading order: what a reader meets first,
# then the working surface, then the two places a note's body can live.
THEMES_GALLERY_PANELS = (
    ('cover',   'Cover'),
    ('card',    'Card, with a note'),
    ('notes',   'Notes section'),
    ('article', 'Full article'),
)


def build_theme_preview_document(theme_key, panel='card'):
    """A complete, standalone card document for `theme_key` — the same
    parser, the same renderer and the same stylesheet a build uses.

    This is what makes the gallery's claim true. The preview used to be a
    hand-written imitation with its own .preview-* rules, and it drifted
    twice without anyone noticing: once it painted every dark theme with a
    light page's overlays, and once it laid the key figure out as a
    left-aligned row with an arrow between figure and caption — an element
    render_slide() has never emitted. A copy that has to be kept in step
    by hand will not be; running the real thing removes the question.

    Rendered inside an iframe by the caller, at the panel's real width and
    at scale 1.0 — no geometric shrink. The previous gallery rendered at
    1100px and scaled 0.34, which is fine for judging a palette and
    useless for judging a note: 14px text lands at under 5 screen pixels.
    Every glyph here is at its true size, so the rule weight, the plate
    edge and the note's own measure are all readable.

    The cost, and it should be said rather than discovered: 340px is below
    every clamp() breakpoint, so each theme shows at its NARROW-viewport
    type scale — a cover title at the 28px floor rather than the ~50px it
    reaches on a desktop. What the panel is for survives that intact:
    colour, ground, rule, and the proportion between the levels.

    `panel` selects which surface is shown:
      cover   — the cover slide, its gradient and its inverted ink
      card    — a standard card carrying a note at its foot
      notes   — the page-wide notes section of `notes_placement: page`
      article — the long-form article, which the gallery never showed
    """
    language_pack = load_language(None, 'en')
    typo_engine = TypoEngine(language_pack)
    strings = language_pack.get('strings', {})
    _, slides, _, _ = parse_markdown_extended(TEMPLATE_THEMES_GALLERY_MOCK)
    # absorb-punct applies only when the mark carries a ground.
    resolved = resolve_theme_properties(theme_property_layer(theme_key))
    absorb_punct = (resolved.get('fact.strong.absorb-punct') == 'on'
                    and not resolved.get('fact.strong.bg', '').endswith('00'))

    if panel == 'cover':
        body = render_slide(slides[0], 1, len(slides), typo_engine, strings,
                            absorb_punct=absorb_punct, show_slide_num=True,
                            slide_id='preview-cover')
    elif panel == 'card':
        body = render_slide(slides[1], 2, len(slides), typo_engine, strings,
                            absorb_punct=absorb_punct, show_slide_num=True,
                            slide_id='preview-card')
    elif panel == 'notes':
        # The real object, fed the real bodies: a scope that has been
        # called once per body, so the return links are there too.
        scope = NoteScope('p', endnotes=True, deferred=True)
        for i, text in enumerate(TEMPLATE_THEMES_GALLERY_NOTE_BODIES, 1):
            scope.define(f'n{i}', apply_typo(typo_engine, text))
            scope.resolve(f'\x02n{i}\x02')
        heading = html_escape(strings.get('notes_section_title', 'Notes'))
        body = (f'<section class="slide notes-section" id="notes" '
                f'role="doc-endnotes">\n  <h2>{heading}</h2>\n'
                f'{scope.render_bodies(strings)}\n</section>')
    elif panel == 'article':
        article = convert_markdown(TEMPLATE_THEMES_GALLERY_ARTICLE,
                                   typo_engine, None, NoteScope('article'), strings)
        body = (f'<section class="slide full-article" id="s1">\n'
                f'  <span class="slide-kicker">'
                f'{html_escape(strings.get("full_article_kicker", "Full article"))}'
                f'</span>\n{article}\n</section>')
    else:
        raise ValueError(f'unknown preview panel: {panel!r}')

    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">'
        f'<style>{compose_stylesheet(resolve_theme_properties(theme_property_layer(theme_key)))}</style>'
        # min-height: 100vh is LEFT ALONE: 100vh resolves to the panel's
        # own height, so the section fills its window and centres in it
        # exactly as it does on a real page. Only two things are
        # overridden -- the page must not scroll inside a static panel,
        # and the slide separator would draw a second line right where the
        # panel's own border already is.
        '<style>html,body{overflow:hidden}.slide{border-bottom-width:0}</style>'
        # A section's own top rule sits at y=0 with nothing above it, so
        # the panel's rounded border clips the one line the panel is meant
        # to show. A strip of bare page above it puts the rule and the
        # plate edge both inside the window.
        + ('<style>body{padding-top:14px}</style>' if panel == 'notes' else '')
        + f'</head><body>{body}</body></html>'
    )


def cmd_themes_gallery(positional, args):
    """theme gallery [<slug>… | --all] [--output path] — generates a
    self-contained HTML page documenting built-in themes (§9.5), built
    purely from that data so it can never drift from what `init --theme`
    actually applies.

    Without arguments: every theme. With one or more slugs: only those.
    With --all: every theme (explicit). --output sets the file path
    (default: themes-gallery.html). Slugs inconnus → erreur fatale.

    Legacy compat: `themes-gallery [path]` (single positional that is not a
    slug) is treated as the output path, so old scripts keep working."""
    # Determine the output path first.
    if args.get('--output'):
        output_path = args['--output']
    elif positional and positional[0] not in THEMES:
        # Legacy form: a single positional that is not a slug → output path.
        output_path = positional[0]
        positional = positional[1:]
    else:
        output_path = 'themes-gallery.html'

    # Validate any remaining positionals: they must all be slugs.
    if positional:
        unknown = [p for p in positional if p not in THEMES]
        if unknown:
            import textwrap
            for s in unknown:
                log('error', f'{s!r} is not a built-in theme.')
            log('error', f'The {len(THEMES)} valid slugs are:')
            for line in textwrap.wrap('  '.join(THEMES), width=_TERM_WIDTH - 4,
                                      break_on_hyphens=False):
                log('error', f'  {line}')
            sys.exit(1)

    # Select the themes to render.
    if args.get('--all'):
        selected = list(THEMES.keys())
    elif positional:
        selected = positional
    else:
        selected = list(THEMES.keys())

    out = Path(output_path).resolve()

    cards = []
    for slug in selected:
        theme = THEMES[slug]
        facets = theme_facets(theme)
        # No variables are injected by hand: the composed sheet carries every
        # property into the preview document's own stylesheet, exactly as it
        # does for an installed series. Every bug this file has had in the
        # preview came from maintaining a second copy of that wiring.
        panels = ''.join(
            TEMPLATE_THEMES_GALLERY_PANEL.format(
                caption=caption,
                label=html_escape(theme['label'], quote=True),
                preview_doc=html_escape(
                    build_theme_preview_document(slug, panel), quote=True))
            for panel, caption in THEMES_GALLERY_PANELS
        )
        # Built from PALETTE_ROLES rather than spelled out in the
        # template, so a role can never be renamed in one place and left
        # behind in the other — which is how the swatches came to
        # announce variable names in the first place.
        swatches = ''.join(
            f'\n        <li class="swatch">'
            f'<span class="swatch-chip" style="background:{theme[role]}"></span>'
            f'<span class="swatch-text">'
            f'<div class="swatch-role">{PALETTE_ROLE_LABELS[role]}</div>'
            f'<div class="swatch-var">{PROPERTY_NAME_OF_ROLE[role]}</div>'
            f'<div class="swatch-hex">{theme[role]}</div>'
            f'</span></li>'
            for role in PALETTE_ROLES
        )
        cards.append(TEMPLATE_THEMES_GALLERY_CARD.format(
            panels=panels,
            swatches=swatches,
            fact_treatment=fact_treatment_label(theme),
            polarity=facets['polarity'],
            hue=facets['hue'],
            family=facets['family'],
            label=theme['label'],
            source=theme['source'],
            note=note_to_html(theme['note']),
            note_good_class=' theme-note--good' if theme.get('note_good') else '',
            essential_badge='<span class="theme-essential">essential</span>' if slug in ESSENTIAL_THEME_IDS else '',
            slug=slug,
        ))

    # The family buttons are generated from THEME_FAMILIES rather than
    # written into the template: a seventh family would otherwise ship
    # with no way to filter on it, which is exactly how `family` reached
    # `theme list --family` and never reached this bar.
    family_buttons = ''.join(
        f'      <button type="button" class="facet" data-facet="family"'
        f' data-value="{name}">{name}</button>\n'
        for name in THEME_FAMILIES)
    # A literal substitution, not .format(): the head carries the page's
    # whole stylesheet and every CSS brace would have to be doubled.
    html = (TEMPLATE_THEMES_GALLERY_HEAD.replace('{family_buttons}', family_buttons)
            + ''.join(cards) + TEMPLATE_THEMES_GALLERY_FOOT)
    ok, detail = validate_page_scripts(html)
    if not ok:
        log('error', 'Build aborted: themes gallery contains invalid JavaScript.\n%s'
            % (detail,))
        sys.exit(1)
    # The legacy positional accepts any non-slug word as an output path,
    # with no check that it can be written. `theme gallery <a directory>`
    # therefore reached write_text() and came back as a raw Python
    # traceback -- the only failure in this program that did, while every
    # other one emits an [ERROR] line.
    if Path(out).is_dir():
        log('error', f'{out} is a directory, not a file. `theme gallery` '
            f'writes one HTML page: give it a filename, or use --output.')
        sys.exit(1)
    try:
        _write_file(out, html)
    except OSError as exc:
        log('error', f'could not write {out}: {exc}')
        sys.exit(1)
    progress(f'Generated: {out}')


