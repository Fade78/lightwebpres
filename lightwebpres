# --- The navigation controls' icons ---
#
# One idiom for the whole column, and it took four to notice. The buttons
# were drawn as: two text glyphs (&#8593; / &#8595;), a colour emoji for
# home, two SVGs pinned at width="19", and the Latin letter L for the tag
# menu. Nothing there is a set. The text glyphs and the emoji followed
# `nav-btn.size`; the SVGs did not, so on a wide screen the button grew
# and the share icon stayed 19 pixels inside it. And the arrows read thin
# beside a 2-unit stroke because a text arrow at 20px has a stem around
# 1.3px — reported from the field as "the arrows have got thinner", which
# was true relatively even though the glyphs never changed.
#
# So: one grid (24 units), one stroke, `currentColor` so the theme paints
# every icon, and `1em` so every icon follows its holder exactly. No new
# property — the knob that sized the controls still sizes them.
#
# The emoji goes with them, and that is the one visible loss: a house
# nobody can theme was the only element of the page whose colour no
# theme could reach. With it goes `nav-btn-home`'s size compensation,
# which existed solely because the emoji read larger than the arrows at
# the same size. A shape drawn on the same grid needs no compensation;
# if it reads heavy, the path is what to change, not a global ratio.
NAV_ICON_PATHS = {
    # Chevron over a stem: the direction is in the head, and the stem is
    # what keeps it from reading as a "collapse" caret at small sizes.
    'prev': '<path d="M12 20V5"/><path d="M5 12l7-7 7 7"/>',
    'next': '<path d="M12 4v15"/><path d="M19 12l-7 7-7-7"/>',
    # A roof and a body. No door, no window: at 20px they close up.
    'home': '<path d="M3 11L12 3l9 8"/>'
            '<path d="M5.5 9.5V20h13V9.5"/>',
    'share': '<path d="M12 15V4"/><path d="M8 8l4-4 4 4"/>'
             '<path d="M5 12v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/>',
    'fullscreen': '<path d="M8 3H5a2 2 0 0 0-2 2v3"/>'
                  '<path d="M21 8V5a2 2 0 0 0-2-2h-3"/>'
                  '<path d="M3 16v3a2 2 0 0 0 2 2h3"/>'
                  '<path d="M16 21h3a2 2 0 0 0 2-2v-3"/>',
    # A luggage label with its eyelet — the metaphor the format already
    # names, since what the menu filters on is `tags:`. A funnel would
    # say the action rather than the thing, and reads as an application
    # control rather than an editorial one.
    'tags': '<path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V5'
            'a2 2 0 0 1 2-2h7a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.6z"/>'
            '<path d="M7.5 7.5h.01"/>',
    'menu': '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
    'theme': '<path d="M12 3a9 9 0 1 0 9 9c0-1.1-.9-2-2-2h-2a2 2 0 0 1-2-2V6a3 3 0 0 0-3-3z"/>'
             '<path d="M7.5 11.5h.01"/><path d="M9.5 7.5h.01"/>'
             '<path d="M14.5 7.5h.01"/>',
    'presenter': '<path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/>'
                 '<path d="M8 8h8"/><path d="M8 12h8"/><path d="M8 16h5"/>',
    'help': '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 4.5 1.5c-.8.9-2 1.1-2 2.5"/>'
            '<path d="M12 16h.01"/>',
    'pause': '<path d="M8 5v14"/><path d="M16 5v14"/>',
}


def nav_icon(name):
    """One button's icon, at the size of the button that holds it."""
    return (f'<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" '
            f'stroke="currentColor" stroke-width="2" stroke-linecap="round" '
            f'stroke-linejoin="round" aria-hidden="true">'
            f'{NAV_ICON_PATHS[name]}</svg>')


# Substituted here rather than at build time: the icons are part of the
# template, not of the page's content, and `apply_strings` escapes what it
# fills in — correctly, since it fills in translated text.
for _name in NAV_ICON_PATHS:
    TEMPLATE_PAGE = TEMPLATE_PAGE.replace('{{icon_' + _name + '}}',
                                          nav_icon(_name))

_left = [n for n in ('{{icon_', )
         if n in TEMPLATE_PAGE]
if _left:  # pragma: no cover - a typo would ship a literal placeholder
    raise PropertyError('a nav icon placeholder went unfilled')

