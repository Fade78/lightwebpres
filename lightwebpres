# --- Logging (the v0.24.0 CLI refonte) ------------------------------------
# A single log() function routes progress/diagnostic messages to stderr.
# Normal user output (the value resolve returns, the HTML build prints,
# the themes listing) stays on stdout via plain print(), so --quiet can
# silence the chatter without silencing the answer.
_LOG_STATE = {'quiet': False, 'verbose': False, 'no_color': False,
              'timestamp': False, 'dry_run': False}

# When this is a list, every warning log() emits is appended to it as well
# as printed. `audit` turns it on while it renders the series in memory, so
# that a warning raised DURING a build reaches the audit report and the
# `--strict` exit code (BACKLOG B19/B24).
#
# It hooks the funnel, not the sites, and that is the whole point. An
# enumeration of warning sites is a list that drifts: the count in the
# register had gone stale on its own, claiming ten in the build path when
# four are what a series can actually raise without audit seeing them.
# Hooking log() means a warning added tomorrow is collected tomorrow, with
# nobody having to remember this place.
_WARN_SINK = None


class collect_warnings:
    """Context manager capturing the warnings log() emits inside the block.

    Reentrancy is refused rather than nested: there is exactly one
    consumer, and an outer sink silently swallowed by an inner one would
    be the very kind of defect this mechanism exists to stop.

    `already_said` lets the consumer name what it has ALREADY reported, by
    the opening of the sentence: such a warning is neither printed nor
    collected. One mistake, one finding -- the rule judge_resolved_theme
    keeps inside a pass, broken between passes the moment audit started
    rendering. A legacy `templates/style.css` was reported by
    audit_presentation, which also names every retired variable the file
    still references, and again by the build path, whose message defers to
    that one ("audit names the variable renames") and then repeats it: two
    lines, two counts, one file, and `--strict` gates on the count.

    The declaration lives here, with the consumer, and not as a flag
    threaded down into the build: what has already been said is audit's
    business, and the build path has no business knowing that an audit is
    what is calling it."""

    def __init__(self, already_said=()):
        self.messages = []
        self.already_said = tuple(already_said)

    def __enter__(self):
        global _WARN_SINK
        if _WARN_SINK is not None:
            raise RuntimeError('collect_warnings is not reentrant')
        _WARN_SINK = self
        return self

    def __exit__(self, *exc):
        global _WARN_SINK
        _WARN_SINK = None
        return False

# ANSI escape sequences stripped from log() messages: author-controlled
# strings (filenames, titles, field values) pass through the logger, and
# must not be able to paint the operator's terminal.
_ANSI_RE = re.compile(r'\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[@-Z\\-_]')

# Terminal width for text wrapping. Initialised once at import time and
# re-read by configure_logging() (called from main()). Falls back to 80
# when not a tty (piped output, CI, non-interactive scripts).
import shutil as _shutil
_TERM_WIDTH = _shutil.get_terminal_size((80, 24)).columns


def configure_logging(quiet=False, verbose=False, no_color=False,
                      timestamp=False, dry_run=False):
    """Sets the global log level. Called once from main() after parsing."""
    _LOG_STATE['quiet'] = quiet
    _LOG_STATE['verbose'] = verbose
    _LOG_STATE['no_color'] = no_color
    _LOG_STATE['timestamp'] = timestamp
    _LOG_STATE['dry_run'] = dry_run


def log(level, msg):
    """Routes a diagnostic message to stderr.

    Levels: 'info' (progress, suppressed by --quiet, shown by default),
    'warn' (never suppressed, and collected by collect_warnings), 'verbose'
    (only with --verbose), 'error' (always shown, even by --quiet).
    Each level carries its own prefix tag so the output stays greppable.
    --timestamp prepends an RFC 3339 timestamp.

    An unknown level RAISES below. It used to be dropped silently, and
    that trap was sprung three times: a hand-written log('warning', ...)
    refused an unsafe read and told nobody. The level is spelt 'warn',
    and a misspelling now stops the run that contains it.

    Getting that spelling right now matters twice over. This text used to
    say there was no warning level and to route anything meaning one
    through 'info' with a [WARNING] tag -- advice that outlived the level
    it denied, six lines above the branch that implements it. Following it
    today produces a line that prints, that --quiet DOES silence, and that
    `audit` never counts, because the collector hooks this funnel and this
    funnel only tags 'warn'. A warning written the old way is invisible to
    the gate that exists to catch it.

    The ANSI strip below is unconditional and must stay that way. It is
    NOT the --no-color flag and must never be wired to it: author-
    controlled strings (filenames, titles, theme slugs) pass through here,
    and a hostile series must not be able to paint the operator's terminal
    or forge log lines -- least of all on the runs where --no-color
    happens to be absent. --no-color is a promise about colour this
    codebase does not emit, which is the whole reason it looks inert:
    there is nothing for it to turn off."""
    if level == 'error':
        prefix = '[ERROR] '
    elif level == 'info':
        if _LOG_STATE['quiet']:
            return
        prefix = '[INFO] '
    elif level == 'warn':
        # NEVER suppressed by --quiet. A warning is the one thing an
        # unattended run most needs to reach a human, and --quiet used to
        # be the flag that removed it: progress went out through bare
        # print() calls the flag could not see, while diagnostics came
        # through here where it could. Measured on one build: without the
        # flag, 1 warning and 645 bytes of progress; with it, 0 warnings
        # and the same 645 bytes. Exactly inverted, in the direction that
        # matters least at a terminal and most in CI.
        prefix = '[WARNING] '
        if _WARN_SINK is not None:
            if str(msg).startswith(_WARN_SINK.already_said):
                return
            _WARN_SINK.messages.append(str(msg))
    elif level == 'verbose':
        if not _LOG_STATE['verbose']:
            return
        prefix = '[DEBUG] '
    else:
        # LOUDLY, and this is the third time the silent version has cost
        # something. The docstring above has warned about the spelling
        # since the second; a warning written `log('warning', ...)`
        # printed nothing, and the person who wrote it had no way to
        # know. A trap that is only documented is a trap. The level set
        # is closed and known at authoring time, so an unknown one is a
        # typo in this file and nothing else -- there is no input that
        # can reach it, and nothing to degrade gracefully for.
        raise ValueError(
            f'log(): unknown level {level!r} — the levels are '
            f"'error', 'warn', 'info', 'verbose' (a warning is 'warn')")
    if _LOG_STATE['timestamp']:
        from datetime import datetime
        ts = datetime.now().astimezone().isoformat(timespec='seconds')
        prefix = f'{ts} {prefix}'
    # Keep the security barrier visible in this function: a static guard
    # ensures it cannot accidentally become conditional on --no-color.
    msg = _ANSI_RE.sub('', str(msg))
    msg = _sanitize_terminal_text(msg, preserve_newlines=True)
    print(prefix + msg, file=sys.stderr)


def _sanitize_terminal_text(msg, preserve_newlines=False):
    """Removes terminal control sequences from author-controlled output."""
    msg = _ANSI_RE.sub('', str(msg))
    return ''.join(
        ch if ch == '\t' or (preserve_newlines and ch == '\n')
        or ch.isprintable() else ' '
        for ch in msg)


def progress(msg=''):
    """Prints a line of progress to stdout, unless --quiet is active.

    stdout, not log()'s stderr, and that is the point of having it at all.
    Progress has always gone to stdout; moving it would change what every
    existing script and the GUI reads, to fix a flag. The defect was never
    the stream, it was that `print()` is invisible to --quiet: the flag
    could only see what came through log(), which is diagnostics, so it
    suppressed the warnings and left the progress. This puts a valve on
    the progress without moving it.

    Commands whose OUTPUT IS THE ANSWER -- resolve, theme show/list,
    series theme, status, completion -- keep bare print(). Asking for less
    chatter must never delete the value you asked the tool to compute."""
    if _LOG_STATE['quiet']:
        return
    print(_sanitize_terminal_text(msg))


# --- Write helpers --------------------------------------------------------
# Every filesystem write goes through _write_file / _mkdir / _copy / _remove
# so --dry-run can journal the action without touching the disk. A test
# guards that no bare write, create or delete call exists outside these
# helpers.
#
# _remove was added after `clean --force` was found deleting files under
# --dry-run: it called Path.unlink() directly, and the guard test's verb
# alphabet held only CREATION verbs — write_text, mkdir, shutil.copy* — so a
# command that DELETES walked through a guard built for what writes. The
# alphabet now covers the delete side, which is what makes this helper the
# only way to remove a file.
def _write_file(path, content, encoding='utf-8'):
    """Writes content to path, unless --dry-run is active (then logs only).

    Writes a sibling temporary file and renames it over the target, so a
    build that dies in the middle of a page leaves the previous page
    intact rather than a truncated one. `os.replace` is atomic within a
    filesystem, and the temporary is a sibling precisely so it is on the
    same one. A reader -- a browser on the served output, `check`, the
    next build's manifest -- never sees half a file.

    The temporary is removed if the write fails, so a crash does not
    litter the output with fragments the manifest has never heard of and
    `clean` will therefore never offer to remove."""
    if _LOG_STATE['dry_run']:
        log('info', f'would write {len(content)} bytes to {path}')
        return
    target = Path(path)
    tmp = target.with_name(target.name + f'.{os.getpid()}.tmp')
    try:
        tmp.write_text(content, encoding=encoding)
        os.replace(tmp, target)
    except OSError as exc:
        try:
            tmp.unlink()
        except OSError:
            pass
        # Re-point the error at the file the caller asked for. The
        # temporary is this helper's business; naming it in the message
        # sends the reader looking for a path that no longer exists.
        raise OSError(exc.errno, exc.strerror, str(target)) from exc
    log('verbose', f'wrote {len(content)} bytes to {path}')


def _mkdir(path, parents=False, exist_ok=False):
    """Creates a directory, unless --dry-run is active (then logs only)."""
    if _LOG_STATE['dry_run']:
        log('info', f'would mkdir {path}')
        return
    Path(path).mkdir(parents=parents, exist_ok=exist_ok)
    log('verbose', f'mkdir {path}')


def _copy(src, dst):
    """Copies a file, unless --dry-run is active (then logs only)."""
    if _LOG_STATE['dry_run']:
        log('info', f'would copy {src} -> {dst}')
        return
    shutil.copy(str(src), str(dst))
    log('verbose', f'copied {src} -> {dst}')


def _copytree(src, dst, **kwargs):
    """Copies a tree, unless --dry-run is active (then logs only).
    kwargs are forwarded to shutil.copytree (dirs_exist_ok, ignore, ...)."""
    if _LOG_STATE['dry_run']:
        log('info', f'would copytree {src} -> {dst}')
        return
    shutil.copytree(str(src), str(dst), **kwargs)
    log('verbose', f'copied tree {src} -> {dst}')


def _remove(path):
    """Deletes a file, unless --dry-run is active (then logs only).

    The only way this program is allowed to delete anything. Deletion is
    the one action no later run can undo, so it gets the same journalling
    every write gets, and the guard test refuses a bare unlink anywhere
    else."""
    if _LOG_STATE['dry_run']:
        log('info', f'would remove {path}')
        return
    Path(path).unlink()
    log('verbose', f'removed {path}')

