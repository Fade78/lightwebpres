    // which would break the equality check.
    if (pauseOverlay.classList.contains('open')
        && pauseOverlay.dataset.pauseKind === kind) {
      closePause();
    } else {
      var bg = 'black';
      if (kind === 'w') bg = 'white';
      else if (kind === 't') bg = getComputedStyle(document.body)
        .getPropertyValue('--page-bg').trim() || 'black';
      pauseOverlay.style.background = bg;
      pauseOverlay.dataset.pauseKind = kind;
      pauseOverlay.classList.add('open');
    }
  }

  // --- Click to advance, right-click to go back, middle-button fullscreen gesture ---
  // The remote-mouse use case. Left-click advances (200ms glide; a
  // click while gliding jumps straight to its target, §8.4), right-click
  // goes back the same way, the middle button arms fullscreen entry when the
  // page is not fullscreen and exits fullscreen when it is
  // (the middle WHEEL scrolls). Esc exits
  // fullscreen (native browser). Buttons, links, images, and the pause
  // overlay intercept clicks so they keep working.
  function isFullscreen() {
    return !!currentFullscreenElement();
  }
  function isInteractive(e) {
    return e.target.closest('.nav-btn, .nav-dots, a, button, img, .share-popover, .share-qr-modal, .tag-menu, .presenter-menu, .theme-menu, .nav-buttons');
  }
  // A double tap is detected from the touch events themselves (see the
  // touch section below), never from the clicks a browser synthesises
  // afterwards. Measured, and it is the reason this exists: a
  // mobile engine can hold a synthesised click back by around 300ms
  // while it waits to see whether a second tap is coming, so two taps
  // 60ms apart arrive here as clicks 300ms apart, read as two singles,
  // and the gesture is never seen at all.
  //
  // Having decided on the touch side, this suppresses the clicks still
  // in flight so the gesture does not also advance the deck twice.
  var swallowClicksUntil = 0;
  // Releasing the button after highlighting a quotation is not a click to
  // advance, and treating it as one costs the reader both the selection
  // and their place. A drag that selected nothing is not one either — it
  // was still a drag, not a click.
  //
  // Two signals rather than one: the selection is the exact statement of
  // "I was highlighting", and the distance covers a drag over an area
  // with no text to take. Four pixels of slack, because a click held long
  // enough to wobble is still a click.
  var pressX = 0;
  var pressY = 0;
  // The selection that EXISTS at press time. The browser clears the
  // selection on mousedown — before our click event arrives — so "is
  // there a selection now" can never say "there was one a moment ago".
  // A click on an existing selection is the reader dismissing it: it
  // must not also advance the deck. Read at mousedown, and only for the
  // left button: a right-click on a selection is the context menu's
  // business, already handled separately.
  var hadSelectionAtPress = false;
  document.addEventListener('mousedown', function (e) {
    if (helpIsOpen()) return;
    pressX = e.clientX;
    pressY = e.clientY;
    hadSelectionAtPress = e.button === 0 && String(window.getSelection()).length > 0;
  });
  function endedADrag(e) {
    if (String(window.getSelection())) return true;
    return Math.abs(e.clientX - pressX) > 4 || Math.abs(e.clientY - pressY) > 4;
  }
  document.addEventListener('click', function (e) {
    if (helpIsOpen()) { closeHelp(); return; }
    if (isInteractive(e)) return;
    // A click the touch side has already answered for. See
    // swallowClicksUntil.
    if (Date.now() < swallowClicksUntil) return;
    if (pauseOverlay && pauseOverlay.contains(e.target)) { closePause(); return; }
    // A popover or dialog is open and the reader clicks outside it:
    // closing it is the whole of the click. Advancing the deck here
    // would move the reader the moment they asked for nothing — and on
    // the way out, the same click that closed the window would change
    // the card under the reader's nose. (A click INSIDE the window never
    // reaches this handler: isInteractive above has already returned.)
    if ((sharePopover && sharePopover.classList.contains('open'))
        || (tagMenu && tagMenu.classList.contains('open'))) {
      closeSharePopover();
      closeTagMenu();
      return;
    }
    // Only the left button (0) drives navigation from here on.
    if (e.button !== 0) return;
    // A click that pressed down on an existing selection is the reader
    // dismissing it — the browser has already cleared it, and the click
    // must not also advance the deck. The reader asked to remove the
    // highlight, not to move on. The second press of a pair is exempt:
    // the pair itself selects the word under the pointer, so the
    // selection at press time is the gesture's own, not a dismissal.
    if (e.detail < 2 && hadSelectionAtPress) return;
    // The drag guards say "a click that ends a drag is not a step".
    // A click that lands DURING a glide is exempt: the pair (press of
    // the first click, then press of this one) has already selected the
    // word under the pointer by the time this event fires, and blocking
    // on it would make the mid-glide jump unreachable with the mouse.
    if (e.detail < 2 && endedADrag(e)) return;
    // One step, and the glide that carries it: the click glides to the
    // next card over 200ms. A click that lands while the deck is still
    // gliding does not wait — it jumps straight to ITS target (§8.4):
    // in the same direction that is the card past the glide's target
    // (two pages in two clicks), in the other it returns to the card
    // the reader left. The click always changes slide (never scrolls
    // within the current one), so the speaker lands on the next card
    // cleanly.
    //
    // While the deck is gliding, `current` already names the glide's
    // target (goTo sets it before the animation starts), so the next
    // step is `current + 1` and the jump lands two pages past the
    // starting one. At rest, `current` may be stale (the scroll
    // observer owns it), so the step is anchored on `currentVisible`.
    var base = isScrolling ? current : currentVisible();
    if (isIndex) {
      // The index: the same click is the same step, card by card —
      // left advances one card's focus, and clicking a card itself is
      // the card's own link, which `isInteractive` has already let
      // through (the native default follows it). There is no fiche to
      // navigate to: the step is a focus move, never a goTo.
      stepIndexCards(1);
      return;
    }
    if (!slides.length) return;
    goTo(base + 1, isScrolling);
    // The second click of a quick pair is also the platform's own
    // double-click, which selects the word under the pointer — on the
    // card the deck has just left. That selection is a ghost: the
    // reader never saw it (the page moved away underneath it), and it
    // steals the next right-click, which opens the copy menu instead
    // of stepping back. The deck's own motion invalidates the
    // platform's gesture, so the ghost is cleared with it.
    if (e.detail >= 2) window.getSelection().removeAllRanges();
  });
  // And the dblclick event itself can re-pose the selection after our
  // click handler wiped it (the browsers differ on when the selection
  // lands), so it is wiped again, out of reach of the copy menu.
  document.addEventListener('dblclick', function (e) {
    if (helpIsOpen()) return;
    if (isInteractive(e)) return;
    window.getSelection().removeAllRanges();
  });
  document.addEventListener('contextmenu', function (e) {
    if (helpIsOpen()) {
      e.preventDefault();
      return;
    }
    // Right-click = go back, the exact mirror of the left button — it
    // works everywhere the left one does, including on the index cards
    // and the series-nav links: on a mouse, the right button is the
    // deck's "back", not the browser's menu. On a touch screen this
    // event IS the long press, which is how a reader selects a word and
    // opens the copy callout. Reported: a long press threw the reader
    // back a card and left them unable to select anything at all,
    // because `preventDefault()` below takes the native gesture with it.
    //
    // Guarded on the pointer rather than on the event, because the event
    // is the same one: a mouse has a second button and a finger does not,
    // and that is the whole of the distinction.
    if (!hasFinePointer) return;
    if (pauseOverlay && pauseOverlay.contains(e.target)) return;
    // A selection is the reader's own text, and right-clicking it asks
    // for the browser's own menu — copy, copy link, search. Reported
    // from the field: right-clicking a highlighted passage went back a
    // card instead, which is the same theft the left-button guard
    // (`endedADrag`) prevents on the way in. Without a selection,
    // right-click keeps its deck meaning: go back one card.
    if (String(window.getSelection())) return;
    // A right-click inside the intent window was already consumed by
    // the middle-then-right gesture (Home) — the menu must not also
    // appear.
    if (Date.now() < fsIntentUntil) return;
    e.preventDefault();
    // The mirror of the left button, including the glide logic: while
    // the deck is gliding, `current` names the glide's target, so the
    // back-click returns to the card the reader left. At rest it is
    // anchored on `currentVisible` (the scroll observer owns it).
    var base = isScrolling ? current : currentVisible();
    if (isIndex) {
      // The mirror of the left button on the index: right-click steps
      // the focus back one card.
      stepIndexCards(-1);
      return;
    }
    if (!slides.length) return;
    goTo(base - 1, isScrolling);
  });
  // The middle button is the fullscreen gatekeeper. Browsers refuse
  // requestFullscreen() from a non-left event (B37), so entry is a
  // two-step gesture: middle button (arms the intent), then a LEFT click
  // within the window (carries the gesture the browser requires). A RIGHT
  // click within the same window goes Home instead. A middle press while
  // fullscreen simply exits. The WHEEL itself keeps scrolling; the ⛶ button
  // and F keep working as direct entries.
  var fsIntentUntil = 0;
  var fsEntryPending = false;
  var FS_INTENT_MS = 900;
  document.addEventListener('mousedown', function (e) {
    if (helpIsOpen()) {
      e.preventDefault();
      e.stopPropagation();
      return;
    }
    if (e.button === 1) {
      e.preventDefault();
      if (isFullscreen()) {
        toggleFullscreen();
      } else {
        fsIntentUntil = Date.now() + FS_INTENT_MS;
      }
      return;
    }
    if (Date.now() >= fsIntentUntil) return;
    if (e.button === 0) {
      // The second half of the gesture: a left click inside the
      // intent window carries the entry. preventDefault keeps the
      // click from also doing whatever the left button normally does
      // on this target (advance the deck, follow a card link).
      e.preventDefault();
      fsIntentUntil = 0;
      fsEntryPending = true;
      toggleFullscreen();
    } else if (e.button === 2) {
      // The same intent, the other way: middle then RIGHT goes Home.
      // Right-click normally steps back; inside the intent window it
      // is a deliberate second half, so it is swallowed here — and the
      // contextmenu handler below never sees it (its own guard checks
      // the intent window too).
      e.preventDefault();
      fsIntentUntil = 0;
      window.location.href = 'index.html';
    }
  }, true);
  document.addEventListener('click', function (e) {
    // The second half of the two-step consumed this click: cancel the
    // link navigation that would otherwise follow (the click default),
    // so the entry does not also open the card under the pointer.
    if (fsEntryPending) {
      fsEntryPending = false;
      e.preventDefault();
      e.stopPropagation();
    }
  }, true);

  // --- Touch swipe and double tap (mobile / tablet) ---
  var touchStartX = null, touchStartY = null, touchStartT = 0;
  var lastTapT = 0;
  // Two taps close together, each of them short and still. The window is
  // wider than the platform's own two-click window (the one that fires
  // dblclick) on purpose: a finger
  // is slower and less accurate than a pointer, and the cost of missing
  // the gesture — chrome the reader cannot put away — is worse than the
  // cost of catching one tap too many.
  var DOUBLE_TAP_MS = 350;
  var TAP_SLOP_PX = 20;
  var navAutoHide = true;
  document.addEventListener('touchstart', function (e) {
    if (helpIsOpen()) {
      touchStartX = null;
      lastTapT = 0;
      return;
    }
    if (e.touches.length !== 1) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    touchStartT = Date.now();
  }, { passive: true });
  document.addEventListener('touchend', function (e) {
    if (helpIsOpen()) {
      touchStartX = null;
      lastTapT = 0;
      return;
    }
    if (touchStartX === null) return;
    var dx = e.changedTouches[0].clientX - touchStartX;
    var dy = e.changedTouches[0].clientY - touchStartY;
    var dt = Date.now() - touchStartT;
    touchStartX = null;
    // Horizontal swipe dominates: 50px threshold, < 500ms, horizontal >
    // vertical. Left = next, right = previous (convention: swipe the way
    // the next slide comes FROM).
    if (dt < 500 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      if (dx < 0) runStepped(stepForward); else runStepped(stepBackward);
      lastTapT = 0;
      return;
    }
    // A double tap is the reader's switch between the default auto-hide
    // mode and a pinned navigation chrome. It changes the mode, not just
    // the current opacity: the reader can leave the controls available
    // while reading, then return to the quiet default with the same gesture.
    //
    // Fullscreen keeps the button in that chrome rather than this
    // gesture. One gesture that means two things depending on a state
    // the reader cannot see coming is not a gesture, it is a lottery.
    if (isInteractive(e)) { lastTapT = 0; return; }
    if (dt >= 500 || Math.abs(dx) > TAP_SLOP_PX || Math.abs(dy) > TAP_SLOP_PX) {
      lastTapT = 0;
      return;
    }
    var now = Date.now();
    if (lastTapT && now - lastTapT < DOUBLE_TAP_MS) {
      lastTapT = 0;
      // The first tap has already advanced the deck, and the
      // synthesised clicks for both taps may still be in flight.
      // Suppress the ones that remain, or the gesture that put the
      // chrome away would also have moved the reader two cards on.
      swallowClicksUntil = now + 450;
      toggleNavMode();
      return;
    }
    lastTapT = now;
  }, { passive: true });

  // --- Toggle nav chrome (buttons + dots) by clicking bottom-right ---
  // A click in the nav-buttons area that does NOT hit a button toggles
  // the visibility of both the pagination dots and the nav buttons.
  // This lets the speaker hide all distracting chrome on a large screen.
  var navButtons = document.querySelector('.nav-buttons');
  var navModeToast = document.getElementById('navModeToast');
  var navModeToastTimer = null;
  function setNavIdle(isIdle) {
    if (navButtons) navButtons.classList.toggle('idle', isIdle);
    if (navDots) navDots.classList.toggle('idle', isIdle);
    if (slideCounter) slideCounter.classList.toggle('idle', isIdle);
    // The scroll bar belongs to the scrolling element, not to any of the
    // three above, so it takes a class of its own on the root. It is
    // navigation all the same: it says where you are and it invites a
    // drag, which is exactly what should not appear on a wall behind a
    // speaker who has stopped touching the mouse.
    document.documentElement.classList.toggle('nav-idle', isIdle);
  }
  // The root class is the one flag all four pieces share, so it is the
  // one thing to ask. Reading `.idle` off any single element would be
  // right until someone hides a piece that no longer exists on the page.
  function navIsIdle() {
    return document.documentElement.classList.contains('nav-idle');
  }
  if (navButtons) {
    navButtons.addEventListener('click', function (e) {
      if (e.target === navButtons && navAutoHide) {
        setNavIdle(!navButtons.classList.contains('idle'));
      }
    });
  }

  // --- Auto-hide nav chrome after 3s of idleness (1s in fullscreen) ---
  // The speaker does not want chrome on the wall while talking; the
  // reader on a phone does not want it sitting on their text. One delay,
  // two ways back, because the two devices do not offer the same signal:
  // continuous mouse movement where there is a pointer, a deliberate
  // double tap where there is none.
  //
  // Touch used to be exempt outright, and the reason recorded was that
  // there is no cursor to wake the chrome. That was a fact about the
  // mechanism, not about the reader, and it left the phone as the one
  // device where the buttons could never be put away.
  var idleTimer = null;
  var hasFinePointer = !!(window.matchMedia
                           && window.matchMedia('(pointer: fine)').matches);
  function getIdleDelay() {
    return isFullscreen() ? 1000 : 3000;
  }
  function setNavMode(autoHide) {
    navAutoHide = autoHide;
    if (idleTimer) clearTimeout(idleTimer);
    idleTimer = null;
    document.documentElement.classList.toggle('nav-permanent', !autoHide);
    setNavIdle(false);
    if (autoHide) scheduleHide();
  }
  function showNavModeToast(autoHide) {
    if (!navModeToast) return;
    if (navModeToastTimer) clearTimeout(navModeToastTimer);
    if (autoHide) {
      navModeToast.textContent = lwpString('nav_mode_auto');
    } else {
      navModeToast.textContent = lwpString('nav_mode_permanent');
    }
    navModeToast.classList.add('show');
    navModeToastTimer = setTimeout(function () {
      navModeToast.classList.remove('show');
      navModeToastTimer = null;
    }, 1800);
  }
  function toggleNavMode() {
    setNavMode(!navAutoHide);
    showNavModeToast(navAutoHide);
  }
  function scheduleHide() {
    if (idleTimer) clearTimeout(idleTimer);
    idleTimer = null;
    if (!navAutoHide) return;
    idleTimer = setTimeout(function () {
      idleTimer = null;
      if (!navAutoHide) return;
      setNavIdle(true);
      // Only where there is one to hide. Setting it on a touch device is
      // harmless but says something false about what just happened.
      if (hasFinePointer) document.body.style.cursor = 'none';
    }, getIdleDelay());
  }
  if (hasFinePointer) {
    document.addEventListener('mousemove', function () {
      // Nothing is revealed here. revealChrome() decides, on the one
      // condition that governs both: movement that has already lasted
      // 250ms. What this handler always does is restart the countdown,
      // so a mouse that is moving is never a mouse that has gone idle.
      revealChrome();
      scheduleHide();
    });
  } else {
    // Nothing here reveals anything: that is the point of asking for a
    // double tap. What a touch does do is restart the countdown while
    // auto-hide is active and the chrome is still up, so it never fades
    // out from under a finger that is in the middle of using it.
    function keepAwakeOnTouch() {
      if (navAutoHide && !navIsIdle()) scheduleHide();
    }
    document.addEventListener('touchstart', keepAwakeOnTouch, { passive: true });
    window.addEventListener('scroll', keepAwakeOnTouch, { passive: true });
  }
  // Reschedule on fullscreen change to use the correct delay
  document.addEventListener('fullscreenchange', scheduleHide);
  document.addEventListener('webkitfullscreenchange', scheduleHide);
  scheduleHide();

  if (btnMenu) btnMenu.addEventListener('click', togglePresenterMenu);
  renderTagMenu();
  applyTagFilter(false);
  window.addEventListener('hashchange', applyHash);
  applyHash();
  updateUI();
})();
});
'''

# --- Template: page.html ---
#
# ONE skeleton serves both kinds of page: an article page and the series
# index are the same page with different content (§9.3.6). `{{body_class}}`
# says which one this build produced (`index-page` for the index, empty
# for an article) and `{{content}}` carries the page-specific body: the
# slides for an article, the header + intro + cards for the index.
# The same furniture (nav buttons, dots, share, help, presenter, tags)
# ships on every page, so a gesture a reader learns anywhere works
# everywhere.
#
# The index page's measure and its breakpoint live in the composed sheet,
# on `.index-page`, beside the `.slide` rules they have to agree with
# (§9.3.1). An inline style on <body> is a literal the theme engine
# cannot reach and a rule no media query can override, which is how this
# page once came to adapt to a screen differently from every other page of
# the same series. Written in the sheet rather than in the template
# because anything inside the string is published to every reader of
# every series.
TEMPLATE_PAGE = '''<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{{meta_head}}<title>{{title}}</title>
<style>
{{css}}
</style>
</head>
<body class="{{body_class}}"
      data-lwp-default-tag="{{default_tag}}"
      data-lwp-series-tags="{{series_tags}}"
      data-lwp-article-tags="{{article_tags}}"
      data-lwp-tag-preview="{{tag_preview}}">

{{build_stamp}}{{draft_banner}}
<nav class="nav-dots"></nav>

<div class="pause-overlay" id="pauseOverlay"></div>

<div class="slide-counter" id="slideCounter"></div>
<div class="presenter-panel" id="presenterPanel" role="region"
     aria-label="{{str_presenter_label}}"
     data-lwp-i18n-aria-label="presenter_label" tabindex="0">
  <div class="pp-head" id="presenterHead"></div>
  <div class="pp-notes" id="presenterNotes" aria-live="polite"></div>
  <div class="pp-next" id="presenterNext"></div>
</div>

<div class="help-overlay" id="helpOverlay" role="dialog" aria-modal="true"
     aria-labelledby="helpTitle">
  <div class="help-card" tabindex="0">
    <div class="help-title" id="helpTitle" data-lwp-i18n="help_title">{{str_help_title}}</div>
    <ul class="help-list" id="helpList"></ul>
    <div class="help-stamp"><span data-lwp-i18n="help_stamp">{{str_help_stamp}}</span> <strong>LightWebPres</strong> v{{lightwebpres_version}}</div>
  </div>
</div>

<div class="presenter-menu" id="presenterMenu" role="dialog" aria-modal="true"
     aria-labelledby="presenterMenuTitle">
  <div class="presenter-menu-card">
    <div class="presenter-menu-title" id="presenterMenuTitle" data-lwp-i18n="menu_title">{{str_menu_title}}</div>
    <div class="presenter-menu-actions">
      <button type="button" class="presenter-menu-action" id="menuPrev" data-menu-action="prev" aria-keyshortcuts="ArrowUp ArrowLeft PageUp Backspace">
        {{icon_prev}}<span class="presenter-menu-label" data-lwp-i18n="menu_prev">{{str_menu_prev}}</span><kbd>Page Up</kbd>
      </button>
      <button type="button" class="presenter-menu-action nav-btn-home" id="menuHome" data-menu-action="home" aria-keyshortcuts="Home">
        {{icon_home}}<span class="presenter-menu-label" data-lwp-i18n="menu_home">{{str_menu_home}}</span><kbd>Home</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuNext" data-menu-action="next" aria-keyshortcuts="ArrowDown ArrowRight PageDown">
        {{icon_next}}<span class="presenter-menu-label" data-lwp-i18n="menu_next">{{str_menu_next}}</span><kbd>Page Down</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuFullscreen" data-menu-action="fullscreen" aria-keyshortcuts="F">
        {{icon_fullscreen}}<span class="presenter-menu-label" data-lwp-i18n="menu_fullscreen">{{str_menu_fullscreen}}</span><kbd>F</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuTheme" data-menu-action="theme" aria-keyshortcuts="C">
        {{icon_theme}}<span class="presenter-menu-label" data-lwp-i18n="menu_theme">{{str_menu_theme}}</span><kbd>C</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuPresenter" data-menu-action="presenter" aria-keyshortcuts="N">
        {{icon_presenter}}<span class="presenter-menu-label" data-lwp-i18n="menu_presenter">{{str_menu_presenter}}</span><kbd>N</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuTags" data-menu-action="tags" aria-keyshortcuts="L">
        {{icon_tags}}<span class="presenter-menu-label" data-lwp-i18n="menu_tags">{{str_menu_tags}}</span><kbd>L</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuShare" data-menu-action="share" aria-keyshortcuts="S">
        {{icon_share}}<span class="presenter-menu-label" data-lwp-i18n="menu_share">{{str_menu_share}}</span><kbd>S</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuHelp" data-menu-action="help" aria-keyshortcuts="H">
        {{icon_help}}<span class="presenter-menu-label" data-lwp-i18n="menu_help">{{str_menu_help}}</span><kbd>H</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuPauseBlack" data-menu-action="pause-black" aria-keyshortcuts="B">
        {{icon_pause}}<span class="presenter-menu-label" data-lwp-i18n="menu_pause_black">{{str_menu_pause_black}}</span><kbd>B</kbd>
      </button>
      <button type="button" class="presenter-menu-action" id="menuPauseWhite" data-menu-action="pause-white" aria-keyshortcuts="W">
        {{icon_pause}}<span class="presenter-menu-label" data-lwp-i18n="menu_pause_white">{{str_menu_pause_white}}</span><kbd>W</kbd>
