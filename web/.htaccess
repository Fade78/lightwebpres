# Apache MIME types for the Pyodide runtime vendored under vendor/pyodide/
# (see specifications.md §23.7). Pyodide dynamic-imports pyodide.asm.mjs
# as an ES module, which browsers strictly validate the Content-Type of;
# many Apache defaults predate the .mjs extension and serve it as
# application/octet-stream, which the browser then refuses to load. This
# file fixes it automatically on deploy for the common case of shared
# hosting with AllowOverride enabled — no server config access needed.
# Has no effect on nginx (which never reads .htaccess) — see
# specifications.md §23.7 for the nginx equivalent.
AddType text/javascript .mjs
AddType application/wasm .wasm

# Defense-in-depth: stop the browser from MIME-sniffing a response into a
# type it wasn't served as. Safe everywhere, no effect on how the page
# functions. A Content-Security-Policy is deliberately NOT set here: the
# page uses inline <script>/<style> and Pyodide needs dynamic wasm +
# workers, so any CSP would require 'unsafe-inline' + 'wasm-unsafe-eval'
# and a connect-src wide enough for any user-supplied GitLab host —
# yielding little real protection (the security review found no DOM-XSS
# sink to protect) while risking breakage across deploy targets. Revisit
# if the page moves to nonce'd scripts.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
